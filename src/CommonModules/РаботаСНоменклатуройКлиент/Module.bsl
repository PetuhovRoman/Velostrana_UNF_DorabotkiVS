
&После("ВыполнитьПодключаемуюКоманду")
Процедура ВС_ВыполнитьПодключаемуюКоманду(Форма, Команда)
	
	Если Команда.Имя = "ОткрытьОписание" Тогда
		ИмяФормы = Форма.ИмяФормы;
		Если ИмяФормы = "Справочник.Номенклатура.Форма.ФормаСпискаВС"
			Или ИмяФормы = "Справочник.Номенклатура.Форма.ФормаСписка"
			Или ИмяФормы = "Обработка.СписокНоменклатуры.Форма.ФормаСписка"
			Тогда
			
			Товары = Форма.Элементы.СписокЗапасы.ВыделенныеСтроки;
			Если ТипЗнч(Товары) <> Тип("Массив") Или Товары.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
			
			Товар = Товары[0];
		КонецЕсли;
		
		ПараметрыФормыОписания = Новый Структура;
		ПараметрыФормыОписания.Вставить("Номенклатура", Товар);
		ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаВыводаОписания", ПараметрыФормыОписания, Форма,,,,);
		
	КонецЕсли; 
	
КонецПроцедуры
