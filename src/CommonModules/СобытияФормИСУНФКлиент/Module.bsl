
&После("ВыполнитьПереопределяемуюКоманду")
Процедура ВС_ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры)
	
	Если Команда.Имя = "ОткрытьОписание" Тогда
		ИмяФормы = Форма.ИмяФормы;
		Если ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда
			Товар = Форма.Объект.Ссылка;
		КонецЕсли;
		
		ПараметрыФормыОписания = Новый Структура;
		ПараметрыФормыОписания.Вставить("Номенклатура", Товар);
		ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаВыводаОписания", ПараметрыФормыОписания, Форма,,,,);
