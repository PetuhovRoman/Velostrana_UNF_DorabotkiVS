Процедура ЗагрузитьДанные() Экспорт
	
	Соединение = ПодключитьсяКFTPСерверу();
	МассивФайлов = ПолучениеФайловПоFTP(Соединение);
	ТаблицаСотрудниковУТ10 = ПолучитьТЗСотрудников(Соединение);
	
	КаталогПапкиAnviz = "C:\Проект 1С\";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПользователиUIDs_ANVIZ.Ссылка КАК Ссылка,
	|	ПользователиUIDs_ANVIZ.МагнитныйКод КАК ИдентификаторANVIZ
	|ИЗ
	|	Справочник.Сотрудники КАК ПользователиUIDs_ANVIZ
	|ГДЕ
	|	ПользователиUIDs_ANVIZ.МагнитныйКод <> """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	//ТаблицаДанных = Новый ТаблицаЗначений;
	////ТаблицаДанных.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	//ТаблицаДанных.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	//ТаблицаДанных.Колонки.Добавить("День", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	//ТаблицаДанных.Колонки.Добавить("ВремяНачала", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Время));
	//ТаблицаДанных.Колонки.Добавить("ВремяОкончания", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Время));
    МассивОшибокЗагрузки = Новый Массив;
	
	//МассивФайлов = НайтиФайлы(КаталогПапкиAnviz + "Anviz\","*.txt", Ложь);
	Для Каждого Файл Из МассивФайлов Цикл 
		
		ТекстовыйФайл = Новый ТекстовыйДокумент;
		ТекстовыйФайл.Прочитать(Файл);
		//1 ид машины
		//2-6 строка ид юзера
		//7-10 время
		Подразделение = "";
		
		Попытка
			ид = Число(ТекстовыйФайл.ПолучитьСтроку(2))*pow(256,4) + Число(ТекстовыйФайл.ПолучитьСтроку(3))*pow(256,3)+
			Число(ТекстовыйФайл.ПолучитьСтроку(4))*pow(256,2) + Число(ТекстовыйФайл.ПолучитьСтроку(5))*256+
			Число(ТекстовыйФайл.ПолучитьСтроку(6));
			
			подразделение = ТекстовыйФайл.ПолучитьСтроку(1);
			
			ДатаВремя = Число(ТекстовыйФайл.ПолучитьСтроку(7))*pow(256,3)+ Число(ТекстовыйФайл.ПолучитьСтроку(8))*pow(256,2) + 
			Число(ТекстовыйФайл.ПолучитьСтроку(9))*256+Число(ТекстовыйФайл.ПолучитьСтроку(10));
			
		Исключение
			ид = Неопределено;
			ДатаВремя = Неопределено;
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(ид) ИЛИ НЕ ЗначениеЗаполнено(ДатаВремя) Тогда 
			//ПереместитьФайл(Файл.ПолноеИмя, КаталогПапкиAnviz + "Anviz\log\errors\"+Файл.Имя);
			ЗаписьЖурналаРегистрации("ЗагрузкаДанныхАнвиз", УровеньЖурналаРегистрации.Ошибка, , , "Ошибки в файле " + Файл);
			Продолжить;
		КонецЕсли;
		
		Выборка.Сбросить();
		
		Если Выборка.НайтиСледующий(Формат(ид, "ЧГ=0"),"ИдентификаторANVIZ") Тогда 
			
			Менеджер = РегистрыСведений.ДанныеАнвиз.СоздатьМенеджерЗаписи();
			Менеджер.Сотрудник = Выборка.Ссылка;
			Менеджер.День = '20000102' + ДатаВремя;
			Менеджер.ИДСотрудника = 0+ид;
			Менеджер.ПредставлениеСотрудника = СокрЛП(Выборка.Ссылка);
			Менеджер.ПредставлениеПодразделения = Подразделение; 
			Менеджер.Записать();
			
			//СтрокаТЗ = ТаблицаДанных.Добавить();
			////СтрокаТЗ.Подразделение = Подразделение;
			//СтрокаТЗ.Сотрудник = Выборка.Ссылка;
			//СтрокаТЗ.День = '20000102' + ДатаВремя;
			//СтрокаТЗ.ВремяНачала = '20000102' + ДатаВремя;
			//СтрокаТЗ.ВремяОкончания = '20000102' + ДатаВремя;
			
			ЗаписьЖурналаРегистрации("ЗагрузкаДанныхАнвиз", УровеньЖурналаРегистрации.Информация, , Выборка.Ссылка, "Загружен файл " + Файл);
			
		Иначе
			СтрокаТЗ = ТаблицаСотрудниковУТ10.Найти(Формат(ид, "ЧГ=0"), "СотрудникНомерКарты"); 
			Если СтрокаТЗ = Неопределено Тогда 
				//ПереместитьФайл(Файл.ПолноеИмя, КаталогПапкиAnviz + "Anviz\log\errors\"+Файл.Имя);
				ЗаписьЖурналаРегистрации("ЗагрузкаДанныхАнвиз", УровеньЖурналаРегистрации.Ошибка, , , "Ошибки в файле " + Файл + " Не найден ИД " + Формат(ид, "ЧГ=0"));
				
				СтрокаВОшибки = "Ошибки в файле Анвиз, не найден ИД " + Формат(ид, "ЧГ=0");
				Если МассивОшибокЗагрузки.Найти(СтрокаВОшибки) = Неопределено Тогда
					МассивОшибокЗагрузки.Добавить(СтрокаВОшибки);
				КонецЕсли;
			Иначе
				
				Сотр = ПолучитьСотрудника(СтрокаТЗ);
				Если ЗначениеЗаполнено(Сотр) Тогда
					Менеджер = РегистрыСведений.ДанныеАнвиз.СоздатьМенеджерЗаписи();
					Менеджер.Сотрудник = Сотр;
					Менеджер.День = '20000102' + ДатаВремя;
					Менеджер.ИДСотрудника = 0+ид;
					Менеджер.ПредставлениеСотрудника = СокрЛП(СтрокаТЗ.СотрудникНаименование);
					Менеджер.ПредставлениеПодразделения = Подразделение; 
					Менеджер.Записать();
					
					ЗаписьЖурналаРегистрации("ЗагрузкаДанныхАнвиз", УровеньЖурналаРегистрации.Информация, , Выборка.Ссылка, "Загружен файл " + Файл);
				Иначе
					ЗаписьЖурналаРегистрации("ЗагрузкаДанныхАнвиз", УровеньЖурналаРегистрации.Ошибка, , , "Ошибки в файле " + Файл + " Не найден ИД " + Формат(ид, "ЧГ=0"));
					
					СтрокаВОшибки = "Ошибки в файле Анвиз, не найден ИД " + Формат(ид, "ЧГ=0");
					Если МассивОшибокЗагрузки.Найти(СтрокаВОшибки) = Неопределено Тогда
						МассивОшибокЗагрузки.Добавить(СтрокаВОшибки);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
	СформироватьДокументыУчета(НачалоДня(ТекущаяДатаСеанса()) - 7*24*60*60, НачалоДня(ТекущаяДатаСеанса()));	
	
	Если МассивОшибокЗагрузки.Количество()>0 Тогда
		ТекстОшибки = "";
		Для Каждого СтрокаОшибки Из МассивОшибокЗагрузки Цикл
			ТекстОшибки = ТекстОшибки + СтрокаОшибки + Символы.ПС;
		КонецЦикла;
		ВС_ОбщегоНазначения.ОтправитьСообщениеОбОшибкеВСистемуВзаимодействия(ТекстОшибки);
	КонецЕсли;	
	
КонецПроцедуры

Функция ПодключитьсяКFTPСерверу()
	
