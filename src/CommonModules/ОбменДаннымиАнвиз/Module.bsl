	);
	
	//Пароли = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища();
	
	Соединение.УстановитьТекущийКаталог("/");
	// Для случаев, когда у ftp сервера нет возможности
	// обращаться к нам (мы находимся за межсетевым экраном)
	// следует использовать пассивный режим работы.
	
	Возврат Соединение;
	
КонецФункции

Функция ПолучениеФайловПоFTP(Соединение)
	
	ПапкаДляСохранения = КаталогВременныхФайлов();    
	МассивСкачанныхФайлов = Новый Массив;
	
	НайденныеФайлы = Соединение.НайтиФайлы("/anviz/*.txt");
	Для Каждого ФайлАнвиз Из НайденныеФайлы Цикл
		
		Если НачалоДня(ФайлАнвиз.ПолучитьВремяИзменения()) < НачалоДня(ТекущаяДатаСеанса()) - 2*24*60*60
			И НачалоДня(ФайлАнвиз.ПолучитьВремяИзменения()) >= НачалоДня(ТекущаяДатаСеанса()) Тогда
			//Если НачалоДня(ФайлАнвиз.ПолучитьВремяИзменения()) < НачалоДня(ТекущаяДатаСеанса()) - 10*24*60*60 Тогда
			//	Соединение.Удалить(ФайлАнвиз.ПолноеИмя);
			//КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		ФайлДляЗагрузки = ПапкаДляСохранения + ФайлАнвиз.Имя;
		Попытка
			// Скачаем 
			// Внимание! Используем прямые слеши.
			Соединение.Получить(ФайлАнвиз.ПолноеИмя, // что качаем
			ФайлДляЗагрузки // куда качаем
			);
			МассивСкачанныхФайлов.Добавить(ФайлДляЗагрузки);
			
			Соединение.Переместить(ФайлАнвиз.ПолноеИмя, "/anviz/log/" + ФайлАнвиз.Имя);
		Исключение
			ЗаписьЖурналаРегистрации("ЗагрузкаДанныхАнвиз", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка получения файла " + ФайлАнвиз.ПолноеИмя);
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат МассивСкачанныхФайлов;
	
КонецФункции

Процедура СформироватьДокументыУчета(ДатаНач, ДатаКон) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДанных.Сотрудник КАК Сотрудник,
	|	НАЧАЛОПЕРИОДА(ТаблицаДанных.День, ДЕНЬ) КАК День,
	|	НАЧАЛОПЕРИОДА(ТаблицаДанных.День, МИНУТА) КАК ВремяНачала,
	|	НАЧАЛОПЕРИОДА(ТаблицаДанных.День, МИНУТА) КАК ВремяОкончания,
	|	ТаблицаДанных.ПредставлениеПодразделения КАК ПредставлениеПодразделения
	|ПОМЕСТИТЬ ТаблицаВремени
	|ИЗ
	|	РегистрСведений.ДанныеАнвиз КАК ТаблицаДанных
	|ГДЕ
	|	ТаблицаДанных.День МЕЖДУ &ДатаНач И &ДатаКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаВремени.Сотрудник КАК Сотрудник,
	|	ТаблицаВремени.День КАК День,
	|	МИНИМУМ(ТаблицаВремени.ВремяНачала) КАК ВремяНачала,
	|	МАКСИМУМ(ТаблицаВремени.ВремяОкончания) КАК ВремяОкончания,
	|	ЕСТЬNULL(ИдентификаторыРабочихСмен.РабочаяСмена, &РабочаяСмена) КАК РабочаяСмена
	|ИЗ
	|	ТаблицаВремени КАК ТаблицаВремени
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИдентификаторыРабочихСмен КАК ИдентификаторыРабочихСмен
	|		ПО (ТаблицаВремени.ПредставлениеПодразделения = ИдентификаторыРабочихСмен.Идентификатор
	|				ИЛИ ТаблицаВремени.ПредставлениеПодразделения = ИдентификаторыРабочихСмен.ИдентификаторАльтернативный)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаВремени.Сотрудник,
	|	ТаблицаВремени.День,
	|	ЕСТЬNULL(ИдентификаторыРабочихСмен.РабочаяСмена, &РабочаяСмена)
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(ТаблицаВремени.ВремяНачала) <> МАКСИМУМ(ТаблицаВремени.ВремяОкончания)
	|ИТОГИ ПО
	|	РабочаяСмена,
	|	День";
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	Запрос.УстановитьПараметр("РабочаяСмена", ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.РабочиеСменыСтруктурныхЕдиниц?ref=bbb385d39ee01ba511f08e36a17d80e7"));
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); //ПО сменам
	Пока Выборка.Следующий() Цикл
		РабочаяСмена = Выборка.РабочаяСмена;
		
		ВыборкаПоДням = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); //ПО ДНЯМ
		Пока ВыборкаПоДням.Следующий() Цикл
			ДокументУчетаВремени = ПолучитьДокументУчета(ВыборкаПоДням.День, РабочаяСмена);
			ДокументУчетаВремени.ОтработанноеВремя.Очистить();
			
			Если Не ЗначениеЗаполнено(ДокументУчетаВремени.Дата) Тогда
				ДокументУчетаВремени.Дата = ТекущаяДатаСеанса();
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ДокументУчетаВремени.Автор) Тогда
				ДокументУчетаВремени.Автор = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
			КонецЕсли;
			ДокументУчетаВремени.ДатаОтчета = ВыборкаПоДням.День;
			ДокументУчетаВремени.РабочаяСмена = РабочаяСмена;
			
			ТЧОтработанноеВремя = ДокументУчетаВремени.ОтработанноеВремя;
			
			ВыборкаСотрудников = ВыборкаПоДням.Выбрать();
			Пока ВыборкаСотрудников.Следующий() Цикл
				
				СтрокаСотрудника = ТЧОтработанноеВремя.Добавить();
				СтрокаСотрудника.Сотрудник = ВыборкаСотрудников.Сотрудник;
				СтрокаСотрудника.НачалоРаботы = ВыборкаСотрудников.ВремяНачала;
				СтрокаСотрудника.ОкончаниеРаботы = ВыборкаСотрудников.ВремяОкончания;
				
				РассчитатьПродолжительностьДня(СтрокаСотрудника);
				
			КонецЦикла;
			ДокументУчетаВремени.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДокументУчета(День, РабочаяСмена)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕжедневныйОтчет.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЕжедневныйОтчет КАК ЕжедневныйОтчет
	|ГДЕ
	|	ЕжедневныйОтчет.ДатаОтчета = &ДатаОтчета
	|	И НЕ ЕжедневныйОтчет.ПометкаУдаления
	|	И ЕжедневныйОтчет.РабочаяСмена = &РабочаяСмена";
	Запрос.УстановитьПараметр("ДатаОтчета", День);
	Запрос.УстановитьПараметр("РабочаяСмена", РабочаяСмена);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Возврат Документы.ЕжедневныйОтчет.СоздатьДокумент();

КонецФункции

Процедура РассчитатьПродолжительностьДня(ТекСтрока)
	
	Разность = 0.00;
	
	Если ЗначениеЗаполнено(ТекСтрока.ОкончаниеРаботы)
		И ЗначениеЗаполнено(ТекСтрока.НачалоРаботы) Тогда
		
		Разность = Разность + (ТекСтрока.ОкончаниеРаботы - ТекСтрока.НачалоРаботы);
		
		Если Разность > 0.00 Тогда
			
			Продолжительность = ЗарплатаИПерсоналКлиентСервер.ПреобразоватьСекундыВДату(Разность);
			
		ИначеЕсли Разность < 0.00 Тогда
			
			Продолжительность = Дата(1, 1, 1);
			
		Иначе
			
			ТекСтрока.ПродолжительностьДня = Дата("00010101");
			
		КонецЕсли;
		
		Если Продолжительность <> Неопределено Тогда
			
			ТекСтрока.ПродолжительностьДня = Продолжительность;
			
		Иначе
			
			ТекСтрока.ПродолжительностьДня = Дата("00010101");
			
		КонецЕсли;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекСтрока.ОкончаниеРаботы)
		И ЗначениеЗаполнено(ТекСтрока.НачалоРаботы) Тогда
		
		ОтметкаНачалаРаботы = ТекСтрока.НачалоРаботы - Дата(1, 1, 1);
		ОтметкаКонцаСуток = 86400;
		
		Разность = ОтметкаКонцаСуток - ОтметкаНачалаРаботы;
		Продолжительность = ЗарплатаИПерсоналКлиентСервер.ПреобразоватьСекундыВДату(Разность);
		ТекСтрока.ПродолжительностьДня = Продолжительность;
		
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПолучитьТЗСотрудников(Соединение) Экспорт
	
	ИмяФайлаНаFTP = "Sotr10UNF.xml";
	ИмяФайла = ПолучениеФайлаСотрудниковПоFTP(Соединение, ИмяФайлаНаFTP);
	
	ТаблицаСотрудников = Новый ТаблицаЗначений;
	ТаблицаСотрудников.Колонки.Добавить("СотрудникИД");
	ТаблицаСотрудников.Колонки.Добавить("СотрудникНаименование"); 
	ТаблицаСотрудников.Колонки.Добавить("СотрудникНомерКарты");
	ТаблицаСотрудников.Колонки.Добавить("СотрудникИдентификаторИнфинити");
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Сотрудники", УровеньЖурналаРегистрации.Предупреждение, , , "Файл не найден");
		Возврат ТаблицаСотрудников;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Исключение
		ЧтениеXML.Закрыть();
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Сотрудники", УровеньЖурналаРегистрации.Ошибка, , ,  "Файл поврежден" + Символы.ПС + ОписаниеОшибки());
		Возврат ТаблицаСотрудников;
	КонецПопытки;
	
	ПостроительДом = Новый ПостроительDOM();
	Попытка
		мДокументДОМ = ПостроительДом.Прочитать(ЧтениеXML);
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Сотрудники", УровеньЖурналаРегистрации.Ошибка, , ,  "Файл не прочитан" + Символы.ПС + ОписаниеОшибки());
		Возврат ТаблицаСотрудников;
	КонецПопытки;
	
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("Сотрудник") Цикл
		НоваяСтрокаТЗ = ТаблицаСотрудников.Добавить();
		НоваяСтрокаТЗ.СотрудникИД = ЭлементДОМ.ПолучитьЭлементыПоИмени("СотрудникИД").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТЗ.СотрудникНаименование = ЭлементДОМ.ПолучитьЭлементыПоИмени("СотрудникНаименование").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТЗ.СотрудникНомерКарты = ЭлементДОМ.ПолучитьЭлементыПоИмени("СотрудникНомерКарты").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТЗ.СотрудникИдентификаторИнфинити = ЭлементДОМ.ПолучитьЭлементыПоИмени("СотрудникИдентификаторИнфинити").Элемент(0).ТекстовоеСодержимое;
	КонецЦикла;
	
	Возврат ТаблицаСотрудников;
	
КонецФункции

Функция ПолучениеФайлаСотрудниковПоFTP(Соединение, ИмяФайлаСтр)
 
	Если Соединение.НайтиФайлы(ИмяФайлаСтр).Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
    ПапкаДляСохранения = КаталогВременныхФайлов();    
	
	ФайлДляЗагрузки = ПапкаДляСохранения + "/" + ИмяФайлаСтр;
    // Скачаем 
    // Внимание! Используем прямые слеши.
    Соединение.Получить(ИмяФайлаСтр, // что качаем
         ФайлДляЗагрузки // куда качаем
    );
	
    Возврат ФайлДляЗагрузки;
	
КонецФункции

Функция ПолучитьСотрудника(СтрТЗ)
	
	Если ПустаяСтрока(СтрТЗ.СотрудникНаименование) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка,
	|	Пользователи.МагнитныйКод КАК МагнитныйКод
	|ИЗ
	|	Справочник.Сотрудники КАК Пользователи
	|ГДЕ
	|	Пользователи.Наименование = &СотрудникНаименование";
	Запрос.УстановитьПараметр("СотрудникНаименование", СтрТЗ.СотрудникНаименование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СпрОбъект.МагнитныйКод = СтрТЗ.СотрудникНомерКарты;
		СпрОбъект.Записать();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НовоеФЛ = Справочники.ФизическиеЛица.СоздатьЭлемент();
	НовоеФЛ.Наименование = СокрЛП(СтрТЗ.СотрудникНаименование);
	НовоеФЛ.Записать();
	
	НовыйСотрудник = Справочники.Сотрудники.СоздатьЭлемент();
	НовыйСотрудник.Заполнить(Неопределено);
	НовыйСотрудник.Наименование = СокрЛП(СтрТЗ.СотрудникНаименование);
	НовыйСотрудник.Физлицо = НовоеФЛ.Ссылка;
	НовыйСотрудник.ФизическоеЛицо = НовоеФЛ.Ссылка;
	НовыйСотрудник.МагнитныйКод = СтрТЗ.СотрудникНомерКарты;
	НовыйСотрудник.Записать();
	
	Если ЗначениеЗаполнено(СтрТЗ.СотрудникИдентификаторИнфинити) Тогда
		МенеджерИнфинити = РегистрыСведений.ИнфинитиИдентификаторыСотрудников.СоздатьМенеджерЗаписи();
		МенеджерИнфинити.Период = НачалоДня(ТекущаяДатаСеанса()) - 7*24*60*60;
		МенеджерИнфинити.Сотрудник = НовыйСотрудник.Ссылка;
		МенеджерИнфинити.Идентификатор = СтрТЗ.СотрудникИдентификаторИнфинити;
		МенеджерИнфинити.Записать();
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("ЗагрузкаДанныхАнвиз", УровеньЖурналаРегистрации.Информация, , НовыйСотрудник.Ссылка, "Создан сотрудник " + СтрТЗ.СотрудникНаименование);
	Возврат НовыйСотрудник.Ссылка;
	
КонецФункции
