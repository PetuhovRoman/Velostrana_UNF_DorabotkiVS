Функция ПолучитьОтветственногоПоОчереди(Очередь = Неопределено, Источник, Исключить = Неопределено) Экспорт
		
	Если Очередь = Неопределено Тогда
		МассивПользователей = Новый Массив;
		МассивСоединений = ПолучитьСоединенияИнформационнойБазы();
		Для каждого х Из МассивСоединений Цикл
			МассивПользователей.Добавить(х.Пользователь.УникальныйИдентификатор);
		КонецЦикла;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Пользователь,
		|	ОтветственныеЗаЗаказы.БезПодключения КАК БезПодключения,
		|	ВЫБОР
		|		КОГДА Пользователи.Ссылка.ИдентификаторПользователяИБ В (&МассивПользователей)
		|				ИЛИ ОтветственныеЗаЗаказы.БезПодключения
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Активность
		|ИЗ
		|	РегистрСведений.ОтветственныеЗаЗаказыПокупателей КАК ОтветственныеЗаЗаказы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиПользователя КАК СотрудникиПользователя
		|		ПО ОтветственныеЗаЗаказы.Ответственный = СотрудникиПользователя.Сотрудник
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО (СотрудникиПользователя.Пользователь = Пользователи.Ссылка)
		|ГДЕ
		|	(Пользователи.Ссылка.ИдентификаторПользователяИБ В (&МассивПользователей)
		|			ИЛИ ОтветственныеЗаЗаказы.БезПодключения)
		|	И ОтветственныеЗаЗаказы.ИсточникЗаказа = &ИсточникЗаказа
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОтветственныеЗаЗаказы.Ответственный.Наименование";
		Запрос.УстановитьПараметр("МассивПользователей", МассивПользователей);
		Запрос.УстановитьПараметр("ИсточникЗаказа", Источник);
		Очередь = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	МассивДоступныхОператоров = Очередь.Скопировать(Новый Структура("Активность",Истина),"Пользователь").ВыгрузитьКолонку("Пользователь");
	Если МассивДоступныхОператоров.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИсточникЗаказа", Источник);
	Запрос.УстановитьПараметр("Пользователи", МассивДоступныхОператоров);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(РаспределениеЗаказов.Период) КАК Период,
	|	РаспределениеЗаказов.Источник КАК ИсточникЗаказа,
	|	СотрудникиПользователя.Сотрудник КАК Ответственный
	|ПОМЕСТИТЬ МаксПериод
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиПользователя КАК СотрудникиПользователя
	|		ПО Пользователи.Ссылка = СотрудникиПользователя.Пользователь
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗаказовПокупателей КАК РаспределениеЗаказов
	|		ПО СотрудникиПользователя.Сотрудник = РаспределениеЗаказов.Ответственный
	|			И (РаспределениеЗаказов.Источник = &ИсточникЗаказа)
	|ГДЕ
	|	Пользователи.Ссылка В(&Пользователи)
	|
	|СГРУППИРОВАТЬ ПО
	|	РаспределениеЗаказов.Источник,
	|	СотрудникиПользователя.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МаксПериод.Период КАК Период,
	|	МаксПериод.ИсточникЗаказа КАК ИсточникЗаказа,
	|	МаксПериод.Ответственный КАК Ответственный,
	|	КОЛИЧЕСТВО(РаспределениеЗаказов.Ответственный) КАК КоличествоЗаказов
	|ИЗ
	|	МаксПериод КАК МаксПериод
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗаказовПокупателей КАК РаспределениеЗаказов
	|		ПО МаксПериод.Период = РаспределениеЗаказов.Период
	|			И МаксПериод.ИсточникЗаказа = РаспределениеЗаказов.Источник
	|			И МаксПериод.Ответственный = РаспределениеЗаказов.Ответственный
	|
	|СГРУППИРОВАТЬ ПО
	|	МаксПериод.Ответственный,
	|	МаксПериод.Период,
	|	МаксПериод.ИсточникЗаказа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период,
	|	КоличествоЗаказов";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ответственный;
	КонецЕсли;

КонецФункции 

Процедура ЗаменаОтветственных(Очередь, Источник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка КАК Ссылка,
	|	ЗаказПокупателя.Ответственный КАК Ответственный
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыЗаказовПокупателей.ПорядокСостояний КАК ВидыЗаказовПокупателейПорядокСостояний
	|		ПО ЗаказПокупателя.ВидЗаказа = ВидыЗаказовПокупателейПорядокСостояний.Ссылка
	|			И ЗаказПокупателя.СостояниеЗаказа = ВидыЗаказовПокупателейПорядокСостояний.Состояние
	|			И (ВидыЗаказовПокупателейПорядокСостояний.Состояние <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен))
	|			И (ВидыЗаказовПокупателейПорядокСостояний.Состояние.ПометкаУдаления = ЛОЖЬ)
	|			И (ВидыЗаказовПокупателейПорядокСостояний.НомерСтроки = 1)
	|ГДЕ
	|	НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.ИсточникПривлечения = &Источник
	|	И ЗаказПокупателя.Дата МЕЖДУ &Дата1 И &Дата2";
	Запрос.УстановитьПараметр("Дата1", НачалоДня(ТекущаяДата() - (7 * 24 * 60 * 60)));
	Запрос.УстановитьПараметр("Дата2", ТекущаяДата() - (5 * 60));
	Запрос.УстановитьПараметр("Источник", Источник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ответственный = ПолучитьОтветственногоПоОчереди(Очередь, Источник, Выборка.Ответственный);
		Если Ответственный = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НачатьТранзакцию();
		
		Док = Выборка.Ссылка.ПолучитьОбъект();
		Док.Дата = ТекущаяДата();
		Док.Ответственный = Ответственный;
		Док.Записать(РежимЗаписиДокумента.Запись);
		
		Менеджер = РегистрыСведений.РаспределениеЗаказовПокупателей.СоздатьМенеджерЗаписи();
		Менеджер.Период = ТекущаяДата();
		Менеджер.ЗаказПокупателя = Док.Ссылка;
		Менеджер.Ответственный = Ответственный;
		Менеджер.Источник = Источник;
		Менеджер.Записать();
		
		ЗафиксироватьТранзакцию();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьСнятиеСРезерва(ДатаПроверки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗапасыОстатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ЗапасыОстатки.Организация КАК Организация
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(
	|			&ДатаПроверки,
	|			НЕ ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|				И НЕ ЗаказПокупателя.ВидЗаказа = &СезонноеХранение
	|				И ВЫБОР
	|					КОГДА ЗаказПокупателя.ДатаОтгрузки = &ПустаяДата
	|						ТОГДА ЗаказПокупателя.Дата < ДОБАВИТЬКДАТЕ(&ДатаПроверки, ДЕНЬ, -3)
	|					ИНАЧЕ ЗаказПокупателя.ДатаОтгрузки < ДОБАВИТЬКДАТЕ(&ДатаПроверки, ДЕНЬ, -3)
	|				КОНЕЦ) КАК ЗапасыОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФактОплатыЗаказов КАК ФактОплатыЗаказов
	|		ПО ЗапасыОстатки.ЗаказПокупателя = ФактОплатыЗаказов.СчетНаОплату
	|ГДЕ
	|	ЗапасыОстатки.КоличествоОстаток > 0
	|	И (НЕ ЕСТЬNULL(ФактОплатыЗаказов.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплатыЗаказов.СуммаАванса, 0) > 0
	|			ИЛИ ЗапасыОстатки.ЗаказПокупателя.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен))
	|ИТОГИ ПО
	|	Организация";
	
	//ИЛИ ВЫБОР
	//	|				КОГДА ЗапасыОстатки.ЗаказПокупателя.ВидЗаказа = ЗНАЧЕНИЕ(Справочник.ВидыЗаказовПокупателей.Основной)
	//	|					ТОГДА ВЫБОР
	//	|							КОГДА ЗапасыОстатки.ЗаказПокупателя.ОжидаемаяДатаВручения <> &ПустаяДата
	//	|								ТОГДА ЗапасыОстатки.ЗаказПокупателя.ОжидаемаяДатаВручения < &ДатаПроверки
	//	|						КОНЕЦ
	//	|			КОНЕЦ)	
	
	Запрос.УстановитьПараметр("ДатаПроверки", НачалоДня(ДатаПроверки));
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1)); 
	//Запрос.УстановитьПараметр("Веломастерская", ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ВидыЗаказовПокупателей?ref=bab2000c29e80aa411f04217c42f6789"));
	Запрос.УстановитьПараметр("СезонноеХранение", ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ВидыЗаказовПокупателей?ref=bbb385d39ee01ba511f099293b41e9a2"));
	
	ВыборкаОрганизация = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОрганизация.Следующий() Цикл
		Выборка = ВыборкаОрганизация.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураЗаполнения = Новый Структура();
			СтруктураЗаполнения.Вставить("ДокументЗаполнения", Выборка.ЗаказПокупателя);
			СтруктураЗаполнения.Вставить("СнятьРезерв", Истина);
			
			Док = Документы.РезервированиеЗапасов.СоздатьДокумент();
			Док.Дата = ТекущаяДатаСеанса();
			Док.Заполнить(СтруктураЗаполнения);
			Док.Организация = ВыборкаОрганизация.Организация;
			Док.Комментарий = "#Регламентное задание";
			Если Док.Запасы.Количество() > 0 Тогда
				Док.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура СнятьЗаказыСРезерва() Экспорт
    ВыполнитьСнятиеСРезерва(ТекущаяДатаСеанса());
КонецПроцедуры
