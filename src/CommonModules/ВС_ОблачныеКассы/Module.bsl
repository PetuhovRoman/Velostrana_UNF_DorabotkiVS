Процедура ОтправитьЧек(СсылкаНаДокумент, ИдентификаторУстройстваФР)
	
	Если Не СсылкаНаДокумент.Проведен Или Не ЗначениеЗаполнено(ИдентификаторУстройстваФР) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		////ИдентификаторУстройстваФР = ПолучитьКассуПоЗаказу(СсылкаНаДокумент); 
		//ИдентификаторУстройстваФР = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ПодключаемоеОборудование?ref=bbb385d39ee01ba511f0c0875cc181f1");
		ЭтоОплатаЗаказа = Ложь;
		
	КонецЕсли;
	
	
	
	ДанныеДляФискализации = РозничныеПродажиСервер.ПолучитьДанныеДляФискализации(СсылкаНаДокумент, ИдентификаторУстройстваФР,, ЭтоОплатаЗаказа);
	ОблачнаяКасса		  = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ;
	
	Если ДанныеДляФискализации <> Неопределено
		И ТипЗнч(ИдентификаторУстройстваФР) = Тип("СправочникСсылка.ПодключаемоеОборудование")
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторУстройстваФР, "ТипОборудования") = ОблачнаяКасса Тогда
		
		ДанныеДляФискализации.ИдентификаторФискальнойЗаписи = ?(ЗначениеЗаполнено(СсылкаНаДокумент.ИдентификаторЧекаВОчереди),
		СсылкаНаДокумент.ИдентификаторЧекаВОчереди,
		XMLСтрока(Новый УникальныйИдентификатор));
		
		ДанныеДляФискализации.ОблачнаяККТ 					= Истина;
		
		ДополнитьДаннымиРазрешительногоРежима(ДанныеДляФискализации);
		
		РаспределеннаяФискализация.ДобавитьЧекВОчередьЧековККТ(ДанныеДляФискализации);
		
		Результат = ОборудованиеЧекопечатающиеОблачныеККТ.ФискализацияЧека(СсылкаНаДокумент, ИдентификаторУстройстваФР, ДанныеДляФискализации);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьЧекиПоРасходнымНакладным() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасходнаяНакладная.Ссылка КАК Накладная,
	|	РасходнаяНакладная.Дата КАК ДатаНакладной,
	|	РасходнаяНакладная.Организация КАК ОрганизацияНакладной,
	|	РасходнаяНакладная.ИдентификаторЧекаВОчереди КАК ИдентификаторЧекаВОчереди,
	|	РасходнаяНакладная.СуммаДокумента КАК СуммаНакладной,
	|	МАКСИМУМ(ОплатаСчетовИЗаказовОбороты.Период) КАК ДатаПлатежа,
	|	МАКСИМУМ(ПодключаемоеОборудование.Ссылка) КАК ПодключаемоеОборудование,
	|	МАКСИМУМ(ОплатаСчетовИЗаказовОбороты.Организация) КАК ОрганизацияПлатежа,
	|	СУММА(ОплатаСчетовИЗаказовОбороты.СуммаАвансаОборот) КАК СуммаПлатежа,
	|	СтатусыНаличияКодовМаркировкиВДокументах.СтатусНаличияКМ КАК СтатусНаличияКМ
	|ИЗ
	|	РегистрНакопления.ОплатаСчетовИЗаказов.Обороты(, , Запись, ) КАК ОплатаСчетовИЗаказовОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная КАК РасходнаяНакладная
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыНаличияКодовМаркировкиВДокументах КАК СтатусыНаличияКодовМаркировкиВДокументах
	|			ПО СтатусыНаличияКодовМаркировкиВДокументах.Документ = РасходнаяНакладная.Ссылка
	|		ПО ОплатаСчетовИЗаказовОбороты.СчетНаОплату = РасходнаяНакладная.Заказ
	|			И ОплатаСчетовИЗаказовОбороты.Организация = РасходнаяНакладная.Организация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|		ПО ОплатаСчетовИЗаказовОбороты.Организация = ПодключаемоеОборудование.Организация
	|			И (ПодключаемоеОборудование.ТипПодключения = ЗНАЧЕНИЕ(Перечисление.ТипыПодключенияОборудования.ОбщийДоступ))
	|			И (ПодключаемоеОборудование.ТипОборудования = ЗНАЧЕНИЕ(Перечисление.ТипыПодключаемогоОборудования.ОблачнаяККТ))
	|			И (НЕ ПодключаемоеОборудование.ПометкаУдаления)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОплатаПлатежнымиКартами.Обороты(, , , ) КАК ОплатаПлатежнымиКартами
	|		ПО (ОплатаПлатежнымиКартами.Заказ = РасходнаяНакладная.Заказ)
	|			И (ОплатаПлатежнымиКартами.Организация = РасходнаяНакладная.Организация)
	|			И (ОплатаПлатежнымиКартами.ЭквайринговыйТерминал.Касса.ПодключаемоеОборудование = ПодключаемоеОборудование.Ссылка)
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(РасходнаяНакладная.Дата, ДЕНЬ) >= &ДатаФормирования
	|	И НЕ РасходнаяНакладная.ПометкаУдаления
	|	И РасходнаяНакладная.НомерЧекаККМ = 0
	|
	|СГРУППИРОВАТЬ ПО
	|	РасходнаяНакладная.Ссылка,
	|	РасходнаяНакладная.Дата,
	|	РасходнаяНакладная.Организация,
	|	РасходнаяНакладная.ИдентификаторЧекаВОчереди,
	|	РасходнаяНакладная.СуммаДокумента,
	|	СтатусыНаличияКодовМаркировкиВДокументах.СтатусНаличияКМ";
	
	Запрос.УстановитьПараметр("ДатаФормирования", НачалоДня(ТекущаяДатаСеанса() - 5 * 24 * 60 * 60));
	//Запрос.УстановитьПараметр("ДатаФормирования", НачалоДня(ТекущаяДатаСеанса() - 5 * 24 * 60 * 60));
	//Запрос.УстановитьПараметр("ДатаФормирования", НачалоДня(ТекущаяДатаСеанса()));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Площадка = "";
	ДанныеПлощадок = ОбщегоНазначенияИСМП.СортированнаяТаблицаCDNПлощадок();
	Если ДанныеПлощадок.ТаблицаПлощадок.Количество() > 0 Тогда
		Площадка = ДанныеПлощадок.ТаблицаПлощадок[0].АдресПлощадки;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		//Если Не Выборка.ОрганизацияНакладной = Выборка.ОрганизацияПлатежа Тогда
		//	ИнформацияОбОшибке = "Не совпадают организации в накладной и оплате";
		//	ЗаписьЖурналаРегистрации("ОтправкаЧековВОблако", УровеньЖурналаРегистрации.Ошибка, , Выборка.Накладная, ИнформацияОбОшибке);
		//	ТекстОшибки = СокрЛП(Выборка.Накладная) + " " + ИнформацияОбОшибке;
		//	ВС_ОбщегоНазначения.ОтправитьСообщениеОбОшибкеВСистемуВзаимодействия(ТекстОшибки);
		//	Продолжить;
		//КонецЕсли;
		Если Не Выборка.СуммаПлатежа = Выборка.СуммаНакладной Тогда
			ИнформацияОбОшибке = "Сумма платежа и накладной не совпадает";
			ЗаписьЖурналаРегистрации("ОтправкаЧековВОблако", УровеньЖурналаРегистрации.Ошибка, , Выборка.Накладная, ИнформацияОбОшибке);
			ТекстОшибки = ПолучитьНавигационнуюСсылку(Выборка.Накладная) + " " + ИнформацияОбОшибке;
			ВС_ОбщегоНазначения.ОтправитьСообщениеОбОшибкеВСистемуВзаимодействия(ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		Накладная = Выборка.Накладная.ПолучитьОбъект();
			
		Если Не ЗначениеЗаполнено(Накладная.ИдентификаторЧекаВОчереди) Тогда
			Накладная.ИдентификаторЧекаВОчереди = XMLСтрока(Новый УникальныйИдентификатор);
		КонецЕсли;
		Если Накладная.Дата < Выборка.ДатаПлатежа Тогда
			Накладная.Дата = Выборка.ДатаПлатежа + 10;
		КонецЕсли;
		//Если НачалоДня(Накладная.Дата) < НачалоДня(ТекущаяДатаСеанса()) Тогда
		//	Накладная.Дата = ТекущаяДатаСеанса();
		//КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Накладная.АдресЭП) Тогда
			Накладная.АдресЭП = "service@velostrana.ru";
		КонецЕсли;
		
		Накладная.Записать(РежимЗаписиДокумента.Проведение);

		Если Накладная.ЭтоУниверсальныйДокумент 
			И (Накладная.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС
			Или Накладная.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.НаЭкспорт)
			И ЭтоПродажа(Накладная.ВидОперации)
			И СчетаФактурыУНФ.ПолучитьПодчиненныйСчетФактуру(Выборка.Накладная, Ложь) = Неопределено Тогда
			
			Если НалогиУНФ.ОрганизацияПлательщикНДС(Накладная.Организация, Накладная.Дата)
				ИЛИ РаботаСКомиссионерамиКомитентамиСервер.ВТабличнойЧастиЕстьКомиссионнаяПартияСНалогообложениемНДС(Накладная) Тогда
				ПараметрыСчетФактуры = СчетаФактурыУНФ.СоздатьСчетФактуру(Выборка.Накладная, Накладная.Дата);
			КонецЕсли;
		КонецЕсли;
		
		Если Накладная.СтруктурнаяЕдиница.ОрдерныйСклад И Накладная.СтруктурнаяЕдиница.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда
			МассивОрдеров = ВС_ОбщегоНазначения.ПолучитьПодчиненныеДокументы(Накладная.Ссылка, Ложь, "РасходныйОрдер");
			Если МассивОрдеров.Количество() > 0 Тогда
				ДокОрдер = МассивОрдеров[0].ПолучитьОбъект();
			Иначе
				ДокОрдер = Документы.РасходныйОрдер.СоздатьДокумент();
				ДокОрдер.Заполнить(Накладная.Ссылка);
				ДокОрдер.Комментарий = "#Сформирован по облачным кассам " + Символы.ПС + ТекстОшибки;
			КонецЕсли;
			
			ДокОрдер.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
		РезультатПроверкиКМ = Истина;
		Если Выборка.СтатусНаличияКМ = 2 Тогда //ОТСУТСТВУЕТ КМ
			ИнформацияОбОшибке = "В накладной не указаны коды маркировки";
			ЗаписьЖурналаРегистрации("ПроверкаКодовМаркировки", УровеньЖурналаРегистрации.Ошибка, , Выборка.Накладная, ИнформацияОбОшибке);
			ТекстОшибки = ПолучитьНавигационнуюСсылку(Выборка.Накладная) + " " + ИнформацияОбОшибке;
			ВС_ОбщегоНазначения.ОтправитьСообщениеОбОшибкеВСистемуВзаимодействия(ТекстОшибки);
			РезультатПроверкиКМ = Ложь;
		КонецЕсли;
		Если Выборка.Накладная.ШтрихкодыУпаковок.Количество() > 0 Тогда //ПРОВЕРЯЕМ КМ
			Если Не ЗначениеЗаполнено(Площадка) Тогда
				ИнформацияОбОшибке = "Не удалось получить CDN площадку";
                ЗаписьЖурналаРегистрации("ПроверкаКодовМаркировки", УровеньЖурналаРегистрации.Ошибка, , Выборка.Накладная, ИнформацияОбОшибке);
				ТекстОшибки = ПолучитьНавигационнуюСсылку(Выборка.Накладная) + " " + ИнформацияОбОшибке;
				ВС_ОбщегоНазначения.ОтправитьСообщениеОбОшибкеВСистемуВзаимодействия(ТекстОшибки);
				РезультатПроверкиКМ = Ложь;
			Иначе
				РезультатПроверкиКМ = ПроверкаКодовМаркировки.ВыполнитьПроверкуКМ(Выборка.Накладная, 
					ПроверкаКодовМаркировки.ПолучитьТокен(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Накладная, "Организация")), 
					Площадка, Накладная.ИдентификаторЧекаВОчереди);
			КонецЕсли;
		КонецЕсли;
		
		Если РезультатПроверкиКМ Тогда 
			ОтправитьЧек(Выборка.Накладная, Выборка.ПодключаемоеОборудование);
		Иначе
			ИнформацияОбОшибке = "Код маркировки не прошел проверку";
			ЗаписьЖурналаРегистрации("ОтправкаЧековВОблако", УровеньЖурналаРегистрации.Ошибка, , Выборка.Накладная, ИнформацияОбОшибке);
			ТекстОшибки = ПолучитьНавигационнуюСсылку(Выборка.Накладная) + " " + ИнформацияОбОшибке;
			ВС_ОбщегоНазначения.ОтправитьСообщениеОбОшибкеВСистемуВзаимодействия(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоПродажа(ВидОперации)
	
	Возврат ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю")
						Или ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходнаяНакладная.ВыкупТоваровКомиссионером");
	
КонецФункции

Процедура ДополнитьДаннымиРазрешительногоРежима(ДанныеДляФискализации) Экспорт
	
	Если Не ЗначениеЗаполнено(ДанныеДляФискализации.ИдентификаторФискальнойЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
	Запись = РегистрыСведений.ОперацииПроверкиКМ.СоздатьНаборЗаписей();
	Запись.Отбор.ИдентификаторФискальнойОперации.Установить(ДанныеДляФискализации.ИдентификаторФискальнойЗаписи);
	Запись.Прочитать();
	ТаблицаРС = Запись.Выгрузить();
	
	Если ТаблицаРС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаЧека Из ДанныеДляФискализации.ПозицииЧека Цикл
		Если СтрокаЧека.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ И ПустаяСтрока(СтрокаЧека.ОтраслевойРеквизит.ЗначениеРеквизита) Тогда
			ЗаписьЖурналаРегистрации("ОтправкаЧековВОблако", УровеньЖурналаРегистрации.Информация, , , СокрЛП(СтрокаЧека.ЗапросПроверкиКода.ИдентификаторЗапроса));
			СтрокаПроверкиКМ = ТаблицаРС.Найти(СтрокаЧека.КонтрольнаяМарка, "КодМаркировки"); 
			Если СтрокаПроверкиКМ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(СтрокаПроверкиКМ.ИдентификаторЗапросаРазрешения) Тогда
				Продолжить;
			КонецЕсли;
			ЗаписьЖурналаРегистрации("ОтправкаЧековВОблако", УровеньЖурналаРегистрации.Информация, , , "Проверка кода маркировки в расширении");
			СтрокаЧека.ЗапросПроверкиКода.ИдентификаторЗапроса = СтрокаПроверкиКМ.ИдентификаторЗапросаРазрешения;
			СтрокаЧека.ЗапросПроверкиКода.ВременнаяМетка = ОбщегоНазначенияБПОКлиентСервер.ДатуВTimestamp(СтрокаПроверкиКМ.ВремяЗапросаРазрешения);
			МенеджерОборудованияМаркировка.ЗаполнитьДанныеЗапросПроверкиКода(СтрокаЧека);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
