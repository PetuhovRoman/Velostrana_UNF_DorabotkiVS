// См. МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру
//
Функция ПреобразоватьДанныеСоСканераВСтруктуру(Параметр) Экспорт
	
	ОбработатьСобытие();
	
	Если Параметр[1] = Неопределено Тогда
		Данные = Новый Структура("Штрихкод, Количество", Параметр[0], 1);    // Достаем штрихкод из основных данных
	Иначе
		Данные = Новый Структура("Штрихкод, Количество", Параметр[1][1], 1); // Достаем штрихкод из дополнительных данных
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

// См. МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВМассив
// 
Функция ПреобразоватьДанныеСоСканераВМассив(Параметр) Экспорт
	
	ОбработатьСобытие();
	
	Данные = Новый Массив;
	Данные.Добавить(ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
	
	Возврат Данные;
	
КонецФункции

// См. МенеджерОборудованияУТКлиент.ОбработатьСобытие
// 
Процедура ОбработатьСобытие() Экспорт
	
	ПараметрыПриложения["ПодключаемоеОборудованиеСобытиеОбработаноИС"] = Истина;
	
КонецПроцедуры

// Консоль AL 28.10.2026 — реакция на нераспознанный штрихкод вынесена из формы «Пересчет товаров» для вызова из любой формы обработки
// Реакция на штрихкод, который не найден в базе: запись в журнал, звук с вибрацией (мобильный клиент)
// и предупреждение пользователю. Штрихкод в предупреждении выделен жирным шрифтом, весь текст — красным цветом.
//
// Параметры:
//  ТекстСообщения - Строка - причина, по которой штрихкод не распознан (попадает в журнал).
//  ТекШтрихкод    - Строка - нераспознанный штрихкод.
//
// Пример вызова из формы (без ожидания закрытия предупреждения):
//  МобильноеРабочееМестоКладовщикаКлиент.ШтрихкодНеРаспознан(НСтр("ru = 'Номенклатура по штрихкоду не найдена'"), ТекШтрихкод);
// Пример вызова с ожиданием закрытия предупреждения (в асинхронной процедуре):
//  Ждать МобильноеРабочееМестоКладовщикаКлиент.ШтрихкодНеРаспознан(НСтр("ru = 'Ячейка по штрихкоду не найдена'"), ТекШтрихкод);
//
Асинх Процедура ШтрихкодНеРаспознан(ТекстСообщения, ТекШтрихкод) Экспорт
	
	МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Предупреждение",
		ТекстСообщения + ": " + ТекШтрихкод);
	
	ВоспроизвестиЗвукОшибки();
	
	// Весь текст красный; жирным выделен только штрихкод. Цвет и шрифт задаются отдельно для каждой части,
	// а готовые части собираются в одну строку конструктором на основании массива (Содержимое = Массив).
	ШрифтОбычный = Новый Шрифт();
	ШрифтЖирный = Новый Шрифт(ШрифтОбычный, , , Истина);
	
	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'По штрихкоду '"), ШрифтОбычный, WebЦвета.Красный));
	ЧастиТекста.Добавить(Новый ФорматированнаяСтрока(ТекШтрихкод, ШрифтЖирный, WebЦвета.Красный));
	ЧастиТекста.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = ' ничего не найдено.'"), ШрифтОбычный, WebЦвета.Красный));
	ТекстПредупреждения = Новый ФорматированнаяСтрока(ЧастиТекста);
	
	Ждать ПредупреждениеАсинх(ТекстПредупреждения, , НСтр("ru = 'Ошибка поиска'"));
	
КонецПроцедуры

Асинх Процедура ОшибкаОперацииТСД(ТекстОшибки) Экспорт
	
	МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Предупреждение", ТекстОшибки);
	ВоспроизвестиЗвукОшибки();
	//ПоказатьПредупреждение(, ТекстОшибки, 0, "Операция не выполнена");
	Ждать ПредупреждениеАсинх(ТекстОшибки, , НСтр("ru = 'Операция не выполнена"));
	
КонецПроцедуры

// Звуковой сигнал ошибки: воспроизводится только в мобильном клиенте.
// В остальных клиентах процедура ничего не делает.
// Звук берется из общего макета «ВС_ЗвукОшибкиСканированияШК» (см. МобильноеРабочееМестоКладовщикаЛокализация.ПолучитьМакетЗвукаОшибки).
//
Процедура ВоспроизвестиЗвукОшибки() Экспорт
	
	#Если МобильныйКлиент Тогда
		ШаблонВибрации = Новый Массив;
		ШаблонВибрации.Добавить(0);
		ШаблонВибрации.Добавить(300);
		ШаблонВибрации.Добавить(150);
		ШаблонВибрации.Добавить(300);
		//СредстваМультимедиа.ВоспроизвестиЗвуковоеОповещение(ЗвуковоеОповещение.ПоУмолчанию, ШаблонВибрации);
		
		// Получаем двоичные данные из общего макета (требуется серверный вызов)
		ДанныеЗвука = МобильноеРабочееМестоКладовщикаЛокализация.ПолучитьМакетЗвукаОшибки("ВС_ЗвукОшибкиСканированияШК");
		
		// Формируем путь во временном каталоге устройства
		ИмяФайла = КаталогВременныхФайлов() + "audio_error.wav";
		
		// Записываем данные в файл
		ДанныеЗвука.Записать(ИмяФайла);
		
		СредстваМультимедиа.ВоспроизвестиАудио(ИмяФайла, 0, Неопределено, Ложь);
	#КонецЕсли
	
КонецПроцедуры
