
&Вместо("ДанныеXDTOИзДанныхИБ")
Функция ВС_ДанныеXDTOИзДанныхИБ(КомпонентыОбмена, Источник, Знач ПравилоКонвертации, СтекВыгрузки)

	Если ТипЗнч(Источник) = Тип("СправочникСсылка.Контрагенты") 
		Или ТипЗнч(Источник) = Тип("СправочникОбъект.Контрагенты") Тогда
		НовыйИсточник = КонтрагентДляВыгрузки(Источник);
	Иначе
		НовыйИсточник = Источник;
	КонецЕсли;
	
	Приемник = ПродолжитьВызов(КомпонентыОбмена, НовыйИсточник, ПравилоКонвертации, СтекВыгрузки);
	Возврат Приемник;
	
КонецФункции

Функция КонтрагентДляВыгрузки(Контрагент)
	
	Если Контрагент.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо Тогда
		Покупатель = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Контрагенты?ref=bab1000c29e80aa411f03bb6bafeed98");
		Если ЗначениеЗаполнено(Покупатель) Тогда
			Возврат Покупатель;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Контрагент;

КонецФункции
