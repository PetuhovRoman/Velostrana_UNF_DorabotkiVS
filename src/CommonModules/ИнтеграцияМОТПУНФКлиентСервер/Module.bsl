
Процедура ЗаполнитьПараметрыСканированияПеремещениеЗапасов(ПараметрыСканирования, Контекст, ВидПродукции)
	
	#Область Метаданные
	
	ПараметрыСканирования.ИмяТабличнойЧастиШтрихкодыУпаковок = "ШтрихкодыУпаковок";
	ПараметрыСканирования.ИмяКолонкиШтрихкодУпаковки = "ШтрихкодУпаковки";
	
	#КонецОбласти
	
	#Область ПоддержкаПродукцииИСМП
	
	ШтрихкодированиеИСМПКлиентСервер.ЗаполнитьПараметрыСканированияДокументаОптовойОтгрузки(ПараметрыСканирования, ВидПродукции);
	
	НастройкиИСМП = Новый Структура;
	НастройкиИСМП.Вставить("КонтролироватьОкончаниеСрокаГодности", Ложь);
	НастройкиИСМП.Вставить("ЗапрашиватьДанныеСервисаИСМП",         Ложь);
	НастройкиИСМП.Вставить("ДопустимыПроверкиСеройЗоныМОТП",       Ложь);
	
	ЗаполнитьЗначенияСвойств(ПараметрыСканирования, НастройкиИСМП);
	
	#КонецОбласти
	
	#Область ПоддержкаАлкогольнойПродукции
	
	ШтрихкодированиеОбщегоНазначенияЕГАИСКлиентСервер.ВключитьПоддержкуАлкогольнойПродукции(ПараметрыСканирования,
		ВидПродукции);
		
	#КонецОбласти
	
КонецПроцедуры

&ИзменениеИКонтроль("ВключитьПоддержкуВидовПродукцииИС")
Процедура ВС_ВключитьПоддержкуВидовПродукцииИС(КонтекстВызова, ПараметрыСканирования, ВидПродукции, Сценарий)

	Если ТипЗнч(КонтекстВызова) = Тип("Структура") И КонтекстВызова.Свойство("Контекст") Тогда
		Контекст = КонтекстВызова.Контекст;
	Иначе
		Контекст = КонтекстВызова;
	КонецЕсли;

	Если ВидПродукции = Неопределено Тогда

		ВидПродукции = Новый Массив();

		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		ВидПродукции,
		КонструкторИСОбщегоНазначенияКлиентСервер.УчитываемыеВидыПродукцииИСМП(Истина));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		ВидПродукции,
		ОбщегоНазначенияЕГАИСКлиентСерверПовтИсп.УчитываемыеВидыМаркируемойПродукции());

	КонецЕсли;

	Если ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ЧекККМ") Тогда
		ЗаполнитьПараметрыСканированияЧекККМ(Контекст, ПараметрыСканирования, ВидПродукции, Ложь);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ЧекККМВозврат") Тогда
		ЗаполнитьПараметрыСканированияЧекККМВозврат(Контекст, ПараметрыСканирования, ВидПродукции, Ложь);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.РасходнаяНакладная") Тогда
		ЗаполнитьПараметрыСканированияРасходнаяНакладная(Контекст, ПараметрыСканирования, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ПриходнаяНакладная") Тогда
		ЗаполнитьПараметрыСканированияПриходнаяНакладная(Контекст, ПараметрыСканирования, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ОперацияПоПлатежнымКартам") Тогда
		ЗаполнитьПараметрыСканированияОперацияПоПлатежнымКартам(Контекст, ПараметрыСканирования, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ПоступлениеВКассу")
		ИЛИ ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ПоступлениеНаСчет") Тогда
		ЗаполнитьПараметрыСканированияПоступлениеДС(Контекст, ПараметрыСканирования, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.РасходИзКассы")
		ИЛИ ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.РасходСоСчета") Тогда
		ЗаполнитьПараметрыСканированияРасходДС(Контекст, ПараметрыСканирования, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.КорректировкаРеализации") Тогда
		ЗаполнитьПараметрыСканированияКорректировкаРеализации(ПараметрыСканирования, Контекст, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ПередачаТоваровМеждуОрганизациями") Тогда
		ЗаполнитьПараметрыСканированияПередачаТоваровМеждуОрганизациями(ПараметрыСканирования, Контекст, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ОтчетОПереработке") Тогда
		ЗаполнитьПараметрыСканированияОтчетОПереработке(ПараметрыСканирования, Контекст, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ОтчетПереработчика") Тогда
		ЗаполнитьПараметрыСканированияОтчетПереработчика(ПараметрыСканирования, Контекст, ВидПродукции);
	ИначеЕсли ПоддерживаетсяСканированиеМаркировки(Контекст) Тогда
		ЗаполнитьБазовыеПараметрыСканирования(Контекст, ПараметрыСканирования, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ЗаказПокупателя") Тогда
		ЗаполнитьПараметрыСканированияЗаказПокупателя(ПараметрыСканирования, Контекст, ВидПродукции);
	#Вставка
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Документ.ПеремещениеЗапасов") Тогда
		ЗаполнитьПараметрыСканированияПеремещениеЗапасов(ПараметрыСканирования, Контекст, ВидПродукции);
	#КонецВставки
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Обработка.ПодборРеализация")
		ИЛИ ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Обработка.ПодборПоступление") Тогда
		ЗаполнитьПараметрыСканированияПодбор(Контекст, ПараметрыСканирования, ВидПродукции);
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Контекст, "Обработка.РабочееМестоКассира") Тогда
		ЗаполнитьПараметрыСканированияРМК(Контекст, ПараметрыСканирования, ВидПродукции, Сценарий);
	КонецЕсли;

	ПараметрыСканирования.ДопустимыеВидыПродукции.Добавить(ПредопределенноеЗначение("Справочник.ВидыПродукцииИС.ПустаяСсылка"));

	ПараметрыСканирования.Вставить("КонтрольРасхожденийСДокументомОснованием", Ложь);

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПараметрыСканирования, "ИспользуетсяРаспределениеКодовПоТоварамСУчетомМРЦ") Тогда
		ПараметрыСканирования.ИспользуетсяРаспределениеКодовПоТоварамСУчетомМРЦ = Истина;
	КонецЕсли;

	Если ПараметрыСканирования.Свойство("ДатаДокумента")
		И Не ЗначениеЗаполнено(ПараметрыСканирования.ДатаДокумента) Тогда
		#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
			ПараметрыСканирования.ДатаДокумента = ОбщегоНазначения.ТекущаяДатаПользователя();
		#ИначеЕсли Клиент Тогда
			ПараметрыСканирования.ДатаДокумента = ОбщегоНазначенияКлиент.ДатаСеанса();
		#КонецЕсли
	КонецЕсли;

КонецПроцедуры


&ИзменениеИКонтроль("ПоддерживаетсяСканированиеМаркировки")
Функция ВС_ПоддерживаетсяСканированиеМаркировки(Контекст)

	Если ТипЗнч(Контекст) = Тип("ФормаКлиентскогоПриложения")
		Или (ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("ИмяФормы")) Тогда
		ИмяФормы = Контекст.ИмяФормы;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	ИменаФорм = Новый СписокЗначений;
	ИменаФорм.Добавить("Обработка.ПомощникВводаНачальныхОстатков.Форма.ФормаВводаОстатков");
	ИменаФорм.Добавить("Документ.СчетНаОплатуПоставщика.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.СчетНаОплату.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.СписаниеЗапасов.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.СборкаЗапасов.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.РезервированиеЗапасов.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.РасходныйОрдер.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.РаспределениеЗатрат.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ПриходныйОрдер.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ПриемИПередачаВРемонт.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ПересортицаЗапасов.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ПереоценкаТоваровНаКомиссии.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ПереоценкаВРозницеСуммовойУчет.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ПеремещениеПоЯчейкам.Форма.ФормаДокумента");
	#Удаление
	ИменаФорм.Добавить("Документ.ПеремещениеЗапасов.Форма.ФормаДокумента");
	#КонецУдаления
	ИменаФорм.Добавить("Документ.ОтчетОРозничныхПродажах.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ОтчетКомитенту.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ОтчетКомиссионераОСписании.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ОтчетКомиссионера.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ОприходованиеЗапасов.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.КомплектацияЗапасов.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ИнвентаризацияЗапасов.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ЗаказНаПроизводство.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ЗаказНаПеремещение.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ВводНачальныхОстатков.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.АвансовыйОтчет.Форма.ФормаДокумента");
	#Удаление
	ИменаФорм.Добавить("Документ.ЗаказПокупателя.Форма.ФормаДокумента");
	#КонецУдаления
	ИменаФорм.Добавить("Документ.УстановкаЦенНоменклатуры.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Справочник.Номенклатура.Форма.ФормаСписка");

	Возврат ИменаФорм.НайтиПоЗначению(ИмяФормы) <> Неопределено;

КонецФункции

