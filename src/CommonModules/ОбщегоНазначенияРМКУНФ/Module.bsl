
&ИзменениеИКонтроль("ОпределитьТекущийТорговыйОбъект")
Процедура ВС_ОпределитьТекущийТорговыйОбъект1(ТорговыйОбъект)

	МагазинПоУмолчанию = ПерсональныеНастройкиРУНФ.Прочитать("ОсновнаяГруппаСкладов");
	Если ЗначениеЗаполнено(МагазинПоУмолчанию) Тогда
		ТорговыйОбъект = МагазинПоУмолчанию;
		Возврат;
	КонецЕсли;

	ТекущееРабочееМесто = МенеджерОборудованияРМК.РабочееМестоКлиента();
	ТипыТорговыхОбъектов = ОбщегоНазначенияРМКУНФКлиентСервер.ТипыТорговыхОбъектов();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка КАК ТорговыйОбъект
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|ГДЕ
	|	НЕ СтруктурныеЕдиницы.ПометкаУдаления
	|	И СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы В(&ТипыТорговыхОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтруктурныеЕдиницы.Ссылка КАК ТорговыйОбъект
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КассыККМ КАК КассыККМ
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодключаемоеОборудование КАК ВтПодключаемоеОборудование
	|			ПО КассыККМ.ПодключаемоеОборудование = ВтПодключаемоеОборудование.Ссылка
	|		ПО СтруктурныеЕдиницы.Ссылка = КассыККМ.СтруктурнаяЕдиница
	|ГДЕ
	|	НЕ СтруктурныеЕдиницы.ПометкаУдаления
	|	И СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы В(&МассивТиповСкладов)
	|	И НЕ КассыККМ.ПометкаУдаления
	|	И КассыККМ.ТипКассы = ЗНАЧЕНИЕ(Перечисление.ТипыКассККМ.ФискальныйРегистратор)
	|	И ВЫБОР
	|			КОГДА КассыККМ.ИспользоватьБезПодключенияОборудования
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВтПодключаемоеОборудование.РабочееМесто = &ТекущееРабочееМесто
	|		КОНЕЦ";

	МассивТиповСкладов = Новый Массив;
	МассивТиповСкладов.Добавить(Перечисления.ТипыСтруктурныхЕдиниц.Розница);
	#Вставка
	МассивТиповСкладов.Добавить(Перечисления.ТипыСтруктурныхЕдиниц.Склад); 
	#КонецВставки
	Запрос.УстановитьПараметр("МассивТиповСкладов", МассивТиповСкладов);
	Запрос.УстановитьПараметр("ТекущееРабочееМесто", ТекущееРабочееМесто);
	Запрос.УстановитьПараметр("ТипыТорговыхОбъектов", ТипыТорговыхОбъектов);

	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ТорговыеОбъекты = РезультатыЗапроса[0].Выгрузить();
	Если ТорговыеОбъекты.Количество() = 1 Тогда
		МагазинПоУмолчанию = ТорговыеОбъекты[0].ТорговыйОбъект;
	ИначеЕсли Не РезультатыЗапроса[1].Пустой() Тогда
		ТорговыеОбъектыИзККМ = РезультатыЗапроса[1].Выгрузить();
		Если ТорговыеОбъектыИзККМ.Количество() = 1 Тогда
			МагазинПоУмолчанию = ТорговыеОбъектыИзККМ[0].ТорговыйОбъект;
		КонецЕсли;
	КонецЕсли;
	ТорговыйОбъект = МагазинПоУмолчанию;

КонецПроцедуры
