
&ИзменениеИКонтроль("ПриУстановкеПараметровОткрытияФормыПроверкиИПодбора")
Процедура ВС_ПриУстановкеПараметровОткрытияФормыПроверкиИПодбора(Форма, Параметры) Экспорт
	
	Если ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ЧекККМ")
		Или ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ЧекККМВозврат") Тогда
		
		Параметры.ПроверятьМодифицированность   = Ложь;
		Параметры.ИмяРеквизитаДокументОснование = "";
		Параметры.ИмяРеквизитаСклад             = "СтруктурнаяЕдиница";
		Параметры.ИмяРеквизитаКонтрагент        = "";
		Параметры.Склад                         = Форма.Объект.СтруктурнаяЕдиница;
		Параметры.ЕГАИС  = Истина;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Истина;
		
		Параметры.ОрганизацияЕГАИС = ИнтеграцияЕГАИСУНФВызовСервера.ОрганизацияЕГАИСПоОрганизацииИТорговомуОбъекту(
			Форма.Объект.Организация,
			Форма.Объект.СтруктурнаяЕдиница);
		
		ПараметрыОповещенияПриЗакрытии = Новый Структура;
		ПараметрыОповещенияПриЗакрытии.Вставить("Форма", Форма);
		
		Параметры.ОписаниеОповещенияПриЗакрытии = Новый ОписаниеОповещения(
			"ПриЗакрытииФормыПроверкиИПодбора",
			СобытияФормИСУНФКлиент,
			ПараметрыОповещенияПриЗакрытии);
		
		Параметры.АдресПроверяемыхДанных = ИнтеграцияМОТПУНФВызовСервера.АдресДанныхПроверкиМаркируемойПродукцииЧекККМ(
			ШтрихкодированиеОбщегоНазначенияИСКлиент.ПараметрыСканирования(Форма),
			Форма.Объект,
			Форма.УникальныйИдентификатор);
		
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.РасходнаяНакладная")
		ИЛИ ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.КорректировкаРеализации") Тогда
		
		Параметры.ИмяРеквизитаДокументОснование = "";
		Параметры.ИмяРеквизитаСклад             = "СтруктурнаяЕдиница";
		Параметры.ИмяРеквизитаКонтрагент        = "";
		Параметры.ЕГАИС  = Ложь;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Истина;
		
		ВидыПродукцииСырье = КонструкторИСМПКлиентСервер.ВидыПродукцииСырьеГИСМТ();
		Если ВидыПродукцииСырье.Количество() Тогда
			
			Для Каждого СтрокаТовары Из Форма.Объект.Запасы Цикл
				
				Если КонструкторИСМПКлиентСервер.ЭтоСырьеГИСМТ(СтрокаТовары.ВидПродукцииИС) Тогда
					Параметры.ИмяФормыПроверки = "СопоставлениеСырья";
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ОтчетОПереработке") Тогда
		
		Параметры.ИмяРеквизитаДокументОснование = "";
		Параметры.ИмяРеквизитаСклад             = "СтруктурнаяЕдиница";
		Параметры.ИмяРеквизитаКонтрагент        = "";
		Параметры.ЕГАИС  = Ложь;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Истина;
		
		ВидыПродукцииСырье = КонструкторИСМПКлиентСервер.ВидыПродукцииСырьеГИСМТ();
		Если ВидыПродукцииСырье.Количество() Тогда
			
			Для Каждого СтрокаТовары Из Форма.Объект.Продукция Цикл
				
				Если КонструкторИСМПКлиентСервер.ЭтоСырьеГИСМТ(СтрокаТовары.ВидПродукцииИС) Тогда
					Параметры.ИмяФормыПроверки = "СопоставлениеСырья";
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ПередачаТоваровМеждуОрганизациями") Тогда
		
		Параметры.ИмяРеквизитаДокументОснование = "";
		Параметры.ИмяРеквизитаСклад             = "СтруктурнаяЕдиница";
		Параметры.ИмяРеквизитаКонтрагент        = "";
		Параметры.ЕГАИС  = Ложь;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Истина;
		
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ЗаказПокупателя") Тогда
		
		Параметры.ИмяРеквизитаДокументОснование = "";
		Параметры.ИмяРеквизитаСклад             = "СтруктурнаяЕдиницаРезерв";
		Параметры.ИмяРеквизитаКонтрагент        = "";
		Параметры.ЕГАИС  = Ложь;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Истина;
	#Вставка
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ПеремещениеЗапасов") Тогда

		Параметры.ИмяРеквизитаДокументОснование = "";
		Параметры.ИмяРеквизитаСклад             = "СтруктурнаяЕдиница";
		Параметры.ИмяРеквизитаКонтрагент        = "";
		Параметры.ЕГАИС  = Ложь;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Истина;
	#КонецВставки
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ПриходнаяНакладная")
		ИЛИ ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Документ.ОтчетПереработчика") Тогда
		
		Параметры.ИмяРеквизитаДокументОснование = "";
		Параметры.ИмяРеквизитаСклад             = "СтруктурнаяЕдиница";
		Параметры.ИмяРеквизитаКонтрагент        = "Контрагент";
		Параметры.РежимПодбораСуществующихУпаковок = Ложь;
		Параметры.ЕГАИС  = Ложь;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Истина;
		
	ИначеЕсли ШтрихкодированиеИСКлиентСервер.ЭтоКонтекстОбъекта(Форма, "Обработка.РабочееМестоКассира") Тогда
		
		Параметры.ИмяРеквизитаФормыОбъект = "";
		Параметры.ИмяРеквизитаОрганизация = "ОсновнаяОрганизация";
		
		
		Параметры.ПроверятьМодифицированность   = Ложь;
	//	Параметры.ИмяРеквизитаДокументОснование = "";
	//	Параметры.ИмяРеквизитаСклад             = "СтруктурнаяЕдиница";
	//	Параметры.ИмяРеквизитаКонтрагент        = "";
	//	Параметры.Склад                         = Форма.Объект.СтруктурнаяЕдиница;
	//	Параметры.ЕГАИС  = Истина;
		Параметры.ИСМП   = Истина;
		Параметры.Прочее = Истина;
		
		//Параметры.ОрганизацияЕГАИС = ИнтеграцияЕГАИСУНФВызовСервера.ОрганизацияЕГАИСПоОрганизацииИТорговомуОбъекту(
		//	Форма.Объект.Организация,
		//	Форма.Объект.СтруктурнаяЕдиница);
		//
		ПараметрыОповещенияПриЗакрытии = Новый Структура;
		ПараметрыОповещенияПриЗакрытии.Вставить("Форма", Форма);
		
		Параметры.ОписаниеОповещенияПриЗакрытии = Новый ОписаниеОповещения(
			"ПриЗакрытииФормыПроверкиИПодбора",
			СобытияФормИСУНФКлиент,
			ПараметрыОповещенияПриЗакрытии);
		
		Параметры.АдресПроверяемыхДанных = ИнтеграцияМОТПУНФВызовСервера.АдресДанныхПроверкиМаркируемойПродукцииРМК(
			ШтрихкодированиеОбщегоНазначенияИСКлиент.ПараметрыСканирования(Форма),
			Форма.Объект,
			Форма.УникальныйИдентификатор);
	
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,"ПараметрыИнтеграцииГосИС") Тогда
		
		НастройкиИнтеграции = Форма.ПараметрыИнтеграцииГосИС.Получить("ФормаПроверкиИПодбора");
		Если Не (НастройкиИнтеграции = Неопределено) Тогда
			Если ТипЗнч(НастройкиИнтеграции) = Тип("Массив") Тогда
				НастройкиИнтеграции = НастройкиИнтеграции[0];
			КонецЕсли;
			Параметры.ПроверкаЭлектронногоДокумента = НастройкиИнтеграции.ЕстьЭлектронныйДокумент;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

