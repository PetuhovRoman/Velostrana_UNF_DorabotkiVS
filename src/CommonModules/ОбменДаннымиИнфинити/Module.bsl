Функция УстановитьСоединениеСPostgreSQL(СтруктураСоединения)  
	
	СтрокаПодключения = "";
	Для каждого Стр Из СтруктураСоединения Цикл
		СтрокаПодключения = СтрокаПодключения + Стр.Ключ + "=" + Стр.Значение + ";"; 
	КонецЦикла;
	
	Соединение = Новый COMОбъект ("ADODB.Connection");
	Соединение.ConnectionString = СтрокаПодключения;
	Соединение.CommandTimeout = 150;
	Соединение.ConnectionTimeout = 90;
	
	Попытка
		Соединение.Open();
	Исключение
		ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Инфинити",УровеньЖурналаРегистрации.Ошибка,,,ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Соединение;
	
КонецФункции  

Функция ПолучитьТаблицуПользователейИнфинити(СтартДата, ТолькоАктивные = Истина) 
	
	База = Новый Структура;
	База.Вставить("Driver", "{PostgreSQL ANSI(x64)}");
	База.Вставить("Server", "192.168.55.100");
	База.Вставить("Port", "10000");
	База.Вставить("Database", "Cx_Security");
	База.Вставить("Uid", "cxdbuser");
	База.Вставить("Pwd", "cxdbwizard");
	
	Соединение = УстановитьСоединениеСPostgreSQL(База);

	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("Ид", Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("Логин", Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Телефон", Новый ОписаниеТипов("Строка"));
	тз.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	тз.Колонки.Добавить("Удаленный", Новый ОписаниеТипов("Булево"));
	
	ТекстЗапроса = 
		"select 
		|	u.""ID"",
		|	u.""Login"",
		|	c.""Contact"", u.""Deleted"" 
		|from  ""U_Users"" as u
		|left join ""U_Contacts"" as c on c.""IDAbonent"" = u.""ID""";
	
	Если ТолькоАктивные Тогда
		ТекстЗапроса = ТекстЗапроса + " where u.""Deleted"" <> 1";
	КонецЕсли;
	
	Результат = Соединение.Execute(ТекстЗапроса);
	
	Попытка
		
		Пока Не Результат.Eof() Цикл
			стр = тз.Добавить();
			Для х = 0 По Результат.Fields.Count() - 1 Цикл
				Если Результат.Fields(х).Name = "ID" Тогда
					стр.Ид = Результат.Fields(х).Value;
				ИначеЕсли Результат.Fields(х).Name = "Login" Тогда
					стр.Логин = Строка(Результат.Fields(х).Value);
				ИначеЕсли Результат.Fields(х).Name = "Contact" Тогда
					стр.Телефон = Строка(Результат.Fields(х).Value);
				ИначеЕсли Результат.Fields(х).Name = "Deleted" Тогда
					стр.Удаленный = Результат.Fields(х).Value = 1;
				КонецЕсли;
			КонецЦикла;
			стр.Пользователь = Справочники.Сотрудники.НайтиПоНаименованию(стр.Логин, Истина);
			Результат.MoveNext();
		КонецЦикла;
		
	Исключение
		ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Инфинити", УровеньЖурналаРегистрации.Ошибка,,,ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	Соединение.Close();
	
	Возврат тз;
	
КонецФункции

Функция ПолучитьТаблицуСтатусовИнфинити() 
	
	База = Новый Структура;
	База.Вставить("Driver", "{PostgreSQL ANSI(x64)}");
	База.Вставить("Server", "192.168.55.100");
	База.Вставить("Port", "10000");
	База.Вставить("Database", "Cx_Configuration");
	База.Вставить("Uid", "cxdbuser");
	База.Вставить("Pwd", "cxdbwizard");
	
	Соединение = УстановитьСоединениеСPostgreSQL(База);
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("Ид", Новый ОписаниеТипов("Число"));
	тз.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	
	Результат = Соединение.Execute("select ""ID"",""Name"" from  ""C_UserStates"" union all select ""ID"",""Name"" from ""C_UserStatesReasons""");
	
	Попытка
		Пока Не Результат.Eof() Цикл
			стр = тз.Добавить();
			Для х = 0 По Результат.Fields.Count() - 1 Цикл
				Если Результат.Fields(х).Name = "ID" Тогда
					стр.Ид = Результат.Fields(х).Value;
				ИначеЕсли Результат.Fields(х).Name = "Name" Тогда
					стр.Наименование = Строка(Результат.Fields(х).Value);
				КонецЕсли;
			КонецЦикла;
			Результат.MoveNext();
		КонецЦикла;
	Исключение
		ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Инфинити", УровеньЖурналаРегистрации.Ошибка,,,ТекстСообщения);
		Возврат Неопределено;
	КонецПопытки;
	
	Соединение.Close();
	
	Возврат тз;
КонецФункции

Процедура ОбновитьИсториюСтатусов(Соединение, Юзеры, СтартДата) 
	
	Статусы = ПолучитьТаблицуСтатусовИнфинити();
	Если Юзеры = Неопределено ИЛИ Статусы = Неопределено Тогда
		Возврат;	
	КонецЕсли;

	СтрокаДанных = Новый Структура("Пользователь,ПользовательИнфинити,Статус,СтарыйСтатус,ПричинаИзменения,ВремяВключения,ВремяОтключения,Длительность");
	
	нз = РегистрыСведений.ИнфинитиИсторияСтатусов.СоздатьНаборЗаписей();
	
	ТекстЗапроса = 	
	"select
	|  ""IDUser"",
	|  ""IDUserState"",
	|  ""OldIDUserState"",
	|  ""IDUserStateReason"",
	|  ""TimeOn"",
	|  ""TimeOff"",
	|  ""TimeDelta"" * 86400 as timedelta
	|from  ""S_UsersStates""
	|where ""TimeOn"" >= TIMESTAMP '" + Формат(СтартДата, "ДФ=""yyyyMMdd HHmmss""") + "'
	|order by ""TimeOn""";
	
	Результат = Соединение.Execute(ТекстЗапроса);
	Попытка
		Пока Не Результат.Eof() Цикл
			Для х = 0 По Результат.Fields.Count() - 1 Цикл
				Если Результат.Fields(х).Name = "IDUser" Тогда
					СтрокаТз = Юзеры.Найти(Результат.Fields(х).Value, "Ид");
					Если СтрокаТз <> Неопределено Тогда
						СтрокаДанных.Пользователь = СтрокаТз.Пользователь;
						СтрокаДанных.ПользовательИнфинити = СтрокаТз.Логин;
					КонецЕсли;
				ИначеЕсли Результат.Fields(х).Name = "IDUserState" Тогда
					СтрокаТз = Статусы.Найти(Результат.Fields(х).Value, "Ид");
					Если СтрокаТз <> Неопределено Тогда
						СтрокаДанных.Статус = СтрокаТз.Наименование;
					КонецЕсли;
				ИначеЕсли Результат.Fields(х).Name = "OldIDUserState" Тогда
					СтрокаТз = Статусы.Найти(Результат.Fields(х).Value, "Ид");
					Если СтрокаТз <> Неопределено Тогда
						СтрокаДанных.СтарыйСтатус = СтрокаТз.Наименование;
					КонецЕсли;
				ИначеЕсли Результат.Fields(х).Name = "IDUserStateReason" Тогда
					СтрокаТз = Статусы.Найти(Результат.Fields(х).Value, "Ид");
					Если СтрокаТз <> Неопределено Тогда
						СтрокаДанных.ПричинаИзменения = СтрокаТз.Наименование;
					КонецЕсли;
				ИначеЕсли Результат.Fields(х).Name = "TimeOn" Тогда
					СтрокаДанных.ВремяВключения = Дата(Результат.Fields(х).Value);
				ИначеЕсли Результат.Fields(х).Name = "TimeOff" Тогда
					Если Результат.Fields(х).Value <> Null Тогда
						СтрокаДанных.ВремяОтключения = Дата(Результат.Fields(х).Value);
					Иначе	
						СтрокаДанных.ВремяОтключения = '00010101';
					КонецЕсли;
				ИначеЕсли Результат.Fields(х).Name = "timedelta" Тогда
					Если Результат.Fields(х).Value <> Null Тогда
						СтрокаДанных.Длительность = Окр(Результат.Fields(х).Value, 2);
					Иначе
						СтрокаДанных.Длительность = 0;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла; 
			
			нз.Очистить();
			нз.Отбор.Пользователь.Установить(СтрокаДанных.Пользователь, Истина);
			нз.Отбор.ПользовательИнфинити.Установить(СтрокаДанных.ПользовательИнфинити, Истина);
			нз.Отбор.ВремяВключения.Установить(СтрокаДанных.ВремяВключения, Истина);
			
			ЗаполнитьЗначенияСвойств(нз.Добавить(), СтрокаДанных);
			
			нз.Записать();
			
			Результат.MoveNext();
			
		КонецЦикла;
	Исключение
		ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Инфинити", УровеньЖурналаРегистрации.Ошибка,,,ТекстСообщения);
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьСоответствиеВходящемуНомеру(Номер, КэшСоответствия = Неопределено) 
	
	Если КэшСоответствия = Неопределено Тогда
		З = Новый Запрос;
		з.Текст = 
		"ВЫБРАТЬ
		|	ИнфинитиСоответствиеНомеров.Номер КАК Номер,
		|	ИнфинитиСоответствиеНомеров.Компания КАК Компания
		|ИЗ
		|	РегистрСведений.ИнфинитиСоответствиеНомеров КАК ИнфинитиСоответствиеНомеров";
		КэшСоответствия = З.Выполнить().Выгрузить();
	КонецЕсли; 
	
	Р = КэшСоответствия.Найти(Номер, "Номер");
	Если Р = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат Р.Компания;
	КонецЕсли;
	
КонецФункции
 
Процедура ОбновитьСтатистикуЗвонков(Соединение, Юзеры, СтартДата) 
	
	КэшСоответствияНомеров = Неопределено;
	
	Если Юзеры = Неопределено Тогда Возврат КонецЕсли;
	
	нз = РегистрыСведений.ИнфинитиСтатистикаЗвонков.СоздатьНаборЗаписей();
	
	ТекстЗапроса = 
	"select 
	|	2 as NumberSelect,
	|	""TimeStart"",
	|	""TimeStartDate"",
	|	cast(div(cast(""TimeStartTime"" * 24 as numeric(20,2)), 1) as integer) as hour,
	|	cast(""B2DurationFull"" * 86400 as numeric(20,2)) as DurationFull,
	|	cast(""B2DurationTalk"" * 86400 as numeric(20,2)) as DurationTalk,
	|	cast(""B2DurationWait"" * 86400 as numeric(20,2)) as DurationWait,
	|	""ANumber"",
	|	""ANumberDialed"",
	|	""BCount"",
	|	""B2Number"" as BNumber, 
	|	""B2IDUser"" as IDUser, 
	|	""SeanceType"" as SeanceType
	|from ""S_Seances""
	|where
	|	""TimeFinish"" >= TIMESTAMP '" + Формат(СтартДата, "ДФ=""yyyyMMdd HHmmss""") + "' 
	|	and ""SeanceType"" = 1 
	|	and cast(""B2DurationTalk"" * 86400 as numeric(20,2)) > 10 
	|	and ""B2Number"" <> '' and ""B2Number"" <> 'ACD'
	|
	|UNION 
	|
	|select 
	|	3 as NumberSelect,
	|	""TimeStart"",
	|	""TimeStartDate"",
	|	cast(div(cast(""TimeStartTime"" * 24 as numeric(20,2)), 1) as integer) as hour,
	|	cast(""B3DurationFull"" * 86400 as numeric(20,2)) as DurationFull,
	|	cast(""B3DurationTalk"" * 86400 as numeric(20,2)) as DurationTalk,
	|	cast(""B3DurationWait"" * 86400 as numeric(20,2)) as DurationWait,
	|	""ANumber"",
	|	""ANumberDialed"",
	|	""BCount"",
	|	""B3Number"" as BNumber,
	|	""B3IDUser"" as IDUser, 
	|	""SeanceType"" as SeanceType
	|from ""S_Seances""
	|where
	|	""TimeFinish"" >= TIMESTAMP '" + Формат(СтартДата, "ДФ=""yyyyMMdd HHmmss""") + "' 
	|	and ""SeanceType"" = 1 
	|	and cast(""B3DurationTalk"" * 86400 as numeric(20,2)) > 10 
	|	and ""B3Number"" <> '' and ""B3Number"" <> 'ACD'
	|
	|UNION 
	|
	|select
	|	4 as NumberSelect,
	|	""TimeStart"",
	|	""TimeStartDate"",
	|	cast(div(cast(""TimeStartTime"" * 24 as numeric(20,2)), 1) as integer) as hour,
	|	cast(""B4DurationFull"" * 86400 as numeric(20,2)) as DurationFull,
	|	cast(""B4DurationTalk"" * 86400 as numeric(20,2)) as DurationTalk,
	|	cast(""B4DurationWait"" * 86400 as numeric(20,2)) as DurationWait,
	|	""ANumber"",
	|	""ANumberDialed"",
	|	""BCount"",
	|	""B4Number"" as BNumber,
	|	""B4IDUser"" as IDUser, 
	|	""SeanceType"" as SeanceType
	|from ""S_Seances""
	|where
	|	""TimeFinish"" >= TIMESTAMP '" + Формат(СтартДата, "ДФ=""yyyyMMdd HHmmss""") + "' 
	|	and ""SeanceType"" = 1 
	|	and cast(""B4DurationTalk"" * 86400 as numeric(20,2)) > 10 
	|	and ""B4Number"" <> '' and ""B4Number"" <> 'ACD'
	|
	|UNION 
	|
	|select
	|	5 as NumberSelect,
	|	""TimeStart"",
	|	""TimeStartDate"",
	|	cast(div(cast(""TimeStartTime"" * 24 as numeric(20,2)), 1) as integer) as hour,
	|	cast(""BLDurationFull"" * 86400 as numeric(20,2)) as DurationFull,
	|	cast(""BLDurationTalk"" * 86400 as numeric(20,2)) as DurationTalk,
	|	cast(""BLDurationWait"" * 86400 as numeric(20,2)) as DurationWait,
	|	""ANumber"",
	|	""ANumberDialed"",
	|	""BCount"",
	|	""BLNumber"" as BNumber,
	|	""BLIDUser"" as IDUser, 
	|	""SeanceType"" as SeanceType
	|from ""S_Seances""
	|where
	|	""TimeFinish"" >= TIMESTAMP '" + Формат(СтартДата, "ДФ=""yyyyMMdd HHmmss""") + "' 
	|	and ""SeanceType"" = 1 
	|	and cast(""B3DurationTalk"" * 86400 as numeric(20,2)) > 10 
	|	and ""BLNumber"" <> '' and ""BLNumber"" <> 'ACD'
	|
	|UNION 
	|
	|select
	|	6 as NumberSelect,
	|	""TimeStart"",
	|	""TimeStartDate"",
	|	cast(div(cast(""TimeStartTime"" * 24 as numeric(20,2)), 1) as integer) as hour,
	|	cast(""DurationFull"" * 86400 as numeric(20,2)) as DurationFull,
	|	cast(""DurationTalk"" * 86400 as numeric(20,2)) as DurationTalk,
	|	cast(""DurationWait"" * 86400 as numeric(20,2)) as DurationWait,
	|	""ANumber"",
	|	""ANumberDialed"",
	|	""BCount"",
	|	case when ""B2Number"" = '' or ""B2Number"" = 'ACD' then
	|		case when ""B3Number"" = '' or ""B3Number"" = 'ACD' then
	|			case when ""B4Number"" = '' or ""B4Number"" = 'ACD' then
	|				""BLNumber""
	|			else ""B4Number"" end
	|		else ""B3Number"" end
	|	else ""B2Number"" end as BNumber,
	|	case when ""B2Number"" = '' or ""B2Number"" = 'ACD' then
	|		case when ""B3Number"" = '' or ""B3Number"" = 'ACD' then
	|			case when ""B4Number"" = '' or ""B4Number"" = 'ACD' then
	|				""BLIDUser""
	|			else ""B4IDUser"" end
	|		else ""B3IDUser"" end
	|	else ""B2IDUser"" end as IDUser,
	|	""SeanceType"" as SeanceType
	|from ""S_Seances""
	|where
	|	""TimeFinish"" >= TIMESTAMP '" + Формат(СтартДата, "ДФ=""yyyyMMdd HHmmss""") + "' 
	|	and ""SeanceType"" <> 1 
	|";
	
	Результат = Соединение.Execute(ТекстЗапроса);
	
	Попытка
		Пока Не Результат.Eof() Цикл
			СтрокаДанных = Новый Структура("ДатаВремяЗвонка,НомерВходящий,НомерВызываемый,НомерПринявший,ДатаЗвонка,ДеньНедели,Час,Гудков,ДлительностьОбщая,ДлительностьРазговора,ДлительностьОжидания,Пользователь,Компания,Реквизит2");
			Для х = 0 По Результат.Fields.Count() - 1 Цикл
				Если Результат.Fields(х).Name = "TimeStart" Тогда
					СтрокаДанных.ДатаВремяЗвонка = Результат.Fields(х).Value;
					СтрокаДанных.ДеньНедели = ДеньНедели(СтрокаДанных.ДатаВремяЗвонка);
					СтрокаДанных.Час = Час(СтрокаДанных.ДатаВремяЗвонка);
				ИначеЕсли Результат.Fields(х).Name = "ANumber" Тогда
					СтрокаДанных.НомерВходящий = Результат.Fields(х).Value;
				ИначеЕсли Результат.Fields(х).Name = "ANumberDialed" Тогда
					СтрокаДанных.НомерВызываемый = СокрЛП(Результат.Fields(х).Value);
					СтрокаДанных.Компания = ПолучитьСоответствиеВходящемуНомеру(СтрокаДанных.НомерВызываемый, КэшСоответствияНомеров);
				ИначеЕсли Результат.Fields(х).Name = "bnumber" Тогда
					СтрокаДанных.НомерПринявший = Результат.Fields(х).Value;
				ИначеЕсли Результат.Fields(х).Name = "TimeStartDate" Тогда
					СтрокаДанных.ДатаЗвонка = Результат.Fields(х).Value;
				ИначеЕсли Результат.Fields(х).Name = "BCount" Тогда
					СтрокаДанных.Гудков = Результат.Fields(х).Value;
				ИначеЕсли Результат.Fields(х).Name = "durationfull" Тогда
					СтрокаДанных.ДлительностьОбщая = Результат.Fields(х).Value;
				ИначеЕсли Результат.Fields(х).Name = "durationtalk" Тогда
					СтрокаДанных.ДлительностьРазговора = Результат.Fields(х).Value;
				ИначеЕсли Результат.Fields(х).Name = "durationwait" Тогда
					СтрокаДанных.ДлительностьОжидания = Результат.Fields(х).Value;
				ИначеЕсли НРег(Результат.Fields(х).Name) = "seancetype" Тогда
					СтрокаДанных.Реквизит2 = Результат.Fields(х).Value;
				КонецЕсли;
			КонецЦикла;
			
			Попытка
				Если Число(СтрокаДанных.ДлительностьОбщая) > 0 Тогда 
					СтрокаТз = Неопределено;
					Если СтрокаДанных.Реквизит2 = 1 Тогда 
						СтрокаТз = Юзеры.Найти(СтрокаДанных.НомерПринявший, "Телефон");
					Иначе 
						СтрокаТз = Юзеры.Найти(СтрокаДанных.НомерВходящий, "Телефон");
					КонецЕсли;
					Если СтрокаТз <> Неопределено Тогда
						СтрокаДанных.Пользователь = СтрокаТз.Пользователь;
					Иначе
						СтрокаДанных.Пользователь = Неопределено;
					КонецЕсли;					
					нз.Очистить();
					нз.Отбор.ДатаВремяЗвонка.Установить(СтрокаДанных.ДатаВремяЗвонка, Истина);
					нз.Отбор.НомерВходящий.Установить(СтрокаДанных.НомерВходящий, Истина);
					нз.Отбор.НомерВызываемый.Установить(СтрокаДанных.НомерВызываемый, Истина);
					ЗаполнитьЗначенияСвойств(нз.Добавить(), СтрокаДанных);
					нз.Записать();
				КонецЕсли;
			Исключение
				//ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				//ЗаписьЖурналаРегистрации("Инфинити", УровеньЖурналаРегистрации.Ошибка,,,ТекстСообщения);
			КонецПопытки;
			Результат.MoveNext();
		КонецЦикла;
	Исключение
		ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Инфинити", УровеньЖурналаРегистрации.Ошибка,,,ТекстСообщения);
		Возврат;
	КонецПопытки;
КонецПроцедуры

Функция ПолучитьДатуНачала()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НАЧАЛОПЕРИОДА(ИнфинитиИсторияСтатусов.ВремяВключения, ДЕНЬ) КАК СтартДата
	|ИЗ
	|	РегистрСведений.ИнфинитиИсторияСтатусов КАК ИнфинитиИсторияСтатусов
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИнфинитиИсторияСтатусов.ВремяВключения УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтартДата = Выборка.СтартДата;
	Иначе
		СтартДата = ДобавитьМесяц(ТекущаяДатаСеанса(), -1);
	КонецЕсли;
	
    Возврат СтартДата;
	
КонецФункции

Процедура ОбновлениеБазИнфинити() Экспорт
	
	База = Новый Структура;
	База.Вставить("Driver", "{PostgreSQL ANSI(x64)}");
	База.Вставить("Server", "192.168.55.100");
	База.Вставить("Port", "10000");
	База.Вставить("Database", "Cx_Statistics");
	База.Вставить("Uid", "cxdbuser");
	База.Вставить("Pwd", "cxdbwizard");

	Соединение = УстановитьСоединениеСPostgreSQL(База);
	Если Соединение = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СтартДата = ПолучитьДатуНачала();
	
	Юзеры = ПолучитьТаблицуПользователейИнфинити(СтартДата);
	
	ОбновитьИсториюСтатусов(Соединение, Юзеры, СтартДата);
	ОбновитьСтатистикуЗвонков(Соединение, Юзеры, СтартДата);
	
	Соединение.Close();
	
КонецПроцедуры

