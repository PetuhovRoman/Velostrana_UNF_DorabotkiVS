
&Перед("ЗаполнитьОплату")
Процедура ВС_ЗаполнитьОплату(Объект, ОбщиеПараметры, СуммаОтгрузки, СуммаПредоплаты, ЭтоОплатаЗаказа)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Заказ") Тогда
		Если ЗначениеЗаполнено(Объект.Заказ) Тогда
			СведенияОЗаказе = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Заказ, "Номер,Дата");
			ЗаполнитьДопольнительныйРеквизитПоЗаказу(ОбщиеПараметры, СведенияОЗаказе);
		КонецЕсли;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДокументОснование") Тогда
		Если ЗначениеЗаполнено(Объект.ДокументОснование) И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			СведенияОЗаказе = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДокументОснование, "Номер,Дата");
			ЗаполнитьДопольнительныйРеквизитПоЗаказу(ОбщиеПараметры, СведенияОЗаказе);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДопольнительныйРеквизитПоЗаказу(ОбщиеПараметры, СведенияОЗаказе)
	
	ОбщиеПараметры.ДополнительныйРеквизитПользователя.Наименование = "Заказ";  
	
	РеквизитыОрганизация = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбщиеПараметры.Организация, "Префикс");
	НомерДокумента 		 = ПечатьДокументовУНФ.ПолучитьНомерНаПечатьСУчетомДатыДокумента(СведенияОЗаказе.Дата, СведенияОЗаказе.Номер, РеквизитыОрганизация.Префикс);
	
	ОбщиеПараметры.ДополнительныйРеквизитПользователя.Значение = " " + СокрЛП(НомерДокумента) + " от " + Формат(СведенияОЗаказе.Дата, "ДФ=dd.MM.yy");

КонецПроцедуры
