
&ИзменениеИКонтроль("ПечатьЧекаНевозможна")
Функция ВС_ПечатьЧекаНевозможна(Форма, ТекстПредупреждения, ВыводитьОписаниеОшибки)
    #Вставка
	Если Год(Форма.Объект.Дата) <> Год(ОбщегоНазначенияКлиент.ДатаСеанса()) Тогда
		ПредупреждениеАсинх(НСтр("ru = 'Необходимо изменить дату перед пробитием чека'"));
		Возврат Истина;
	КонецЕсли;
	#КонецВставки
	Если Форма.Объект.Проведен И Не Форма.Модифицированность Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Форма.Объект) = Тип("ДокументСсылка.ЗаказПокупателя")
		И РаботаСЗаявкамиКлиентСервер.ЭтоЗаявка(Форма.Объект.ВидОперации) Тогда
		ПредупреждениеАсинх(НСтр("ru = 'Работа с чеками не поддерживается для заявок'"));
		Возврат Истина;
	КонецЕсли;

	Попытка
		Если Форма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда
			Возврат Ложь;
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Если ВыводитьОписаниеОшибки Тогда
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ОбщегоНазначенияКлиент.СообщитьПользователю(ИнформацияОбОшибке.Описание);
		КонецЕсли;
	КонецПопытки;

	Возврат Истина;

КонецФункции
