Функция ВыполнитьПроверкуКМ(СсылкаНаДокумент, Токен, Площадка, ИдентификаторЧека = "") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументШтрихкодыУпаковок.ШтрихкодУпаковки,
	|	ПулКодовМаркировкиСУЗ.КодМаркировки,
	|	ПулКодовМаркировкиСУЗ.ПолныйКодМаркировки,
	|	ПулКодовМаркировкиСУЗ.Номенклатура,
	|	ПулКодовМаркировкиСУЗ.Характеристика,
	|	ДокументШтрихкодыУпаковок.Ссылка,
	|	ДокументШтрихкодыУпаковок.Ссылка.Организация,
	|	ДокументШтрихкодыУпаковок.Ссылка.Организация.ИНН КАК ИНН
	|ИЗ
	|	Документ.РасходнаяНакладная.ШтрихкодыУпаковок КАК ДокументШтрихкодыУпаковок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
	|		ПО ДокументШтрихкодыУпаковок.ШтрихкодУпаковки = ПулКодовМаркировкиСУЗ.ШтрихкодУпаковки
	|ГДЕ
	|	ДокументШтрихкодыУпаковок.Ссылка = &СсылкаНаДокумент
	|";
	Запрос.УстановитьПараметр("СсылкаНаДокумент", СсылкаНаДокумент);
	
	ВыборкаТоваров = Запрос.Выполнить().Выбрать();
	Если ВыборкаТоваров.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Токен) Тогда
		ЗаписьЖурналаРегистрации("ПроверкаКодовМаркировки", УровеньЖурналаРегистрации.Ошибка, , СсылкаНаДокумент, "Не заполнен Токен"); 
		Возврат Ложь;
	КонецЕсли;
	
	НомерФН = "";
	ДатаЗаписи = ОбщегоНазначенияБПО.ДатаСеанса();
	ГодМесяц = Год(ДатаЗаписи)*100+Месяц(ДатаЗаписи);
	Пока ВыборкаТоваров.Следующий() Цикл;
		
		Марка = ВыборкаТоваров.ПолныйКодМаркировки;
		
		СтруктураНоменклатурыИС = ОбщегоНазначенияИС.ОписаниеНоменклатуры(ВыборкаТоваров.Номенклатура);  //ключивидовпродукции
		СимволовСН = ПолучитьТоварнуюГруппуПоКлючу(СтруктураНоменклатурыИС[ВыборкаТоваров.Номенклатура].КлючВидовПродукции);
		
		СимволЗамены = Символ(29); // Разделитель 29 //90 -Z
		Если ЗначениеЗаполнено(ВыборкаТоваров.ПолныйКодМаркировки) Тогда
			КМ = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.Base64ВШтрихкод(ВыборкаТоваров.ПолныйКодМаркировки);
			
			ДлинаМарки = СтрДлина(КМ);
			Если ДлинаМарки > 38 И СтрНайти(КМ, Символ(29)) = 0 Тогда
				ПолныйКМ = Сред(КМ,1,18+СимволовСН) + СимволЗамены + Сред(КМ,18+СимволовСН + 1,6)+ СимволЗамены + Сред(КМ,38,ДлинаМарки-(18+СимволовСН + 1 + 6)+1);
			ИначеЕсли ДлинаМарки > 30 И СтрНайти(КМ, Символ(29)) = 0 Тогда
				ПолныйКМ = Сред(КМ,1,18+СимволовСН) + СимволЗамены + Сред(КМ,18+СимволовСН + 1,6);
			Иначе
				ПолныйКМ = КМ;
			КонецЕсли; 
			
			МаркаBase64 =  ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.ШтрихкодВBase64(ПолныйКМ);
			//СтрокаЧека.КодМаркировки         = СокрЛП(ПолныйКМ);
			Марка = ПолныйКМ;//ШтрихкодированиеИСКлиентСервер.ШтрихкодВBase64(ПолныйКМ);
			
		ИначеЕсли ЗначениеЗаполнено(ВыборкаТоваров.ЗначениеШтрихкода) Тогда
			МаркаBase64 = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.ШтрихкодВBase64(ВыборкаТоваров.ЗначениеШтрихкода);
			Марка = ВыборкаТоваров.ЗначениеШтрихкода;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Марка = СтрЗаменить(Марка, СимволЗамены, "(29)");
		
		НомерФН = "";
		РезультатПроверки = ВыполнитьОнлайнКонтрольМаркиЧестныйЗнак(Марка, Токен, ВыборкаТоваров.ИНН, НомерФН, Площадка);
		
		Если Не Булево(РезультатПроверки.ПродажаРазрешена) Тогда
			ЗаписьЖурналаРегистрации("ПроверкаКодовМаркировки", УровеньЖурналаРегистрации.Ошибка,, СсылкаНаДокумент, СокрЛП(ВыборкаТоваров.Номенклатура) + Символы.ПС + Марка + Символы.ПС + РезультатПроверки.ТекстОшибки);
			Возврат Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИдентификаторЧека) Тогда
			РС = РегистрыСведений.ОперацииПроверкиКМ.СоздатьМенеджерЗаписи();
			РС.КодМаркировки = МаркаBase64;
			РС.Прочитать();
			Если Не ЗначениеЗаполнено(РС.ИдентификаторЗапроса) И ЗначениеЗаполнено(РезультатПроверки.ИдЗапроса) Тогда 
				
				РС.ИдентификаторСессии = Новый УникальныйИдентификатор;
				РС.ИдентификаторЗапроса = Новый УникальныйИдентификатор;
				РС.ИдентификаторФискальнойОперации = ИдентификаторЧека;
				РС.ГодМесяц = ГодМесяц;
				РС.КодМаркировки = МаркаBase64;
				//РС.ЗапросКодаМаркировки = Новый ХранилищеЗначения;
				//РС.РезультатПроверкиКМНаККТ = Новый ХранилищеЗначения;
				//РС.РезультатПроверкиКМНаСервере = Новый ХранилищеЗначения;
				РС.ФлагиПроверкиОИСМ = "00001111"; 
				РС.ПокупкаПодтверждена = Истина;
				РС.Наименование = ОбщегоНазначенияИС.ПредставлениеНоменклатуры(ВыборкаТоваров.Номенклатура, ВыборкаТоваров.Характеристика);
				РС.АдресСервераЗапросаРазрешения = Площадка;
				РС.ТекстЗапросаРазрешения = Новый ХранилищеЗначения(РезультатПроверки.ТекстЗапросаРазрешения);
				РС.КодОтветаРазрешения = РезультатПроверки.КодОтвета;
				РС.РезультатЗапросаРазрешения = Новый ХранилищеЗначения(РезультатПроверки.РезультатЗапросаРазрешения);
				РС.ИдентификаторЗапросаРазрешения = РезультатПроверки.ИдЗапроса;
				РС.ВремяЗапросаРазрешения = РезультатПроверки.ВременнаяМетка;
				РС.ПродажаРазрешена = Истина;
				//РС.ПричинаЗапрета = Истина;
				РС.ДополнительныеСведения = Новый ХранилищеЗначения(Новый Массив);
				
				РС.Дата = ДатаЗаписи;
				РС.Результат = Истина;
				РС.КодМаркировкиПредставление = СокрЛП(ВыборкаТоваров.КодМаркировки);
				РС.Штрихкод = РезультатПроверки.ГТИН;
				РС.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьСпрКМ(Знач КМ)
	
	Если СтрНайти(КМ, "(01)") = 0 И СтрНачинаетсяС(КМ, "01") Тогда
		КМ = "(01)" + Сред(КМ,3,14) + "(21)" + Сред(КМ,19,13);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеШтрихкода";
	Запрос.УстановитьПараметр("ЗначениеШтрихкода", КМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
	
КонецФункции

Функция ПолучитьТоварнуюГруппуПоКлючу(Ключ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияЭлементовКонструктораВидовПродукцииИС.ЭлементКонструктора КАК ЭлементКонструктора,
	|	ЗначенияЭлементовКонструктораВидовПродукцииИС.Значение КАК ТоварнаяГруппа,
	|	ШаблоныКодовМаркировкиСУЗ.ДлинаСерийногоНомера КАК ДлинаСерийногоНомера
	|ИЗ
	|	РегистрСведений.ЗначенияЭлементовКонструктораВидовПродукцииИС КАК ЗначенияЭлементовКонструктораВидовПродукцииИС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиВидовПродукцииИС КАК КлючиВидовПродукцииИС
	|		ПО ЗначенияЭлементовКонструктораВидовПродукцииИС.ВидПродукции = КлючиВидовПродукцииИС.ВидПродукцииГИСМТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныКодовМаркировкиСУЗ КАК ШаблоныКодовМаркировкиСУЗ
	|		ПО ЗначенияЭлементовКонструктораВидовПродукцииИС.Значение = ШаблоныКодовМаркировкиСУЗ.ТоварнаяГруппа
	|ГДЕ
	|	ЗначенияЭлементовКонструктораВидовПродукцииИС.ЭлементКонструктора = ЗНАЧЕНИЕ(Справочник.ЭлементыКонструктораВидовПродукцииИС.ТоварныеГруппыГИСМТ)
	|	И КлючиВидовПродукцииИС.Ссылка = &Ключ
	|	И ШаблоныКодовМаркировкиСУЗ.ТипКодаМаркировки = ЗНАЧЕНИЕ(Перечисление.ТипыКодовМаркировкиИСМП.ЕдиницаТовара)";
	
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДлинаСерийногоНомера;
	КонецЕсли;
	
	Возврат 13;

КонецФункции


Функция ВыполнитьОнлайнКонтрольМаркиЧестныйЗнак(Марка, Токен, ИНН, НомерФН, ПлощадкаCDN) Экспорт
	
	Рез = Новый Структура();
	Рез.Вставить("ПродажаРазрешена", Ложь);
	Рез.Вставить("ИдЗапроса",		"");
	Рез.Вставить("ВременнаяМетка",	"");
	Рез.Вставить("ТекстОшибки",		"");
	Рез.Вставить("ОтветПолучен",	Ложь);
	Рез.Вставить("ВремяЗапроса",	0);
	Рез.Вставить("КодМаркировки",	"");
	Рез.Вставить("КодМаркировкиСтрокой","");
	Рез.Вставить("ГТИН","");
	
	Рез.Вставить("КодОтвета","");
	Рез.Вставить("ТекстЗапросаРазрешения","");
	Рез.Вставить("РезультатЗапросаРазрешения","");

	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("X-API-KEY",Токен);
	Заголовки.Вставить("Accept-Charset","utf-8");
	Заголовки.Вставить("Content-Type","application/json; charset=utf-8");
	
	HTTPЗапрос = Новый HTTPЗапрос("api/v4/true-api/codes/check",Заголовки);
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		ЧастьЗапросаИНН = ",""inn"":"""+СокрЛП(ИНН)+"""";
	Иначе
		ЧастьЗапросаИНН = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерФН) Тогда
		ЧастьЗапросаФН  = ",""fiscalDriveNumber"":"""+СокрЛП(НомерФН)+"""";
	Иначе
		ЧастьЗапросаФН  = "";
	КонецЕсли;	
	
	ТелоЗапросаJSON = "{""codes"":["""+JSONСтрока(СокрЛП(Марка))+"""]"+ЧастьЗапросаИНН+ЧастьЗапросаФН+"}"; 
	
	Рез.Вставить("ТекстЗапросаРазрешения",ТелоЗапросаJSON);
	
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Если ЗначениеЗаполнено(ПлощадкаCDN) Тогда
		
		ДанныеУРЛ = РазобратьСерверПортИзСтроки(ПлощадкаCDN);
		
		АдресРесурса  = ДанныеУРЛ.Адрес;
		ПортРесурса   = ?(ДанныеУРЛ.Порт<>0,ДанныеУРЛ.Порт,443);
		ИспШифрование = ДанныеУРЛ.Шифрование;
		
	Иначе	
	
		АдресРесурса  = "markirovka.crpt.ru";
		ПортРесурса   = 443;
		ИспШифрование = Истина;
		
	КонецЕсли;	
	
	ВремяЗапроса = 0;
	
	Попытка
		
		Если ИспШифрование Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено,Неопределено);
		Иначе	                   
			ЗащищенноеСоединение = Неопределено;
		КонецЕсли;	
		
		Соединение = Новый HTTPСоединение(АдресРесурса,ПортРесурса,,,Неопределено,15,ЗащищенноеСоединение);
		
		ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос); //post
		
		ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ВремяЗапроса = ВремяОкончания - ВремяНачала;
		
	Исключение
		
		//Нет соединения или таймаут - продажа разрешена
		
		Рез.ТекстОшибки = ОписаниеОшибки();
		
		Возврат Рез;
		
	КонецПопытки;
	
	ТелоОтветаJSON = HTTPОтвет.ПолучитьТелоКакСтроку();
	
	Рез.Вставить("РезультатЗапросаРазрешения", ТелоОтветаJSON);
	//Сообщить("Код состояния: "+HTTPОтвет.КодСостояния);
	//Сообщить("Текст ответа: "+ТелоОтветаJSON);
	Рез.Вставить("КодОтвета", HTTPОтвет.КодСостояния);
	
	Если HTTPОтвет.КодСостояния = 200 Тогда
		
		Рез.ОтветПолучен = Истина;
		Рез.ВремяЗапроса = ВремяЗапроса;
		Рез.КодМаркировки = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"cis");
		Рез.КодМаркировкиСтрокой = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"printView");
		Рез.ГТИН = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"gtin");
		
		КодОшибки       = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"errorCode");
		
		ТекстОшибки     = "";
				
		Если (ЗначениеЗаполнено(КодОшибки))И(КодОшибки<>"0") Тогда
			
			ТекстОшибкиГИСМТ = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"message");
			
			Если КодОшибки = "1" Тогда
				ТекстОшибки = "Ошибка валидации КМ в ГИС МТ.";
			ИначеЕсли КодОшибки = "2" Тогда
				ТекстОшибки = "КМ не содержит GTIN.";
			ИначеЕсли КодОшибки = "3" Тогда
				ТекстОшибки = "КМ не содержит серийный номер.";
			ИначеЕсли КодОшибки = "4" Тогда
				ТекстОшибки = "КМ содержит недопустимые символы.";
			ИначеЕсли КодОшибки = "5" Тогда
				ТекстОшибки = "Ошибка верификации крипто-подписи КМ в ГИС МТ (формат крипто-подписи не соответствует типу КМ).";
			ИначеЕсли КодОшибки = "6" Тогда
				ТекстОшибки = "Ошибка верификации крипто-подписи КМ в ГИС МТ (крипто-подпись не валидная).";
			ИначеЕсли КодОшибки = "7" Тогда
				ТекстОшибки = "Ошибка верификации крипто-подписи КМ в ГИС МТ (крипто-ключ не валиден).";
			ИначеЕсли КодОшибки = "8" Тогда
				ТекстОшибки = "КМ не прошел верификацию в стране эмитента/ошибка разбора КМ.";
			ИначеЕсли КодОшибки = "9" Тогда
				ТекстОшибки = "Найденные AI в КМ не поддерживаются.";
			ИначеЕсли КодОшибки = "10" Тогда
				ТекстОшибки = "КМ не найден в ГИС МТ.";
			Иначе
				ТекстОшибки = "Неклассифицированная ошибка отправки запроса по КМ в ГИС МТ: "+КодОшибки+".";
			КонецЕсли;
			
			Рез.ТекстОшибки = ТекстОшибки+" "+ТекстОшибкиГИСМТ;
			Рез.ПродажаРазрешена = Ложь;
			Возврат Рез;
			
		Иначе     
			
			Валидность  = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"valid");
			Наличие     = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"found");
			Продан      = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"sold");
			Нанесен     = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"utilised");
			СераяЗона   = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"grayZone");
			БлокПродажи = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"isBlocked");
			Принадлежность = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"isOwner");
						
			УспешнаяПроверкаКриптоподписи = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"verified");
			ВозможностьРеализации         = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"realizable");
			
			Если Продан = "true" Тогда
				СтатусМарки = "Продан";
			ИначеЕсли ВозможностьРеализации = "true" Тогда
				Если Принадлежность="false" тогда
					СтатусМарки = "Принадлежит другой организации";
				Иначе	
					СтатусМарки = "В обороте";
				КонецЕсли;	
			ИначеЕсли (ВозможностьРеализации <> "true")И(Нанесен = "true") Тогда
				СтатусМарки = "Нанесен";
			ИначеЕсли Нанесен <> "true" Тогда
				СтатусМарки = "Эмитирован";
			Иначе
				СтатусМарки = "Неизвестен";
			КонецЕсли;
			
			Если СтатусМарки = "Неизвестен" Тогда
				
				Если Валидность <> "true" Тогда
					
					ТекстОшибки = "Структура данных кода маркировки некорректна.";
					
				ИначеЕсли УспешнаяПроверкаКриптоподписи <> "true" Тогда
					
					ТекстОшибки = "Проверка крипто-подписи кода маркировки в ГИС МТ завершилась с ошибкой.";
					
				ИначеЕсли Наличие <> "true" Тогда
					
					ТекстОшибки = "Код маркировки не найден в ГИС МТ.";
					
				КонецЕсли;
				
			КонецЕсли;	
			
			Если БлокПродажи = "true" Тогда
				
				ТекстОшибки = "Продажа заблокирована контролирующей организацией.";
				
			КонецЕсли;	
			
			Если СтатусМарки <> "В обороте" Тогда
				
				ТекстОшибки = ТекстОшибки +"; Недопустимый статус марки: "+СтатусМарки;
				
			КонецЕсли;	
			
			Если ТекстОшибки = "" Тогда
				
				Рез.ПродажаРазрешена = Истина;
				
				Рез.ИДЗапроса = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"reqId");
				
				Рез.ВременнаяМетка = ОбщегоНазначенияБПОКлиентСервер.TimestampВДату(ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"reqTimestamp"));
				
				Возврат Рез;				
				
			Иначе 
				
				Рез.ТекстОшибки = ТекстОшибки;
				Рез.ПродажаРазрешена = Ложь;
				Возврат Рез;
				
			КонецЕсли;					
			
		КонецЕсли;	
				
	Иначе
		
		ТекстОшибкиГИСМТ = ПолучитьИзСтрокиJSON(ТелоОтветаJSON,"description");
		
		Рез.ТекстОшибки = "Не удалось выполнить проверку марки. Код ответа: "+Строка(HTTPОтвет.КодСостояния)+". "+ТекстОшибкиГИСМТ;
		Рез.ПродажаРазрешена = Ложь;
		Возврат Рез;
		
	КонецЕсли;	
	
	
КонецФункции	

Функция JSONСтрока(Знач Стр)
    Стр=СтрЗаменить(Стр,"\","\\");
    Стр=СтрЗаменить(Стр,Символы.ПС,"\n");
    Стр=СтрЗаменить(Стр,Символы.ВК,"\r");
    Стр=СтрЗаменить(Стр,Символы.Таб,"\t");
    Стр=СтрЗаменить(Стр,"/","\/");
    Стр=СтрЗаменить(Стр,"""","\""");
	Стр=СтрЗаменить(Стр,"(29)","\u001d");
	Стр=СтрЗаменить(Стр,Символ(29),"\u001d");
    Возврат Стр
КонецФункции

Функция ПолучитьИзСтрокиJSON(ИсходнаяСтрока, ИмяПараметра, ВырезатьПолученное=Ложь)
	
	Стр = ИсходнаяСтрока;
	
	Рез = "";
	
	СтрПараметра = """"+СокрЛП(ИмяПараметра)+""":";
	
	ПозПараметра = Найти(Стр,СтрПараметра);
	
	Если ПозПараметра<>0 Тогда
		
		Поз = ПозПараметра+СтрДлина(СтрПараметра);
		ТекС = Сред(Стр,Поз,1);
		
		Если ТекС = """" Тогда
			Поз=Поз+1; 
			СимвСтоп = """";
		Иначе
			СимвСтоп = ",}]";
		КонецЕсли;	
		
		Экранирование = "";
		
		Пока Поз<=СтрДлина(Стр) Цикл
			
			ТекС = Сред(Стр,Поз,1);
			
			Если Экранирование = "" Тогда
				
				Если ТекС = "\" Тогда
					Экранирование = "\";
					Поз = Поз + 1; 
				Иначе
					Если Найти(СимвСтоп,ТекС)=0 Тогда
						Рез = Рез+ТекС;
						Поз = Поз+1;
					Иначе
						
						Если ВырезатьПолученное Тогда
							
							ИсходнаяСтрока = Лев(ИсходнаяСтрока,ПозПараметра-1)+Сред(ИсходнаяСтрока,?(ТекС="""",Поз+1,Поз));
							
						КонецЕсли;	
						
						Возврат Рез;
					КонецЕсли;	
				КонецЕсли;	
				
			Иначе     
				
				Экранирование = "";
				
				Рез = Рез+ТекС;
				Поз = Поз+1;
				
			КонецЕсли;		
			
		КонецЦикла;	
		
		Возврат Рез;
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;	
	
КонецФункции	

Функция ПолучитьМассивИзСтрокиJSON(ИсходнаяСтрока, ИмяПараметра)
	
	Рез = Новый Массив();
	Стр = ИсходнаяСтрока;
	
	Пока 1=1 Цикл
		
		ТекЗначение = ПолучитьИзСтрокиJSON(Стр,ИмяПараметра,Истина);
		
		Если ЗначениеЗаполнено(ТекЗначение) Тогда
			Рез.Добавить(ТекЗначение);
		Иначе
			Возврат Рез;
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецФункции	

Функция НайтиСКонца(ИсходнаяСтрока,ШаблонПоиска)
	
	Стр  = ИсходнаяСтрока;
	ДлИ  = СтрДлина(Стр);
	ДлШ  = СтрДлина(ШаблонПоиска);
		
	Для П=1 по ДлИ Цикл
		
		ТекПоз = ДлИ-П+1;
		
		ТекПодстрока = Сред(Стр,ТекПоз,ДлШ);
		
		Если ТекПодстрока = ШаблонПоиска Тогда
			Возврат ТекПоз;
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат 0;
	
КонецФункции	

Функция РазобратьСерверПортИзСтроки(Знач СтрокаАдреса)
	
	Рез = Новый Структура();
	Рез.Вставить("Адрес",СтрокаАдреса);
	Рез.Вставить("Порт",0);
	Рез.Вставить("Шифрование",Ложь);
	
	Если Лев(Нрег(СтрокаАдреса),8)="https://" Тогда
		Рез.Шифрование = Истина;
		СтрокаАдреса = Сред(СтрокаАдреса,9);
		Рез.Адрес = СтрокаАдреса;
	ИначеЕсли Лев(Нрег(СтрокаАдреса),7)="http://" Тогда	
		СтрокаАдреса = Сред(СтрокаАдреса,8);
		Рез.Адрес = СтрокаАдреса;
	КонецЕсли;	
		
	П = НайтиСКонца(СтрокаАдреса,":");
	
	Если П<>0 Тогда
		
		Попытка
			Порт = Число(Сред(СтрокаАдреса,П+1));
			Рез.Вставить("Адрес",Лев(СтрокаАдреса,П-1));
			Рез.Вставить("Порт",Порт);
		Исключение   
			
			//none
			
		КонецПопытки;	
		
	КонецЕсли;	
	
	Возврат Рез;
	
КонецФункции	

Функция ПолучитьТокен(Организация) Экспорт
	
	ТипТокенаАвторизации = ПредопределенноеЗначение("Перечисление.ТипыТокеновАвторизации.ИСМПРозница");
	
	ДанныеКлючаСессии = ИнтерфейсАвторизацииИСМПСлужебный.ПолучитьСохраненныеДанныеКлючаСессии(
		ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ИмяДанныхКлючаСессии(ТипТокенаАвторизации));
	Если ДанныеКлючаСессии = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = ДанныеКлючаСессии[Организация];
	
	Если Данные = Неопределено Тогда
		
		Возврат ПолучитьТокенПоИНН(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ИНН"));
		
	КонецЕсли;
	
	Токен = Данные.КлючСессии;
	//ДействуетДо = МестноеВремя(Данные.ДействуетДо, ЧасовойПоясСеанса());
	//РасшифроватьТокен(ЭтотОбъект);
	
	Возврат Токен;
	
КонецФункции

