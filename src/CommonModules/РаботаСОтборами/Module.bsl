///==============================================================================
// Заполняет списка выбора поле отбора "Статус обеспеченности"
//
// Параметры:
//   Форма - Форма списка с полем отбора
//   ИмяПоляОтбора - Имя поля для которого необходимо сформировать список отбора
процедура ЗаполнитьСписокВыбораОтборОбеспеченность(Форма, ИмяПоляОтбора, СОтступом = Истина, МассивИсключений = Неопределено) Экспорт
	
	если МассивИсключений = неопределено тогда
		МассивИсключений = новый Массив;
	конецЕсли;

	Отступ       = ?(СОтступом, "   ", "");
	списокВыбора = Форма.Элементы[ИмяПоляОтбора].СписокВыбора;
	ДобавитьЭлементВСписокВыбора(массивИсключений, 2, БиблиотекаКартинок.БезОплатыНеПросрочено,       "Не обеспечено",        списокВыбора);
	ДобавитьЭлементВСписокВыбора(массивИсключений, 1, БиблиотекаКартинок.ОплаченЧастичноНеПросрочено, "Обеспечено частично",  списокВыбора);
	ДобавитьЭлементВСписокВыбора(массивИсключений, 0, БиблиотекаКартинок.ОплаченПолностью,            "Обеспечено полностью", списокВыбора);
конецПроцедуры // ЗаполнитьСписокВыбораОтборОбеспеченность

///==============================================================================
процедура ДобавитьЭлементВСписокВыбора(массивИсключений, значение, картинка, текст, списокВыбора)

	если массивИсключений.Найти(значение) = неопределено тогда
		КомпонентыФС = новый Массив;
		КомпонентыФС.Добавить(картинка);
		КомпонентыФС.Добавить(" ");
		КомпонентыФС.Добавить(НСтр("ru='" + текст + "'"));

		СтрокаПредставления = новый ФорматированнаяСтрока(КомпонентыФС);
		списокВыбора.Добавить(текст, СтрокаПредставления);
	конецЕсли;
конецПроцедуры // ДобавитьЭлементВСписокВыбора
