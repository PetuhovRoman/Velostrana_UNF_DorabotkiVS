
Процедура ЗапретВводаНаОснованииНепроведенногоДокументаОбработкаЗаполнения(Источник, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт

	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ОперацияПоПлатежнымКартам") 
		И ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		
		Если РольДоступна(Метаданные.Роли.ВС_РазрешитьВводОплатНаОснованииНепроведенногоДокумента) Тогда
			Возврат;
		КонецЕсли;
		
		ДокументСсылкаРасходнаяНакладнаяПроведен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДанныеЗаполнения,
		"Проведен");
		
		Если Не ДокументСсылкаРасходнаяНакладнаяПроведен Тогда
			ВызватьИсключение НСтр("ru = 'Невозможен ввод документа на основании не проведенной расходной накладной!'");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписьюДокументовДляОбменаУТ10ПриЗаписи(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Не Отказ Тогда
		Источник.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
		Источник.ОбменДанными.Получатели.Очистить();
		
		Если Не СтрЧислоВхождений(Источник.Комментарий, "#") = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
			Организация = Источник.Организация;
			Подразделение = Источник.СтруктурнаяЕдиницаПродажи;
		ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ОтчетОРозничныхПродажах") Тогда
			Если Источник.КассаККМ.ИспользоватьБезПодключенияОборудования Тогда
				Возврат;
			КонецЕсли;
			Организация = Источник.Организация;
			Подразделение = Источник.Подразделение;
		ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказНаПеремещение") Тогда
			Организация = Источник.СтруктурнаяЕдиницаПолучатель.Организация;
			Подразделение = Источник.СтруктурнаяЕдиницаПолучатель.Родитель;
		Иначе
			Организация = Источник.Организация;
			Подразделение = Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
		КонецЕсли;
		
		ПланыОбмена.ОбменСУТ10.ЗарегистрироватьИзмененияДляОбмена(Источник.ОбменДанными, Организация, Подразделение);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписиДокументовСтатусНаличияКодовМаркировки(Источник, Отказ) Экспорт
	РегистрыСведений.СтатусыНаличияКодовМаркировкиВДокументах.УстановитьСтатусНаличияКодовМаркировки(Источник.Ссылка);
КонецПроцедуры
