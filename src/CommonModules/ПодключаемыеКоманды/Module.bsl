///==============================================================================
процедура ИзменитьТекстЗапросаСКонтролем(текстЗапроса, строкаПоиска, строкаЗамены) Экспорт

	поз = СтрНайти(текстЗапроса, строкаПоиска);
	если поз <= 0 тогда
		ВызватьИсключение "Не найден искомый текст в запросе.";
	конецЕсли;

	текстЗапроса = СтрЗаменить(текстЗапроса, строкаПоиска, строкаЗамены);
конецПроцедуры // ИзменитьТекстЗапросаСКонтролем

///==============================================================================
Функция ДобавитьЭлементУправленияФормы(Элементы, имя, типЭлемента, родитель, ПутьКДаннымИмяКоманды, вид) Экспорт

	result     = Элементы.Add(имя, типЭлемента, родитель);
	result.Вид = вид;
	if типЭлемента = Тип("КнопкаФормы") then
		result.ИмяКоманды  = ПутьКДаннымИмяКоманды;
	else
		result.ПутьКДанным = ПутьКДаннымИмяКоманды;
	endIf;
	return result;
	
КонецФункции // ДобавитьЭлементУправленияФормы

// Консоль AL 09.11.2026 — безопасное добавление группы подключаемых команд с поддержкой мобильного клиента (где элемент ФормаИзменитьФорму отсутствует)
&Перед("ПриСозданииНаСервере")
Процедура ВС_ПередПриСозданииНаСервере(Форма, Знач ПараметрыРазмещения)
	
	Если Форма.ИмяФормы <> "Справочник.Ячейки.Форма.ФормаСписка" Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	Если Элементы.Найти("ПодключаемыеКоманды") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементСписок = Элементы.Найти("Список");
	Если ЭлементСписок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементИзменитьФорму = Элементы.Найти("ФормаИзменитьФорму");
	Если ЭлементИзменитьФорму <> Неопределено Тогда
		ГруппаПодключаемыхКоманд = Элементы.Вставить("ПодключаемыеКоманды", Тип("ГруппаФормы"), ЭлементСписок.КоманднаяПанель, ЭлементИзменитьФорму);
	Иначе
		ГруппаПодключаемыхКоманд = Элементы.Добавить("ПодключаемыеКоманды", Тип("ГруппаФормы"), ЭлементСписок.КоманднаяПанель);
	КонецЕсли;
	ГруппаПодключаемыхКоманд.Вид = ВидГруппыФормы.ГруппаКнопок;
	ГруппаПодключаемыхКоманд.Заголовок = НСтр("ru = 'Подключаемые команды'");
	
КонецПроцедуры
// Конец Консоль AL

&После("ПриСозданииНаСервере")
Процедура ВС_ПриСозданииНаСервере(Форма, Знач ПараметрыРазмещения)
	
	ИмяФормы = Форма.ИмяФормы;
	Элементы = Форма.Элементы;
	Команды  = Форма.Команды;
	
	Если ИмяФормы = "Справочник.Номенклатура.Форма.ФормаСпискаВС" Тогда
		
		НоваяКоманда = Команды.Добавить("ОткрытьОписание");
		НоваяКоманда.Действие = "Подключаемый_ВыполнитьКомандуРаботаСНоменклатурой";
		НоваяКоманда.Заголовок = "Открыть описание";
		
		ДобавитьКнопкуОткрытьОписаниеНоменклатуры(Форма, "ОсновныеКоманды");
		
	ИначеЕсли ИмяФормы = "Справочник.Номенклатура.Форма.ФормаСписка" Тогда
		
		НоваяКоманда = Команды.Добавить("ОткрытьОписание");
		НоваяКоманда.Действие = "Подключаемый_ВыполнитьКомандуРаботаСНоменклатурой";
		НоваяКоманда.Заголовок = "Открыть описание";
		
		ДобавитьКнопкуОткрытьОписаниеНоменклатуры(Форма, "КомандыСписка");
		
	ИначеЕсли ИмяФормы = "Обработка.СписокНоменклатуры.Форма.ФормаСписка" Тогда
		
		НоваяКоманда = Команды.Добавить("ОткрытьОписание");
		НоваяКоманда.Действие = "Подключаемый_ВыполнитьКомандуРаботаСНоменклатурой";
		НоваяКоманда.Заголовок = "Открыть описание";
		
		ДобавитьКнопкуОткрытьОписаниеНоменклатуры(Форма, "КомандыСписка");
		
	ИначеЕсли ИмяФормы = "Справочник.Номенклатура.Форма.ФормаЭлемента" Тогда

		НоваяКоманда = Команды.Добавить("ОткрытьОписание");
		НоваяКоманда.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		НоваяКоманда.Заголовок = "Открыть описание";
		
		
		ДобавитьКнопкуОткрытьОписаниеНоменклатуры(Форма, "ФормаГруппаНастройки");
		ДобавитьПолеРеквизитаТорговаяМарка(Форма, "ГруппаЗакупкаПроизводство");
		
	ИначеЕсли ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаСписка" Тогда
		
		//ДобавитьКнопкуКомандыОтправитьСсылку(Форма, Команды, ИмяПанели);
		
		ДобавитьКолонкуНаличияКодовМаркировки(Форма, Элементы, "ДокументЗаказПокупателя");
		
		ТекстЗапроса = Форма.Список.ТекстЗапроса;
		ИзменитьТекстЗапросаСКонтролем(ТекстЗапроса, "НомерКартинкиОтгрузки,",
			"НомерКартинкиОтгрузки,
			|ВЫБОР
			|	КОГДА ДокументЗаказПокупателя.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
			|			ИЛИ НЕ ДокументЗаказПокупателя.Проведен
			|		ТОГДА -1
			|	КОГДА ДокументЗаказПокупателя.ОжидаетсяВыборВариантаКП
			|		ТОГДА 2
			|	КОГДА графикОбеспечения.Заказ ЕСТЬ NULL
			|		ТОГДА 0
			|	КОГДА ЕСТЬNULL(графикОбеспечения.процент, 0) >= 100
			|		ТОГДА 0
			|	КОГДА ЕСТЬNULL(графикОбеспечения.процент, 0) <= 0
			|		ТОГДА 2
			|	ИНАЧЕ 1
			|КОНЕЦ КАК НомерКартинкиОбеспечения,
			|");

		Форма.Список.ТекстЗапроса = текстЗапроса + "
			|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикОбеспеченияЗаказов КАК графикОбеспечения
			|		ПО ДокументЗаказПокупателя.Ссылка = графикОбеспечения.Заказ}";
		ctrl = ДобавитьЭлементУправленияФормы(Элементы,
					"СписокНомерКартинкиОбеспечения",
					Тип("ПолеФормы"),
					Элементы.Список,
					"Список.НомерКартинкиОбеспечения",
					ВидПоляФормы.ПолеКартинки);
		ctrl.КартинкаЗначений         = БиблиотекаКартинок.СостояниеЗаказа;
		ctrl.КартинкаШапки            = БиблиотекаКартинок.РазделЗакупки;
		ctrl.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ctrl.РастягиватьПоВертикали   = ложь;
		ctrl.РастягиватьПоГоризонтали = ложь;
		ctrl.Заголовок                = "Номер картинки обеспечения";
		ctrl.Подсказка                = "Состояние обеспечения";
		ctrl.Ширина                   = 2;

		ДобавляемыеРеквизиты = new Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ОтборОбеспеченность",
										Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Фиксированная)),
										,
										"Отбор обеспеченность"));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		ГруппаОтборОбеспеченность = Элементы.Добавить("ГруппаОтборОбеспеченность", Тип("ГруппаФормы"), Элементы.ГруппаОтборы);
		ЗаполнитьЗначенияСвойств(ГруппаОтборОбеспеченность, Элементы.ГруппаОтборОплата, , "Имя, ПутьКДаннымЗаголовка");
		ГруппаОтборОбеспеченность.Подсказка = "Группа отбор обеспеченность";
		ГруппаОтборОбеспеченность.Заголовок = "Обеспеченность";
		ctrl = ДобавитьЭлементУправленияФормы(Элементы,
					"ОтборОбеспеченность",
					Тип("ПолеФормы"),
					ГруппаОтборОбеспеченность,
					"ОтборОбеспеченность",
					ВидПоляФормы.ПолеВвода);
		ctrl.ПоложениеЗаголовка      = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ctrl.КнопкаВыпадающегоСписка = истина;
		ctrl.ПодсказкаАвтоЗаполнения = ПодсказкаАвтоЗаполненияПоляВвода.НеИспользовать;
		ctrl.ПодсказкаВвода          = "Обеспеченность";
		ctrl.УстановитьДействие("ОбработкаВыбора", "ОтборОбеспеченностьОбработкаВыбора");
		РаботаСОтборами.ЗаполнитьСписокВыбораОтборОбеспеченность(Форма, "ОтборОбеспеченность");
		
	ИначеЕсли ИмяФормы = "Документ.РасходнаяНакладная.Форма.ФормаСписка" Тогда
		
		ДобавитьКолонкуНаличияКодовМаркировки(Форма, Элементы, "ДокументРасходнаяНакладная");
		
	ИначеЕсли ИмяФормы = "Документ.ПриходнаяНакладная.Форма.ФормаСписка" Тогда
		
		ДобавитьКолонкуНаличияКодовМаркировки(Форма, Элементы, "ДокументПриходнаяНакладная");
		
	ИначеЕсли ИмяФормы = "Документ.ПеремещениеПоЯчейкам.Форма.ФормаДокумента" Тогда

		ДобавитьПолеРеквизитаСостояние(Форма, "ЛеваяКолонка");
		
	ИначеЕсли ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента" Тогда
		
		ДобавитьПолеРеквизитаВКоробке(Форма, "ГруппаОтгрузкаОплатаКалькуляция");
		
	//ИначеЕсли ИмяФормы = "Документ.РасходнаяНакладная.Форма.ФормаДокумента" Тогда

//		НоваяКоманда = Команды.Добавить("ДобавитьКодМаркировки");
//		НоваяКоманда.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
//		НоваяКоманда.Заголовок = "Добавить код маркировки";
//		
//		ДобавитьКнопкуДобавленияКМ(Форма, "ЗапасыГруппаКопированиеСтрок");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКнопкуОткрытьОписаниеНоменклатуры(Форма, ИмяПанели) 
	НовыйЭлемент = Форма.Элементы.Добавить("КнопкаОткрытьОписание", Тип("КнопкаФормы"), Форма.Элементы[ИмяПанели]); 
	НовыйЭлемент.ИмяКоманды = "ОткрытьОписание";
	НовыйЭлемент.Картинка = БиблиотекаКартинок.ИнформацияНовости32Статичная;
	НовыйЭлемент.Отображение = ОтображениеКнопки.Картинка;	
КонецПроцедуры 

Процедура ДобавитьКнопкуКомандыОтправитьСсылку(Форма, Команды, ИмяПанели)
	
	НоваяКоманда = Команды.Добавить("ОтправитьСсылкуНаОплату");
	НоваяКоманда.Действие = "ОнлайнЗаказыВыставлениеСчетов";
	НоваяКоманда.Заголовок = "Отправить ссылку на оплату";
	
	НовыйЭлемент = Форма.Элементы.Добавить("КнопкаОтправитьСсылкуНаОписание", Тип("КнопкаФормы"), Форма.Элементы[ИмяПанели]); 
	НовыйЭлемент.ИмяКоманды = "ОтправитьСсылкуНаОплату";
	НовыйЭлемент.Картинка = БиблиотекаКартинок.ЭмблемаСервиса1СЭДО;
	НовыйЭлемент.Отображение = ОтображениеКнопки.Картинка;
	
КонецПроцедуры 

Процедура ДобавитьПолеРеквизитаТорговаяМарка(Форма, ИмяПанели)
	
	НовыйЭлемент = Форма.Элементы.Добавить("ТорговаяМарка", Тип("ПолеФормы"), Форма.Элементы[ИмяПанели]);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ТорговаяМарка";
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.МаксимальнаяШирина = 34;
КонецПроцедуры

Процедура ДобавитьПолеРеквизитаВКоробке(Форма, ИмяПанели)
	
	НовыйЭлемент = Форма.Элементы.Добавить("ВКоробке", Тип("ПолеФормы"), Форма.Элементы[ИмяПанели]);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным = "Объект.ВКоробке";
	//НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	//НовыйЭлемент.МаксимальнаяШирина = 34;
КонецПроцедуры

Процедура ДобавитьПолеРеквизитаСостояние(Форма, ИмяПанели)
	
	НовыйЭлемент = Форма.Элементы.Вставить("Состояние", Тип("ПолеФормы"), Форма.Элементы[ИмяПанели], Форма.Элементы["СтруктурнаяЕдиница"]);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.СостояниеЗаказа";
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.МаксимальнаяШирина = 34;
	
КонецПроцедуры

Процедура ДобавитьКолонкуНаличияКодовМаркировки(Форма, Элементы, СтрокаОбъекта)
	
	ТекстЗапроса = Форма.Список.ТекстЗапроса;
		ИзменитьТекстЗапросаСКонтролем(ТекстЗапроса, "Проведен КАК Проведен,",
			"Проведен КАК Проведен,
			|СтатусыНаличияКМ.СтатусНаличияКМ КАК НомерКартинкиНаличиеКМ,
			|");

		Форма.Список.ТекстЗапроса = текстЗапроса + "
			|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыНаличияКодовМаркировкиВДокументах КАК СтатусыНаличияКМ
			|		ПО " + СтрокаОбъекта + ".Ссылка = СтатусыНаличияКМ.Документ}";
		ctrl = ДобавитьЭлементУправленияФормы(Элементы,
					"СписокНомерКартинкиНаличиеКМ",
					Тип("ПолеФормы"),
					Элементы.Список,
					"Список.НомерКартинкиНаличиеКМ",
					ВидПоляФормы.ПолеКартинки);
		ctrl.КартинкаЗначений         = БиблиотекаКартинок.МаркируемаяПродукцияТЧ;
		ctrl.КартинкаШапки            = БиблиотекаКартинок.МаркируемаяПродукцияШапка;
		ctrl.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ctrl.РастягиватьПоВертикали   = ложь;
		ctrl.РастягиватьПоГоризонтали = ложь;
		ctrl.Заголовок                = "Номер картинки наличия КМ";
		ctrl.Подсказка                = "Наличие кодов маркировки";
		ctrl.Ширина                   = 2;

КонецПроцедуры
 
