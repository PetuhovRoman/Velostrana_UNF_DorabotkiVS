Функция ПолучитьКассовуюСмену(ДатаСмены, КассаККМ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КассоваяСмена.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КассоваяСмена КАК КассоваяСмена
	|ГДЕ
	|	КассоваяСмена.КассаККМ = &КассаККМ
	|	И НАЧАЛОПЕРИОДА(КассоваяСмена.Дата, ДЕНЬ) = &ДатаДок
	|	И НЕ КассоваяСмена.ПометкаУдаления
	|	И КассоваяСмена.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)";
	
	Запрос.УстановитьПараметр("ДатаДок", НачалоДня(ДатаСмены));
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	НоваяКассоваяСмена = Документы.КассоваяСмена.СоздатьДокумент();
	РеквизитыКассыККМ = Справочники.КассыККМ.ПолучитьРеквизитыКассыККМ(КассаККМ);
	ЗаполнитьЗначенияСвойств(НоваяКассоваяСмена, РеквизитыКассыККМ);
	
	НоваяКассоваяСмена.Дата                   = ДатаСмены;
	НоваяКассоваяСмена.Статус                 = Перечисления.СтатусыКассовойСмены.Открыта;
	НоваяКассоваяСмена.НачалоКассовойСмены    = ДатаСмены;
	НоваяКассоваяСмена.ОкончаниеКассовойСмены = '00010101';
	
	НоваяКассоваяСмена.ДополнительныеСвойства.Вставить("НеСоздаватьОтчетОРозничныхПродажах", Истина);
	НоваяКассоваяСмена.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат НоваяКассоваяСмена.Ссылка
	
КонецФункции

Функция ПолучитьЭТ(КассаККМ, ТипОплаты, ВидОплаты)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СпособыОплаты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СпособыОплаты КАК СпособыОплаты
	|ГДЕ
	|	СпособыОплаты.Касса = &КассаККМ
	|	И СпособыОплаты.Тип = &Тип";   
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	Запрос.УстановитьПараметр("Тип", ТипОплаты);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Ссылка.ВидыПлатежныхКарт.Найти(ВидОплаты, "ВидПлатежнойКарты") = Неопределено Тогда
			СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
			СтрокаВид = СпрОбъект.ВидыПлатежныхКарт.Добавить();
			СтрокаВид.ВидПлатежнойКарты = ВидОплаты;
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.Записать();
		КонецЕсли;
		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	СпрН = Справочники.СпособыОплаты.СоздатьЭлемент();
	СпрН.Заполнить(Неопределено);
	СпрН.Тип = ТипОплаты;
	СпрН.Организация = КассаККМ.Владелец;
	СпрН.Касса = КассаККМ;
	СпрН.ИспользоватьБезПодключенияОборудования = Истина;
	
	Если СпрН.Тип = ПредопределенноеЗначение("Перечисление.ТипыСпособовОплат.СБП") Тогда
		ШаблонАвтоНаименования = НСтр("ru = 'СБП %1'");
		ЭквайрерСтрокой = ?(ЗначениеЗаполнено(СпрН.Эквайрер), Строка(СпрН.Эквайрер), НСтр("ru = ''"));
		СтрокаНаименования = СокрП(СтрШаблон(ШаблонАвтоНаименования, ЭквайрерСтрокой));
	ИначеЕсли СпрН.Тип = ПредопределенноеЗначение("Перечисление.ТипыСпособовОплат.ЮKassa") Тогда
		СтрокаНаименования = НСтр("ru = 'ЮKassa'");
	Иначе
		СтрокаНаименования = НСтр("ru='Эквайринговый терминал '") + " (" + Строка(СпрН.Касса) + ")";
		СтрокаНаименования = Лев(СтрокаНаименования, 100);
	КонецЕсли;
	
	СпрН.Наименование = СтрокаНаименования;
	
	СтрокаВид = СпрН.ВидыПлатежныхКарт.Добавить();
	СтрокаВид.ВидПлатежнойКарты = ВидОплаты;
	
	СпрН.ОбменДанными.Загрузка = Истина;
	СпрН.Записать();
	
	Возврат СпрН.Ссылка;


КонецФункции

Функция НайтиЭТ(Организация, Подразделение)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СпособыОплаты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СпособыОплаты КАК СпособыОплаты
	|ГДЕ
	|	СпособыОплаты.Касса.Подразделение = &Подразделение
	|	И СпособыОплаты.Организация = &Организация
	|	И Не СпособыОплаты.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)";   
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	
	Возврат Справочники.СпособыОплаты.ПустаяСсылка();


КонецФункции

Функция ПолучитьПолныйКМ(ШтрихкодУпаковки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПулКодовМаркировкиСУЗ.ПолныйКодМаркировки КАК ПолныйКодМаркировки
	|ИЗ
	|	РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
	|ГДЕ
	|	ПулКодовМаркировкиСУЗ.ШтрихкодУпаковки = &ШтрихкодУпаковки";
	
	Запрос.УстановитьПараметр("ШтрихкодУпаковки", ШтрихкодУпаковки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
