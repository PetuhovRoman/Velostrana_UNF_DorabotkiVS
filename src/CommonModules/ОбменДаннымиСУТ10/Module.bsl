	КонецЕсли;	
	Док.Комментарий = "#Загружен из УТ10 " + СтатусЗаказа + ", "  + Источник  + Символы.ПС + ВидОплаты + " " + Формат(ДатаОплаты, "ДФ=dd.MM.yy; ДП=") + Символы.ПС + "Промокод: " + СтруктураПромокод.Наименование + Символы.ПС + ТекстОшибки;
		
	Если ЗначениеЗаполнено(ТипЗаказа) Тогда
		ДопСвойство = Док.ДополнительныеРеквизиты.Добавить();
		ДопСвойство.Свойство = РеквизитТипЗаказа;
		ДопСвойство.Значение = ПолучитьЗначениеРеквизита(РеквизитТипЗаказа, ТипЗаказа);
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ОписаниеЗаказа) Тогда
		ДопСвойство = Док.ДополнительныеРеквизиты.Добавить();
		ДопСвойство.Свойство = РеквизитОписание;
		ДопСвойство.Значение = СокрЛП(ОписаниеЗаказа);
		Если СтрДлина(ОписаниеЗаказа) > 1024 Тогда
			ДопСвойство.ТекстоваяСтрока = СокрЛП(ОписаниеЗаказа);
		КонецЕсли;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Исполнитель) Тогда
		ДопСвойство = Док.ДополнительныеРеквизиты.Добавить();
		ДопСвойство.Свойство = РеквизитИсполнитель;
		ДопСвойство.Значение = ПолучитьМенеджера(Исполнитель);
	КонецЕсли;

	Док.Записать();
	
	Если Проведен Тогда
		МассивДокументовКПроведению.Добавить(Док.Ссылка);
	КонецЕсли;
	
	РСЗаказыСайта = РегистрыСведений.ЗаказыПокупателейССайта.СоздатьМенеджерЗаписи();
	РСЗаказыСайта.ЗаказПокупателя = Док.Ссылка;
	РСЗаказыСайта.ДатаЗаказаНаСайте = Дата;
	РСЗаказыСайта.НомерЗаказаНаСайте = Номер;
	РСЗаказыСайта.Записать(Истина);
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Док.Ссылка, Док.Ссылка);
	ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Заказы", УровеньЖурналаРегистрации.Информация, , Док.Ссылка, "Создан документ " + Док.Ссылка);
	//СуммаВсего = 0;
	//Пока Выборка.Следующий() Цикл
	//	Если Не ЗначениеЗаполнено(Выборка.Товар) Тогда
	//		Сообщить("Заказ № " + НоваяСтрокаДок.Номер);
	//		Сообщить("Не найдена товар " + СокрЛП(Выборка.НаименованиеПокупателя) + " с кодом покупателя " + СокрЛП(Выборка.КодПокупателя) + ", с ШК покупателя " + СокрЛП(Выборка.ШтрихКодПокупателя) + " ("  + Выборка.НомерСтрокиЗаказа+ ")");
	//	КонецЕсли;
	//	НоваяСтрока = Товары.Добавить();
	//	ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	//	СуммаВсего = СуммаВсего + Выборка.Всего;
	//КонецЦикла;
	//
	//НоваяСтрокаДок.СуммаДокумента = СуммаВсего;
КонецПроцедуры

Процедура ЗагрузитьНакладную(мДокументДОМ, МассивДокументовКПроведению)
	Перем ВариантыОбеспечения;
	
	Номер = мДокументДОМ.ПолучитьЭлементыПоИмени("Номер").Элемент(0).ТекстовоеСодержимое;
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
	НомерЗаказа = мДокументДОМ.ПолучитьЭлементыПоИмени("НомерЗаказа").Элемент(0).ТекстовоеСодержимое;
	ДатаЗаказа = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("ДатаЗаказа").Элемент(0).ТекстовоеСодержимое);
	Проведен = Булево(мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Элемент(0).ТекстовоеСодержимое);
	
	Если мДокументДОМ.ПолучитьЭлементыПоИмени("ПометкаУдаления").Количество() = 0 Тогда
		ПометкаУдаления = Ложь;
	Иначе
		ПометкаУдаления = Булево(мДокументДОМ.ПолучитьЭлементыПоИмени("ПометкаУдаления").Элемент(0).ТекстовоеСодержимое);
	КонецЕсли;

	СтруктураОрганизация = Новый Структура;
	СтруктураОрганизация.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Организация").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияИНН").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураКонтрагент = Новый Структура;
	СтруктураКонтрагент.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентИНН").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("КПП", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентКПП").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("ТиповойПокупатель", мДокументДОМ.ПолучитьЭлементыПоИмени("ТиповойПокупатель").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураКонтрагент.Вставить("ЮрАдрес", 		мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентЮрАдрес").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Адрес", 			мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентАдрес").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Телефон", 		мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентТелефон").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Почта", 			СтрЗаменить(мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентПочта").Элемент(0).ТекстовоеСодержимое, " ", ""));
	СтруктураКонтрагент.Вставить("Удостоверение", 	мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентУдостоверение").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Покупатель", 		Истина);
	СтруктураКонтрагент.Вставить("Поставщик", 		Ложь);
	
	СтруктураДоговор = Новый Структура;
	СтруктураДоговор.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураДоговор.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураДоговор.Вставить("Номер", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорНомер").Элемент(0).ТекстовоеСодержимое);
	СтруктураДоговор.Вставить("Дата", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорДата").Элемент(0).ТекстовоеСодержимое);
	СтруктураДоговор.Вставить("Вид", мДокументДОМ.ПолучитьЭлементыПоИмени("ВидДоговора").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураСклад = Новый Структура;
	СтруктураСклад.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Склад").Элемент(0).ТекстовоеСодержимое);
	СтруктураСклад.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладНаименование").Элемент(0).ТекстовоеСодержимое);
	Склад = ПолучитьСклад(СтруктураСклад);

	СтруктураПодразделение = Новый Структура;
	СтруктураПодразделение.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Подразделение").Элемент(0).ТекстовоеСодержимое);
	СтруктураПодразделение.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ПодразделениеНаименование").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураКарта = Новый Структура;
	СтруктураКарта.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Карта").Элемент(0).ТекстовоеСодержимое);
	СтруктураКарта.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("КартаНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураКарта.Вставить("Код", мДокументДОМ.ПолучитьЭлементыПоИмени("КартаКод").Элемент(0).ТекстовоеСодержимое);
	СтруктураКарта.Вставить("Заблокирована", мДокументДОМ.ПолучитьЭлементыПоИмени("Заблокирована").Элемент(0).ТекстовоеСодержимое);
	//СтруктураПромокод = Новый Структура;
	//СтруктураПромокод.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Промокод").Элемент(0).ТекстовоеСодержимое);
	//СтруктураПромокод.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ПромокодНаименование").Элемент(0).ТекстовоеСодержимое);
	
	МенеджерТекст = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Менеджер").Элемент(0).ТекстовоеСодержимое);
	
	//ОписаниеЗаказа = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Сайт").Элемент(0).ТекстовоеСодержимое);
	
	//ТипЗаказа = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Тип").Элемент(0).ТекстовоеСодержимое);
	//СтатусЗаказа = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Статус").Элемент(0).ТекстовоеСодержимое);
	//Источник = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Источник").Элемент(0).ТекстовоеСодержимое);
	АдресДоставки = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("АдресДоставки").Элемент(0).ТекстовоеСодержимое);
	//ВидОплаты = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("ВидОплаты").Элемент(0).ТекстовоеСодержимое);
	//ДатаОплаты = ПреобразоватьДату(СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("ДатаОплаты").Элемент(0).ТекстовоеСодержимое));
	
	ТЗТоваров = Новый ТаблицаЗначений;
	ТЗТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗТоваров.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	ТЗТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	ТЗТоваров.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("СуммаСкидкиОплатыБонусом", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("НомерСтрокиЗаказа", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 0)));
	
	ТЗКМ = Новый ТаблицаЗначений;
	ТЗКМ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗКМ.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗКМ.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	ТЗКМ.Колонки.Добавить("ПолныйКодМаркировки", Новый ОписаниеТипов("Строка"));
	ТЗКМ.Колонки.Добавить("ШтрихкодУпаковкиСкан", Новый ОписаниеТипов("Строка"));
	ТЗКМ.Колонки.Добавить("GTIN", Новый ОписаниеТипов("Строка"));
	
	НомерСтрокиПП = 0;
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("СтрокаТоваров") Цикл
		НомерСтрокиПП = НомерСтрокиПП + 1;
		
		СтруктураРеквизитовНоменклатуры = ПолучитьСтруктуруРеквизитовНоменклатуры(ЭлементДОМ);
		
		НоваяСтрокаТоваров = ТЗТоваров.Добавить();
		//НоваяСтрокаТоваров.ДокИД = НоваяСтрокаДок.ДокИД;
		НоваяСтрокаТоваров.НомерСтрокиЗаказа = НомерСтрокиПП;
		Если СтруктураРеквизитовНоменклатуры.Количество() <> 0 Тогда
			//НоваяСтрокаТоваров.ШтрихКодТовара = Прав("0000" + ЭлементДОМ.ПолучитьЭлементыПоИмени("PRODUCT").Элемент(0).ТекстовоеСодержимое, 13);
			НоваяСтрокаТоваров.Номенклатура = ПолучитьНоменклатуру(СтруктураРеквизитовНоменклатуры);
			НоваяСтрокаТоваров.Характеристика = ПолучитьХарактеристику(СтруктураРеквизитовНоменклатуры, НоваяСтрокаТоваров.Номенклатура);
			НоваяСтрокаТоваров.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию(СокрЛП(ЭлементДОМ.ПолучитьЭлементыПоИмени("СтавкаНДС").Элемент(0).ТекстовоеСодержимое));
		КонецЕсли;
		НоваяСтрокаТоваров.Количество = ЭлементДОМ.ПолучитьЭлементыПоИмени("Количество").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.Сумма = ЭлементДОМ.ПолучитьЭлементыПоИмени("Сумма").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.Цена = ЭлементДОМ.ПолучитьЭлементыПоИмени("Цена").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.СуммаСкидкиОплатыБонусом = ЭлементДОМ.ПолучитьЭлементыПоИмени("СуммаСписанияВелоБонусы").Элемент(0).ТекстовоеСодержимое;
	КонецЦикла;
	
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("СтрокаУпаковки") Цикл
		НомерСтрокиПП = НомерСтрокиПП + 1;
		
		СтруктураРеквизитовУпаковки = ПолучитьСтруктуруРеквизитовУпаковки(ЭлементДОМ);
		
		НоваяСтрокаТоваров = ТЗКМ.Добавить();
		//НоваяСтрокаТоваров.ДокИД = НоваяСтрокаДок.ДокИД;
		//НоваяСтрокаТоваров.НомерСтрокиЗаказа = НомерСтрокиПП;
		Если СтруктураРеквизитовУпаковки.Количество() <> 0 Тогда
			//НоваяСтрокаТоваров.ШтрихКодТовара = Прав("0000" + ЭлементДОМ.ПолучитьЭлементыПоИмени("PRODUCT").Элемент(0).ТекстовоеСодержимое, 13);
			
			ГУИД = ЭлементДОМ.ПолучитьЭлементыПоИмени("ГУИД").Элемент(0).ТекстовоеСодержимое;
			Если ПустаяСтрока(ГУИД) Или ГУИД = "00000000-0000-0000-0000-000000000000" Тогда
			Иначе
				НовыйGUID = Новый УникальныйИдентификатор(ГУИД);
				Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(НовыйGUID); 
				Если ОбщегоНазначения.СсылкаСуществует(Номенклатура) Тогда
					НоваяСтрокаТоваров.Номенклатура = Номенклатура;
				КонецЕсли;
			КонецЕсли;
			
			ГУИДХарактеристики = ЭлементДОМ.ПолучитьЭлементыПоИмени("ГУИДХарактеристики").Элемент(0).ТекстовоеСодержимое;
			Если ПустаяСтрока(ГУИДХарактеристики) Или ГУИДХарактеристики = "00000000-0000-0000-0000-000000000000" Тогда
			Иначе
				НовыйGUID = Новый УникальныйИдентификатор(ГУИДХарактеристики);
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(НовыйGUID); 
				Если ОбщегоНазначения.СсылкаСуществует(Характеристика) Тогда
					НоваяСтрокаТоваров.Характеристика = Характеристика;
				КонецЕсли;
