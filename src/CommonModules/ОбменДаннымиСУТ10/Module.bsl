Процедура ВыгрузитьЗаказНаПеремещение(ОбъектXML, СсылкаНаДокумент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Заказ.Номер КАК Номер,
	|	Заказ.Дата КАК Дата,
	|	Заказ.Проведен КАК Проведен,
	|	Заказ.Организация КАК Организация,
	|	Заказ.Организация.Наименование КАК ОрганизацияНаименование,
	|	Заказ.Организация.ИНН КАК ОрганизацияИНН,
	|	Заказ.Организация.КПП КАК ОрганизацияКПП,
	|	Заказ.Организация.ИндивидуальныйПредприниматель КАК ОрганизацияИндивидуальныйПредприниматель,
	|	Заказ.СтруктурнаяЕдиницаПолучатель КАК СкладПолучатель,
	|	Заказ.СтруктурнаяЕдиницаПолучатель.Наименование КАК СкладПолучательНаименование,
	|	Заказ.СтруктурнаяЕдиницаРезерв КАК Склад,
	|	Заказ.СтруктурнаяЕдиницаРезерв.Наименование КАК СкладНаименование,
	|	Заказ.Ответственный КАК Ответственный,
	|	Заказ.СостояниеЗаказа КАК СостояниеЗаказа,
	|	Заказ.ЗаказПокупателя.Номер КАК ЗаказПокупателяНомер,
	|	Заказ.ЗаказПокупателя.Дата КАК ЗаказПокупателяДата,
	|	ЕСТЬNULL(ЗаказыПокупателейССайта.НомерЗаказаНаСайте, """") КАК НомерЗаказаНаСайте,
	|	ЕСТЬNULL(ЗаказыПокупателейССайта.ДатаЗаказаНаСайте, &ПустаяДата) КАК ДатаЗаказаНаСайте,
	|	Заказ.Комментарий КАК Комментарий,
	|	Заказ.Запасы.(
	|		Номенклатура КАК Номенклатура,
	|		Характеристика КАК Характеристика,
	|		Резерв КАК Резерв,
	|		ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		Количество КАК Количество,
	|		СтруктурнаяЕдиницаРезерв КАК СтруктурнаяЕдиницаРезерв
	|	) КАК Запасы
	|ИЗ
	|	Документ.ЗаказНаПеремещение КАК Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыПокупателейССайта
	|		ПО Заказ.ЗаказПокупателя = ЗаказыПокупателейССайта.ЗаказПокупателя
	|ГДЕ
	|	Заказ.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаписатьТекстовойУзел(ОбъектXML, "Номер", СокрЛП(Выборка.Номер), Ложь); 
		ЗаписатьТекстовойУзел(ОбъектXML, "Дата", Формат(Выборка.Дата, "ДФ=ггггММддЧЧммсс"), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "НомерЗаказа", СокрЛП(Выборка.ЗаказПокупателяНомер), Ложь); 
		ЗаписатьТекстовойУзел(ОбъектXML, "ДатаЗаказа", Формат(Выборка.ЗаказПокупателяДата, "ДФ=ггггММддЧЧммсс"), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "НомерНаСайте", СокрЛП(Выборка.НомерЗаказаНаСайте), Ложь); 
		ЗаписатьТекстовойУзел(ОбъектXML, "ДатаНаСайте", Формат(Выборка.ДатаЗаказаНаСайте, "ДФ=ггггММддЧЧммсс"), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "Проведен", Выборка.Проведен, Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "Статус", Выборка.СостояниеЗаказа, Ложь);
		
		ЗаписатьТекстовойУзел(ОбъектXML, "Склад", XMLСтрока(Выборка.Склад), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "СкладНаименование", СокрЛП(Выборка.СкладНаименование), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "СкладПолучатель", XMLСтрока(Выборка.СкладПолучатель), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "СкладПолучательНаименование", СокрЛП(Выборка.СкладПолучательНаименование), Ложь);
		
		ВыгрузитьОрганизацию(ОбъектXML, Выборка);
		
		ЗаписатьТекстовойУзел(ОбъектXML, "Менеджер", СокрЛП(Выборка.Ответственный), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "Комментарий", СокрЛП(Выборка.Комментарий), Ложь);
		
		ВыборкаТоваров = Выборка.Запасы.Выбрать();
		Пока ВыборкаТоваров.Следующий() Цикл
			
			ОбъектXML.ЗаписатьНачалоЭлемента("СтрокаТоваров");
			
				ЗаписатьТекстовойУзел(ОбъектXML, "ГУИД", XMLСтрока(ВыборкаТоваров.Номенклатура), Ложь);
				Если ЗначениеЗаполнено(ВыборкаТоваров.Характеристика) Тогда
					ЗаписатьТекстовойУзел(ОбъектXML, "ГУИДХарактеристики", XMLСтрока(ВыборкаТоваров.Характеристика), Ложь);
				Иначе
					ЗаписатьТекстовойУзел(ОбъектXML, "ГУИДХарактеристики", "00000000-0000-0000-0000-000000000000", Ложь);
				КонецЕсли;
				
				ЗаписатьТекстовойУзел(ОбъектXML, "Количество", Формат(ВыборкаТоваров.Количество, "ЧГ=0"), Ложь);
			
			ОбъектXML.ЗаписатьКонецЭлемента();
	
		КонецЦикла;
	КонецЕсли;	

