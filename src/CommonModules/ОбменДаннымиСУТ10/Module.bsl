    Соединение = ПодключитьсяКFTPСерверу();
	
	ИмяФайла = ПолучениеФайловПоFTP(Соединение, ИмяФайлаНаFTP);
	//КонецЕсли;

	Если ПустаяСтрока(ИмяФайла) Тогда
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Заказы", УровеньЖурналаРегистрации.Предупреждение, , , "Файл не найден");
