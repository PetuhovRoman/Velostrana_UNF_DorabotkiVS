Функция ПолучитьПодарочныйСертификат(ГУИД, НомерСертификата, Номенклатура, Номинал, ПинКод)
	
	Если ГУИД = "00000000-0000-0000-0000-000000000000" И ПустаяСтрока(НомерСертификата) Тогда
		Возврат Справочники.СерииНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Если Не ПустаяСтрока(ГУИД) И НЕ ГУИД = "00000000-0000-0000-0000-000000000000" Тогда
		НовыйGUID = Новый УникальныйИдентификатор(ГУИД);
		Серия = Справочники.СерииНоменклатуры.ПолучитьСсылку(НовыйGUID);
		
		Если ОбщегоНазначения.СсылкаСуществует(Серия) Тогда
			Возврат Серия;
		КонецЕсли;
	КонецЕсли;
	
	НоменклатураПС = ПолучитьНоменклатуруПС(Номенклатура, Номинал);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СерииНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|ГДЕ
	|	СерииНоменклатуры.Наименование = &Наименование
	|	И СерииНоменклатуры.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Наименование", НомерСертификата);
	Запрос.УстановитьПараметр("Владелец", НоменклатураПС);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	СпрН = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	СпрН.Заполнить(Неопределено);
	Если Не ПустаяСтрока(ГУИД) Тогда
		СпрН.УстановитьСсылкуНового(Серия);
	КонецЕсли;
	СпрН.Наименование = НомерСертификата;
	СпрН.Владелец = НоменклатураПС;
	СпрН.Записать();
	
	Если ЗначениеЗаполнено(ПинКод) Тогда
		РС = РегистрыСведений.ДанныеПодарочныхСертификатов.СоздатьМенеджерЗаписи();
		РС.НомерСертификата = СпрН.Ссылка;
		РС.ПинКод = ПинКод;
		РС.Записать();
	КонецЕсли;
	
	Возврат СпрН.Ссылка;
	
КонецФункции

Функция ПолучитьНоменклатуруПС(Знач ОбразецПС, Номинал)
	
	Если Не ЗначениеЗаполнено(Номинал) Тогда
		Возврат ОбразецПС;
	КонецЕсли;
	
	Возврат ОбразецПС;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И Не Номенклатура.ПроизвольныйНоминал
	|	И Номенклатура.Номинал = &Номинал
	|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)";
	Запрос.УстановитьПараметр("Номинал", Число(Номинал));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НоменклатураПС = ОбразецПС.Скопировать();
	НоменклатураПС.Наименование = ОбразецПС.Наименование + " " + Формат(Номинал, "ЧГ=0");
	НоменклатураПС.ФиксированнаяСтоимость = Истина;
	НоменклатураПС.Номинал = Номинал;
	НоменклатураПС.ИсключитьИзПрайсЛистов = Истина;
	НоменклатураПС.ПроизвольныйНоминал = Ложь;
	НоменклатураПС.Записать();
	
	Возврат НоменклатураПС.Ссылка;
	
КонецФункции

Процедура ЗаполнитьПромокод(ДокОбъект, Промокод)
	
	ПромокодСоответствие = ПромокодыУНФ.УсловияПримененияПромокодов(Промокод);
	Если ПромокодСоответствие.Количество() = 0 Тогда
		
		УсловиеПредоставленияСкидки = Справочники.УсловияПредоставленияСкидокНаценок.НайтиПоНаименованию(Промокод, Истина);
		Если Не ЗначениеЗаполнено(УсловиеПредоставленияСкидки) Тогда
			УсловиеПромокод = Справочники.УсловияПредоставленияСкидокНаценок.СоздатьЭлемент();
			УсловиеПромокод.УсловиеПредоставления = Перечисления.УсловияПредоставленияСкидокНаценок.ЗаПромокод;
			УсловиеПромокод.Наименование = Промокод;
			УсловиеПромокод.Записать();
			УсловиеПредоставленияСкидки = УсловиеПромокод.Ссылка;
		КонецЕсли;
		
		
		Док = Документы.АктивацияПромокодов.СоздатьДокумент();
		Док.Заполнить(Неопределено); 
		Док.Дата = НачалоДня(ДокОбъект.Дата);
		Док.УсловиеПредоставленияСкидки = УсловиеПредоставленияСкидки;
		СтрокаТЧ = Док.Промокоды.Добавить();
		СтрокаТЧ.Промокод = Промокод;
		СтрокаТЧ.УсловиеПредоставленияСкидки = УсловиеПредоставленияСкидки;
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		СкидкиСпр = Справочники.АвтоматическиеСкидки.СоздатьЭлемент();
		СкидкиСпр.Заполнить(Неопределено);
		СкидкиСпр.Наименование = Промокод;
		СкидкиСпр.Действует = Ложь;
		СтрокаУсловие = СкидкиСпр.УсловияПредоставления.Добавить();
		СтрокаУсловие.УсловиеПредоставления = УсловиеПредоставленияСкидки;
		СкидкиСпр.Записать();
	Иначе
		
		УсловиеПредоставленияСкидки = ПромокодСоответствие[Промокод];
		
	КонецЕсли;
	
	СтрокаПромо = ДокОбъект.ПримененныеПромокоды.Добавить();
	СтрокаПромо.Промокод = Промокод;
	СтрокаПромо.УсловиеПредоставленияСкидки = УсловиеПредоставленияСкидки;
		
КонецПроцедуры

//РАСЧЕТ СКИДОК
Функция ЗаполнитьБонуснуюПрограмму(ТекОбъект, СтруктураПараметры)
	
	РеквизитыБП = РаботаСБонусами.РеквизитыБонуснойПрограммы(ТекОбъект.ДисконтнаяКарта);
	
	СтруктураПараметры.Вставить("БонуснаяПрограмма", РеквизитыБП.БонуснаяПрограмма);
	Возврат Истина;
	
КонецФункции

Функция ВыполнитьРасчетСкидокНаСервере(ОбъектДляРасчета, СтруктураПараметры)
	
	СтруктураПараметры.Вставить("ПрименятьКОбъекту", Ложь);
	СтруктураПараметры.Вставить("ТолькоПредварительныйРасчет", Ложь);
	СкидкиНаценкиСервер.ЗаполнитьКлючиСвязиВТабличнойЧастиТовары(ОбъектДляРасчета, "Запасы");
	
	СкидкиНаценкиСервер.ЗаполнитьКлючиСвязиВТабличнойЧастиТовары(ОбъектДляРасчета, "Запасы");
  	РасчетныеСкидки = СкидкиНаценкиСерверПереопределяемый.ВыполнитьРасчетСкидокНаСервере(ОбъектДляРасчета, СтруктураПараметры);
	Если НЕ РасчетныеСкидки.ДеревоСкидок = Неопределено И РасчетныеСкидки.ДеревоСкидок.Строки.Количество() = 0 Тогда
		РасчетныеСкидки.Вставить("НетДействующихСкидок", Истина);
  	ИначеЕсли РасчетныеСкидки.ТаблицаСкидкиНаценки.Количество() = 0
		И (НЕ РасчетныеСкидки.Свойство("ТаблицаПодарков") ИЛИ РасчетныеСкидки.ТаблицаПодарков.Количество() = 0)
		И (НЕ РасчетныеСкидки.Свойство("ТаблицаСообщений") ИЛИ РасчетныеСкидки.ТаблицаСообщений.Количество() = 0)
		И (НЕ РасчетныеСкидки.Свойство("ТаблицаБонусыКНачислению") ИЛИ РасчетныеСкидки.ТаблицаБонусыКНачислению.Количество() = 0) Тогда
		// Если есть бонусы, подарки, или собщения - то сработавшие скидки все же есть, считаем что расчет прошел штатно
		// А вот если ничего сработавшего нет - сообщим об этом, и выведем гиперссылку на настройку скидок
		РасчетныеСкидки.Вставить("НетСработавшихСкидок", Истина);
	КонецЕсли;
	
	Возврат РасчетныеСкидки;

КонецФункции 

Функция ПрименитьРассчитанныеСкидкиКОбъекту(ОбъектДляРасчета, РасчетныеСкидки, НаименованиеТЧ = "Запасы")
	
	Результат = СкидкиНаценкиСервер.ПрименитьРассчитанныеСкидкиКОбъекту(ОбъектДляРасчета, РасчетныеСкидки); 

	Возврат Результат;
	
КонецФункции

Процедура РассчитатьСкидкиНаценкиНаСервере(СтруктураПараметры, ОбъектДляРасчета)
	
	ЗаполнитьБонуснуюПрограмму(ОбъектДляРасчета, СтруктураПараметры);

	РасчетныеСкидки = ВыполнитьРасчетСкидокНаСервере(ОбъектДляРасчета, СтруктураПараметры);
	РезультатПрименения = ПрименитьРассчитанныеСкидкиКОбъекту(ОбъектДляРасчета, РасчетныеСкидки);
							
КонецПроцедуры 


Функция ЗначениеПеречисления(ИмяПеречисления, СтрЗначения)
    
    Для Каждого эл из  Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
        Если СтрЗначения = эл.Синоним Тогда 
			Сообщить(эл.Имя);
			Возврат Перечисления[ИмяПеречисления][эл.Имя];
        КонецЕсли;
    КонецЦикла;

КонецФункции // ЗначениеПеречисления()
 
Функция ПреобразоватьДату(ДатаСтрокой)
	
	Если ПустаяСтрока(ДатаСтрокой) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Возврат Дата(ДатаСтрокой);	
	
КонецФункции

Процедура ЗаписатьШапкуФайла(ОбъектXML) 
	
	ОбъектXML.ЗаписатьАтрибут("ДатаФормирования", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd'Т'ЧЧ:мм:сс"));
	
КонецПроцедуры

// Процедура проводит проверку значнеие и пишет текстовой узел в файл XML
//
// Параметры:
//  ОбъектXML - объект ЗаписьXML
//  Имя       - наименования узла
//  Значение  - текстовое значение для записи в файл
//
Процедура ЗаписатьТекстовойУзел(ОбъектXML, Имя, Значение, ОбязательнаяПроверкаНаПустуюСтроку = Истина)

	СтрокаЗаписи = Строка(Значение);
	Если ОбязательнаяПроверкаНаПустуюСтроку
		И НЕ ЗначениеЗаполнено(СтрокаЗаписи) Тогда
		
		Возврат;		
		
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		
		СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, Символы.НПП, "");
		СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, ",", ".");
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		
		Если Значение Тогда
			СтрокаЗаписи = "true";
		Иначе
			СтрокаЗаписи = "false";
		КонецЕсли;
		
	КонецЕсли;
	
	ОбъектXML.ЗаписатьНачалоЭлемента(Имя);
	ОбъектXML.ЗаписатьТекст(СтрокаЗаписи);
	ОбъектXML.ЗаписатьКонецЭлемента();

КонецПроцедуры
   
Функция ОтобратьСтрокиПоКритериям(Источник, СтруктураКритериев, СтруктураСложныхКритериев = Неопределено)

	Перем ВидСравненияСложный;

	Если СтруктураСложныхКритериев = Неопределено Тогда
		СтруктураСложныхКритериев = Новый Структура;
	КонецЕсли;

	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Источник);

	Для Каждого Критерий Из СтруктураКритериев Цикл
		НовыйОтбор = ПостроительЗапроса.Отбор.Добавить(Критерий.Ключ);

		СтруктураСложныхКритериев.Свойство(Критерий.Ключ, ВидСравненияСложный);

		Если ВидСравненияСложный = Неопределено Тогда
			НовыйОтбор.Установить(Критерий.Значение);
		Иначе
			НовыйОтбор.Использование = Истина;
			НовыйОтбор.ВидСравнения = ВидСравненияСложный;
			НовыйОтбор.Значение = Критерий.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат ПостроительЗапроса.Результат;

КонецФункции // ОтобратьСтрокиПоКритериям()
