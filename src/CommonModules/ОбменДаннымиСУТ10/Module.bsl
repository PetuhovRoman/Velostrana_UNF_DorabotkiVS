		//СтрокаОплат = Док.Предоплата.Добавить();
		//СтрокаОплат.ОплатаБонусами = Истина;
		//СтрокаОплат.Документ = Док.ДисконтнаяКарта;
		//СтрокаОплат.СуммаРасчетов = СписаноБонусов;
		//СтрокаОплат.Курс = 1;
		//СтрокаОплат.Кратность = 1;
		//СтрокаОплат.СуммаПлатежа = СписаноБонусов;
	//КонецЕсли;
	
	Если ЗначениеЗаполнено(Док.ДисконтнаяКарта) Тогда
		СтруктураПараметры = Новый Структура;
		СтруктураПараметры.Вставить("ПрименятьКОбъекту",           Ложь);
		СтруктураПараметры.Вставить("ТолькоПредварительныйРасчет", Ложь);
		СтруктураПараметры.Вставить("РабочееМесто", "");
		
		РассчитатьСкидкиНаценкиНаСервере(СтруктураПараметры, Док);
	Иначе
		Док.СкидкиРассчитаны = Истина;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
