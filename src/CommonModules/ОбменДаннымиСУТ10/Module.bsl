	Запрос.УстановитьПараметр("ДатаОстатков", Дата);

	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	ТаблицаОприходование 	= ОтобратьСтрокиПоКритериям(ТаблицаЗапроса, Новый Структура("Количество", 0), Новый Структура("Количество", ВидСравнения.Больше)).Выгрузить();
	ТаблицаСписание 		= ОтобратьСтрокиПоКритериям(ТаблицаЗапроса, Новый Структура("Количество", 0), Новый Структура("Количество", ВидСравнения.Меньше)).Выгрузить();
	
	Если ТаблицаОприходование.Количество() > 0 Или ТаблицаСписание.Количество() > 0 Тогда
		
		Док = Документы.НачислениеСписаниеБонусныхБаллов.СоздатьДокумент();
