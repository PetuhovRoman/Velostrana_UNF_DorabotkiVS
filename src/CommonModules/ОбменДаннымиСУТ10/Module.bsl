
Процедура ВыполнитьЗагрузкуОстатков() Экспорт
	
	ИмяФайлаНаFTP = "Ost10UNF.xml";
	
	Соединение = ПодключитьсяКFTPСерверу();
	
	ЗагрузитьЯчейки(Соединение);
	
	ИмяФайла = ПолучениеФайловПоFTP(Соединение, ИмяФайлаНаFTP);

	Если ПустаяСтрока(ИмяФайла) Тогда
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Остатки", УровеньЖурналаРегистрации.Предупреждение, , , "Файл не найден");
		Возврат;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Исключение
		ЧтениеXML.Закрыть();
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Остатки", УровеньЖурналаРегистрации.Ошибка, , ,  "Файл поврежден" + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	ПостроительДом = Новый ПостроительDOM();
	Попытка
		мДокументДОМ = ПостроительДом.Прочитать(ЧтениеXML);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	//НомерПринятогоСообщения = мДокументДОМ.ПолучитьЭлементыПоИмени("MessageNo").Элемент(0).ТекстовоеСодержимое;
	
	//НачатьТранзакцию();
	РегистрыСведений.ОстаткиТоваровПоставщиков.СоздатьНаборЗаписей().Записать(); //очистим остатки поставщиков	
	
	МассивДокументовКПроведению = Новый Массив;
	СтруткураДопТаблиц = ПолучитьДопТаблицы();
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("Организация") Цикл
		ЗагрузитьОстаток(ЭлементДОМ, СтруткураДопТаблиц, МассивДокументовКПроведению);
	КонецЦикла;
	
	ЗаписатьТаблицуЦен(СтруткураДопТаблиц.ТаблицаЦен, МассивДокументовКПроведению, Истина);
	
	Если МассивДокументовКПроведению.Количество() > 0 Тогда
		Для Каждого ДокументКПроведению Из МассивДокументовКПроведению Цикл
			ДокОбъект = ДокументКПроведению.ПолучитьОбъект();
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Остатки", УровеньЖурналаРегистрации.Ошибка, , ДокументКПроведению,  СокрЛП(ДокументКПроведению) + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	//ЗафиксироватьТранзакцию();
	  
	Попытка
		
		УдалитьФайлНаFTP(Соединение, ИмяФайлаНаFTP);
		
	Исключение
		ЗаписатьОшибкуВЖурнал("ЗагрузкаДанныхУТ10.Остатки", ОписаниеОшибки());
	КонецПопытки;
	
	ВыполнитьЗагрузкуБонусов();
	//// Обработка файла…
	//ИмяФайлаОтвета = "C:\data_exchange\Ord1110.xml";
	//ОбъектXML = Новый ЗаписьXML;
	//ОбъектXML.ОткрытьФайл(ИмяФайла, "UTF-8");
	//
	//ОбъектXML.ЗаписатьОбъявлениеXML();
	//ОбъектXML.ЗаписатьАтрибут("НомерПринятогоСообщения", НомерПринятогоСообщения);
	//ОбъектXML.Закрыть();
	
КонецПроцедуры

Процедура ВыполнитьЗагрузкуЗаказов() Экспорт
	
