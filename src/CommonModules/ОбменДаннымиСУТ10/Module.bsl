		Если Не ЗначениеЗаполнено(СтруктураКарта.ИД) Или СтруктураКарта.ИД = "00000000-0000-0000-0000-000000000000" Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаСгорания = ПреобразоватьДату(ЭлементДОМ.ПолучитьЭлементыПоИмени("ДатаСгорания").Элемент(0).ТекстовоеСодержимое);
		Если ЗначениеЗаполнено(ДатаСгорания) И Не ДатаСгорания > Дата Тогда
			Продолжить;
		КонецЕсли;
		
		//Попытка
		//	Контрагент = ПолучитьКонтрагента(СтруктураКонтрагент, Ложь);
