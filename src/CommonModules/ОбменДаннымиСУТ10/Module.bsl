Процедура ДобавитьДанныеПоМаркировке(Док, ТЗКМ, ИмяТЧ = "ШтрихкодыУпаковок")
	
	ОписанияНоменклатуры = ОбщегоНазначенияИС.ОписаниеНоменклатуры(ТЗКМ.ВыгрузитьКолонку("Номенклатура"));
	Для Каждого СтрокаКМ Из ТЗКМ Цикл
		Если Не ЗначениеЗаполнено(СтрокаКМ.ШтрихкодУпаковки) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТЧ = Док[ИмяТЧ].Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаКМ);
		
		Если НоменклатураВДокументахКлиентСервер.ЕстьРеквизитОбъекта("КлючСвязи", СтрокаТЧ) Тогда
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("Номенклатура", СтрокаКМ.Номенклатура);
			ОтборСтрок.Вставить("Характеристика", СтрокаКМ.Характеристика);
			МассивСтрок = Док.Запасы.НайтиСтроки(ОтборСтрок);
			Если МассивСтрок.Количество() > 0 Тогда
				СтрокаТЧ.КлючСвязи = МассивСтрок[0].КлючСвязи;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЧ.ШтрихкодУпаковки) Тогда
			//ТекстОшибки = ТекстОшибки + "Не найден код маркировки " + Символы.ПС;
		Иначе
			ОписаниеНоменклатуры = ОписанияНоменклатуры[СтрокаКМ.Номенклатура];
			
			МенеджерЗаписиКМ = РегистрыСведений.ПулКодовМаркировкиСУЗ.СоздатьМенеджерЗаписи();
			//МенеджерЗаписиКМ.ВидКИЗ = Перечисления.ВидыКиЗГИСМ.Навесной;
			МенеджерЗаписиКМ.ТоварнаяГруппа = КонструкторИСМПОбщегоНазначенияКлиентСервер.ТоварнаяГруппаПоВидуПродукции(ОписаниеНоменклатуры.КлючВидовПродукции.ВидПродукцииГИСМТ);
			Если ЗначениеЗаполнено(МенеджерЗаписиКМ.ТоварнаяГруппа) Тогда
				МенеджерЗаписиКМ.Шаблон = ИнтеграцияИСМПКлиентСервер.ШаблонКодаМаркировкиПоВидуПродукции(МенеджерЗаписиКМ.ТоварнаяГруппа);
			КонецЕсли;
			//МенеджерЗаписиКМ.СпособВводаВОборот = Перечисления.СпособыВводаВОборотСУЗ.Импорт;
			МенеджерЗаписиКМ.ХешСуммаКодаМаркировки = СтрокаТЧ.ШтрихкодУпаковки.ХешСуммаЗначенияШтрихкода;
			МенеджерЗаписиКМ.КодМаркировки = СтрокаТЧ.ШтрихкодУпаковки.ЗначениеШтрихкода;
			МенеджерЗаписиКМ.Номенклатура = СтрокаКМ.Номенклатура; 
			МенеджерЗаписиКМ.Характеристика = СтрокаКМ.Характеристика;
			МенеджерЗаписиКМ.Организация = Док.Организация;
			МенеджерЗаписиКМ.ПолныйКодМаркировки = СтрокаКМ.ПолныйКодМаркировки;
			//МенеджерЗаписиКМ.Статус = Перечисления.СтатусыКодовМаркировкиСУЗ.Сгенерирован;
			МенеджерЗаписиКМ.ШтрихкодУпаковки = СтрокаКМ.ШтрихкодУпаковки;
			МенеджерЗаписиКМ.GTIN = СтрокаКМ.GTIN;
			МенеджерЗаписиКМ.ТипШтрихкода = СтрокаКМ.ШтрихкодУпаковки.ТипШтрихкода;
			МенеджерЗаписиКМ.ДатаПечатиУниверсальная = Док.Дата;
			МенеджерЗаписиКМ.Записать(Истина);
		КонецЕсли;
	КонецЦикла;
