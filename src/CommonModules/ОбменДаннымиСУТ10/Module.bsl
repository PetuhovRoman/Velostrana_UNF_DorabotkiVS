		СуммаОплатыБонусами = Док.Запасы.Итог("СуммаСкидкиОплатыБонусом");
		
		Если СуммаОплатыБонусамиЗаказ > 0 Тогда
			НоваяСтрокаОплат = Док.Предоплата.Добавить();
			НоваяСтрокаОплат.ОплатаБонусами = Истина;
