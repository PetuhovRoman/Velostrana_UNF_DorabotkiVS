	КонецПопытки;
	
	//Если НомерПринятогоСообщения <> 0 Тогда
	//	// Обработка файла… 
	//	ИмяФайлаОтветаНаFTP = "BonusUNF10.xml";

	//	ИмяФайлаОтвета = КаталогВременныхФайлов() + "\BonusUNF10.xml";
	//	ОбъектXML = Новый ЗаписьXML;
	//	ОбъектXML.ОткрытьФайл(ИмяФайлаОтвета, "UTF-8");
	//	
	//	ОбъектXML.ЗаписатьОбъявлениеXML();
	//	//ОбъектXML.ЗаписатьАтрибут("НомерПринятогоСообщения", НомерПринятогоСообщения);
	//	ЗаписатьТекстовойУзел(ОбъектXML, "НомерПринятогоСообщения", НомерПринятогоСообщения, Ложь);
	//	ОбъектXML.Закрыть();
	//	
	//	ПередачаФайловПоFTP(Соединение, ИмяФайлаОтветаНаFTP, ИмяФайлаОтвета);
	//	
	//КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьОстаток(мДокументДОМ, СтруктураДопТаблиц, МассивДокументовКПроведению)
	
	//НоваяСтрокаДок = СписокДокументовЗаказы.Добавить();
	
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
		
	//НоваяСтрокаДок.АдресДоставки = ПолучитьАдресДоставки(мДокументДОМ.ПолучитьЭлементыПоИмени("DELIVERYPLACE").Элемент(0).ТекстовоеСодержимое);
	//ГЛНТочкиДоставки = мДокументДОМ.ПолучитьЭлементыПоИмени("DELIVERYPLACE").Элемент(0).ТекстовоеСодержимое;
	//НоваяСтрокаДок.АдресСтрокой = мДокументДОМ.ПолучитьЭлементыПоИмени("ConsigneeAddr").Элемент(0).ТекстовоеСодержимое;
	//НоваяСтрокаДок.ДокИД = ИмяФайла;//мДокументДОМ.ПолучитьЭлементыПоИмени("DocID").Элемент(0).ТекстовоеСодержимое;
	СтруктураОрганизация = Новый Структура;
	СтруктураОрганизация.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияГУИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияИНН").Элемент(0).ТекстовоеСодержимое);
	Организация = ПолучитьОрганизацию(СтруктураОрганизация);
	
	СтруктураСклад = Новый Структура;
	СтруктураСклад.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладГУИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураСклад.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураСклад.Вставить("СкладПоставщика", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладПоставщика").Элемент(0).ТекстовоеСодержимое);
	Склад = ПолучитьСклад(СтруктураСклад);
	
	//СтруктураПодразделение = Новый Структура;
	//СтруктураПодразделение.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Подразделение").Элемент(0).ТекстовоеСодержимое);
	//СтруктураПодразделение.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ПодразделениеНаименование").Элемент(0).ТекстовоеСодержимое);
	
	ТЗТоваров = Новый ТаблицаЗначений;
	ТЗТоваров.Колонки.Добавить("СтруктурнаяЕдиница", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	ТЗТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗТоваров.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
	ТЗТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗТоваров.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	ТЗТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	//ТЗТоваров.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("ЦенаУчетная", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	//ТЗТоваров.Колонки.Добавить("ДокИД", ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(100));

	НомерСтрокиПП = 0;
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("Остаток") Цикл
		НачатьТранзакцию();
		
		НомерСтрокиПП = НомерСтрокиПП + 1;
	
		СтруктураРеквизитовНоменклатуры = ПолучитьСтруктуруРеквизитовНоменклатуры(ЭлементДОМ);
		
		Товар = ПолучитьНоменклатуру(СтруктураРеквизитовНоменклатуры);
		
		Если Не ЗначениеЗаполнено(Товар) Тогда
			ОтменитьТранзакцию();
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаТоваров = ТЗТоваров.Добавить();
		НоваяСтрокаТоваров.СтруктурнаяЕдиница = Склад;

		Если СтруктураРеквизитовНоменклатуры.Количество() <> 0 Тогда
			НоваяСтрокаТоваров.Артикул = СтруктураРеквизитовНоменклатуры.Артикул;
			НоваяСтрокаТоваров.Номенклатура = Товар;
			НоваяСтрокаТоваров.Характеристика = ПолучитьХарактеристику(СтруктураРеквизитовНоменклатуры, НоваяСтрокаТоваров.Номенклатура); 
			
			Если ЭлементДОМ.ПолучитьЭлементыПоИмени("СтавкаНДС").Количество() > 0 Тогда
				НоваяСтрокаТоваров.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию(СокрЛП(ЭлементДОМ.ПолучитьЭлементыПоИмени("СтавкаНДС").Элемент(0).ТекстовоеСодержимое));
			Иначе
				НоваяСтрокаТоваров.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДСПоПеречислениюСтавкиНДС(НоваяСтрокаТоваров.Номенклатура.ВидСтавкиНДС);
			КонецЕсли;
		КонецЕсли;
		НоваяСтрокаТоваров.Количество = ЭлементДОМ.ПолучитьЭлементыПоИмени("Количество").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.Цена = ЭлементДОМ.ПолучитьЭлементыПоИмени("Цена").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.ЦенаУчетная = ЭлементДОМ.ПолучитьЭлементыПоИмени("ЦенаУчетная").Элемент(0).ТекстовоеСодержимое;
		//ЭлементЦенаБезНДС = ЭлементДОМ.ПолучитьЭлементыПоИмени("ORDERPRICE");
		//Если ЭлементЦена2.Количество() > 0 Тогда
		//	НоваяСтрокаТоваров.Цена = ЭлементЦенаБезНДС[0].ТекстовоеСодержимое;
		//Иначе
		//	СтавкаНДС = обПолучитьСтавкуНДСТовара(ДанныеСтроки.Товар, ДатаДок);
		//	НоваяСтрокаТоваров.Цена = НоваяСтрокаТоваров.ЦенаБезНДС + НоваяСтрокаТоваров.ЦенаБезНДС * СтавкаНДС / 100;
		//КонецЕсли;
		Если ЗначениеЗаполнено(НоваяСтрокаТоваров.Номенклатура) И СтруктураРеквизитовНоменклатуры.Свойство("Штрихкод") И ЗначениеЗаполнено(СтруктураРеквизитовНоменклатуры.Штрихкод) Тогда
			
			РСШК = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
			РСШК.Номенклатура = НоваяСтрокаТоваров.Номенклатура;
			РСШК.Характеристика = НоваяСтрокаТоваров.Характеристика;
			РСШК.Штрихкод = СтруктураРеквизитовНоменклатуры.Штрихкод;
			//РСШК. = Спрх.Ссылка;
			РСШК.Записать(Истина);
			
		КонецЕсли;
		Если ЗначениеЗаполнено(НоваяСтрокаТоваров.Номенклатура) И СтруктураДопТаблиц.ТаблицаЦен.Найти(НоваяСтрокаТоваров.Номенклатура) = Неопределено Тогда
			Если СтруктураРеквизитовНоменклатуры.Свойство("Цена") И ЗначениеЗаполнено(СтруктураРеквизитовНоменклатуры.Цена) Тогда
				СтрокаТаблицыЗначений = СтруктураДопТаблиц.ТаблицаЦен.Добавить();
				СтрокаТаблицыЗначений.Период = Дата; 
				СтрокаТаблицыЗначений.ВидЦены = Справочники.ВидыЦен.Оптовая;
				СтрокаТаблицыЗначений.Номенклатура = НоваяСтрокаТоваров.Номенклатура;
				СтрокаТаблицыЗначений.Характеристика = НоваяСтрокаТоваров.Характеристика;
				СтрокаТаблицыЗначений.Цена    = НоваяСтрокаТоваров.Цена;
			КонецЕсли;
			
			СтрокаТаблицыЗначений = СтруктураДопТаблиц.ТаблицаЦен.Добавить();
			СтрокаТаблицыЗначений.Период = Дата; 
			СтрокаТаблицыЗначений.ВидЦены = Справочники.ВидыЦен.Учетная;
			СтрокаТаблицыЗначений.Номенклатура = НоваяСтрокаТоваров.Номенклатура;
			СтрокаТаблицыЗначений.Характеристика = НоваяСтрокаТоваров.Характеристика;
			СтрокаТаблицыЗначений.Цена    = НоваяСтрокаТоваров.ЦенаУчетная; 
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Склад) 
			И Булево(СтруктураСклад.СкладПоставщика) 
			И ЭлементДОМ.ПолучитьЭлементыПоИмени("Контрагент").Количество() > 0 Тогда
			
			СтруктураКонтрагент = Новый Структура;
			СтруктураКонтрагент.Вставить("ИД", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентИД").Элемент(0).ТекстовоеСодержимое);
			СтруктураКонтрагент.Вставить("Тип", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентТип").Элемент(0).ТекстовоеСодержимое);
			СтруктураКонтрагент.Вставить("Наименование", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентНаименование").Элемент(0).ТекстовоеСодержимое);
			СтруктураКонтрагент.Вставить("ИНН", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентИНН").Элемент(0).ТекстовоеСодержимое);
			СтруктураКонтрагент.Вставить("КПП", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентКПП").Элемент(0).ТекстовоеСодержимое);
			СтруктураКонтрагент.Вставить("ТиповойПокупатель", ЭлементДОМ.ПолучитьЭлементыПоИмени("ТиповойПокупатель").Элемент(0).ТекстовоеСодержимое);
			
			СтруктураКонтрагент.Вставить("ЮрАдрес", 		ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентЮрАдрес").Элемент(0).ТекстовоеСодержимое);
			СтруктураКонтрагент.Вставить("Адрес", 			ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентАдрес").Элемент(0).ТекстовоеСодержимое);
			СтруктураКонтрагент.Вставить("Телефон", 		ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентТелефон").Элемент(0).ТекстовоеСодержимое);
			СтруктураКонтрагент.Вставить("Почта", 			СтрЗаменить(ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентПочта").Элемент(0).ТекстовоеСодержимое, " ", ""));
			СтруктураКонтрагент.Вставить("Удостоверение", 	ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентУдостоверение").Элемент(0).ТекстовоеСодержимое);
			СтруктураКонтрагент.Вставить("Покупатель", 		Ложь);
			СтруктураКонтрагент.Вставить("Поставщик", 		Истина);
			
			РСОстатки = РегистрыСведений.ОстаткиТоваровПоставщиков.СоздатьМенеджерЗаписи();
			РСОстатки.НоменклатураПоставщика = ПолучитьНоменклатуруПоставщика(НоваяСтрокаТоваров.Номенклатура, НоваяСтрокаТоваров.Характеристика, СтруктураКонтрагент);
			РСОстатки.Количество = НоваяСтрокаТоваров.Количество;
			РСОстатки.Записать(Истина);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.ЦенаУчетная КАК ЦенаУчетная,
	|	ТаблицаТоваров.Цена КАК Цена,
	|	ТаблицаТоваров.Количество КАК Количество
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТЗТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ВложенныйЗапрос.ЦенаУчетная) КАК ЦенаУчетная,
	|	МАКСИМУМ(ВложенныйЗапрос.Цена) КАК Цена,
	|	СУММА(ЕСТЬNULL(ВложенныйЗапрос.Количество, 0)) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|		ТаблицаТоваров.Характеристика КАК Характеристика,
	|		ТаблицаТоваров.ЦенаУчетная КАК ЦенаУчетная,
	|		ТаблицаТоваров.Цена КАК Цена,
	|		ТаблицаТоваров.Количество КАК Количество
	|	ИЗ
	|		ТаблицаТоваров КАК ТаблицаТоваров
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЗапасыНаСкладахОстатки.Номенклатура,
	|		ЗапасыНаСкладахОстатки.Характеристика,
	|		ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 1),
	|		0,
	|		-ЗапасыНаСкладахОстатки.КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.ЗапасыНаСкладах.Остатки(
	|				,
	|				Организация = &Организация
	|					И СтруктурнаяЕдиница = &Склад) КАК ЗапасыНаСкладахОстатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦен = ЗНАЧЕНИЕ(Справочник.ВидыЦен.Учетная)) КАК ЦеныНоменклатурыСрезПоследних
	|			ПО ЗапасыНаСкладахОстатки.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|				И (ВЫБОР
	|					КОГДА ЗапасыНаСкладахОстатки.Номенклатура.ИспользоватьХарактеристики
	|						ТОГДА ЗапасыНаСкладахОстатки.Характеристика = ЦеныНоменклатурыСрезПоследних.Характеристика
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ)) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Характеристика,
	|	ВложенныйЗапрос.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	СУММА(ЕСТЬNULL(ВложенныйЗапрос.Количество, 0)) <> 0";
	Запрос.УстановитьПараметр("ТЗТоваров", ТЗТоваров);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	ТаблицаОприходование 	= ОтобратьСтрокиПоКритериям(ТаблицаЗапроса, Новый Структура("Количество", 0), Новый Структура("Количество", ВидСравнения.Больше)).Выгрузить();
	ТаблицаСписание 		= ОтобратьСтрокиПоКритериям(ТаблицаЗапроса, Новый Структура("Количество", 0), Новый Структура("Количество", ВидСравнения.Меньше)).Выгрузить();
	
	//НачатьТранзакцию();
	Если ТаблицаОприходование.Количество() > 0 Тогда
		Док = Документы.ОприходованиеЗапасов.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Заполнить(Неопределено);
		Док.Организация = Организация;
		Док.СтруктурнаяЕдиница = Склад;
		Док.ХозяйственнаяОперация = Справочники.ХозяйственныеОперации.ОприходованиеЗапасов;
		Док.Корреспонденция = ПланыСчетов.Управленческий.ПрочиеДоходы;
		
		ТекстОшибки = "";
		Для Каждого СтрокаТЗ Из ТаблицаОприходование Цикл
			
			СтрокаТЧ = Док.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
			Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
				ТекстОшибки = ТекстОшибки + "Не найдена номенклатура " + Символы.ПС;
			КонецЕсли;
			Если СтрокаТЗ.ЦенаУчетная = 0 Тогда
				СтрокаТЧ.Цена = СтрокаТЗ.Цена;
			Иначе
				СтрокаТЧ.Цена = СтрокаТЗ.ЦенаУчетная; 
			КонецЕсли;
			СтрокаТЧ.ЕдиницаИзмерения = СтрокаТЧ.Номенклатура.ЕдиницаИзмерения;
			//СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТЧ.СтавкаНДС);
			
			СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
			//СтрокаТЧ.СуммаНДС = СтрокаТЧ.Сумма - (СтрокаТЧ.Сумма) / ((СтавкаНДС + 100) / 100);
			//СтрокаТЧ.СуммаБезНДС = СтрокаТЧ.Сумма - СтрокаТЧ.СуммаНДС;
			
			
		КонецЦикла;
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "Ошибок нет";	
		КонецЕсли;	
		Док.Комментарий = "#Загружен из УТ10 " + Символы.ПС + ТекстОшибки;
		
		Док.Записать(РежимЗаписиДокумента.Запись);
		МассивДокументовКПроведению.Добавить(Док.Ссылка);
		
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Остатки", УровеньЖурналаРегистрации.Информация, , Док.Ссылка, "Создан документ " + Док.Ссылка);
	КонецЕсли;
	
	Если ТаблицаСписание.Количество() > 0 Тогда
		Док = Документы.СписаниеЗапасов.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Заполнить(Неопределено);
		Док.Организация = Организация;
		Док.СтруктурнаяЕдиница = Склад;
		Док.ХозяйственнаяОперация = Справочники.ХозяйственныеОперации.СписаниеЗапасов;
		Док.Корреспонденция = ПланыСчетов.Управленческий.НедостачиИПотериОтПорчиЦенностей;
		ТекстОшибки = "";
		Для Каждого СтрокаТЗ Из ТаблицаСписание Цикл
			
			СтрокаТЧ = Док.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
			Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
				ТекстОшибки = ТекстОшибки + "Не найдена номенклатура " + Символы.ПС;
			КонецЕсли;
			СтрокаТЧ.Количество = -СтрокаТЗ.Количество;
			//СтрокаТЧ.Цена = СтрокаТЗ.ЦенаУчетная;
			СтрокаТЧ.ЕдиницаИзмерения = СтрокаТЧ.Номенклатура.ЕдиницаИзмерения;
			//СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТЧ.СтавкаНДС);
			
			//СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
			//СтрокаТЧ.СуммаНДС = СтрокаТЧ.Сумма - (СтрокаТЧ.Сумма) / ((СтавкаНДС + 100) / 100);
			//СтрокаТЧ.СуммаБезНДС = СтрокаТЧ.Сумма - СтрокаТЧ.СуммаНДС;
			
			
		КонецЦикла;
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "Ошибок нет";	
		КонецЕсли;	
		Док.Комментарий = "#Загружен из УТ10 " + Символы.ПС + ТекстОшибки;
		
		Док.Записать(РежимЗаписиДокумента.Запись);
		МассивДокументовКПроведению.Добавить(Док.Ссылка);
		
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Остатки", УровеньЖурналаРегистрации.Информация, , Док.Ссылка, "Создан документ " + Док.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьБонусы(мДокументДОМ)
	
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
	
	ТЗБонусов = Новый ТаблицаЗначений;
	ТЗБонусов.Колонки.Добавить("БонуснаяКарта", Новый ОписаниеТипов("СправочникСсылка.ДисконтныеКарты"));
	ТЗБонусов.Колонки.Добавить("Количество", 	Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	ТЗБонусов.Колонки.Добавить("ДатаНачисления",Новый ОписаниеТипов("Дата"));
	ТЗБонусов.Колонки.Добавить("ДатаСгорания",	Новый ОписаниеТипов("Дата"));
	
	НомерСтрокиПП = 0;
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("ОстатокБонусов") Цикл
		
		НомерСтрокиПП = НомерСтрокиПП + 1;
		
		СтруктураКонтрагент = Новый Структура;
		СтруктураКонтрагент.Вставить("ИД", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентИД").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Тип", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентТип").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Наименование", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентНаименование").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("ИНН", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентИНН").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("КПП", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентКПП").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("ТиповойПокупатель", ЭлементДОМ.ПолучитьЭлементыПоИмени("ТиповойПокупатель").Элемент(0).ТекстовоеСодержимое);
		
		СтруктураКонтрагент.Вставить("ЮрАдрес", 		ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентЮрАдрес").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Адрес", 			ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентАдрес").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Телефон", 		ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентТелефон").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Почта", 			СтрЗаменить(ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентПочта").Элемент(0).ТекстовоеСодержимое, " ", ""));
		СтруктураКонтрагент.Вставить("Удостоверение", 	ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентУдостоверение").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Покупатель", 		Истина);
		СтруктураКонтрагент.Вставить("Поставщик", 		Ложь);
		
		СтруктураКарта = Новый Структура;
		СтруктураКарта.Вставить("ИД", ЭлементДОМ.ПолучитьЭлементыПоИмени("Карта").Элемент(0).ТекстовоеСодержимое);
		СтруктураКарта.Вставить("Наименование", ЭлементДОМ.ПолучитьЭлементыПоИмени("КартаНаименование").Элемент(0).ТекстовоеСодержимое);
		СтруктураКарта.Вставить("Код", ЭлементДОМ.ПолучитьЭлементыПоИмени("КартаКод").Элемент(0).ТекстовоеСодержимое);
		СтруктураКарта.Вставить("Заблокирована", ЭлементДОМ.ПолучитьЭлементыПоИмени("Заблокирована").Элемент(0).ТекстовоеСодержимое);
		
		Контрагент = ПолучитьКонтрагента(СтруктураКонтрагент);
		ДисконтнаяКарта = ПолучитьКарту(СтруктураКарта, Контрагент);
		Если Не ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
			Продолжить;
		КонецЕсли;
		
			НоваяСтрокаБонусов = ТЗБонусов.Добавить();
			НоваяСтрокаБонусов.БонуснаяКарта = ДисконтнаяКарта;
			НоваяСтрокаБонусов.Количество = ЭлементДОМ.ПолучитьЭлементыПоИмени("Количество").Элемент(0).ТекстовоеСодержимое;
			НоваяСтрокаБонусов.ДатаНачисления = ПреобразоватьДату(ЭлементДОМ.ПолучитьЭлементыПоИмени("ДатаНачисления").Элемент(0).ТекстовоеСодержимое);
			НоваяСтрокаБонусов.ДатаСгорания = ПреобразоватьДату(ЭлементДОМ.ПолучитьЭлементыПоИмени("ДатаСгорания").Элемент(0).ТекстовоеСодержимое);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаБонусов.БонуснаяКарта КАК БонуснаяКарта,
	|	ТаблицаБонусов.ДатаНачисления КАК ДатаНачисления,
	|	ТаблицаБонусов.ДатаСгорания КАК ДатаСгорания,
	|	ТаблицаБонусов.Количество КАК Количество
	|ПОМЕСТИТЬ ТаблицаБонусов
	|ИЗ
	|	&ТЗБонусов КАК ТаблицаБонусов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.БонуснаяКарта КАК БонуснаяКарта,
	|	МАКСИМУМ(ВложенныйЗапрос.ДатаНачисления) КАК ДатаНачисления,
	|	МАКСИМУМ(ВложенныйЗапрос.ДатаСгорания) КАК ДатаСгорания,
	|	СУММА(ЕСТЬNULL(ВложенныйЗапрос.Количество, 0)) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаБонусов.БонуснаяКарта КАК БонуснаяКарта,
	|		ТаблицаБонусов.Количество КАК Количество,
	|		ТаблицаБонусов.ДатаНачисления КАК ДатаНачисления,
	|		ТаблицаБонусов.ДатаСгорания КАК ДатаСгорания
	|	ИЗ
	|		ТаблицаБонусов КАК ТаблицаБонусов
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		БонусныеБаллыОстатки.БонуснаяКарта,
	|		-БонусныеБаллыОстатки.НачисленоОстаток,
	|		&ПустаяДата,
	|		&ПустаяДата
	|	ИЗ
	|		РегистрНакопления.БонусныеБаллы.Остатки(
	|				,
	|				БонуснаяКарта В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ТаблицаБонусов.БонуснаяКарта
	|					ИЗ
	|						ТаблицаБонусов)) КАК БонусныеБаллыОстатки) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.БонуснаяКарта
	|
	|ИМЕЮЩИЕ
	|	СУММА(ЕСТЬNULL(ВложенныйЗапрос.Количество, 0)) <> 0";
	Запрос.УстановитьПараметр("ТЗБонусов", ТЗБонусов);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	ТаблицаОприходование 	= ОтобратьСтрокиПоКритериям(ТаблицаЗапроса, Новый Структура("Количество", 0), Новый Структура("Количество", ВидСравнения.Больше)).Выгрузить();
	ТаблицаСписание 		= ОтобратьСтрокиПоКритериям(ТаблицаЗапроса, Новый Структура("Количество", 0), Новый Структура("Количество", ВидСравнения.Меньше)).Выгрузить();
	
	Если ТаблицаОприходование.Количество() > 0 Или ТаблицаСписание.Количество() > 0 Тогда
		
		Док = Документы.НачислениеСписаниеБонусныхБаллов.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Заполнить(Неопределено);
		Док.БонуснаяПрограмма = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.БонусныеПрограммы?ref=bab1000c29e80aa411f03c7267ec46b6"); 
		
		Для Каждого СтрокаТЗ Из ТаблицаОприходование Цикл
			
			СтрокаТЧ = Док.НачисленияБонусов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
			
		КонецЦикла;
		
		Для Каждого СтрокаТЗ Из ТаблицаСписание Цикл
			
			СтрокаТЧ = Док.СписанияБонусов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
			СтрокаТЧ.Количество = -СтрокаТЗ.Количество;			
			
		КонецЦикла;
		Док.Автор = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
		
		Док.Комментарий = "#Загружен из УТ10 ";
		
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Бонусы", УровеньЖурналаРегистрации.Информация, , Док.Ссылка, "Создан документ " + Док.Ссылка);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ЗагрузитьБонусыОстатки(мДокументДОМ)
	
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
	
	РегистрыСведений.ЗагрузкаБонусовВременный.СоздатьНаборЗаписей().Записать();
	
	//ТЗБонусов = Новый ТаблицаЗначений;
	//ТЗБонусов.Колонки.Добавить("БонуснаяКарта", Новый ОписаниеТипов("СправочникСсылка.ДисконтныеКарты"));
	//ТЗБонусов.Колонки.Добавить("Количество", 	Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	//ТЗБонусов.Колонки.Добавить("ДатаНачисления",Новый ОписаниеТипов("Дата"));
	//ТЗБонусов.Колонки.Добавить("ДатаСгорания",	Новый ОписаниеТипов("Дата"));
	
	НомерСтрокиПП = 0;
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("Остаток") Цикл
		
		НомерСтрокиПП = НомерСтрокиПП + 1;
		
		СтруктураКонтрагент = Новый Структура;
		СтруктураКонтрагент.Вставить("ИД", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентИД").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Тип", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентТип").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Наименование", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентНаименование").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("ИНН", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентИНН").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("КПП", ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентКПП").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("ТиповойПокупатель", ЭлементДОМ.ПолучитьЭлементыПоИмени("ТиповойПокупатель").Элемент(0).ТекстовоеСодержимое);
		
		СтруктураКонтрагент.Вставить("ЮрАдрес", 		ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентЮрАдрес").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Адрес", 			ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентАдрес").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Телефон", 		ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентТелефон").Элемент(0).ТекстовоеСодержимое);
		СтруктураКонтрагент.Вставить("Почта", 			СтрЗаменить(ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентПочта").Элемент(0).ТекстовоеСодержимое, " ", ""));
		СтруктураКонтрагент.Вставить("Удостоверение", 	ЭлементДОМ.ПолучитьЭлементыПоИмени("КонтрагентУдостоверение").Элемент(0).ТекстовоеСодержимое);
