	Если МассивДокументовКПроведению.Количество() > 0 Тогда
		Для Каждого ДокументКПроведению Из МассивДокументовКПроведению Цикл
			ДокОбъект = ДокументКПроведению.ПолучитьОбъект();
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.ЦеныНоменклатуры", УровеньЖурналаРегистрации.Ошибка, , ДокументКПроведению,  СокрЛП(ДокументКПроведению) + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.ЦеныНоменклатуры", УровеньЖурналаРегистрации.Информация, , , "Загружено и проведено Цены номенклатуры " + МассивДокументовКПроведению.Количество());
	КонецЕсли;

	//БОНУСЫ
	//Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("Бонусы") Цикл
	//	ЗагрузитьБонусы(ЭлементДОМ);
	//КонецЦикла;
	
	Попытка
		
		УдалитьФайлНаFTP(Соединение, ИмяФайлаНаFTP);
		
	Исключение
		
		ЗаписатьОшибкуВЖурнал("ЗагрузкаДанныхУТ10.Заказы", ОписаниеОшибки());
	КонецПопытки;
	
	//Если НомерПолученногоСообщения <> 0 Тогда
		// Обработка файла… 
		ВыгрузитьДанные(НомерПолученногоСообщения, Соединение, ПланОбменаУТ);
	//КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьЯчейки(Соединение) Экспорт
	
	ИмяФайлаНаFTP = "Cell10UNF.xml";
	ИмяФайла = ПолучениеФайловПоFTP(Соединение, ИмяФайлаНаFTP);
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Ячейки", УровеньЖурналаРегистрации.Предупреждение, , , "Файл не найден");
		Возврат;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Исключение
		ЧтениеXML.Закрыть();
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Ячейки", УровеньЖурналаРегистрации.Ошибка, , ,  "Файл поврежден" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ПостроительДом = Новый ПостроительDOM();
	Попытка
		мДокументДОМ = ПостроительДом.Прочитать(ЧтениеXML);
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Ячейки", УровеньЖурналаРегистрации.Ошибка, , ,  "Файл не прочитан" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	НачатьТранзакцию();
	
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("Ячейка") Цикл
		//ЗаписатьТекстовойУзел(ОбъектXML, "ЯчейкаИД", XMLСтрока(Выборка.Ячейка), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "ЯчейкаНаименование", СокрЛП(Выборка.Наименование), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "ЯчейкаКод", СокрЛП(Выборка.Код), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "ЯчейкаРодитель", СокрЛП(Выборка.Родитель), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "ЯчейкаРодительИД", XMLСтрока(Выборка.Родитель), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "ЭтоГруппа", Выборка.ЭтоГруппа, Ложь);
		//
		//ЗаписатьТекстовойУзел(ОбъектXML, "Секция", СокрЛП(Выборка.Секция), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "Линия", СокрЛП(Выборка.Линия), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "Стеллаж", СокрЛП(Выборка.Стеллаж), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "Ярус", СокрЛП(Выборка.Ярус), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "Позиция", СокрЛП(Выборка.Позиция), Ложь);
		ЯчейкаИД = 					ЭлементДОМ.ПолучитьЭлементыПоИмени("ЯчейкаИД").Элемент(0).ТекстовоеСодержимое;
		ЯчейкаНаименование = 		ЭлементДОМ.ПолучитьЭлементыПоИмени("ЯчейкаНаименование").Элемент(0).ТекстовоеСодержимое;
		ЯчейкаКод = 				ЭлементДОМ.ПолучитьЭлементыПоИмени("ЯчейкаКод").Элемент(0).ТекстовоеСодержимое;
		ЯчейкаРодительНаименование =ЭлементДОМ.ПолучитьЭлементыПоИмени("ЯчейкаРодитель").Элемент(0).ТекстовоеСодержимое;
		ЯчейкаРодительИД = 			ЭлементДОМ.ПолучитьЭлементыПоИмени("ЯчейкаРодительИД").Элемент(0).ТекстовоеСодержимое;
		ЭтоГруппа = 				Булево(ЭлементДОМ.ПолучитьЭлементыПоИмени("ЭтоГруппа").Элемент(0).ТекстовоеСодержимое);
		
		СтруктураЯчейки = Новый Структура();
		СтруктураЯчейки.Вставить("Секция", 	ЭлементДОМ.ПолучитьЭлементыПоИмени("Секция").Элемент(0).ТекстовоеСодержимое);
		СтруктураЯчейки.Вставить("Линия", 	ЭлементДОМ.ПолучитьЭлементыПоИмени("Линия").Элемент(0).ТекстовоеСодержимое);
		СтруктураЯчейки.Вставить("Стеллаж", ЭлементДОМ.ПолучитьЭлементыПоИмени("Стеллаж").Элемент(0).ТекстовоеСодержимое);
		СтруктураЯчейки.Вставить("Ярус", 	ЭлементДОМ.ПолучитьЭлементыПоИмени("Ярус").Элемент(0).ТекстовоеСодержимое);
		СтруктураЯчейки.Вставить("Позиция", ЭлементДОМ.ПолучитьЭлементыПоИмени("Позиция").Элемент(0).ТекстовоеСодержимое);
		
		Если Не ПустаяСтрока(ЯчейкаРодительИД) И НЕ ЯчейкаРодительИД = "00000000-0000-0000-0000-000000000000" Тогда
			НовыйGUIDРодитель = Новый УникальныйИдентификатор(ЯчейкаРодительИД);
			ЯчейкаРодитель = Справочники.Ячейки.ПолучитьСсылку(НовыйGUIDРодитель);
		Иначе
			ЯчейкаРодитель = Справочники.Ячейки.ПустаяСсылка();
		КонецЕсли;
		
		Если Не ПустаяСтрока(ЯчейкаИД) И НЕ ЯчейкаИД = "00000000-0000-0000-0000-000000000000" Тогда
			НовыйGUID = Новый УникальныйИдентификатор(ЯчейкаИД);
			Ячейка = Справочники.Ячейки.ПолучитьСсылку(НовыйGUID);
		КонецЕсли;
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Ячейка) Тогда
			НоваяЯчейка = Справочники.Ячейки.СоздатьЭлемент();
			НоваяЯчейка.УстановитьСсылкуНового(Ячейка);
			ЗаполнитьЗначенияСвойств(НоваяЯчейка, СтруктураЯчейки);
			
			НоваяЯчейка.Код = ЯчейкаКод;
			НоваяЯчейка.Наименование = ЯчейкаНаименование;
			НоваяЯчейка.Владелец = Справочники.СтруктурныеЕдиницы.ОсновнойСклад();
			НоваяЯчейка.Родитель = ЯчейкаРодитель;
			НоваяЯчейка.ОбменДанными.Загрузка = Истина;
			НоваяЯчейка.Записать();
		Иначе
			
		КонецЕсли;
		
		
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура ЗагрузитьОстаткиПодарочныхСертификатов(Соединение) Экспорт
	
	ИмяФайлаНаFTP = "GiftCert10UNF.xml";
	ИмяФайла = ПолучениеФайловПоFTP(Соединение, ИмяФайлаНаFTP);
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.ПодарочныеСертификаты", УровеньЖурналаРегистрации.Предупреждение, , , "Файл не найден");
		Возврат;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Исключение
		ЧтениеXML.Закрыть();
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.ПодарочныеСертификаты", УровеньЖурналаРегистрации.Ошибка, , ,  "Файл поврежден" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ПостроительДом = Новый ПостроительDOM();
	Попытка
		мДокументДОМ = ПостроительДом.Прочитать(ЧтениеXML);
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.ПодарочныеСертификаты", УровеньЖурналаРегистрации.Ошибка, , ,  "Файл не прочитан" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ТЗПС = Новый ТаблицаЗначений;
	ТЗПС.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗПС.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	ТЗПС.Колонки.Добавить("Номинал", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	ТЗПС.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	
	НачатьТранзакцию();
	
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("ПодарочнаяКарта") Цикл
		
		Номенклатура = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Номенклатура?ref=b37a00155d014f0711e74ac01358921f"); 
		
		ГУИДСертитфиката = ЭлементДОМ.ПолучитьЭлементыПоИмени("ПодарочнаяКартаИД").Элемент(0).ТекстовоеСодержимое;
		НомерСертификата = ЭлементДОМ.ПолучитьЭлементыПоИмени("НомерСертификата").Элемент(0).ТекстовоеСодержимое;
		НоминалСертификата = ЭлементДОМ.ПолучитьЭлементыПоИмени("Номинал").Элемент(0).ТекстовоеСодержимое;
		ПинКодСертификата = ЭлементДОМ.ПолучитьЭлементыПоИмени("Пинкод").Элемент(0).ТекстовоеСодержимое;
		СуммаОстаток = ЭлементДОМ.ПолучитьЭлементыПоИмени("ПодарочнаяКартаСуммаОстаток").Элемент(0).ТекстовоеСодержимое;
		
		Сертификат = ПолучитьПодарочныйСертификат(ГУИДСертитфиката, НомерСертификата, Номенклатура, НоминалСертификата, ПинКодСертификата);
		Если ЗначениеЗаполнено(Сертификат) Тогда
			НоваяСтрокаТоваров = ТЗПС.Добавить();
			НоваяСтрокаТоваров.Номенклатура = Сертификат.Владелец;
			НоваяСтрокаТоваров.Серия = Сертификат;
			НоваяСтрокаТоваров.Номинал = НоминалСертификата;
			НоваяСтрокаТоваров.Сумма = СуммаОстаток;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПС.Номенклатура КАК Номенклатура,
	|	ТаблицаПС.Серия КАК Серия,
	|	ТаблицаПС.Номинал КАК Номинал,
	|	ТаблицаПС.Сумма КАК Сумма
	|ПОМЕСТИТЬ ТаблицаПС
	|ИЗ
	|	&ТаблицаСерт КАК ТаблицаПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.Серия КАК Серия,
	|	МАКСИМУМ(ВложенныйЗапрос.Номинал) КАК Номинал,
	|	СУММА(ЕСТЬNULL(ВложенныйЗапрос.Сумма, 0)) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаПС.Номенклатура КАК Номенклатура,
	|		ТаблицаПС.Серия КАК Серия,
	|		ТаблицаПС.Номинал КАК Номинал,
	|		ТаблицаПС.Сумма КАК Сумма
	|	ИЗ
	|		ТаблицаПС КАК ТаблицаПС
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПодарочныеСертификатыОстатки.ПодарочныйСертификат,
	|		ПодарочныеСертификатыОстатки.НомерСертификата,
	|		ВЫБОР
	|			КОГДА ПодарочныеСертификатыОстатки.СуммаОстаток < 0
	|				ТОГДА -ПодарочныеСертификатыОстатки.СуммаОстаток
	|			ИНАЧЕ ПодарочныеСертификатыОстатки.СуммаОстаток
	|		КОНЕЦ,
	|		-ПодарочныеСертификатыОстатки.СуммаОстаток
	|	ИЗ
	|		РегистрНакопления.ПодарочныеСертификаты.Остатки(, ) КАК ПодарочныеСертификатыОстатки) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Серия
	|
	|ИМЕЮЩИЕ
	|	СУММА(ЕСТЬNULL(ВложенныйЗапрос.Сумма, 0)) > 0";
	Запрос.УстановитьПараметр("ТаблицаСерт", ТЗПС);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДокОприходования = Документы.ОприходованиеЗапасов.СоздатьДокумент();
	ДокОприходования.Дата = ТекущаяДатаСеанса();
	ДокОприходования.Заполнить(Неопределено);
	ДокОприходования.Организация = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Организации?ref=bab1000c29e80aa411f03b1460349299");
	ДокОприходования.СтруктурнаяЕдиница = Справочники.СтруктурныеЕдиницы.ОсновнойСклад();
	ДокОприходования.ХозяйственнаяОперация = Справочники.ХозяйственныеОперации.ОприходованиеЗапасов;
	ДокОприходования.Корреспонденция = ПланыСчетов.Управленческий.ПрочиеДоходы;
	
	ДокРеализация = Документы.РасходнаяНакладная.СоздатьДокумент();
	ДокРеализация.Дата = ТекущаяДатаСеанса();
	ДокРеализация.Заполнить(Неопределено); 
	
	ДокРеализация.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю;
	ДокРеализация.Организация = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Организации?ref=bab1000c29e80aa411f03b1460349299");
	ДокРеализация.ПодписьКассира = ДокРеализация.Организация.КассаПоУмолчанию.ПодписьКассира;
	
	ДокРеализация.Контрагент = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Контрагенты?ref=bbbe970f694b62b611f1d3aec9fa5af3"); //маркетинг
	ДокРеализация.Договор = "";
	ДокРеализация.СтруктурнаяЕдиница = Справочники.СтруктурныеЕдиницы.ОсновнойСклад();
	ДокРеализация.Подразделение = ДокРеализация.СтруктурнаяЕдиница.Родитель;
	
	ДокРеализация.Ответственный = ДокРеализация.Контрагент.Ответственный;
	ДокРеализация.Автор = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
	
	ДокРеализация.СуммаВключаетНДС = Истина;
	ДокРеализация.СпособЗачетаПредоплаты = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную;
	ДокРеализация.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
	
	НастройкиНДС = НалогиУНФ.НастройкиНДСОрганизации(ДокРеализация.Организация, ДокРеализация.СтруктурнаяЕдиница, ДокРеализация.Дата);
	ДокРеализация.НалогообложениеНДС = НастройкиНДС.ТипНалогообложения;
	ВидСтавкиНДСПоУмолчанию = НастройкиНДС.ВидСтавкиНДС;
	
	Пока Выборка.Следующий() Цикл   
		Если Выборка.Сумма < 500 Тогда Продолжить КонецЕсли;
		
		СтрокаТЧ = ДокОприходования.Запасы.Добавить();
		СтрокаТЧ.Номенклатура = Выборка.Серия.Владелец;
		СтрокаТЧ.ЕдиницаИзмерения = СтрокаТЧ.Номенклатура.ЕдиницаИзмерения;
		СтрокаТЧ.СерииНоменклатуры = СокрЛП(Выборка.Серия);
		
		СтрокаТЧ.Цена = 0.01;
		СтрокаТЧ.Количество = 1;
		СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
		СтрокаТЧ.КлючСвязи = ТабличныеЧастиУНФКлиентСервер.СоздатьНовыйКлючСвязиДляТаблицы(ДокОприходования.Запасы);
		
		СтрокаСерии = ДокОприходования.СерииНоменклатуры.Добавить();
		СтрокаСерии.КлючСвязи = СтрокаТЧ.КлючСвязи;
		СтрокаСерии.Серия = Выборка.Серия;
		СтрокаСерии.Количество = 1;
		
			СтрокаТЧ = ДокРеализация.Запасы.Добавить();
			СтрокаТЧ.Номенклатура = Выборка.Серия.Владелец;
			СтрокаТЧ.СтруктурнаяЕдиница = ДокРеализация.СтруктурнаяЕдиница;
			СтрокаТЧ.ЕдиницаИзмерения = СтрокаТЧ.Номенклатура.ЕдиницаИзмерения;
			СтрокаТЧ.СерииНоменклатуры = СокрЛП(Выборка.Серия);
			
			СтрокаТЧ.Цена = ?(Выборка.Сумма > Выборка.Номинал, Выборка.Номинал, Выборка.Сумма);
			СтрокаТЧ.Количество = 1;
			//СтрокаТЧ.СуммаСкидкиНаценки = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
			//СтрокаТЧ.ПроцентСкидкиНаценки = Окр(100*СтрокаТЧ.СуммаСкидкиНаценки / (СтрокаТЧ.Количество * СтрокаТЧ.Цена), 2);
			
			ПараметрыРасчета = Новый Структура("СброситьФлагСкидкиРассчитаны", Истина);
			ПараметрыРасчета.Вставить("СуммаВключаетНДС", ДокРеализация.СуммаВключаетНДС); 
			ПараметрыРасчета.Вставить("РассчитатьПроцентСкидки", Истина);
			ПараметрыРасчета.Вставить("ИспользоватьМинимальныеЦены", Ложь);
			
			ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммыВСтрокеТЧ(СтрокаТЧ, ПараметрыРасчета);
			
			СтрокаТЧ.КлючСвязи = ТабличныеЧастиУНФКлиентСервер.СоздатьНовыйКлючСвязиДляТаблицы(ДокРеализация.Запасы);
			
			СтрокаСерии = ДокРеализация.СерииНоменклатуры.Добавить();
			СтрокаСерии.КлючСвязи = СтрокаТЧ.КлючСвязи;
			СтрокаСерии.Серия = Выборка.Серия;
			СтрокаСерии.Количество = 1;
			
		
	КонецЦикла;
	НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти(ДокРеализация, "Запасы", Истина);
	
	ДокОприходования.Комментарий = "#Загрузка ПС из УТ10";
	ДокОприходования.Записать(РежимЗаписиДокумента.Проведение);
	
		ДокРеализация.Комментарий = "#Загрузка ПС из УТ10";
		ДокРеализация.Записать(РежимЗаписиДокумента.Проведение);
		
		ДокКорректировка = Документы.Взаимозачет.СоздатьДокумент(); 
		ДокКорректировка.Дата = ТекущаяДатаСеанса();
		ДокКорректировка.Организация = ДокРеализация.Организация;
		ДокКорректировка.ВидОперации = Перечисления.ВидыОперацийВзаимозачет.КорректировкаДолгаПокупателя;
		ДокКорректировка.КонтрагентИсточник = ДокРеализация.Контрагент;
		ДокКорректировка.Автор = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
		ДокКорректировка.Корреспонденция = ПланыСчетов.Управленческий.ПрочиеДоходы;
		ДокКорректировка.ЗаполнитьРасчетыСКонтрагентом("РасчетыСДебитором");
		ДокКорректировка.Записать(РежимЗаписиДокумента.Проведение);
		
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура ВыгрузитьДанные(НомерПолученногоСообщения, Соединение, ПланОбменаУТ) Экспорт
	
	ИмяФайлаОтветаНаFTP = "OrdUNF10.xml";
	//ПланОбменаУТ = ПланыОбмена.ОбменСУТ10.НайтиПоКоду("УТ10");//ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/ПланОбмена.ОбменСУТ10?ref=bbb385d39ee01ba511f0c158b26d651a");
	
	ИмяФайлаОтвета = КаталогВременныхФайлов() + "\OrdUNF10.xml";
	ОбъектXML = Новый ЗаписьXML;
	ОбъектXML.ОткрытьФайл(ИмяФайлаОтвета, "UTF-8");
	
	ОбъектXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(ОбъектXML, ПланОбменаУТ);
	НомерСообщения 	= ЗаписьСообщения.НомерСообщения;
	
	ЗаписатьШапкуФайла(ОбъектXML);
	
	ЗаписатьТекстовойУзел(ОбъектXML, "НомерПринятогоСообщения", НомерПолученногоСообщения, Ложь);
	
	ОбъектXML.ЗаписатьНачалоЭлемента("Документы");
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ПланОбменаУТ, НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
		
		Объект = ВыборкаИзменений.Получить();
		
		флУдаление = ?(ТипЗнч(Объект) = Тип("УдалениеОбъекта"), Истина, Ложь);
		
		Если Не флУдаление Тогда
			ОбъектXML.ЗаписатьНачалоЭлемента("Документ");
			
				ЗаписатьТекстовойУзел(ОбъектXML, "ДокументГУИД", XMLСтрока(Объект.Ссылка), Ложь);
				
				Если ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
					ЗаписатьТекстовойУзел(ОбъектXML, "ДокументТип", "ЗаказПокупателя", Ложь);
					
					ВыгрузитьЗаказ(ОбъектXML, Объект.Ссылка);
				ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ОтчетОРозничныхПродажах") Тогда
					ЗаписатьТекстовойУзел(ОбъектXML, "ДокументТип", "ОтчетОРозничныхПродажах", Ложь);
					
					ВыгрузитьОРП(ОбъектXML, Объект.Ссылка);
				ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаказНаПеремещение") Тогда
					ЗаписатьТекстовойУзел(ОбъектXML, "ДокументТип", "ЗаказНаПеремещение", Ложь);
					
					ВыгрузитьЗаказНаПеремещение(ОбъектXML, Объект.Ссылка);
				КонецЕсли;
				
			ОбъектXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
		
	КонецЦикла;
	
	ОбъектXML.ЗаписатьКонецЭлемента();
	//ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, НомерСообщения, МассивДанных);
	ЗаписьСообщения.ЗакончитьЗапись();
	
	ОбъектXML.Закрыть();
	
	ПередачаФайловПоFTP(Соединение, ИмяФайлаОтветаНаFTP, ИмяФайлаОтвета);
	
КонецПроцедуры

Процедура ВыгрузитьЗаказ(ОбъектXML, СсылкаНаДокумент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Заказ.Ссылка КАК Ссылка,
	|	Заказ.Номер КАК Номер,
	|	Заказ.Дата КАК Дата,
	|	ЕСТЬNULL(ЗаказыПокупателейССайта.НомерЗаказаНаСайте, """") КАК НомерЗаказаНаСайте,
	|	ЕСТЬNULL(ЗаказыПокупателейССайта.ДатаЗаказаНаСайте, &ПустаяДата) КАК ДатаЗаказаНаСайте,
	|	Заказ.Проведен КАК Проведен,
	|	Заказ.АдресДоставки КАК АдресДоставки,
	|	Заказ.АдресЭП КАК АдресЭП,
	|	Заказ.ДатаОтгрузки КАК ДатаОтгрузки,
	|	Заказ.Организация КАК Организация,
	|	Заказ.Организация.Наименование КАК ОрганизацияНаименование,
	|	Заказ.Организация.ИНН КАК ОрганизацияИНН,
	|	Заказ.Организация.КПП КАК ОрганизацияКПП,
	|	Заказ.Организация.ИндивидуальныйПредприниматель КАК ОрганизацияИндивидуальныйПредприниматель,
	|	Заказ.Контрагент КАК Контрагент,
	|	Заказ.Контрагент.Наименование КАК КонтрагентНаименование,
	|	Заказ.Контрагент.ИНН КАК КонтрагентИНН,
	|	Заказ.Контрагент.КПП КАК КонтрагентКПП,
	|	Заказ.Контрагент.ЮридическоеФизическоеЛицо КАК КонтрагентЮридическоеФизическоеЛицо,
	|	Заказ.Контрагент.ВидКонтрагента КАК КонтрагентВидКонтрагента,
	|	Заказ.Договор КАК Договор,
	|	Заказ.Договор.Наименование КАК ДоговорНаименование,
	|	Заказ.Договор.Организация КАК ДоговорОрганизация,
	|	Заказ.Договор.ВидДоговора КАК ДоговорВидДоговора,
	|	Заказ.Договор.НомерДоговора КАК ДоговорНомерДоговора,
	|	Заказ.Договор.ДатаДоговора КАК ДоговорДатаДоговора,
	|	Заказ.СуммаДокумента КАК СуммаДокумента,
	|	Заказ.СтруктурнаяЕдиницаПродажи КАК Подразделение,
	|	Заказ.СтруктурнаяЕдиницаПродажи.Наименование КАК ПодразделениеНаименование,
	|	Заказ.СтруктурнаяЕдиницаРезерв КАК Склад,
	|	Заказ.СтруктурнаяЕдиницаРезерв.Наименование КАК СкладНаименование,
	|	Заказ.Ответственный КАК Ответственный,
	|	Заказ.СостояниеЗаказа КАК СостояниеЗаказа,
	|	Заказ.ДисконтнаяКарта КАК ДисконтнаяКарта,
	|	Заказ.ДисконтнаяКарта.Наименование КАК ДисконтнаяКартаНаименование,
	|	Заказ.ДисконтнаяКарта.КодКартыШтрихкод КАК ДисконтнаяКартаКодКартыШтрихкод,
	|	Заказ.ДисконтнаяКарта.ВладелецКарты КАК ДисконтнаяКартаВладелецКарты,
	|	Заказ.ИсточникПривлечения КАК ИсточникПривлечения,
	|	Заказ.Комментарий КАК Комментарий,
	|	ЗаказПокупателяДополнительныеРеквизитыТип.Значение КАК ТипЗаказа,
	|	ЕСТЬNULL(ЗаказПокупателяДополнительныеРеквизитыИсполнитель.Значение, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК Исполнитель,
	|	Заказ.Запасы.(
	|		Номенклатура КАК Номенклатура,
	|		Характеристика КАК Характеристика,
	|		Резерв КАК Резерв,
	|		РезервОтгрузка КАК РезервОтгрузка,
	|		ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		Цена КАК Цена,
	|		ПроцентСкидкиНаценки КАК ПроцентСкидкиНаценки,
	|		СуммаСкидкиНаценки КАК СуммаСкидкиНаценки,
	|		Сумма КАК Сумма,
	|		СтавкаНДС КАК СтавкаНДС,
	|		СуммаНДС КАК СуммаНДС,
	|		Всего КАК Всего,
	|		ДатаОтгрузки КАК ДатаОтгрузки,
	|		Содержание КАК Содержание,
	|		ПроцентАвтоматическойСкидки КАК ПроцентАвтоматическойСкидки,
	|		СуммаАвтоматическойСкидки КАК СуммаАвтоматическойСкидки,
	|		Количество КАК Количество,
	|		СтруктурнаяЕдиницаРезерв КАК СтруктурнаяЕдиницаРезерв,
	|		СуммаСкидкиОплатыБонусом КАК СуммаСкидкиОплатыБонусом
	|	) КАК Запасы,
	|	Заказ.ПримененныеПромокоды.(
	|		Промокод КАК Промокод,
	|		УсловиеПредоставленияСкидки КАК УсловиеПредоставленияСкидки,
	|		СкидкаПредоставлена КАК СкидкаПредоставлена,
	|		ЭтоАктивацияПромокода КАК ЭтоАктивацияПромокода
	|	) КАК ПримененныеПромокоды,
	|	Заказ.ШтрихкодыУпаковок.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|		ШтрихкодУпаковки.Номенклатура КАК Номенклатура,
	|		ШтрихкодУпаковки.Характеристика КАК ХарактеристикаНоменклатуры,
	|		ШтрихкодУпаковки.ТипУпаковки КАК ШтрихкодУпаковкиТипУпаковки,
	|		ШтрихкодУпаковки.ТипШтрихкода КАК ШтрихкодУпаковкиТипШтрихкода,
	|		ШтрихкодУпаковки.ЗначениеШтрихкода КАК ШтрихкодУпаковкиЗначениеШтрихкода,
	|		ШтрихкодУпаковки.Количество КАК ШтрихкодУпаковкиКоличество,
	|		ШтрихкодУпаковки.ДатаУпаковки КАК ШтрихкодУпаковкиДатаУпаковки,
	|		ШтрихкодУпаковки.КоличествоПотребительскихУпаковок КАК ШтрихкодУпаковкиКоличествоПотребительскихУпаковок,
	|		ШтрихкодУпаковки.ХешСумма КАК ШтрихкодУпаковкиХешСумма,
	|		ШтрихкодУпаковки.ХешСуммаЗначенияШтрихкода КАК ШтрихкодУпаковкиХешСуммаЗначенияШтрихкода,
	|		ШтрихкодУпаковки.ХешСуммаНормализации КАК ШтрихкодУпаковкиХешСуммаНормализации
	|	) КАК ШтрихкодыУпаковок
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.ДополнительныеРеквизиты КАК ЗаказПокупателяДополнительныеРеквизитыТип
	|		ПО Заказ.Ссылка = ЗаказПокупателяДополнительныеРеквизитыТип.Ссылка
	|			И (ЗаказПокупателяДополнительныеРеквизитыТип.Свойство = &СвойствоЗаказаТип)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.ДополнительныеРеквизиты КАК ЗаказПокупателяДополнительныеРеквизитыИсполнитель
	|		ПО Заказ.Ссылка = ЗаказПокупателяДополнительныеРеквизитыИсполнитель.Ссылка
	|			И (ЗаказПокупателяДополнительныеРеквизитыИсполнитель.Свойство = &СвойствоЗаказаИсполнитель)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыПокупателейССайта
	|		ПО Заказ.Ссылка = ЗаказыПокупателейССайта.ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФактОплатыЗаказов КАК ФактОплатыЗаказов
	|		ПО Заказ.Ссылка = ФактОплатыЗаказов.СчетНаОплату
	|ГДЕ
	|	Заказ.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	Запрос.УстановитьПараметр("СвойствоЗаказаТип", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ТипЗаказа_499f11036f214dbfbf0a5cb0cdee99f8"));
	Запрос.УстановитьПараметр("СвойствоЗаказаИсполнитель", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "Исполнитель_11b013084e704ae5962740253b5ca52d"));
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаписатьТекстовойУзел(ОбъектXML, "Ссылка", XMLСтрока(Выборка.Ссылка), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "Номер", СокрЛП(Выборка.Номер), Ложь); 
		ЗаписатьТекстовойУзел(ОбъектXML, "Дата", Формат(Выборка.Дата, "ДФ=ггггММддЧЧммсс"), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "НомерНаСайте", СокрЛП(Выборка.НомерЗаказаНаСайте), Ложь); 
		ЗаписатьТекстовойУзел(ОбъектXML, "ДатаНаСайте", Формат(Выборка.ДатаЗаказаНаСайте, "ДФ=ггггММддЧЧммсс"), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "Проведен", Выборка.Проведен, Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "ДатаОтгрузки", Формат(Выборка.ДатаОтгрузки, "ДФ=ггггММддЧЧммсс"), Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "ДатаСнятияРезерва", Формат(Выборка.ДатаСнятияРезерва, "ДФ=ггггММддЧЧммсс"), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "Статус", Выборка.СостояниеЗаказа, Ложь);
		//ЗаписатьТекстовойУзел(ОбъектXML, "СтатусОтгрузки", ПолучитьСтатусОтгрузкиЗаказа(Выборка.Заказ), Ложь);
		ЗаписатьТекстовойУзел(ОбъектXML, "Склад", XMLСтрока(Выборка.Склад), Ложь);
