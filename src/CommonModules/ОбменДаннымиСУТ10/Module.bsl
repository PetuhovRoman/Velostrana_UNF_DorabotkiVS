	КонецПопытки;
	
	ПланОбменаУТ = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/ПланОбмена.ОбменСУТ10?ref=bbb385d39ee01ba511f0c158b26d651a");

	НомерПолученногоСообщения = 0;
	Если мДокументДОМ.ПолучитьЭлементыПоИмени("MessageNo").Количество() > 0 Тогда
		НомерПолученногоСообщения = Число(мДокументДОМ.ПолучитьЭлементыПоИмени("MessageNo").Элемент(0).ТекстовоеСодержимое);
