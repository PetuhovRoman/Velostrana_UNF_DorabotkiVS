Функция ПолучитьОРП(ДокЧек)

	КассаККМ = ДокЧек.КассаККМ;
	ДатаДокумента = НачалоДня(ДокЧек.Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтчетОРозничныхПродажах.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	|ГДЕ
	|	ОтчетОРозничныхПродажах.КассаККМ = &КассаККМ
	|	И НАЧАЛОПЕРИОДА(ОтчетОРозничныхПродажах.Дата, ДЕНЬ) = &ДатаДок
	|	И НЕ ОтчетОРозничныхПродажах.ПометкаУдаления
	|	И ОтчетОРозничныхПродажах.СтатусКассовойСмены = ЗНАЧЕНИЕ(Перечисление.СтатусыОтчетаОРозничныхПродажах.Открыта)";
	Запрос.УстановитьПараметр("ДатаДок", ДатаДокумента);
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	ОРП = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент();
	ОРП.Дата = ДатаДокумента + 4*60*60;
	ОРП.Заполнить(Неопределено);
	ОРП.Организация = ДокЧек.Организация;
	ОРП.КассаККМ = КассаККМ;
	ОРП.СтруктурнаяЕдиница = КассаККМ.СтруктурнаяЕдиница;
	ОРП.Подразделение = КассаККМ.Подразделение;
	ОРП.СтатусКассовойСмены = Перечисления.СтатусыОтчетаОРозничныхПродажах.Открыта;
	ОРП.КассоваяСмена = ПолучитьКассовуюСмену(ОРП.Дата - 1, КассаККМ);
	ОРП.Комментарий = "#Загружен из УТ10";
	
	ОРП.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат ОРП.Ссылка;

КонецФункции

