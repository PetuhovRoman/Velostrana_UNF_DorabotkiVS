		ЧтениеXML.ОткрытьФайл(ИмяФайла);
	Исключение
		ЧтениеXML.Закрыть();
		Сообщить("Документ XML поврежден");
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Заказы", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
