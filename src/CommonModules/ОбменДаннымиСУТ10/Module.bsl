		НоваяСтрокаБонусов.ДатаНачисления = Выборка.ДатаНачисления;
		НоваяСтрокаБонусов.ДатаСгорания = Выборка.ДатаСгорания;
		
		НоваяСтрокаБонусов.СтруктураКарта = Выборка.СтруктураКарта;
		НоваяСтрокаБонусов.СтруктураКонтрагент = Выборка.СтруктураКонтрагент;
		
		НоваяСтрокаБонусов.Записать(Истина);
		ЗафиксироватьТранзакцию();
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаБонусов.БонуснаяКарта КАК БонуснаяКарта,
	|	ТаблицаБонусов.ДатаНачисления КАК ДатаНачисления,
	|	ТаблицаБонусов.ДатаСгорания КАК ДатаСгорания,
	|	ТаблицаБонусов.Количество КАК Количество
	|ПОМЕСТИТЬ ТаблицаБонусов
	|ИЗ
	|	РегистрСведений.ЗагрузкаБонусовВременный КАК ТаблицаБонусов
	|ГДЕ
	|	НЕ ТаблицаБонусов.БонуснаяКарта.Наименование ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.БонуснаяКарта КАК БонуснаяКарта,
	|	МАКСИМУМ(ВложенныйЗапрос.ДатаНачисления) КАК ДатаНачисления,
	|	МАКСИМУМ(ВложенныйЗапрос.ДатаСгорания) КАК ДатаСгорания,
	|	СУММА(ЕСТЬNULL(ВложенныйЗапрос.Количество, 0)) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаБонусов.БонуснаяКарта КАК БонуснаяКарта,
	|		ТаблицаБонусов.Количество КАК Количество,
	|		ТаблицаБонусов.ДатаНачисления КАК ДатаНачисления,
	|		ТаблицаБонусов.ДатаСгорания КАК ДатаСгорания
	|	ИЗ
