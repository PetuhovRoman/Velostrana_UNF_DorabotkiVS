			НоваяСтрокаОплат.Заказ = ЗаказПокупателя;
			
			НоваяСтрокаОплат.СуммаРасчетов = СуммаОплатыБонусамиЗаказ;
			НоваяСтрокаОплат.СуммаПлатежа = НоваяСтрокаОплат.СуммаРасчетов;
