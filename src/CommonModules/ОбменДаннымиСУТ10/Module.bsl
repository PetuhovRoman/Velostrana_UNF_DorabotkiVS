Функция ПолучитьКонтрагента(СтруктураРеквизитов, Дозаписывать = Истина)
	//Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровИКонтрагентов") Тогда
	//	Возврат Справочники.Контрагенты.ПустаяСсылка();
	//КонецЕсли;
	
	Если Булево(СтруктураРеквизитов.ТиповойПокупатель) Тогда
		Возврат ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Контрагенты?ref=bab1000c29e80aa411f03bb6bafeed98");
	КонецЕсли;
	
	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) И Не СтруктураРеквизитов.ИД = "00000000-0000-0000-0000-000000000000" Тогда
		НовыйGUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.ИД);
		Контрагент = Справочники.Контрагенты.ПолучитьСсылку(НовыйGUID);
		
		Если ОбщегоНазначения.СсылкаСуществует(Контрагент) Тогда
			Если Дозаписывать Тогда
				Если ЗначениеЗаполнено(СтруктураРеквизитов.Телефон) 
					И Контрагент.КонтактнаяИнформация.Найти(Перечисления.ТипыКонтактнойИнформации.Телефон, "Тип") = Неопределено Тогда
					СпрН = Контрагент.ПолучитьОбъект();
					КИ = СпрН.КонтактнаяИнформация.Добавить();
					КИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
					КИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
					//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
					КИ.Представление = СтруктураРеквизитов.Телефон;
					КИ.НомерТелефона = СтруктураРеквизитов.Телефон;
					СпрН.Записать();
				КонецЕсли;
				Если ЗначениеЗаполнено(СтруктураРеквизитов.Почта) 
					И Контрагент.КонтактнаяИнформация.Найти(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты, "Тип") = Неопределено Тогда
					СпрН = Контрагент.ПолучитьОбъект();
					КИ = СпрН.КонтактнаяИнформация.Добавить();
					КИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
					КИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
					//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
					КИ.Представление = СтрЗаменить(СтруктураРеквизитов.Почта, " ", "");
					КИ.АдресЭП = СтрЗаменить(СтруктураРеквизитов.Почта, " ", "");
					СпрН.Записать();
				КонецЕсли;
			КонецЕсли;
			Возврат Контрагент;
		КонецЕсли;
		
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	0 КАК Приоритет,
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	1,
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И Контрагенты.ИНН = &ИНН
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	2,
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И НЕ &ИскатьПоТелефону
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	2,
	|	КИ.Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.НомерТелефона = &Телефон
	|	И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	|	И &ИскатьПоТелефону
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	3,
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("Наименование", СтруктураРеквизитов.Наименование);
	Запрос.УстановитьПараметр("ИНН", ?(ПустаяСтрока(СтруктураРеквизитов.ИНН), "?------?", СтруктураРеквизитов.ИНН));
	Запрос.УстановитьПараметр("КПП", СтруктураРеквизитов.КПП);
	Запрос.УстановитьПараметр("Телефон", СтруктураРеквизитов.Телефон);
	Если ЗначениеЗаполнено(СтруктураРеквизитов.Телефон) Тогда
		Запрос.УстановитьПараметр("ИскатьПоТелефону", Истина);
	Иначе
		Запрос.УстановитьПараметр("ИскатьПоТелефону", Ложь);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Дозаписывать Тогда
			Если ЗначениеЗаполнено(СтруктураРеквизитов.Телефон) 
				И Выборка.Ссылка.КонтактнаяИнформация.Найти(Перечисления.ТипыКонтактнойИнформации.Телефон, "Тип") = Неопределено Тогда
				СпрН = Выборка.Ссылка.ПолучитьОбъект();
				КИ = СпрН.КонтактнаяИнформация.Добавить();
				КИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				КИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
				//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
				КИ.Представление = СтруктураРеквизитов.Телефон;
				КИ.НомерТелефона = СтруктураРеквизитов.Телефон;
				СпрН.Записать();
			КонецЕсли;
			Если ЗначениеЗаполнено(СтруктураРеквизитов.Почта) 
				И Выборка.Ссылка.КонтактнаяИнформация.Найти(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты, "Тип") = Неопределено Тогда
				СпрН = Выборка.Ссылка.ПолучитьОбъект();
				КИ = СпрН.КонтактнаяИнформация.Добавить();
				КИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
				КИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
				//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
				КИ.Представление = СтрЗаменить(СтруктураРеквизитов.Почта, " ", "");
				КИ.АдресЭП = СтрЗаменить(СтруктураРеквизитов.Почта, " ", "");
				СпрН.Записать();
			КонецЕсли;
		КонецЕсли;
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	
	СпрН = Справочники.Контрагенты.СоздатьЭлемент();
	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) И Не СтруктураРеквизитов.ИД = "00000000-0000-0000-0000-000000000000" Тогда
		СпрН.УстановитьСсылкуНового(Контрагент);
	КонецЕсли;
	
	СпрН.Покупатель = СтруктураРеквизитов.Покупатель;
	СпрН.Поставщик = СтруктураРеквизитов.Поставщик;
	Если СтруктураРеквизитов.Тип = "Физ. лицо" Тогда
		СпрН.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		Если ЗначениеЗаполнено(СтруктураРеквизитов.ИНН) Тогда
			СпрН.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель;
			СпрН.ВестиРасчетыПоДоговорам = Истина;
			СпрН.ВестиРасчетыПоДокументам = Истина;
			СпрН.ВестиРасчетыПоЗаказам = Истина;
		Иначе
			СпрН.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо;
			СпрН.ВестиРасчетыПоДоговорам = Ложь;
			СпрН.ВестиРасчетыПоДокументам = Истина;
			СпрН.ВестиРасчетыПоЗаказам = Истина;
		КонецЕсли;
	Иначе
		СпрН.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
		СпрН.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо;
		СпрН.ВестиРасчетыПоДоговорам = Истина;
		СпрН.ВестиРасчетыПоДокументам = Истина;
		СпрН.ВестиРасчетыПоЗаказам = Истина;
	КонецЕсли;
	СпрН.Наименование = СтруктураРеквизитов.Наименование;
	СпрН.НаименованиеПолное = СтруктураРеквизитов.Наименование;
	СпрН.ИНН = СтруктураРеквизитов.ИНН;
	СпрН.КПП = СтруктураРеквизитов.КПП;
	
	СпрН.СчетУчетаАвансовПокупателя = ПланыСчетов.Управленческий.РасчетыПоАвансамПолученным;
	СпрН.СчетУчетаРасчетовСПокупателем = ПланыСчетов.Управленческий.РасчетыСПокупателями;
	СпрН.СчетУчетаАвансовПоставщику = ПланыСчетов.Управленческий.РасчетыПоАвансамВыданным;
	СпрН.СчетУчетаРасчетовСПоставщиком = ПланыСчетов.Управленческий.РасчетыСПоставщиками;
	
	СпрН.СпособЗачетаПредоплатыПоУмолчанию = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто;
	СпрН.СпособРазнесенияОплатыПоУмолчанию = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто;
	
	Если ЗначениеЗаполнено(СтруктураРеквизитов.Телефон) Тогда
		КИ = СпрН.КонтактнаяИнформация.Добавить();
		КИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		КИ.Представление = СтруктураРеквизитов.Телефон;
		КИ.НомерТелефона = СтруктураРеквизитов.Телефон;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРеквизитов.Почта) Тогда
		КИ = СпрН.КонтактнаяИнформация.Добавить();
		КИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
		КИ.Представление = СтрЗаменить(СтруктураРеквизитов.Почта, " ", "");
		КИ.АдресЭП = СтрЗаменить(СтруктураРеквизитов.Почта, " ", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРеквизитов.ЮрАдрес) Тогда
		КИ = СпрН.КонтактнаяИнформация.Добавить();
		КИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		КИ.Представление = СтруктураРеквизитов.ЮрАдрес;
		КИ.Страна = "Россия";
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРеквизитов.Адрес) Тогда
		КИ = СпрН.КонтактнаяИнформация.Добавить();
		КИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
		//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
		КИ.Представление = СтруктураРеквизитов.Адрес;
		КИ.Страна = "Россия";
	КонецЕсли;
	
	СпрН.Записать();
	
	Возврат СпрН.Ссылка;
	
	
КонецФункции

Функция ПолучитьМенеджера(СтрМенеджер)
	
	Если ПустаяСтрока(СтрМенеджер) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Пользователи
	|ГДЕ
	|	Пользователи.Наименование = &СтрМенеджер";
	Запрос.УстановитьПараметр("СтрМенеджер", СтрМенеджер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НовыйПользователь = Справочники.Сотрудники.СоздатьЭлемент();
	НовыйПользователь.Заполнить(Неопределено);
	НовыйПользователь.Наименование = СокрЛП(СтрМенеджер);
	//НовыйПользователь.Комментарий = "Создан автоматически при загрузке заказов УТ10";
	НовыйПользователь.Записать();
	
	Возврат НовыйПользователь.Ссылка;
	
КонецФункции

Функция ПолучитьИсточник(Знач СтрИсточник)
	
	Если ПустаяСтрока(СтрИсточник) Тогда
		Возврат Справочники.ИсточникиПривлеченияПокупателей.ПустаяСсылка();
	КонецЕсли;

    ИсточникСсылка = Справочники.ИсточникиПривлеченияПокупателей.НайтиПоНаименованию(СтрИсточник, Истина);
	
	Если ЗначениеЗаполнено(ИсточникСсылка) Тогда
		Возврат ИсточникСсылка;
	КонецЕсли;
	
	НовыйСпр = Справочники.ИсточникиПривлеченияПокупателей.СоздатьЭлемент();
	НовыйСпр.Заполнить(Неопределено);
	НовыйСпр.Наименование = СокрЛП(СтрИсточник);
	//НовыйПользователь.Комментарий = "Создан автоматически при загрузке заказов УТ10";
	НовыйСпр.Записать();
	
	Возврат НовыйСпр.Ссылка;
	
КонецФункции

Функция ПолучитьБренд(Знач СтрБренд)
	
	Если ПустаяСтрока(СтрБренд) Тогда
		Возврат Справочники.ТорговыеМарки.ПустаяСсылка();
	КонецЕсли;

    ТМСсылка = Справочники.ТорговыеМарки.НайтиПоНаименованию(СтрБренд, Истина);
	
	Если ЗначениеЗаполнено(ТМСсылка) Тогда
		Возврат ТМСсылка;
	КонецЕсли;
	
	НовыйСпр = Справочники.ТорговыеМарки.СоздатьЭлемент();
	НовыйСпр.Заполнить(Неопределено);
	НовыйСпр.Наименование = СокрЛП(СтрБренд);
	//НовыйПользователь.Комментарий = "Создан автоматически при загрузке заказов УТ10";
	НовыйСпр.Записать();
	
	Возврат НовыйСпр.Ссылка;
	
КонецФункции

Процедура ЗаполнитьДоговорПоУмолчанию(ДокОбъект, СтруктураРеквизитов)
	
	Если Не ДокОбъект.Контрагент.ВестиРасчетыПоДоговорам Тогда
		ДокОбъект.Договор = "";
		Возврат;
	КонецЕсли;
	
	Если СтруктураРеквизитов.Вид = "С комиссионером" 
		Или ДокОбъект.Контрагент.ИНН = "7704217370"  //ОЗОН
		Тогда
		ВидДоговора = Перечисления.ВидыДоговоров.СКомиссионером;
	ИначеЕсли СтруктураРеквизитов.Вид = "С поставщиком" Тогда
		ВидДоговора = Перечисления.ВидыДоговоров.СПоставщиком;
	Иначе
		ВидДоговора = Перечисления.ВидыДоговоров.СПокупателем;
	КонецЕсли;
	
	СписокВидовДоговоров = Новый СписокЗначений();
	СписокВидовДоговоров.Добавить(ВидДоговора);
	Договор = Справочники.ДоговорыКонтрагентов.ПоКонтрагентуПоОрганизации(ДокОбъект.Контрагент, ДокОбъект.Организация, СписокВидовДоговоров);
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Если Не ДокОбъект.Контрагент.ВестиРасчетыПоДоговорам Тогда
			Договор = Справочники.ДоговорыКонтрагентов.СоздатьПоКонтрагентуПоОрганизации(ДокОбъект.Контрагент, ДокОбъект.Организация, ВидДоговора);
		Иначе
			НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			НовыйДоговор.Заполнить(Неопределено);
			НовыйДоговор.Наименование = СокрЛП(СтруктураРеквизитов.Наименование);
			НовыйДоговор.НомерДоговора = СокрЛП(СтруктураРеквизитов.Номер);
			НовыйДоговор.ДатаДоговора = ПреобразоватьДату(СокрЛП(СтруктураРеквизитов.Дата));
			НовыйДоговор.Организация = ДокОбъект.Организация;
			НовыйДоговор.Владелец = ДокОбъект.Контрагент;
			НовыйДоговор.ВидДоговора = ВидДоговора;
			НовыйДоговор.Комментарий = "Создан автоматически при загрузке заказов УТ10";
			Попытка
				НовыйДоговор.Записать();
			Исключение
				ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Заказы", УровеньЖурналаРегистрации.Ошибка, , ДокОбъект.Ссылка, "Ошибка при создании договора " + ДокОбъект.Контрагент + Символы.ПС + ОписаниеОшибки());
				Возврат;
			КонецПопытки;
			
			Договор = НовыйДоговор.Ссылка;
		КонецЕсли;
	КонецЕсли;
	ДокОбъект.Договор = Договор;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("БанковскийСчет", ДокОбъект.Метаданные()) Тогда
		ДокОбъект.БанковскийСчет = Справочники.БанковскиеСчета.БанковскийСчетСубъекта(ДокОбъект.Организация,
		ДокОбъект.ВалютаДокумента, ДокОбъект.Дата, ДокОбъект.Договор);
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьАртикулХарактеристики(Товар, СтрокаАртикула)

	Если ЗначениеЗаполнено(СтрокаАртикула) Тогда
		Возврат СтрокаАртикула;
	КонецЕсли;
	
    Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХарактеристикиНоменклатуры.Наименование
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Владелец", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Формат(Выборка.Количество() + 1, "ЧЦ=2; ЧВН=");
	
КонецФункции

Функция ПолучитьНоменклатуру(Знач СтрокаТЧ, Перезаполнять = Ложь)
	//СтрокаТЧ = ДанныеЗагрузки[0];
	
	Если ПустаяСтрока(СтрокаТЧ.ГУИД) И СтрокаТЧ.Свойство("НаименованиеНоменклатуры") Тогда
		Товар = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.НаименованиеНоменклатуры, Истина);
	ИначеЕсли Не ПустаяСтрока(СтрокаТЧ.ГУИД) Тогда 
		НовыйGUID = Новый УникальныйИдентификатор(СтрокаТЧ.ГУИД);
		Товар = Справочники.Номенклатура.ПолучитьСсылку(НовыйGUID);
	Иначе
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	СсылкаСуществует = ОбщегоНазначения.СсылкаСуществует(Товар);
	
	Если СсылкаСуществует И Не Перезаполнять Тогда
		Если ЗначениеЗаполнено(СтрокаТЧ.ВидПродукцииИС) Тогда
			Если Не Товар.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ Тогда
				СпрН = Товар.ПолучитьОбъект();
				//СпрН.ВидПродукцииИС = ЗначениеПеречисления("ВидыПродукцииИС", СокрЛП(СтрокаТЧ.ВидПродукцииИС));
				СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ;
				СпрН.Записать();
			КонецЕсли;
			
			Если НетЗаписейИС(Товар) Тогда
				ДанныеЗаписиНоменклатуры = Новый Структура;
				ДанныеОписания = ОбщегоНазначенияИС.ИнициализироватьДанныеОписанияНоменклатуры();
				ДанныеОписания.Номенклатура = Товар;
				Если СтрокаТЧ.ВидПродукцииИС = "Обувная продукция" Тогда
					ВидПродукцииКлюча = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ВидыПродукцииИС?ref=bbbb8ae4c7529bca11f1217d7f638709");
				Иначе
					ВидПродукцииКлюча = Справочники.ВидыПродукцииИС.НайтиПоНаименованию(СтрокаТЧ.ВидПродукцииИС);
				КонецЕсли;
				ДанныеОписания.КлючВидовПродукции = Справочники.КлючиВидовПродукцииИС.ПолучитьКлюч(Новый Структура("ВидПродукцииГИСМТ", ВидПродукцииКлюча));
				ДанныеЗаписиНоменклатуры.Вставить("ДанныеОписания", ДанныеОписания);
				
				ИнтеграцияИСУНФ.ЗаписатьДанныеНоменклатуры(ДанныеЗаписиНоменклатуры);
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Товар.КатегорияНоменклатуры) И ЗначениеЗаполнено(СтрокаТЧ.ВидНоменклатуры) Тогда
			СпрН = Товар.ПолучитьОбъект();
			СпрН.КатегорияНоменклатуры = ПолучитьВидНоменклатуры(СтрокаТЧ);
			СпрН.Записать();
		КонецЕсли;
		
		Возврат Товар;
	КонецЕсли;
	
	Если Не СтрокаТЧ.Свойство("НаименованиеНоменклатуры") Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Если СсылкаСуществует Тогда
		СпрН = Товар.ПолучитьОбъект();
	Иначе
		СпрН = Справочники.Номенклатура.СоздатьЭлемент();
		СпрН.УстановитьСсылкуНового(Товар); 
	КонецЕсли;
	
	СпрН.Артикул = СтрокаТЧ.Артикул;
	СпрН.Наименование = СтрокаТЧ.НаименованиеНоменклатуры;
	СпрН.НаименованиеПолное = СтрокаТЧ.НаименованиеПолное;
	Если СтрокаТЧ.ТипНоменклатуры = "Услуга" Тогда
		СпрН.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
		СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Услуга;
	Иначе
		СпрН.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
		
		СпрН.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
		СпрН.МетодОценки = Перечисления.МетодОценкиЗапасов.FIFO;
		СпрН.СчетУчетаЗапасов = ПланыСчетов.Управленческий.ТоварыПродукция;
		
		СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
		
	КонецЕсли;
	СпрН.КатегорияНоменклатуры = ПолучитьВидНоменклатуры(СтрокаТЧ);//Справочники.ВидыНоменклатуры.НайтиПоНаименованию(СтрокаТЧ.ВидНоменклатуры));
	СпрН.Родитель = ПолучитьРодителя(СтрокаТЧ);
	СпрН.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.шт;
	Если ЗначениеЗаполнено(СтрокаТЧ.Страна) Тогда
		СпрН.СтранаПроисхождения = Справочники.СтраныМира.НайтиПоНаименованию(СтрокаТЧ.Страна);
	Иначе
		СпрН.СтранаПроисхождения = "";
	КонецЕсли;
	СпрН.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ВидСтавки(Справочники.СтавкиНДС.НайтиПоНаименованию(СтрокаТЧ.СтавкаНДС));
	СпрН.ИспользоватьХарактеристики = Булево(СтрокаТЧ.УчетПоХарактеристикам);
	СпрН.ПроверятьЗаполнениеХарактеристики = СпрН.ИспользоватьХарактеристики;
	
	СпрН.ВидМаркировки = Перечисления.ВидыМаркировки.НеМаркируется;
	Если ЗначениеЗаполнено(СтрокаТЧ.ВидПродукцииИС) Тогда
		//СпрН.ВидПродукцииИС = ЗначениеПеречисления("ВидыПродукцииИС", СокрЛП(СтрокаТЧ.ВидПродукцииИС));
		СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ;
	КонецЕсли;
	
	СпрН.СчетУчетаЗатрат = ПланыСчетов.Управленческий.КоммерческиеРасходы;
	СпрН.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
	СпрН.ТорговаяМарка = ПолучитьБренд(СтрокаТЧ.Бренд);
	
	Если ЗначениеЗаполнено(СтрокаТЧ.РазмерКолес) И ЗначениеЗаполнено(СпрН.КатегорияНоменклатуры) Тогда
		ДопСвойство = СпрН.ДополнительныеРеквизиты.Добавить();
		ДопСвойство.Свойство = ПолучитьСвойствоНоменклатуры("Колеса", СпрН.КатегорияНоменклатуры);
		ДопСвойство.Значение = ПолучитьЗначениеРеквизита(ДопСвойство.Свойство, СтрокаТЧ.РазмерКолес);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ТипТовара) И ЗначениеЗаполнено(СпрН.КатегорияНоменклатуры) Тогда
		ДопСвойство = СпрН.ДополнительныеРеквизиты.Добавить();
		ДопСвойство.Свойство = ПолучитьСвойствоНоменклатуры("Тип товара", СпрН.КатегорияНоменклатуры);
		ДопСвойство.Значение = ПолучитьЗначениеРеквизита(ДопСвойство.Свойство, СтрокаТЧ.ТипТовара);
	КонецЕсли;
	
	СпрН.Записать();
	
	Товар = СпрН.Ссылка;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ВидПродукцииИС) Тогда
		ДанныеЗаписиНоменклатуры = Новый Структура;
		ДанныеОписания = ОбщегоНазначенияИС.ИнициализироватьДанныеОписанияНоменклатуры();
		ДанныеОписания.Номенклатура = Товар;
		Если СтрокаТЧ.ВидПродукцииИС = "Обувная продукция" Тогда
			ВидПродукцииКлюча = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ВидыПродукцииИС?ref=bbbb8ae4c7529bca11f1217d7f638709");
		Иначе
			ВидПродукцииКлюча = Справочники.ВидыПродукцииИС.НайтиПоНаименованию(СтрокаТЧ.ВидПродукцииИС);
		КонецЕсли;
		ДанныеОписания.КлючВидовПродукции = Справочники.КлючиВидовПродукцииИС.ПолучитьКлюч(Новый Структура("ВидПродукцииГИСМТ", ВидПродукцииКлюча));
		ДанныеЗаписиНоменклатуры.Вставить("ДанныеОписания", ДанныеОписания);
		
		ИнтеграцияИСУНФ.ЗаписатьДанныеНоменклатуры(ДанныеЗаписиНоменклатуры);
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Номенклатура", УровеньЖурналаРегистрации.Информация, , Товар, "Создана номенклатура " + СтрокаТЧ.НаименованиеНоменклатуры + " (" + СтрокаТЧ.Артикул + ")");
	
	Возврат Товар;
	
КонецФункции

Функция НетЗаписейИС(Товар)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОписаниеНоменклатурыИС.КлючВидовПродукции КАК КлючВидовПродукции
	|ИЗ
	|	РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|ГДЕ
	|	ОписаниеНоменклатурыИС.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Товар);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Пустой();
	
КонецФункции

Функция ПолучитьХарактеристику(Знач СтрокаТЧ, Товар)
	
	Если Не Товар.ИспользоватьХарактеристики Тогда
		Если СтрокаТЧ.Свойство("УчетПоХарактеристикам") И Булево(СтрокаТЧ.УчетПоХарактеристикам) И СтрокаТЧ.Свойство("ХарактеристикаНаименование") И ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикаНаименование) Тогда
			СпрН = Товар.ПолучитьОбъект();
			СпрН.ИспользоватьХарактеристики = Булево(СтрокаТЧ.УчетПоХарактеристикам);
			СпрН.ПроверятьЗаполнениеХарактеристики = СпрН.ИспользоватьХарактеристики;
			СпрН.Записать();
		Иначе
			Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаТЧ.ГУИДХарактеристики) Или СтрокаТЧ.ГУИДХарактеристики = "00000000-0000-0000-0000-000000000000" Тогда
		Если СтрокаТЧ.Свойство("ХарактеристикаНаименование") И ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикаНаименование) Тогда
			Характеристика = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(СтрокаТЧ.ХарактеристикаНаименование, Истина, , Товар); 
		Иначе
			Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		КонецЕсли;
	Иначе
		НовыйGUID = Новый УникальныйИдентификатор(СтрокаТЧ.ГУИДХарактеристики);
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Характеристика) Тогда
		Если Не СтрокаТЧ.Свойство("ХарактеристикаНаименование") Тогда
			Возврат Характеристика;
		КонецЕсли;
		СпрХ = Характеристика.ПолучитьОбъект();
	Иначе
		Если Не СтрокаТЧ.Свойство("ХарактеристикаНаименование") Или ПустаяСтрока(СтрокаТЧ.ХарактеристикаНаименование) Тогда
			Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		КонецЕсли;
		
		СпрХ = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		СпрХ.УстановитьСсылкуНового(Характеристика);
		СпрХ.Владелец = Товар;
		СпрХ.Наименование = СтрокаТЧ.ХарактеристикаНаименование;
		СпрХ.НаименованиеДляПечати = СтрокаТЧ.ХарактеристикаНаименование;
		СпрХ.Артикул = ПолучитьАртикулХарактеристики(Товар, СтрокаТЧ.АртикулХарактеристики);
	КонецЕсли;
	
	Если СпрХ.ДополнительныеРеквизиты.Количество() = 0 Тогда 
		Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаЦвет)) Тогда
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("Цвет", Товар.КатегорияНоменклатуры);
			СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаЦвет));
		КонецЕсли;
		Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаРостовка)) Тогда
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("Ростовка", Товар.КатегорияНоменклатуры);
			СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаРостовка));
		КонецЕсли;
		//Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаРост)) Тогда
		//	СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
		//	СтрокаДР.Свойство = ПолучитьСвойство("Рост", Товар.КатегорияНоменклатуры);
		//	СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаРост));
		//КонецЕсли;
		Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаРама)) Тогда
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("Рама", Товар.КатегорияНоменклатуры);
			СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаРама));
		КонецЕсли; 
		Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаРостОт)) Тогда
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("РостОт", Товар.КатегорияНоменклатуры);
			СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаРостОт));
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("РостДо", Товар.КатегорияНоменклатуры);
