					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		ДобавитьДанныеПоМаркировке(Док, ТЗКМ);
		
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "Ошибок нет";	
		КонецЕсли;	
		Док.Комментарий = "#Загружен из УТ10 " + Символы.ПС + ТекстОшибки;
		//Док.ДополнительнаяИнформация = СокрЛП(ОписаниеЗаказа);
		//ЗаписатьСвойстваУОбъекта
		
		
		Док.Записать();
	
		МассивДокументовКПроведению.Добавить(Док.Ссылка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Док.Ссылка, Док.Ссылка);
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьПеремещение(мДокументДОМ, МассивДокументовКПроведению)
	Перем ВариантыОбеспечения;
	
	Номер = мДокументДОМ.ПолучитьЭлементыПоИмени("Номер").Элемент(0).ТекстовоеСодержимое;
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
	ДатаПриемки = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("ДатаПриемки").Элемент(0).ТекстовоеСодержимое);
	Проведен = Булево(мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Элемент(0).ТекстовоеСодержимое);

	СтруктураОрганизация = Новый Структура;
	СтруктураОрганизация.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Организация").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияИНН").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураКонтрагент = Новый Структура;
	СтруктураКонтрагент.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентИНН").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("КПП", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентКПП").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("ТиповойПокупатель", мДокументДОМ.ПолучитьЭлементыПоИмени("ТиповойПокупатель").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураКонтрагент.Вставить("ЮрАдрес", 		мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентЮрАдрес").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Адрес", 			мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентАдрес").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Телефон", 		мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентТелефон").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Почта", 			СтрЗаменить(мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентПочта").Элемент(0).ТекстовоеСодержимое, " ", ""));
	СтруктураКонтрагент.Вставить("Удостоверение", 	мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентУдостоверение").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Покупатель", 		Истина);
	СтруктураКонтрагент.Вставить("Поставщик", 		Ложь);
	
	СтруктураСклад = Новый Структура;
	СтруктураСклад.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Склад").Элемент(0).ТекстовоеСодержимое);
	СтруктураСклад.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладНаименование").Элемент(0).ТекстовоеСодержимое);
	Склад = ПолучитьСклад(СтруктураСклад);
	
	СтруктураСкладПолучатель = Новый Структура;
	СтруктураСкладПолучатель.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладПолучатель").Элемент(0).ТекстовоеСодержимое);
	СтруктураСкладПолучатель.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладПолучательНаименование").Элемент(0).ТекстовоеСодержимое);
	СкладПолучатель = ПолучитьСклад(СтруктураСкладПолучатель);

	
	ТЗТоваров = Новый ТаблицаЗначений;
	ТЗТоваров.Колонки.Добавить("Номенклатура", 		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗТоваров.Колонки.Добавить("Характеристика", 	Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗТоваров.Колонки.Добавить("СтавкаНДС", 		Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	ТЗТоваров.Колонки.Добавить("Количество", 		Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	ТЗТоваров.Колонки.Добавить("Сумма", 			Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("СуммаНДС", 			Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("Цена", 				Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("ЗаказПокупателя", 	Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
	ТЗТоваров.Колонки.Добавить("НомерСтрокиЗаказа", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 0)));
	
	ТЗКМ = Новый ТаблицаЗначений;
	ТЗКМ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗКМ.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗКМ.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	ТЗКМ.Колонки.Добавить("ПолныйКодМаркировки", Новый ОписаниеТипов("Строка"));
	ТЗКМ.Колонки.Добавить("ШтрихкодУпаковкиСкан", Новый ОписаниеТипов("Строка"));
	ТЗКМ.Колонки.Добавить("GTIN", Новый ОписаниеТипов("Строка"));
	
	НомерСтрокиПП = 0;
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("СтрокаТоваров") Цикл
		НомерСтрокиПП = НомерСтрокиПП + 1;
		
		СтруктураРеквизитовНоменклатуры = ПолучитьСтруктуруРеквизитовНоменклатуры(ЭлементДОМ);
		Если СтруктураРеквизитовНоменклатуры.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		НомерЗаказа = ЭлементДОМ.ПолучитьЭлементыПоИмени("НомерЗаказа").Элемент(0).ТекстовоеСодержимое;
		ДатаЗаказа = ПреобразоватьДату(ЭлементДОМ.ПолучитьЭлементыПоИмени("ДатаЗаказа").Элемент(0).ТекстовоеСодержимое);
		
		Заказ = НайтиЗаказ(НомерЗаказа, ДатаЗаказа);
		Товар = ПолучитьНоменклатуру(СтруктураРеквизитовНоменклатуры);
		
		Если Не ЗначениеЗаполнено(Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаТоваров = ТЗТоваров.Добавить();
		
		НоваяСтрокаТоваров.НомерСтрокиЗаказа = НомерСтрокиПП;
		//НоваяСтрокаТоваров.ШтрихКодТовара = Прав("0000" + ЭлементДОМ.ПолучитьЭлементыПоИмени("PRODUCT").Элемент(0).ТекстовоеСодержимое, 13);
		НоваяСтрокаТоваров.Номенклатура = Товар;
		НоваяСтрокаТоваров.Характеристика = ПолучитьХарактеристику(СтруктураРеквизитовНоменклатуры, НоваяСтрокаТоваров.Номенклатура);
		НоваяСтрокаТоваров.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию(СокрЛП(ЭлементДОМ.ПолучитьЭлементыПоИмени("СтавкаНДС").Элемент(0).ТекстовоеСодержимое));
		НоваяСтрокаТоваров.ЗаказПокупателя = Заказ;
		НоваяСтрокаТоваров.Количество = ЭлементДОМ.ПолучитьЭлементыПоИмени("Количество").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.Сумма = ЭлементДОМ.ПолучитьЭлементыПоИмени("Сумма").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.Цена = ЭлементДОМ.ПолучитьЭлементыПоИмени("Цена").Элемент(0).ТекстовоеСодержимое;
		
	КонецЦикла;
	
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("СтрокаУпаковки") Цикл
		НомерСтрокиПП = НомерСтрокиПП + 1;
		
		СтруктураРеквизитовУпаковки = ПолучитьСтруктуруРеквизитовУпаковки(ЭлементДОМ);
		
		//НоваяСтрокаТоваров.ДокИД = НоваяСтрокаДок.ДокИД;
		//НоваяСтрокаТоваров.НомерСтрокиЗаказа = НомерСтрокиПП;
		Если СтруктураРеквизитовУпаковки.Количество() <> 0 Тогда
			//НоваяСтрокаТоваров.ШтрихКодТовара = Прав("0000" + ЭлементДОМ.ПолучитьЭлементыПоИмени("PRODUCT").Элемент(0).ТекстовоеСодержимое, 13);
			НоваяСтрокаТоваров = ТЗКМ.Добавить();
			ГУИД = ЭлементДОМ.ПолучитьЭлементыПоИмени("ГУИД").Элемент(0).ТекстовоеСодержимое;
			Если ПустаяСтрока(ГУИД) Или ГУИД = "00000000-0000-0000-0000-000000000000" Тогда
			Иначе
				НовыйGUID = Новый УникальныйИдентификатор(ГУИД);
				Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(НовыйGUID); 
				Если ОбщегоНазначения.СсылкаСуществует(Номенклатура) Тогда
					НоваяСтрокаТоваров.Номенклатура = Номенклатура;
				КонецЕсли;
			КонецЕсли;
			
			ГУИДХарактеристики = ЭлементДОМ.ПолучитьЭлементыПоИмени("ГУИДХарактеристики").Элемент(0).ТекстовоеСодержимое;
			Если ПустаяСтрока(ГУИДХарактеристики) Или ГУИДХарактеристики = "00000000-0000-0000-0000-000000000000" Тогда
			Иначе
				НовыйGUID = Новый УникальныйИдентификатор(ГУИДХарактеристики);
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(НовыйGUID); 
				Если ОбщегоНазначения.СсылкаСуществует(Характеристика) Тогда
					НоваяСтрокаТоваров.Характеристика = Характеристика;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрокаТоваров.ШтрихкодУпаковки = ПолучитьУпаковку(СтруктураРеквизитовУпаковки, НоваяСтрокаТоваров.Номенклатура, НоваяСтрокаТоваров.Характеристика);
			
			П1 = СтрНайти(СтруктураРеквизитовУпаковки.ЗначениеШтрихкода, "(01)");
			ГТИН = Сред(СтруктураРеквизитовУпаковки.ЗначениеШтрихкода, П1 + 4, 14);
			
			НоваяСтрокаТоваров.GTIN = ГТИН;
			ПолныйКодМаркировки = ЭлементДОМ.ПолучитьЭлементыПоИмени("ПолныйКодМаркировки").Элемент(0).ТекстовоеСодержимое;
			
			НоваяСтрокаТоваров.ПолныйКодМаркировки = ПолучитьИсправленныйКМ(ПолныйКодМаркировки, НоваяСтрокаТоваров.Номенклатура);
			НоваяСтрокаТоваров.ШтрихкодУпаковкиСкан = ЭлементДОМ.ПолучитьЭлементыПоИмени("ШтрихкодУпаковкиСкан").Элемент(0).ТекстовоеСодержимое;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ДокЗаказ = ПолучитьЗаказНаПеремещение(Номер, Дата);
	//Если Док.Проведен Тогда
	//	Возврат;
	//КонецЕсли;
	ДокЗаказ.Запасы.Очистить();
	ДокЗаказ.СерииНоменклатуры.Очистить();
	ДокЗаказ.ДополнительныеРеквизиты.Очистить();

	ДокЗаказ.Дата = Дата-1;
	ДокЗаказ.Заполнить(Неопределено);
	ДокЗаказ.Номер = Номер;
	ДокЗаказ.ДатаПеремещения = ДатаПриемки;
	ДокЗаказ.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
	ДокЗаказ.ПоложениеЗаказаПокупателя = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
	ДокЗаказ.Организация = ПолучитьОрганизацию(СтруктураОрганизация);
	
	Если Не ЗначениеЗаполнено(ДокЗаказ.Организация) Тогда
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Заказы", УровеньЖурналаРегистрации.Ошибка, , , "Пустая организация в перемещении " + Номер + Символы.ПС + СтруктураОрганизация.Наименование); 
		Возврат;
	КонецЕсли;
	
	ДокЗаказ.СтруктурнаяЕдиницаРезерв = Склад;
	ДокЗаказ.СтруктурнаяЕдиницаПолучатель = СкладПолучатель;
	
	ДокЗаказ.Автор = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
	
	ТекстОшибки = "";
	Для Каждого СтрокаТЗ Из ТЗТоваров Цикл
		
		СтрокаТЧ = ДокЗаказ.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			ТекстОшибки = ТекстОшибки + "Не найдена номенклатура " + Символы.ПС;
		КонецЕсли;
		СтрокаТЧ.ЕдиницаИзмерения = СтрокаТЧ.Номенклатура.ЕдиницаИзмерения;
		
	КонецЦикла;
	ДокЗаказ.Комментарий = "#Загружен из УТ10 " + ТекущаяДатаСеанса();
	
	ДокЗаказ.Записать();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ДокЗаказ.Ссылка, ДокЗаказ.Ссылка);
	Если Проведен Тогда
		МассивДокументовКПроведению.Добавить(ДокЗаказ.Ссылка);
	КонецЕсли;	
	
	Док = ПолучитьПеремещение(Номер, Дата);
	//Если Док.Проведен Тогда
	//	Возврат;
	//КонецЕсли;
	Док.Запасы.Очистить();
	Док.СерииНоменклатуры.Очистить();
	Док.ДополнительныеРеквизиты.Очистить();
	Док.ШтрихкодыУпаковок.Очистить();
	
	//Док = Документы.РасходнаяНакладная.СоздатьДокумент();
	Док.Дата = ДатаПриемки;
	Док.Заполнить(Неопределено);
	Док.Номер = Номер;
	Док.ЗаказНаПеремещение = ДокЗаказ.Ссылка;
	Док.ДокументОснование = ДокЗаказ.Ссылка;
	//Док.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
	Док.ПоложениеЗаказаПокупателя = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
	Док.Организация = ПолучитьОрганизацию(СтруктураОрганизация);
	
	Если Не ЗначениеЗаполнено(Док.Организация) Тогда
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Заказы", УровеньЖурналаРегистрации.Ошибка, , , "Пустая организация в перемещении " + Номер + Символы.ПС + СтруктураОрганизация.Наименование); 
		Возврат;
	КонецЕсли;
	
	Док.СтруктурнаяЕдиница = Склад;
	Док.СтруктурнаяЕдиницаПолучатель = СкладПолучатель;
	
	Док.Автор = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
	
	ТекстОшибки = "";
	Для Каждого СтрокаТЗ Из ТЗТоваров Цикл
		
		СтрокаТЧ = Док.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			ТекстОшибки = ТекстОшибки + "Не найдена номенклатура " + Символы.ПС;
		КонецЕсли;
		СтрокаТЧ.ЕдиницаИзмерения = СтрокаТЧ.Номенклатура.ЕдиницаИзмерения;
		
	КонецЦикла;
	
	ДобавитьДанныеПоМаркировке(Док, ТЗКМ);
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = "Ошибок нет";	
	КонецЕсли;	
	Док.Комментарий = "#Загружен из УТ10 " + Символы.ПС + ТекстОшибки;

	Док.ОбменДанными.Загрузка = Истина;
	Док.Записать();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Док.Ссылка, Док.Ссылка);
	Если Проведен Тогда
		МассивДокументовКПроведению.Добавить(Док.Ссылка);
	КонецЕсли;
	
	Если Склад.ОрдерныйСклад И Склад.ИспользоватьОрдернуюСхемуПриПеремещении Тогда
		МассивОрдеров = ВС_ОбщегоНазначения.ПолучитьПодчиненныеДокументы(Док.Ссылка, Ложь, "РасходныйОрдер");
		Если МассивОрдеров.Количество() > 0 Тогда
			ДокОрдер = МассивОрдеров[0].ПолучитьОбъект();
		Иначе
			ДокОрдер = Документы.РасходныйОрдер.СоздатьДокумент();
		КонецЕсли;
		
		ДокОрдер.Заполнить(Док.Ссылка);
		ДокОрдер.Комментарий = "#Загружен из УТ10 " + Символы.ПС + ТекстОшибки;
		
		ДокОрдер.Записать();
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ДокОрдер.Ссылка, ДокОрдер.Ссылка);
		Если Проведен Тогда 
			МассивДокументовКПроведению.Добавить(ДокОрдер.Ссылка);
		КонецЕсли;
	КонецЕсли;
	Если СкладПолучатель.ОрдерныйСклад И СкладПолучатель.ИспользоватьОрдернуюСхемуПриПеремещении Тогда
		МассивОрдеров = ВС_ОбщегоНазначения.ПолучитьПодчиненныеДокументы(Док.Ссылка, Ложь, "ПриходныйОрдер");
		Если МассивОрдеров.Количество() > 0 Тогда
			ДокОрдер = МассивОрдеров[0].ПолучитьОбъект();
		Иначе
			ДокОрдер = Документы.ПриходныйОрдер.СоздатьДокумент();
		КонецЕсли;
		
		ДокОрдер.Заполнить(Док.Ссылка);
		ДокОрдер.Комментарий = "#Загружен из УТ10 " + Символы.ПС + ТекстОшибки;
		
		ДокОрдер.Записать();
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ДокОрдер.Ссылка, ДокОрдер.Ссылка);
		Если Проведен Тогда 
			МассивДокументовКПроведению.Добавить(ДокОрдер.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураОрганизация.ИНН = СтруктураКонтрагент.ИНН Тогда
		Возврат;
	КонецЕсли;
	
	ДокПередачи = ПолучитьПередачу(Док.Ссылка);
	ДокПередачи.Запасы.Очистить();
	ДокПередачи.СерииНоменклатуры.Очистить();
	ДокПередачи.ДополнительныеРеквизиты.Очистить();
	ДокПередачи.ШтрихкодыУпаковок.Очистить();
	
	ДокПередачи.Дата = ДатаПриемки + 5;
	ДокПередачи.Заполнить(Док.Ссылка);
	ДокПередачи.Комментарий = "#Загружен из УТ10 " + СокрЛП(Док.Номер);
	ДокПередачи.Автор = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
	
	Для Каждого СтрокаТЧ Из ДокПередачи.Запасы Цикл
		
		Если СтрокаТЧ.Цена = 0 И ЗначениеЗаполнено(СтрокаТЧ.ЗаказПокупателя) Тогда
			СтруктураОтбораСтрокиЗаказ = Новый Структура;
			СтруктураОтбораСтрокиЗаказ.Вставить("Номенклатура", СтрокаТЧ.Номенклатура); 
			СтруктураОтбораСтрокиЗаказ.Вставить("Характеристика", СтрокаТЧ.Характеристика);
			НайденныеСтроки = СтрокаТЧ.ЗаказПокупателя.Запасы.НайтиСтроки(СтруктураОтбораСтрокиЗаказ);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокаТЧ.Цена = 1; 
			Иначе
				СтрокаТЧ.Цена = НайденныеСтроки[0].Цена;
			КонецЕсли;
			СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
			СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТЧ.СтавкаНДС);
			Если ДокПередачи.СуммаВключаетНДС Тогда
				СтрокаТЧ.СуммаНДС = СтрокаТЧ.Сумма - (СтрокаТЧ.Сумма) / ((СтавкаНДС + 100) / 100);
				СтрокаТЧ.Всего = СтрокаТЧ.Сумма;
			Иначе
				СтрокаТЧ.СуммаНДС = СтрокаТЧ.Сумма * СтавкаНДС / 100;
				СтрокаТЧ.Всего = СтрокаТЧ.Сумма + СтрокаТЧ.СуммаНДС;
			КонецЕсли;
		ИначеЕсли СтрокаТЧ.Цена = 0 Тогда
			
			СтрокаТЧ.Цена = 1; 
			СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
			СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТЧ.СтавкаНДС);
			Если ДокПередачи.СуммаВключаетНДС Тогда
				СтрокаТЧ.СуммаНДС = СтрокаТЧ.Сумма - (СтрокаТЧ.Сумма) / ((СтавкаНДС + 100) / 100);
				СтрокаТЧ.Всего = СтрокаТЧ.Сумма;
			Иначе
				СтрокаТЧ.СуммаНДС = СтрокаТЧ.Сумма * СтавкаНДС / 100;
				СтрокаТЧ.Всего = СтрокаТЧ.Сумма + СтрокаТЧ.СуммаНДС;
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла;
	
	ДокПередачи.Записать();
	
	Если Проведен Тогда
		МассивДокументовКПроведению.Добавить(ДокПередачи.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьПоступление(мДокументДОМ, МассивДокументовКПроведению)
	Перем ВариантыОбеспечения;
	
	Номер = мДокументДОМ.ПолучитьЭлементыПоИмени("Номер").Элемент(0).ТекстовоеСодержимое;
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
	Если мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Количество() = 0 Тогда
		Проведен = Истина;;
	Иначе
		Проведен = Булево(мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Элемент(0).ТекстовоеСодержимое);
	КонецЕсли;

	СтруктураОрганизация = Новый Структура;
	СтруктураОрганизация.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Организация").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияИНН").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураКонтрагент = Новый Структура;
	СтруктураКонтрагент.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентИНН").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("КПП", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентКПП").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("ТиповойПокупатель", мДокументДОМ.ПолучитьЭлементыПоИмени("ТиповойПокупатель").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураКонтрагент.Вставить("ЮрАдрес", 		мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентЮрАдрес").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Адрес", 			мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентАдрес").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Телефон", 		мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентТелефон").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Почта", 			СтрЗаменить(мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентПочта").Элемент(0).ТекстовоеСодержимое, " ", ""));
	СтруктураКонтрагент.Вставить("Удостоверение", 	мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентУдостоверение").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Покупатель", 		Истина);
	СтруктураКонтрагент.Вставить("Поставщик", 		Ложь);
	
	СтруктураДоговор = Новый Структура;
	СтруктураДоговор.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураДоговор.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураДоговор.Вставить("Номер", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорНомер").Элемент(0).ТекстовоеСодержимое);
	СтруктураДоговор.Вставить("Дата", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорДата").Элемент(0).ТекстовоеСодержимое);
	СтруктураДоговор.Вставить("Вид", мДокументДОМ.ПолучитьЭлементыПоИмени("ВидДоговора").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураСклад = Новый Структура;
	СтруктураСклад.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Склад").Элемент(0).ТекстовоеСодержимое);
	СтруктураСклад.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладНаименование").Элемент(0).ТекстовоеСодержимое);
	Склад = ПолучитьСклад(СтруктураСклад);

	СтруктураПодразделение = Новый Структура;
	СтруктураПодразделение.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Подразделение").Элемент(0).ТекстовоеСодержимое);
	СтруктураПодразделение.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ПодразделениеНаименование").Элемент(0).ТекстовоеСодержимое);
	
	МенеджерТекст = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Менеджер").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураДопТаблиц = ПолучитьДопТаблицы();
	
	ТЗТоваров = Новый ТаблицаЗначений;
	ТЗТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗТоваров.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	ТЗТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	ТЗТоваров.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	
	ТЗКМ = Новый ТаблицаЗначений;
	ТЗКМ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗКМ.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗКМ.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	ТЗКМ.Колонки.Добавить("ПолныйКодМаркировки", Новый ОписаниеТипов("Строка"));
	ТЗКМ.Колонки.Добавить("ШтрихкодУпаковкиСкан", Новый ОписаниеТипов("Строка"));
	ТЗКМ.Колонки.Добавить("GTIN", Новый ОписаниеТипов("Строка"));
	
	НомерСтрокиПП = 0;
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("СтрокаТоваров") Цикл
		НомерСтрокиПП = НомерСтрокиПП + 1;
		
		СтруктураРеквизитовНоменклатуры = ПолучитьСтруктуруРеквизитовНоменклатуры(ЭлементДОМ);
		
		НоваяСтрокаТоваров = ТЗТоваров.Добавить();
		//НоваяСтрокаТоваров.ДокИД = НоваяСтрокаДок.ДокИД;
		Если СтруктураРеквизитовНоменклатуры.Количество() <> 0 Тогда
			//НоваяСтрокаТоваров.ШтрихКодТовара = Прав("0000" + ЭлементДОМ.ПолучитьЭлементыПоИмени("PRODUCT").Элемент(0).ТекстовоеСодержимое, 13);
			НоваяСтрокаТоваров.Номенклатура = ПолучитьНоменклатуру(СтруктураРеквизитовНоменклатуры, Истина);
			НоваяСтрокаТоваров.Характеристика = ПолучитьХарактеристику(СтруктураРеквизитовНоменклатуры, НоваяСтрокаТоваров.Номенклатура);
			НоваяСтрокаТоваров.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию(СокрЛП(ЭлементДОМ.ПолучитьЭлементыПоИмени("СтавкаНДС").Элемент(0).ТекстовоеСодержимое));
		КонецЕсли;
		НоваяСтрокаТоваров.Количество = ЭлементДОМ.ПолучитьЭлементыПоИмени("Количество").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.Сумма = ЭлементДОМ.ПолучитьЭлементыПоИмени("Сумма").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.Цена = ЭлементДОМ.ПолучитьЭлементыПоИмени("Цена").Элемент(0).ТекстовоеСодержимое;
		
		Если ЗначениеЗаполнено(НоваяСтрокаТоваров.Номенклатура) И ЭлементДОМ.ПолучитьЭлементыПоИмени("ЦенаРозница").Количество() > 0 Тогда
			ЦенаРозница = ЭлементДОМ.ПолучитьЭлементыПоИмени("ЦенаРозница").Элемент(0).ТекстовоеСодержимое;
			Если ЗначениеЗаполнено(ЦенаРозница) Тогда
				СтрокаТаблицыЗначений = СтруктураДопТаблиц.ТаблицаЦен.Добавить();
				СтрокаТаблицыЗначений.Период = Дата + 1; 
				СтрокаТаблицыЗначений.ВидЦены = Справочники.ВидыЦен.Оптовая;
				СтрокаТаблицыЗначений.Номенклатура = НоваяСтрокаТоваров.Номенклатура;
				СтрокаТаблицыЗначений.Характеристика = НоваяСтрокаТоваров.Характеристика;
				СтрокаТаблицыЗначений.Цена    = ЦенаРозница;
			КонецЕсли;
			
			СтрокаТаблицыЗначений = СтруктураДопТаблиц.ТаблицаЦен.Добавить();
			СтрокаТаблицыЗначений.Период = Дата + 1; 
			СтрокаТаблицыЗначений.ВидЦены = Справочники.ВидыЦен.Учетная;
			СтрокаТаблицыЗначений.Номенклатура = НоваяСтрокаТоваров.Номенклатура;
			СтрокаТаблицыЗначений.Характеристика = НоваяСтрокаТоваров.Характеристика;
			СтрокаТаблицыЗначений.Цена    = ЭлементДОМ.ПолучитьЭлементыПоИмени("ЦенаУчетная").Элемент(0).ТекстовоеСодержимое; 
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("СтрокаУпаковки") Цикл
		НомерСтрокиПП = НомерСтрокиПП + 1;
		
		СтруктураРеквизитовУпаковки = ПолучитьСтруктуруРеквизитовУпаковки(ЭлементДОМ);
		
		НоваяСтрокаТоваров = ТЗКМ.Добавить();
		//НоваяСтрокаТоваров.ДокИД = НоваяСтрокаДок.ДокИД;
		//НоваяСтрокаТоваров.НомерСтрокиЗаказа = НомерСтрокиПП;
		Если СтруктураРеквизитовУпаковки.Количество() <> 0 Тогда
			//НоваяСтрокаТоваров.ШтрихКодТовара = Прав("0000" + ЭлементДОМ.ПолучитьЭлементыПоИмени("PRODUCT").Элемент(0).ТекстовоеСодержимое, 13);
			
			ГУИД = ЭлементДОМ.ПолучитьЭлементыПоИмени("ГУИД").Элемент(0).ТекстовоеСодержимое;
			Если ПустаяСтрока(ГУИД) Или ГУИД = "00000000-0000-0000-0000-000000000000" Тогда
			Иначе
				НовыйGUID = Новый УникальныйИдентификатор(ГУИД);
				Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(НовыйGUID); 
				Если ОбщегоНазначения.СсылкаСуществует(Номенклатура) Тогда
					НоваяСтрокаТоваров.Номенклатура = Номенклатура;
				КонецЕсли;
			КонецЕсли;
			
			ГУИДХарактеристики = ЭлементДОМ.ПолучитьЭлементыПоИмени("ГУИДХарактеристики").Элемент(0).ТекстовоеСодержимое;
			Если ПустаяСтрока(ГУИДХарактеристики) Или ГУИДХарактеристики = "00000000-0000-0000-0000-000000000000" Тогда
			Иначе
				НовыйGUID = Новый УникальныйИдентификатор(ГУИДХарактеристики);
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(НовыйGUID); 
				Если ОбщегоНазначения.СсылкаСуществует(Характеристика) Тогда
					НоваяСтрокаТоваров.Характеристика = Характеристика;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрокаТоваров.ШтрихкодУпаковки = ПолучитьУпаковку(СтруктураРеквизитовУпаковки, НоваяСтрокаТоваров.Номенклатура, НоваяСтрокаТоваров.Характеристика);
		КонецЕсли;
		
		П1 = СтрНайти(СтруктураРеквизитовУпаковки.ЗначениеШтрихкода, "(01)");
		ГТИН = Сред(СтруктураРеквизитовУпаковки.ЗначениеШтрихкода, П1 + 4, 14);
		
	    НоваяСтрокаТоваров.GTIN = ГТИН;
		ПолныйКодМаркировки = ЭлементДОМ.ПолучитьЭлементыПоИмени("ПолныйКодМаркировки").Элемент(0).ТекстовоеСодержимое;
		
		НоваяСтрокаТоваров.ПолныйКодМаркировки = ПолучитьИсправленныйКМ(ПолныйКодМаркировки, НоваяСтрокаТоваров.Номенклатура);
		НоваяСтрокаТоваров.ШтрихкодУпаковкиСкан = ЭлементДОМ.ПолучитьЭлементыПоИмени("ШтрихкодУпаковкиСкан").Элемент(0).ТекстовоеСодержимое;
		
	КонецЦикла; 
	
		//Сообщить(Номер);
		Док = ПолучитьПоступление(Номер, Дата);
		Если Док.Проведен Тогда
			Возврат;
		КонецЕсли;
		Док.Запасы.Очистить();
		Док.СерииНоменклатуры.Очистить();
		Док.ДополнительныеРеквизиты.Очистить();
		Док.ШтрихкодыУпаковок.Очистить();
		
		//Док = Документы.РасходнаяНакладная.СоздатьДокумент();
		Док.Дата = Дата;
		Док.Заполнить(Неопределено);
		Док.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика;
		Док.Организация = ПолучитьОрганизацию(СтруктураОрганизация);
		Если Не ЗначениеЗаполнено(Док.Организация) Тогда
			ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.ПриходныеНакладные", УровеньЖурналаРегистрации.Ошибка, , , "Пустая организация в накладной " + Номер + Символы.ПС + СтруктураОрганизация.Наименование); 
			Возврат;
		КонецЕсли;
		
		//Док.Заказ = ЗаказПокупателя;
		//Если ЗначениеЗаполнено(Док.Организация) 
		//	И ЗначениеЗаполнено(Док.Организация.КассаПоУмолчанию) Тогда
		//	Док.ПодписьКассира = Док.Организация.КассаПоУмолчанию.ПодписьКассира;
		//КонецЕсли;
		
		Док.Контрагент = ПолучитьКонтрагента(СтруктураКонтрагент);
		ЗаполнитьДоговорПоУмолчанию(Док, СтруктураДоговор);
		Док.СтруктурнаяЕдиница = Склад;
		Если ЗначениеЗаполнено(Склад) И ЗначениеЗаполнено(Склад.Родитель) И НЕ Склад.Родитель.ЭтоГруппа 
			И Склад.Родитель.ТипСтруктурнойЕдиницы = Перечисления.ТипыСтруктурныхЕдиниц.Подразделение Тогда
			Док.Подразделение = Склад.Родитель;
		Иначе
			Док.Подразделение = ПолучитьПодразделение(СтруктураПодразделение);
		КонецЕсли;
		//Док.ДисконтнаяКарта = ПолучитьКарту(СтруктураКарта, Док.Контрагент);
		
		Менеджер = ПолучитьМенеджера(МенеджерТекст);
		Если ЗначениеЗаполнено(Менеджер) Тогда
			Док.Ответственный = Менеджер;
		Иначе
			Док.Ответственный = Док.Контрагент.Ответственный;
		КонецЕсли;
		Док.Автор = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
		
		//Док.АдресДоставки = СокрЛП(АдресДоставки);
		//Док.ДатаОтгрузки = ДатаПоставки;
		//Если Не ЗначениеЗаполнено(Док.ДатаОтгрузки) Тогда
		//	Док.ДатаОтгрузки = Дата + 24*60*60;
		//КонецЕсли;
		Док.ДатаВходящегоДокумента = Дата;
		Док.НомерВходящегоДокумента = Номер;
		Док.СуммаВключаетНДС = Истина;
		Док.СпособЗачетаПредоплаты = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто;
		Док.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;

		Док.ЭтоУниверсальныйДокумент = Истина;	
		
		НастройкиНДС = НалогиУНФ.НастройкиНДСОрганизации(Док.Организация, Док.СтруктурнаяЕдиница, Док.Дата);
		Док.НалогообложениеНДС = НастройкиНДС.ТипНалогообложения;
		ВидСтавкиНДСПоУмолчанию = НастройкиНДС.ВидСтавкиНДС;
		
		ТекстОшибки = "";
		Для Каждого СтрокаТЗ Из ТЗТоваров Цикл
			
			СтрокаТЧ = Док.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
			Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
				ТекстОшибки = ТекстОшибки + "Не найдена номенклатура " + Символы.ПС;
			КонецЕсли;
			СтрокаТЧ.СтруктурнаяЕдиница = Склад;
			//СтрокаТЧ.ЗаказПокупателя = ЗаказПокупателя;
			СтрокаТЧ.ЕдиницаИзмерения = СтрокаТЧ.Номенклатура.ЕдиницаИзмерения;
			//СтрокаТЧ.СуммаСкидкиНаценки = СтрокаТЧ.Цена * СтрокаТЧ.Количество - СтрокаТЧ.Сумма;
			
			//Если СтрокаТЧ.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас Тогда
			//	СтрокаТЧ.ТипНоменклатурыЗапас = Истина;
			//КонецЕсли;
		
			ПараметрыРасчета = Новый Структура("СброситьФлагСкидкиРассчитаны",Истина);
			ПараметрыРасчета.Вставить("СуммаВключаетНДС", Док.СуммаВключаетНДС); 
			ПараметрыРасчета.Вставить("РассчитатьПроцентСкидки", Истина);
			ПараметрыРасчета.Вставить("ИспользоватьМинимальныеЦены", Ложь);
			//ПараметрыРасчета.Вставить("КорректировкаСуммыЗаСчетРучнойСкидки", Истина);
			
			ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммыВСтрокеТЧ(СтрокаТЧ, ПараметрыРасчета);
			
			
		КонецЦикла;
		НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти(Док, "Запасы", Истина, ВидСтавкиНДСПоУмолчанию);
		//Док.ЗаполнитьКолонкуРезервПоРезервам();
		
		ДобавитьДанныеПоМаркировке(Док, ТЗКМ);
		
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "Ошибок нет";	
		КонецЕсли;	
		Док.Комментарий = "#Загружен из УТ10 " + Символы.ПС + ТекстОшибки;
		
		Док.Записать();
		Если Док.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС 
			И СчетаФактурыУНФ.ПолучитьПодчиненныйСчетФактуру(Док.Ссылка, Истина) = Неопределено Тогда
			ПараметрыСчетФактуры = СчетаФактурыУНФ.СоздатьСчетФактуру(Док.Ссылка, Док.ДатаВходящегоДокумента, Док.НомерВходящегоДокумента);
		КонецЕсли;
		
	
	Если Проведен Тогда
		МассивДокументовКПроведению.Добавить(Док.Ссылка);
		
		ЗаписатьТаблицуЦен(СтруктураДопТаблиц.ТаблицаЦен, МассивДокументовКПроведению, Истина, Док.Ссылка);
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Док.Ссылка, Док.Ссылка);
	
	Если Склад.ОрдерныйСклад И Склад.ИспользоватьОрдернуюСхемуПриПоступлении Тогда
		МассивОрдеров = ВС_ОбщегоНазначения.ПолучитьПодчиненныеДокументы(Док.Ссылка, Ложь, "ПриходныйОрдер");
		Если МассивОрдеров.Количество() > 0 Тогда
			ДокОрдер = МассивОрдеров[0].ПолучитьОбъект();
		Иначе
			ДокОрдер = Документы.ПриходныйОрдер.СоздатьДокумент();
		КонецЕсли;
		
		ДокОрдер.Заполнить(Док.Ссылка);
		ДокОрдер.Комментарий = "#Загружен из УТ10 " + Символы.ПС + ТекстОшибки;
		
		ДокОрдер.Записать();
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ДокОрдер.Ссылка, ДокОрдер.Ссылка);
		Если Проведен Тогда
			МассивДокументовКПроведению.Добавить(ДокОрдер.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьОплатуКартой(мДокументДОМ, МассивДокументовКПроведению)
	
	Номер = мДокументДОМ.ПолучитьЭлементыПоИмени("Номер").Элемент(0).ТекстовоеСодержимое;
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
    ВидОперации = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("ВидОперации").Элемент(0).ТекстовоеСодержимое);
	
	Если мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Количество() = 0 Тогда
		Проведен = Истина;;
	Иначе
		Проведен = Булево(мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Элемент(0).ТекстовоеСодержимое);
	КонецЕсли;

	СтруктураОрганизация = Новый Структура;
	СтруктураОрганизация.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Организация").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияИНН").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураКонтрагент = Новый Структура;
	СтруктураКонтрагент.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентИНН").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("КПП", мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентКПП").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("ТиповойПокупатель", мДокументДОМ.ПолучитьЭлементыПоИмени("ТиповойПокупатель").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураКонтрагент.Вставить("ЮрАдрес", 		мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентЮрАдрес").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Адрес", 			мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентАдрес").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Телефон", 		мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентТелефон").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Почта", 			СтрЗаменить(мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентПочта").Элемент(0).ТекстовоеСодержимое, " ", ""));
	СтруктураКонтрагент.Вставить("Удостоверение", 	мДокументДОМ.ПолучитьЭлементыПоИмени("КонтрагентУдостоверение").Элемент(0).ТекстовоеСодержимое);
	СтруктураКонтрагент.Вставить("Покупатель", 		Истина);
	СтруктураКонтрагент.Вставить("Поставщик", 		Ложь);
	
	СтруктураПодразделение = Новый Структура;
	СтруктураПодразделение.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Подразделение").Элемент(0).ТекстовоеСодержимое);
	СтруктураПодразделение.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ПодразделениеНаименование").Элемент(0).ТекстовоеСодержимое);
	Подразделение = ПолучитьПодразделение(СтруктураПодразделение); 
			
	СтруктураТерминал = Новый Структура;
	СтруктураТерминал.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорЭквайринга").Элемент(0).ТекстовоеСодержимое);
	СтруктураТерминал.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ДоговорЭквайрингаНаименование").Элемент(0).ТекстовоеСодержимое);
	
	МенеджерТекст = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Менеджер").Элемент(0).ТекстовоеСодержимое);
	
	//ОписаниеЗаказа = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Сайт").Элемент(0).ТекстовоеСодержимое);
	
	//ТипЗаказа = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Тип").Элемент(0).ТекстовоеСодержимое);
	//СтатусЗаказа = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Статус").Элемент(0).ТекстовоеСодержимое);
	//Источник = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Источник").Элемент(0).ТекстовоеСодержимое);
	//АдресДоставки = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("АдресДоставки").Элемент(0).ТекстовоеСодержимое);
	//ВидОплаты = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("ВидОплаты").Элемент(0).ТекстовоеСодержимое);
	//ДатаОплаты = ПреобразоватьДату(СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("ДатаОплаты").Элемент(0).ТекстовоеСодержимое));
	
	ТЗОплат = Новый ТаблицаЗначений;
	ТЗОплат.Колонки.Добавить("СтавкаНДС", 		Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	ТЗОплат.Колонки.Добавить("СуммаРасчетов", 	Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
