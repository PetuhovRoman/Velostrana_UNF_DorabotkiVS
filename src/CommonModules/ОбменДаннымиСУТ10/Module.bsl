Процедура ЗагрузитьОплатуПС(мДокументДОМ, МассивДокументовКПроведению)
	
	Номер = мДокументДОМ.ПолучитьЭлементыПоИмени("Номер").Элемент(0).ТекстовоеСодержимое;
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
	
	Если мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Количество() = 0 Тогда
		Проведен = Истина;;
	Иначе
		Проведен = Булево(мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Элемент(0).ТекстовоеСодержимое);
	КонецЕсли;
	
	Если Не Проведен Тогда
		Возврат;
	КонецЕсли;
	
	НомерЗаказа = мДокументДОМ.ПолучитьЭлементыПоИмени("НомерЗаказа").Элемент(0).ТекстовоеСодержимое;
	ДатаЗаказа = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("ДатаЗаказа").Элемент(0).ТекстовоеСодержимое);
	
	Заказ = НайтиЗаказ(НомерЗаказа, ДатаЗаказа); 
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПодарочныйСертификат = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Номенклатура?ref=b37a00155d014f0711e74ac01358921f");
	НомерСертификата = ПолучитьПодарочныйСертификат("", мДокументДОМ.ПолучитьЭлементыПоИмени("НомерСертификата").Элемент(0).ТекстовоеСодержимое, ПодарочныйСертификат, мДокументДОМ.ПолучитьЭлементыПоИмени("Номинал").Элемент(0).ТекстовоеСодержимое, мДокументДОМ.ПолучитьЭлементыПоИмени("Пинкод").Элемент(0).ТекстовоеСодержимое);
	Сумма = мДокументДОМ.ПолучитьЭлементыПоИмени("Сумма").Элемент(0).ТекстовоеСодержимое;
	
	Если Заказ.Предоплата.Найти(НомерСертификата, "НомерСертификата") = Неопределено Тогда
		
		Док = Заказ.ПолучитьОбъект();
		
		СтрокаОплат = Док.Предоплата.Добавить();
		СтрокаОплат.ОплатаСертификатом = Истина;
		СтрокаОплат.Документ = НомерСертификата.Владелец;
		СтрокаОплат.НомерСертификата = НомерСертификата;
		СтрокаОплат.СуммаРасчетов = Сумма;
		СтрокаОплат.Курс = 1;
		СтрокаОплат.Кратность = 1;
		
		СтрокаОплат.СуммаПогашенияСертификата = Сумма;
		СтрокаОплат.СуммаПлатежа = Сумма;
		
		//НоваяСтрокаОплат = Док.БезналичнаяОплата.Добавить();
		//НоваяСтрокаОплат.ВидОплаты = Перечисления.ВидыБезналичныхОплат.ПодарочныйСертификат;
		//НоваяСтрокаОплат.ПодарочныйСертификат = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Номенклатура?ref=b37a00155d014f0711e74ac01358921f");
		//НоваяСтрокаОплат.НомерСертификата = ПолучитьПодарочныйСертификат("", ЭлементДОМ.ПолучитьЭлементыПоИмени("НомерСертификата").Элемент(0).ТекстовоеСодержимое, НоваяСтрокаОплат.ПодарочныйСертификат);
		//НоваяСтрокаОплат.Сумма = ЭлементДОМ.ПолучитьЭлементыПоИмени("Сумма").Элемент(0).ТекстовоеСодержимое;
		//НоваяСтрокаОплат.СуммаПогашенияСертификата = НоваяСтрокаОплат.Сумма;
		
		Если ЗначениеЗаполнено(СтрокаОплат.НомерСертификата) И Не СтрокаОплат.НомерСертификата.Продан Тогда
			СертификатОбъект = СтрокаОплат.НомерСертификата.ПолучитьОбъект();
			СертификатОбъект.Продан = Истина;
			СертификатОбъект.Записать();
		КонецЕсли;
		
		Док.ОбменДанными.Загрузка = Истина;
		Док.Записать();
		
		МассивДокументовКПроведению.Добавить(Док.Ссылка);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обновлен документ " + Док.Ссылка, Док.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьЦены(мДокументДОМ, МассивДокументовКПроведению)
	
	Номер = мДокументДОМ.ПолучитьЭлементыПоИмени("Номер").Элемент(0).ТекстовоеСодержимое;
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
	Если мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Количество() = 0 Тогда
		Проведен = Истина;;
	Иначе
		Проведен = Булево(мДокументДОМ.ПолучитьЭлементыПоИмени("Проведен").Элемент(0).ТекстовоеСодержимое);
	КонецЕсли;

	МенеджерТекст = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Менеджер").Элемент(0).ТекстовоеСодержимое);
	
	ТаблицаЦен = Новый ТаблицаЗначений;
	ТаблицаЦен.Колонки.Добавить("Номенклатура", 		Новый ОписаниеТипов("СправочникСсылка.Номенклатура")); 
	ТаблицаЦен.Колонки.Добавить("Характеристика", 		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаЦен.Колонки.Добавить("ЕдиницаИзмерения", 	Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаЦен.Колонки.Добавить("ВидЦены",             	Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	ТаблицаЦен.Колонки.Добавить("Цена",                	Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТаблицаЦен.Колонки.Добавить("Валюта",              	Новый ОписаниеТипов("СправочникСсылка.Валюты")); 
	ТаблицаЦен.Колонки.Добавить("ВалютаСтарая",         Новый ОписаниеТипов("СправочникСсылка.Валюты")); 
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("СтрокаЦен") Цикл
		
		СтруктураРеквизитовНоменклатуры = ПолучитьСтруктуруРеквизитовНоменклатуры(ЭлементДОМ);
		
		НоваяСтрокаТоваров = ТаблицаЦен.Добавить();
		Если СтруктураРеквизитовНоменклатуры.Количество() <> 0 Тогда
			НоваяСтрокаТоваров.Номенклатура = ПолучитьНоменклатуру(СтруктураРеквизитовНоменклатуры);
		КонецЕсли;
		НоваяСтрокаТоваров.ВидЦены = ПолучитьВидЦен(ЭлементДОМ);

		НоваяСтрокаТоваров.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.шт;
		НоваяСтрокаТоваров.Валюта = НоваяСтрокаТоваров.ВидЦены.ВалютаЦены;
		НоваяСтрокаТоваров.ВалютаСтарая = НоваяСтрокаТоваров.ВидЦены.ВалютаЦены;
		
		НоваяСтрокаТоваров.Цена = ЭлементДОМ.ПолучитьЭлементыПоИмени("Цена").Элемент(0).ТекстовоеСодержимое;
	КонецЦикла;
	//ТаблицаЦен.ЗаполнитьЗначения(ВидЦены.ВалютаЦены, "Валюта");
	//ТаблицаЦен.ЗаполнитьЗначения(ВидЦены.ВалютаЦены, "ВалютаСтарая");
	//ТаблицаЦен.ЗаполнитьЗначения(Справочники.КлассификаторЕдиницИзмерения.шт, "ЕдиницаИзмерения");

	Док = ПолучитьУстановкуЦен(Номер, Дата);
	Док.Запасы.Очистить();
	Док.ДополнительныеРеквизиты.Очистить();
	
	//Док = Документы.РасходнаяНакладная.СоздатьДокумент();
	Док.Дата = Дата;
	Док.Номер = Номер;
	Док.Заполнить(Неопределено);
	
	Менеджер = ПолучитьМенеджера(МенеджерТекст);
	//Если ЗначениеЗаполнено(Менеджер) Тогда
	//	Док.Ответственный = Менеджер;
	//Иначе
	//	Док.Ответственный = Док.Контрагент.Ответственный;
	//КонецЕсли;
	Док.Автор = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
	
	Док.ПоказыватьДействующуюЦену = Истина;
	Док.ПоказыватьНовуюЦену = Истина;
	Док.ЗаписыватьНовыеЦеныПоверхУстановленных = Ложь;
	Док.УстанавливатьХарактеристикамБезЦен = Истина;
		
	Для Каждого СтрокаТЗ Из ТаблицаЦен Цикл
		
		СтрокаТЧ = Док.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
	КонецЦикла;
	
	Док.Комментарий = "#Загружен из УТ10 " + Символы.ПС;
	
	Док.ОбменДанными.Загрузка = Истина;
	Док.Записать();
	
	Если Проведен Тогда
		МассивДокументовКПроведению.Добавить(Док.Ссылка);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + Док.Ссылка, Док.Ссылка);

КонецПроцедуры


