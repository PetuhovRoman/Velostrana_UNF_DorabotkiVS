Функция ПолучитьУпаковку(Знач СтрокаТЧ, Товар, Характеристика)
	//СтрокаТЧ = ДанныеЗагрузки[0];
	
	Если ПустаяСтрока(СтрокаТЧ.ГУИД) Или СтрокаТЧ.ГУИД = "00000000-0000-0000-0000-000000000000" Тогда
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Наименование) Тогда
			Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
		КонецЕсли;
		Упаковка = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоНаименованию(СтрокаТЧ.Наименование, Истина, , Товар);
	Иначе
		НовыйGUID = Новый УникальныйИдентификатор(СтрокаТЧ.ГУИД);
		Упаковка = Справочники.ШтрихкодыУпаковокТоваров.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Упаковка) И ОбщегоНазначения.СсылкаСуществует(Упаковка) Тогда
		Возврат Упаковка;
	КонецЕсли;
	
		СпрХ = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
		СпрХ.УстановитьСсылкуНового(Упаковка);
		СпрХ.Номенклатура = Товар;
		СпрХ.Характеристика = Характеристика;
		//СпрХ.Наименование = СтрокаТЧ.Наименование;
		СпрХ.ДатаУпаковки = СтрокаТЧ.ДатаУпаковки;
		СпрХ.ТипУпаковки = ЗначениеПеречисления("ТипыУпаковок", СтрокаТЧ.ТипУпаковки);
		СпрХ.ТипШтрихкода = ЗначениеПеречисления("ТипыШтрихкодов", СтрокаТЧ.ТипШтрихкода);
		
		СпрХ.ЗначениеШтрихкода = СтрокаТЧ.ЗначениеШтрихкода;
		СпрХ.Количество = СтрокаТЧ.Количество;
		СпрХ.КоличествоПотребительскихУпаковок = СтрокаТЧ.КоличествоПотребительскихУпаковок;
		
		СпрХ.ХешСумма = СтрокаТЧ.ХешСумма;
		СпрХ.ХешСуммаЗначенияШтрихкода = СтрокаТЧ.ХешСуммаЗначенияШтрихкода;
		СпрХ.ХешСуммаНормализации = СтрокаТЧ.ХешСуммаНормализации;
		
		СпрХ.Записать();
		
		Упаковка = СпрХ.Ссылка;
		
	
	Возврат Упаковка;
	
КонецФункции

