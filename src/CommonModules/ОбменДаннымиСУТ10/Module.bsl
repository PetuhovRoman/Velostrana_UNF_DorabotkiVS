			//							ИЛИ (СтрокаТЧ.Номенклатура.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПодарочныйСертификат"));
										
			//ПараметрыРасчета = Новый Структура("СброситьФлагСкидкиРассчитаны",Истина);
