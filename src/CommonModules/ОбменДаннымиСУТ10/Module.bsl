Процедура ЗаписатьТаблицуЦен(ТаблицаЦен, МассивДокументовКПроведению, ПолнаяПерезапись = Ложь, Основание = Неопределено)
	
	Если ТаблицаЦен.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВидЦены = Справочники.ВидыЦен.Оптовая;
	ТаблицаЦен.ЗаполнитьЗначения(ВидЦены.ВалютаЦены, "Валюта");
	ТаблицаЦен.ЗаполнитьЗначения(ВидЦены.ВалютаЦены, "ВалютаСтарая");
	ТаблицаЦен.ЗаполнитьЗначения(Справочники.КлассификаторЕдиницИзмерения.шт, "ЕдиницаИзмерения");
	//ТаблицаЦен.Сортировать("Период");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаЦен.Период КАК Период,
	|	ТаблицаЦен.Номенклатура КАК Номенклатура,
	|	ТаблицаЦен.Характеристика КАК Характеристика,
	|	ТаблицаЦен.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаЦен.ВидЦены КАК ВидЦены,
	|	ТаблицаЦен.Цена КАК Цена,
	|	ТаблицаЦен.Валюта КАК Валюта,
	|	ТаблицаЦен.ВалютаСтарая КАК ВалютаСтарая
	|ПОМЕСТИТЬ ТаблицаЦен
	|ИЗ
	|	&ТаблицаЦен КАК ТаблицаЦен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МИНИМУМ(ТаблицаЦен.Период) КАК Период,
	|	ТаблицаЦен.Номенклатура КАК Номенклатура,
	|	ТаблицаЦен.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаЦен.ВидЦены КАК ВидЦены,
	|	ТаблицаЦен.Цена КАК Цена,
	|	ТаблицаЦен.Валюта КАК Валюта,
	|	ТаблицаЦен.ВалютаСтарая КАК ВалютаСтарая
	|ИЗ
	|	ТаблицаЦен КАК ТаблицаЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	|		ПО ТаблицаЦен.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|			И ТаблицаЦен.Характеристика = ЦеныНоменклатурыСрезПоследних.Характеристика
	|			И ТаблицаЦен.ВидЦены = ЦеныНоменклатурыСрезПоследних.ВидЦен
	|ГДЕ
	|	НЕ ТаблицаЦен.Цена = ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЦен.ЕдиницаИзмерения,
	|	ТаблицаЦен.ВидЦены,
	|	ТаблицаЦен.Цена,
	|	ТаблицаЦен.Валюта,
	|	ТаблицаЦен.ВалютаСтарая,
	|	ТаблицаЦен.Номенклатура
	|
	|";
	Запрос.УстановитьПараметр("ТаблицаЦен", ТаблицаЦен);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		
		ДатаДок = ТаблицаЗапроса[0].Период;
		ДокЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		ДокЦен.Дата = ДатаДок;
		
		Если ЗначениеЗаполнено(Основание) Тогда
			ДокЦен.ДокументОснование = Основание;
		КонецЕсли;
		
		ДокЦен.ПоказыватьДействующуюЦену = Истина;
		ДокЦен.ПоказыватьНовуюЦену = Истина;
		ДокЦен.ЗаписыватьНовыеЦеныПоверхУстановленных = ПолнаяПерезапись;
		ДокЦен.УстанавливатьХарактеристикамБезЦен = Истина;
		ДокЦен.Запасы.Загрузить(ТаблицаЗапроса);
	    ДокЦен.Записать(РежимЗаписиДокумента.Запись);
		
		МассивДокументовКПроведению.Добавить(ДокЦен.Ссылка);
		
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Цены", УровеньЖурналаРегистрации.Информация, , ДокЦен.Ссылка, "Создан документ " + ДокЦен.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьИсправленныйКМ(Знач КодМаркировки, Номенклатура)
	
	Если ЗначениеЗаполнено(КодМаркировки) Тогда
		
		СтруктураНоменклатурыИС = ОбщегоНазначенияИС.ОписаниеНоменклатуры(Номенклатура);
		СимволовСН = ПолучитьТоварнуюГруппуПоКлючу(СтруктураНоменклатурыИС[Номенклатура].КлючВидовПродукции);
		
		КМСтр = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.Base64ВШтрихкод(КодМаркировки);
		КМСтр = СтрЗаменить(КМСтр, "(01)", "01");
		КМСтр = СтрЗаменить(КМСтр, "(21)", "21");
		ДлинаМарки = СтрДлина(КМСтр);
		Если ДлинаМарки > 38 И СтрНайти(КМСтр, Символ(29)) = 0 Тогда
			ПолныйКМ = Сред(КМСтр,1,18+СимволовСН) + Символ(29) + Сред(КМСтр,18+СимволовСН + 1,6)+ Символ(29) + Сред(КМСтр,38,ДлинаМарки-(18+СимволовСН + 1 + 6)+1);
		ИначеЕсли ДлинаМарки > 30 И СтрНайти(КМСтр, Символ(29)) = 0 Тогда
			ПолныйКМ = Сред(КМСтр,1,18+СимволовСН) + Символ(29) + Сред(КМСтр,18+СимволовСН + 1,6);
		Иначе
			ПолныйКМ = КМСтр;
		КонецЕсли;
		Возврат ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.ШтрихкодВBase64(ПолныйКМ);
	КонецЕсли;
	
	Возврат КодМаркировки;
	
КонецФункции

Функция ПолучитьТоварнуюГруппуПоКлючу(Ключ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияЭлементовКонструктораВидовПродукцииИС.ЭлементКонструктора КАК ЭлементКонструктора,
	|	ЗначенияЭлементовКонструктораВидовПродукцииИС.Значение КАК ТоварнаяГруппа,
	|	ШаблоныКодовМаркировкиСУЗ.ДлинаСерийногоНомера КАК ДлинаСерийногоНомера
	|ИЗ
	|	РегистрСведений.ЗначенияЭлементовКонструктораВидовПродукцииИС КАК ЗначенияЭлементовКонструктораВидовПродукцииИС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиВидовПродукцииИС КАК КлючиВидовПродукцииИС
	|		ПО ЗначенияЭлементовКонструктораВидовПродукцииИС.ВидПродукции = КлючиВидовПродукцииИС.ВидПродукцииГИСМТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныКодовМаркировкиСУЗ КАК ШаблоныКодовМаркировкиСУЗ
	|		ПО ЗначенияЭлементовКонструктораВидовПродукцииИС.Значение = ШаблоныКодовМаркировкиСУЗ.ТоварнаяГруппа
	|ГДЕ
	|	ЗначенияЭлементовКонструктораВидовПродукцииИС.ЭлементКонструктора = ЗНАЧЕНИЕ(Справочник.ЭлементыКонструктораВидовПродукцииИС.ТоварныеГруппыГИСМТ)
	|	И КлючиВидовПродукцииИС.Ссылка = &Ключ
	|	И ШаблоныКодовМаркировкиСУЗ.ТипКодаМаркировки = ЗНАЧЕНИЕ(Перечисление.ТипыКодовМаркировкиИСМП.ЕдиницаТовара)";
	
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДлинаСерийногоНомера;
	КонецЕсли;
	
	Возврат 13;

КонецФункции

Функция ПолучитьЗаказ(Номер, Дата, ГУИД = "")
	
	Если Не ПустаяСтрока(ГУИД) И НЕ ГУИД = "00000000-0000-0000-0000-000000000000" Тогда
		НовыйGUID = Новый УникальныйИдентификатор(ГУИД);
		Док = Документы.ЗаказПокупателя.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Док) Тогда
		Возврат Док.ПолучитьОбъект();
	КонецЕсли;
	
	ЗапросПоЗаказу = Новый Запрос;
	ЗапросПоЗаказу.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказ
	|ГДЕ
	|	НЕ Заказ.ПометкаУдаления
	|	И Заказ.НомерВходящегоДокумента = &ВходящийНомер
	|	И НАЧАЛОПЕРИОДА(Заказ.Дата, ГОД) = &Дата";
	
	ЗапросПоЗаказу.УстановитьПараметр("ВходящийНомер", Номер);
	ЗапросПоЗаказу.УстановитьПараметр("Дата", НачалоГода(Дата));
	
	Выборка = ЗапросПоЗаказу.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	НовыйДок = Документы.ЗаказПокупателя.СоздатьДокумент();
	Если Не ПустаяСтрока(ГУИД) И НЕ ГУИД = "00000000-0000-0000-0000-000000000000" Тогда
		НовыйДок.УстановитьСсылкуНового(Док);
	КонецЕсли; 
	
	Возврат НовыйДок;
	
КонецФункции

Функция НайтиЗаказ(Номер, Дата)
	
	Если ПустаяСтрока(Номер) Тогда
