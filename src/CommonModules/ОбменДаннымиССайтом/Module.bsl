Функция ВыполнитьРасчетСкидокНаСервере(ОбъектДляРасчета, СтруктураПараметры)
	
	СтруктураПараметры.Вставить("ПрименятьКОбъекту", Ложь);
	СтруктураПараметры.Вставить("ТолькоПредварительныйРасчет", Ложь);
	СкидкиНаценкиСервер.ЗаполнитьКлючиСвязиВТабличнойЧастиТовары(ОбъектДляРасчета, "Запасы");
	
	СкидкиНаценкиСервер.ЗаполнитьКлючиСвязиВТабличнойЧастиТовары(ОбъектДляРасчета, "Запасы");
  	РасчетныеСкидки = СкидкиНаценкиСерверПереопределяемый.ВыполнитьРасчетСкидокНаСервере(ОбъектДляРасчета, СтруктураПараметры);
	Если НЕ РасчетныеСкидки.ДеревоСкидок = Неопределено И РасчетныеСкидки.ДеревоСкидок.Строки.Количество() = 0 Тогда
		РасчетныеСкидки.Вставить("НетДействующихСкидок", Истина);
  	ИначеЕсли РасчетныеСкидки.ТаблицаСкидкиНаценки.Количество() = 0
		И (НЕ РасчетныеСкидки.Свойство("ТаблицаПодарков") ИЛИ РасчетныеСкидки.ТаблицаПодарков.Количество() = 0)
		И (НЕ РасчетныеСкидки.Свойство("ТаблицаСообщений") ИЛИ РасчетныеСкидки.ТаблицаСообщений.Количество() = 0)
		И (НЕ РасчетныеСкидки.Свойство("ТаблицаБонусыКНачислению") ИЛИ РасчетныеСкидки.ТаблицаБонусыКНачислению.Количество() = 0) Тогда
		// Если есть бонусы, подарки, или собщения - то сработавшие скидки все же есть, считаем что расчет прошел штатно
		// А вот если ничего сработавшего нет - сообщим об этом, и выведем гиперссылку на настройку скидок
		РасчетныеСкидки.Вставить("НетСработавшихСкидок", Истина);
	КонецЕсли;
	
	Возврат РасчетныеСкидки;

КонецФункции 

Функция ПрименитьРассчитанныеСкидкиКОбъекту(ОбъектДляРасчета, РасчетныеСкидки, НаименованиеТЧ = "Запасы")
	
	Результат = СкидкиНаценкиСервер.ПрименитьРассчитанныеСкидкиКОбъекту(ОбъектДляРасчета, РасчетныеСкидки); 

	Возврат Результат;
	
КонецФункции

Процедура РассчитатьСкидкиНаценкиНаСервере(СтруктураПараметры, ОбъектДляРасчета)
	
	ЗаполнитьБонуснуюПрограмму(ОбъектДляРасчета, СтруктураПараметры);

	РасчетныеСкидки = ВыполнитьРасчетСкидокНаСервере(ОбъектДляРасчета, СтруктураПараметры);
	РезультатПрименения = ПрименитьРассчитанныеСкидкиКОбъекту(ОбъектДляРасчета, РасчетныеСкидки);
							
КонецПроцедуры 

Функция ПолучитьСтруктуруНастроек(Источник, Магазин, ВидДоставки)
	
	СтруктураНастроек = Новый Структура("Организация, Склад, Подразделение, ВидЗаказа, Контрагент, Проект, СпособДоставки, ВремяДоставкиС, ВремяДоставкиПо, ВКоробке");
	СтруктураНастроек.Организация 	= Справочники.Организации.ОсновнаяОрганизация;
	СтруктураНастроек.Склад 		= ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.СтруктурныеЕдиницы?ref=bc1f00155d014f0711e89b02cb647de3");
	СтруктураНастроек.Подразделение = СтруктураНастроек.Склад.Родитель;
	СтруктураНастроек.ВидЗаказа 	= Справочники.ВидыЗаказовПокупателей.Основной;
	СтруктураНастроек.Контрагент 	= ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Контрагенты?ref=bab1000c29e80aa411f03bb6bafeed98");
	СтруктураНастроек.Проект 		= ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Проекты?ref=bbbe970f694b62b611f19fa8235e2108");
	СтруктураНастроек.СпособДоставки= Перечисления.СпособыДоставки.Самовывоз; 
	СтруктураНастроек.ВКоробке 		= Ложь;
	
	СтруктураНастроек.ВремяДоставкиС = Дата(01,01,01,10,0,0);
	СтруктураНастроек.ВремяДоставкиПо = Дата(01,01,01,18,0,0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"Выбрать * из РегистрСведений.СайтНастройкаЗагрузкиЗаказов КАК НастройкаЗагрузкиЗаказов Где НастройкаЗагрузкиЗаказов.Источник = &Источник И НастройкаЗагрузкиЗаказов.ИдентификаторМагазина = &Магазин И НастройкаЗагрузкиЗаказов.ИдентификаторДоставки = &ВидДоставки";
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("ВидДоставки", ВидДоставки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураНастроек, Выборка, , "СпособДоставки, ВремяДоставкиС, ВремяДоставкиПо");
		
		Если ЗначениеЗаполнено(Выборка.СпособДоставки) Тогда
			СтруктураНастроек.СпособДоставки= Выборка.СпособДоставки;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ВремяДоставкиС) Тогда
			СтруктураНастроек.ВремяДоставкиС= Выборка.ВремяДоставкиС;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ВремяДоставкиПо) Тогда
			СтруктураНастроек.ВремяДоставкиПо= Выборка.ВремяДоставкиПо;
		КонецЕсли;
	КонецЕсли;

	Возврат СтруктураНастроек;
	
