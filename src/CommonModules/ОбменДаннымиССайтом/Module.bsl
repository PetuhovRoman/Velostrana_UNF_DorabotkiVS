Функция ПолучитьМетрику(ДатаЗапроса) Экспорт
	
	Конект = Новый HTTPСоединение("api.velostrana.ru");
	Токен = "M7QyNbpVsb7tYd7lMvdJvC0nCzf4Qyvfy3W8e2AgWp9Ul6Mq5AnDKkYg8bS6ZM7r";
	ЗаголовокHTTP = Новый Соответствие();

	
	СтрокаЗапроса = "/api/velostrana/1c/metrica/?token=" + Токен;
	ХТТПЗапрос = Новый HTTPЗапрос(СтрокаЗапроса, ЗаголовокHTTP);
	ОтветHTTP = Конект.ВызватьHTTPМетод("GET", ХТТПЗапрос);
	
	Количество = 0;
	Если ОтветHTTP.КодСостояния = 200 Тогда
		СтрокаОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
		Результат = ПреобразоватьJSONВСоответствие(СтрокаОтвета);
		
		Для Каждого СтрокаПосетителей Из Результат Цикл
			ДатаМетрики = СтрокаПосетителей.Получить("date");
			Если НачалоДня(ДатаЗапроса) = НачалоДня(ДатаМетрики) Тогда
				Количество = Количество + Число(СтрокаПосетителей.Получить("users"));
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		СтрокаОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
		ЗаписьЖурналаРегистрации("Метрика", УровеньЖурналаРегистрации.Ошибка,,, СтрокаОтвета);
	КонецЕсли;
	
	Возврат Количество;

