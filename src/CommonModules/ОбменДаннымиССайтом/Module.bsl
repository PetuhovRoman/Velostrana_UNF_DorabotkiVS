Функция ЕстьДокОплатыПоСсылкеНаОплату(СсылкаНаОплатуСтр, ДатаПлатежа)
	
	Если ПустаяСтрока(СсылкаНаОплатуСтр) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОплатыПокупателейССайта.ДокументОплаты КАК Ссылка
	|ИЗ
	|	РегистрСведений.ОплатыПокупателейССайта КАК ОплатыПокупателейССайта
	|ГДЕ
	|	ОплатыПокупателейССайта.НомерОплатыНаСайте = &СсылочныйНомер
	|	И НАЧАЛОПЕРИОДА(ОплатыПокупателейССайта.ДатаОплатыНаСайте, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ДатаДок, ДЕНЬ)";
	
	Запрос.УстановитьПараметр("СсылочныйНомер", СсылкаНаОплатуСтр);
	Запрос.УстановитьПараметр("ДатаДок", ДатаПлатежа);
    РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
	Возврат Ложь;

КонецФункции

Процедура ПробитьЧекНаПредоплату(СсылкаНаДокумент)
	
	Если Не ЗначениеЗаполнено(СсылкаНаДокумент.КассаККМ) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторУстройстваФР = СсылкаНаДокумент.КассаККМ.ПодключаемоеОборудование;
	
	ЭтоОплатаЗаказа = СсылкаНаДокумент.ФискализируетсяЗаказомВОблачнойКассе;
	
	ДанныеДляФискализации = РозничныеПродажиСервер.ПолучитьДанныеДляФискализации(СсылкаНаДокумент, ИдентификаторУстройстваФР,, ЭтоОплатаЗаказа);
	ОблачнаяКасса		  = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ;
	
	Если ДанныеДляФискализации <> Неопределено
		И ТипЗнч(ИдентификаторУстройстваФР) = Тип("СправочникСсылка.ПодключаемоеОборудование")
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторУстройстваФР, "ТипОборудования") = ОблачнаяКасса Тогда
		
		Если СсылкаНаДокумент.ФискализируетсяЗаказомВОблачнойКассе И Не СсылкаНаДокумент.РасчетВИнтернете Тогда
			ДанныеДляФискализации.МестоРасчетов   = ДанныеДляФискализации.АдресМагазина;
		КонецЕсли;
		
		ДанныеДляФискализации.ИдентификаторФискальнойЗаписи = ?(ЗначениеЗаполнено(СсылкаНаДокумент.ИдентификаторЧекаВОчереди),
			СсылкаНаДокумент.ИдентификаторЧекаВОчереди,
			XMLСтрока(Новый УникальныйИдентификатор));
			
		ДанныеДляФискализации.ОблачнаяККТ 					= Истина;
		
		РаспределеннаяФискализация.ДобавитьЧекВОчередьЧековККТ(ДанныеДляФискализации);
		
		Если Не ЗначениеЗаполнено(СсылкаНаДокумент.ИдентификаторЧекаВОчереди) Тогда
			ДокументОбъект = СсылкаНаДокумент.ПолучитьОбъект();
			ДокументОбъект.ИдентификаторЧекаВОчереди = ДанныеДляФискализации.ИдентификаторФискальнойЗаписи;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		Результат = ОборудованиеЧекопечатающиеОблачныеККТ.ФискализацияЧека(СсылкаНаДокумент, ИдентификаторУстройстваФР, ДанныеДляФискализации);
		
		Если Результат.Свойство("ИнформацияОбОшибке") И ЗначениеЗаполнено(Результат.ИнформацияОбОшибке) Тогда
			ЗаписьЖурналаРегистрации("VelostranaAPI.СтатусОплаты", УровеньЖурналаРегистрации.Ошибка, , СсылкаНаДокумент,  СокрЛП(СсылкаНаДокумент) + Символы.ПС + Результат.ИнформацияОбОшибке + Символы.ПС + Результат.СообщениеОбОшибке);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

