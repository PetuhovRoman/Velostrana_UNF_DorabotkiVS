	Почта = ЗаказСоответствие["email"];
	
	ОписаниеЗаказа = ОписаниеЗаказа + "
					|
					|"+ ЗаказСоответствие["created_at"]+" оформлен заказ #" +  СтрЗаменить(ЗаказСоответствие["order_number"], Символы.НПП, "") +"
					|_________________________________________
					|Способ оплаты: " + СпособОплаты + " 
					|
					|Способ доставки: " + СпособДоставки + " (" + ВидДоставки + ")" + " 
					|Стоимость доставки: " + СуммаДоставки + "   
					|_________________________________________
					|	 
					|Заказ на сайте: " + Номер + " 
					|
					|Персональные данные пользователя:
