	ЗаголовокHTTP = Новый Соответствие();
	СтрокаЗапроса = "/api/velostrana/1c/ozon/orders/?date=" + Формат(ДатаЗагрузки, "ДФ=dd-MM-yyyy") + "&token=" + Токен;
	//СтрокаЗапроса = "/api/velostrana/1c/ozon/orders/?date=" + Формат(ДатаНач, "ДФ=dd-MM-yyyy") + "&status=delivered&token=" + Токен;
	//СтрокаЗапроса = "/api/velostrana/1c/ozon/orders/?from=" + Формат(ДатаНач, "ДФ=dd-MM-yyyy") + "&to=" + Формат(ДатаКон, "ДФ=dd-MM-yyyy") + "&status=delivered&token=" + Токен;
	ХТТПЗапрос = Новый HTTPЗапрос(СтрокаЗапроса, ЗаголовокHTTP);
	ОтветHTTP = Конект.ВызватьHTTPМетод("GET",ХТТПЗапрос);
	
	Если ОтветHTTP.КодСостояния = 200 Тогда
		СтрокаОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
		ЗаписьЖурналаРегистрации("ЗагрузкаПродажиОзон", УровеньЖурналаРегистрации.Примечание, ,, СтрокаОтвета);
		
