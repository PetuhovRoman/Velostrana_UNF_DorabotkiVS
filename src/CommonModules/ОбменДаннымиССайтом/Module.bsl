Функция ПолучитьЗаказ(Номер, Дата)
	
	ЗапросПоЗаказу = Новый Запрос;
	ЗапросПоЗаказу.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК Заказ
	|ГДЕ
	|	НЕ Заказ.ПометкаУдаления
	|	И Заказ.НомерВходящегоДокумента = &ВходящийНомер";
	//|	И НАЧАЛОПЕРИОДА(Заказ.Дата, ГОД) = &Дата";
	
	ЗапросПоЗаказу.УстановитьПараметр("ВходящийНомер", Номер);
	ЗапросПоЗаказу.УстановитьПараметр("Дата", НачалоГода(Дата));
	
	Выборка = ЗапросПоЗаказу.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		//Возврат Неопределено;
	КонецЕсли;
	
	НовыйДок = Документы.ЗаказПокупателя.СоздатьДокумент();
	
	Возврат НовыйДок;
	
КонецФункции

Функция ПолучитьМенеджера(СтруктураРеквизитов, Источник, СтруктураПараметров)
	
	Если СтрНайти(СтруктураРеквизитов["type"], "ozon") > 0 Тогда
		Ответственный = УправлениеОчередьюЗаказовПокупателей.ПолучитьОтветственногоПоОчереди(СтруктураПараметров.ОчередьОзон, Источник);
	ИначеЕсли НРег(СокрЛП(СтруктураРеквизитов["type"])) = "wildberries" Тогда
		Ответственный = УправлениеОчередьюЗаказовПокупателей.ПолучитьОтветственногоПоОчереди(СтруктураПараметров.ОчередьВБ, Источник);
	ИначеЕсли СтрНайти(НРег(СокрЛП(СтруктураРеквизитов["type"])), "yandexmarket.fbs") > 0 Тогда
		Ответственный = УправлениеОчередьюЗаказовПокупателей.ПолучитьОтветственногоПоОчереди(СтруктураПараметров.ОчередьЯМ, Источник);
	ИначеЕсли СтрНайти(НРег(СокрЛП(СтруктураРеквизитов["type"])), "yandexmarket.go") > 0 Тогда
		Ответственный = УправлениеОчередьюЗаказовПокупателей.ПолучитьОтветственногоПоОчереди(СтруктураПараметров.ОчередьЯМГ, Источник);
	Иначе
		Ответственный = УправлениеОчередьюЗаказовПокупателей.ПолучитьОтветственногоПоОчереди(СтруктураПараметров.ОчередьОсновная, Источник);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Возврат ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Сотрудники?ref=bab2000c29e80aa411f03ebfb131c618");  //Василенков Андрей Андреевич 
	КонецЕсли;
	
	Возврат Ответственный;
	
КонецФункции

Функция НайтиКарту(СтруктураРеквизитов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КартыЛояльности.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДисконтныеКарты КАК КартыЛояльности
	|ГДЕ
	|	(КартыЛояльности.Наименование = &Наименование
	|			ИЛИ КартыЛояльности.КодКартыШтрихкод = &Код)";
	Запрос.УстановитьПараметр("Наименование", СтруктураРеквизитов.Наименование);
	Запрос.УстановитьПараметр("Код", СтруктураРеквизитов.Код);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ДисконтныеКарты.ПустаяСсылка();
	
КонецФункции

Функция ПолучитьКарту(СтруктураРеквизитов, Контрагент)
	
	Если Контрагент = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Контрагенты?ref=bab1000c29e80aa411f03bb6bafeed98") Тогда  //ТИПОВОЙ ПОКУПАТЕЛЬ
		Возврат Справочники.ДисконтныеКарты.ПустаяСсылка();
	КонецЕсли;
	Если ПустаяСтрока(СтруктураРеквизитов.Код) И ПустаяСтрока(СтруктураРеквизитов.Наименование) Тогда
		Возврат Справочники.ДисконтныеКарты.ПустаяСсылка();
	КонецЕсли;
	
	СпрН = Справочники.ДисконтныеКарты.СоздатьЭлемент();
	СпрН.Заполнить(Неопределено);
	СпрН.Наименование = СтруктураРеквизитов.Наименование;
	СпрН.Владелец = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ВидыДисконтныхКарт?ref=bab1000c29e80aa411f03c7243a97e6a");
	СпрН.ВладелецКарты = Контрагент;
	СпрН.КодКартыШтрихкод = СтруктураРеквизитов.Код;
	СпрН.Комментарий = "Создана автоматически при загрузке заказа с сайта vs";
	СпрН.Записать();
	
	Возврат СпрН.Ссылка;
	
КонецФункции

Функция ПолучитьИсточник(Знач СтрИсточник)
	
	Если ПустаяСтрока(СтрИсточник) Тогда
		Возврат Справочники.ИсточникиПривлеченияПокупателей.ПустаяСсылка();
	КонецЕсли;

    ИсточникСсылка = Справочники.ИсточникиПривлеченияПокупателей.НайтиПоНаименованию(СтрИсточник, Истина);
	
	Если ЗначениеЗаполнено(ИсточникСсылка) Тогда
		Возврат ИсточникСсылка;
	КонецЕсли;
	
	НовыйСпр = Справочники.ИсточникиПривлеченияПокупателей.СоздатьЭлемент();
	НовыйСпр.Заполнить(Неопределено);
	НовыйСпр.Наименование = СокрЛП(СтрИсточник);
	//НовыйПользователь.Комментарий = "Создан автоматически при загрузке заказов УТ10";
	НовыйСпр.Записать();
	
	Возврат НовыйСпр.Ссылка;
	
КонецФункции

Процедура ЗаполнитьДоговорПоУмолчанию(ДокОбъект)
	
	Если Не ДокОбъект.Контрагент.ВестиРасчетыПоДоговорам Тогда
		ДокОбъект.Договор = "";
		Возврат;
	КонецЕсли;
	
	Если ДокОбъект.Контрагент.ИНН = "7704217370"  //ОЗОН
		Тогда
		ВидДоговора = Перечисления.ВидыДоговоров.СКомиссионером;
	Иначе
		ВидДоговора = Перечисления.ВидыДоговоров.СПокупателем;
	КонецЕсли;
	
	СписокВидовДоговоров = Новый СписокЗначений();
	СписокВидовДоговоров.Добавить(ВидДоговора);
	Договор = Справочники.ДоговорыКонтрагентов.ПоКонтрагентуПоОрганизации(ДокОбъект.Контрагент, ДокОбъект.Организация, СписокВидовДоговоров);
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат;
		НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовыйДоговор.Заполнить(Неопределено);
		НовыйДоговор.Наименование = "Основной договор";
		НовыйДоговор.Организация = ДокОбъект.Организация;
		НовыйДоговор.Владелец = ДокОбъект.Контрагент;
		НовыйДоговор.ВидДоговора = ВидДоговора;
		НовыйДоговор.Комментарий = "Создан автоматически при загрузке заказов";
		Попытка
			НовыйДоговор.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("VelostranaAPI.ЗагрузкаЗаказов", УровеньЖурналаРегистрации.Ошибка, , ДокОбъект.Ссылка, "Ошибка при создании договора " + ДокОбъект.Контрагент + Символы.ПС + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		
		Договор = НовыйДоговор.Ссылка;
	КонецЕсли;
	ДокОбъект.Договор = Договор;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("БанковскийСчет", ДокОбъект.Метаданные()) Тогда
		ДокОбъект.БанковскийСчет = Справочники.БанковскиеСчета.БанковскийСчетСубъекта(ДокОбъект.Организация,
		ДокОбъект.ВалютаДокумента, ДокОбъект.Дата, ДокОбъект.Договор);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗаполнитьПромокод(ДокОбъект, Промокод)
	
	ПромокодСоответствие = ПромокодыУНФ.УсловияПримененияПромокодов(Промокод);
	Если ПромокодСоответствие.Количество() = 0 Тогда
		Возврат;
	Иначе
		УсловиеПредоставленияСкидки = ПромокодСоответствие[Промокод];
	КонецЕсли;
	
	СтрокаПромо = ДокОбъект.ПримененныеПромокоды.Добавить();
	СтрокаПромо.Промокод = Промокод;
	СтрокаПромо.УсловиеПредоставленияСкидки = УсловиеПредоставленияСкидки;
		
КонецПроцедуры

Функция ВернутьСпособОплаты(payment_id)
	
	Если payment_id  = "1" Тогда
		Возврат "Наличными или банковской картой курьеру при получении";
	ИначеЕсли payment_id  = "2" Тогда
		Возврат  "Яндекс. Касса ((Web Money, Яндекс Деньги и др.)";	
	ИначеЕсли payment_id  = "3" Тогда
		Возврат  "Оплата через сайт по карте VISA, MasterCard или Maestro";	
	ИначеЕсли payment_id  = "4" Тогда
		Возврат  "Предоплата по квитанции через банк";	
	ИначеЕсли payment_id  = "5" Тогда
		Возврат  "Рассрочка от Яндекс.Кассы.";	
	ИначеЕсли payment_id  = "6" Тогда
		Возврат  "Покупка в кредит";					   
	ИначеЕсли payment_id  = "7" Тогда
		Возврат  "";	
	ИначеЕсли payment_id  = "8" Тогда
		Возврат  "";	
	ИначеЕсли payment_id  = "9" Тогда
		Возврат  "";	
	ИначеЕсли payment_id  = "10" Тогда
		Возврат "";	
	КонецЕсли;
	
КонецФункции

