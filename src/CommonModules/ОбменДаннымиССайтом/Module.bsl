				//			Попытка
				//				НакладнаяОбъект = Накладная.ПолучитьОбъект();
				//				НакладнаяОбъект.Записать(РежимЗаписиДокумента.Проведение);
				//			Исключение
				//				ЗаписьЖурналаРегистрации("VelostranaAPI.СтатусОплаты", УровеньЖурналаРегистрации.Ошибка, , Накладная, "Не удалось провести документ " + Накладная + Символы.ПС + ОписаниеОшибки());
				//				Продолжить;
