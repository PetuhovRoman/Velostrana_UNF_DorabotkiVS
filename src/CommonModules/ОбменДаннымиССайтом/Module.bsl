Процедура ВыгрузитьПромокоды() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДатаСеанса());   //ДАТАВРЕМЯ(2016, 6, 23)
	//Запрос.УстановитьПараметр("Номер", "1083567");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Промокоды.ДействуетС < ДАТАВРЕМЯ(1980, 1, 1, 0, 0, 0)
	|			ТОГДА ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|		ИНАЧЕ Промокоды.ДействуетС
	|	КОНЕЦ КАК ДатаНачала,
	|	ВЫБОР
	|		КОГДА Промокоды.ДействуетДо > ДАТАВРЕМЯ(2035, 1, 1, 0, 0, 0)
	|			ТОГДА ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|		ИНАЧЕ Промокоды.ДействуетДо
	|	КОНЕЦ КАК ДатаОкончания,
	|	Промокоды.Промокод КАК Промокод
	|ИЗ
	|	Справочник.АвтоматическиеСкидки.УсловияПредоставления КАК АвтоматическиеСкидкиУсловияПредоставления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УсловияПредоставленияСкидокНаценок КАК Вело_РекламныеАкции
	|		ПО АвтоматическиеСкидкиУсловияПредоставления.УсловиеПредоставления = Вело_РекламныеАкции.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Промокоды КАК Промокоды
	|		ПО (Промокоды.УсловиеПредоставленияСкидки = Вело_РекламныеАкции.Ссылка)
	|ГДЕ
	|	Вело_РекламныеАкции.УсловиеПредоставления = ЗНАЧЕНИЕ(Перечисление.УсловияПредоставленияСкидокНаценок.ЗаПромокод)
	|	И &ТекДата МЕЖДУ Промокоды.ДействуетС И ВЫБОР
	|			КОГДА Промокоды.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|				ТОГДА КОНЕЦПЕРИОДА(&ТекДата, МЕСЯЦ)
	|			ИНАЧЕ Промокоды.ДействуетДо
	|		КОНЕЦ
	|	И АвтоматическиеСкидкиУсловияПредоставления.Ссылка.Действует
	|	И НЕ АвтоматическиеСкидкиУсловияПредоставления.Ссылка.ПометкаУдаления
	|	И НЕ Вело_РекламныеАкции.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИмяСайта = "panel.velostrana.ru";
	Токен = "M7QyNbpVsb7tYd7lMvdJvC0nCzf4Qyvfy3W8e2AgWp9Ul6Mq5AnDKkYg8bS6ZM7r";
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Cookie", "token=" + Токен);
	ЗаголовокHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded;");  
	HTTPСоединение = Новый HTTPСоединение(ИмяСайта,,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	
	ПараметрыЗапроса = Новый Структура;
	МассивДанных = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		СтруктураДанных = Новый Структура;

		СтруктураДанных.Вставить("promo", 		СокрЛП(Выборка.Промокод));
		Если ЗначениеЗаполнено(Выборка.ДатаНачала) Тогда
			СтруктураДанных.Вставить("date_start", 	Выборка.ДатаНачала);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ДатаОкончания) Тогда
			СтруктураДанных.Вставить("date_end", 	Выборка.ДатаОкончания);
		КонецЕсли;
		
		МассивДанных.Добавить(СтруктураДанных);
	КонецЦикла;
	
	//ПараметрыЗапроса.Вставить("data", МассивДанных);
	ТелоЗапроса = ПреобразоватьДанныеВJSON(МассивДанных);
	
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("txt");
	ИмяФайлаОтправки = ПреобразоватьДанныеДляОтправки(ЗаписьВФайл(ТелоЗапроса, "promo.json"), ЗаголовокHTTP, "promo.zip");
	
	ОтветPOST = HTTPСоединение.ОтправитьДляОбработки(ИмяФайлаОтправки, "api/velostrana/1c/promo/?token=" + Токен, ИмяФайлаОтвета, ЗаголовокHTTP);
	ОтветТекст = Новый ЧтениеТекста(ИмяФайлаОтвета);
	//Сообщить(ОтветТекст.Прочитать());
	
	СтрокаОтвета = СокрЛП(ОтветТекст.Прочитать());
	Комментарий = "Ошибка: " + СтрокаОтвета;
	
	Если СтрНайти(Комментарий, "Success") = 0 Тогда
		ЗаписьЖурналаРегистрации("VelostranaAPI.Промокоды", УровеньЖурналаРегистрации.Ошибка, , , Комментарий);
    КонецЕсли;
	
КонецПроцедуры

