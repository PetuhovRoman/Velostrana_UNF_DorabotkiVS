КонецПроцедуры

Функция ПолучитьОтчетКомиссионера(ДатаДок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОтчетКомиссионераОПродажах.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетКомиссионера КАК ОтчетКомиссионераОПродажах
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(ОтчетКомиссионераОПродажах.Дата, ДЕНЬ) = &Дата
	|	И НЕ ОтчетКомиссионераОПродажах.ПометкаУдаления";
	Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаДок));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ОтчетКомиссионера.ПустаяСсылка();
	
КонецФункции

Процедура ЗаполнитьТаблицуЗаказов(ДатаЗагрузки, ЗаказыFBS)
	
	//ДатаЗагрузки = ТекущаяДата();
	
	Товары = Новый ТаблицаЗначений;
	Товары.Колонки.Добавить("НаименованиеТовара");
	Товары.Колонки.Добавить("Комментарий");
	Товары.Колонки.Добавить("Номенклатура");
	Товары.Колонки.Добавить("Характеристика");
	Товары.Колонки.Добавить("Статус");
	Товары.Колонки.Добавить("НомерЗаказа");
	Товары.Колонки.Добавить("ЕдиницаИзмерения");
	Товары.Колонки.Добавить("Коэффициент");
	Товары.Колонки.Добавить("Количество");
	Товары.Колонки.Добавить("Цена");
	Товары.Колонки.Добавить("Сумма");
	
	Для Каждого СтрокаЗаказов Из ЗаказыFBS Цикл
		
		ДанныеПоЗаказу = ЗаказыFBS.Получить(СтрокаЗаказов.Ключ);
		
		СуммаЗаказа = 0;
		Артикул 	= "";
		
		ТоварыЗаказа = ДанныеПоЗаказу.Получить("products");
		Если Товары <> Неопределено Тогда                          
			КоличествоТоваров 	= ТоварыЗаказа.Количество();
			Для Каждого СтрокаТоваров Из ТоварыЗаказа Цикл
				
				ДанныеПоТовару = ТоварыЗаказа.Получить(СтрокаТоваров.Ключ);
				Статус = ДанныеПоЗаказу.Получить("status");
				Если Не Статус = "delivered" 
					//И Не Статус = "cancelled" 
					Тогда
					Продолжить;
				КонецЕсли;
				
				Артикул 	= СтрШаблон("%1 %2, %3 шт.%4", Артикул, ДанныеПоТовару.Получить("offer_id"), ДанныеПоТовару.Получить("quantity"), Символы.ПС);
				
				Цена = ДанныеПоТовару.Получить("price");
				Количество = ДанныеПоТовару.Получить("quantity");
				Сумма = ?(Цена = Неопределено, 0, Цена) * ?(Количество = Неопределено, 1, Количество);
				СуммаЗаказа = СуммаЗаказа + Сумма;
				
				ПолныйАртикулТовара = СокрЛП(ДанныеПоТовару.Получить("offer_id"));
				
				НоваяСтрокаТЧ = Товары.Добавить();
				НоваяСтрокаТЧ.НаименованиеТовара = ДанныеПоТовару.Получить("name");
				НоваяСтрокаТЧ.Комментарий = ДанныеПоТовару.Получить("name") + " (" + ПолныйАртикулТовара + ")";
				НоваяСтрокаТЧ.Номенклатура 	= ПолучитьТовар(ПолныйАртикулТовара);
				Если ЗначениеЗаполнено(ДанныеПоТовару.Получить("guid")) Тогда
					НоваяСтрокаТЧ.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеПоТовару.Получить("guid")));
				КонецЕсли;
				Если Не ЗначениеЗаполнено(НоваяСтрокаТЧ.Номенклатура) И ЗначениеЗаполнено(НоваяСтрокаТЧ.Характеристика) Тогда
					НоваяСтрокаТЧ.Номенклатура = НоваяСтрокаТЧ.ХарактеристикаНоменклатуры.Владелец;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(НоваяСтрокаТЧ.Номенклатура) 
					И НоваяСтрокаТЧ.Номенклатура.ИспользоватьХарактеристики 
					И Не ЗначениеЗаполнено(НоваяСтрокаТЧ.Характеристика) Тогда
					НоваяСтрокаТЧ.Характеристика = ПолучитьХарактеристику(НоваяСтрокаТЧ.Номенклатура, ПолныйАртикулТовара);
				КонецЕсли;
				Если ЗначениеЗаполнено(НоваяСтрокаТЧ.Номенклатура) 
					И НоваяСтрокаТЧ.Номенклатура.ИспользоватьХарактеристики 
					И Не ЗначениеЗаполнено(НоваяСтрокаТЧ.Характеристика) Тогда
					НоваяСтрокаТЧ.Характеристика = ПолучитьОсновнуюХарактеристику(НоваяСтрокаТЧ.Номенклатура);
				КонецЕсли;
				НоваяСтрокаТЧ.Статус = ДанныеПоЗаказу.Получить("status");
				НоваяСтрокаТЧ.НомерЗаказа = ДанныеПоТовару.Получить("order_id");
				НоваяСтрокаТЧ.ЕдиницаИзмерения = ?(ЗначениеЗаполнено(НоваяСтрокаТЧ.Номенклатура), НоваяСтрокаТЧ.Номенклатура.ЕдиницаИзмерения, "");
				НоваяСтрокаТЧ.Коэффициент = 1;
				Если Статус = "cancelled" Тогда
					НоваяСтрокаТЧ.Количество 	=  - ДанныеПоТовару.Получить("quantity");
				Иначе
					НоваяСтрокаТЧ.Количество 	=  ДанныеПоТовару.Получить("quantity");
				КонецЕсли;
				НоваяСтрокаТЧ.Цена 		= Цена;
				НоваяСтрокаТЧ.Сумма 		= НоваяСтрокаТЧ.Количество * Цена;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	Если Товары.Количество() > 0 Тогда
		СоздатьОтчет(ДатаЗагрузки, Товары);
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьОтчет(ДатаЗагрузки, Товары)
	
	СтрокаКом = "Загрузка за " + Формат(ДатаЗагрузки, "ДФ=dd.MM.yyyy");
	
	ДокСсылка = ПолучитьОтчетКомиссионера(ДатаЗагрузки);
	Если ЗначениеЗаполнено(ДокСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Док = Документы.ОтчетКомиссионера.СоздатьДокумент();
	Док.Дата = НачалоДня(ДатаЗагрузки) + 23*60*60;
	Док.Заполнить(Неопределено);
	Док.Организация = Справочники.Организации.ОсновнаяОрганизация;
	Док.ВидОперации = Перечисления.ВидыОперацийОтчетКомиссионера.ОтчетКомиссионера;
	
	Док.Контрагент = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Контрагенты?ref=bbbac927e050f73411ea764da7ee754e");
	
	СписокВидовДоговоров = Новый СписокЗначений();
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоров.СКомиссионером);
	Док.Договор = Справочники.ДоговорыКонтрагентов.ПоКонтрагентуПоОрганизации(Док.Контрагент, Док.Организация, СписокВидовДоговоров);

	Док.СпособРасчетаКомиссионногоВознаграждения = Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается;
	Док.СуммаВключаетНДС = Истина;
	//Док.Подразделение = Справочники.Подразделения.НайтиПоНаименованию("ОЗОН FBO");
	
	СтрокаПокупатели = Док.Покупатели.Добавить();
	СтрокаПокупатели.Покупатель = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Контрагенты?ref=bab1000c29e80aa411f03bb6bafeed98");
	СтрокаПокупатели.Всего = Товары.Итог("Сумма");
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		
		НоваяСтрока = Док.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
		НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(НоваяСтрока.Номенклатура.ВидСтавкиНДС);
		
		ПараметрыРасчета = Новый Структура();
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", Док.СуммаВключаетНДС); 
		//ПараметрыРасчета.Вставить("КорректировкаСуммыЗаСчетРучнойСкидки", Истина);
		
		ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммыВСтрокеТЧ(НоваяСтрока, ПараметрыРасчета);
		
		СтрокаИнформации = "Строка " + СокрЛП(НоваяСтрока.НомерСтроки) + " " + СокрЛП(СтрокаТЧ.Комментарий) + Символы.ПС + СокрЛП(СтрокаТЧ.НомерЗаказа);
		ЗаписьЖурналаРегистрации("ЗагрузкаПродажиОзон", УровеньЖурналаРегистрации.Информация, , Док.Ссылка, СтрокаИнформации);
		
		СтрокаКом = СтрокаКом + Символы.ПС + СтрЗаменить(СтрокаИнформации, Символы.ПС, " ");
		
	КонецЦикла; 
	
	Док.Комментарий = СтрокаКом;
	//Попытка
	//	Док.Записать(РежимЗаписиДокумента.Проведение);
	//Исключение
		Док.Записать();
	//КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьТовар(ЗначениеПоиска) 
	
	Если СтрНайти(ЗначениеПоиска, "-") = 0 Тогда
		ЗначениеПоиска = Формат(ЗначениеПоиска,"ЧГ=0");
	Иначе
		ЗначениеПоиска = Лев(Формат(ЗначениеПоиска,"ЧГ=0"), СтрНайти(ЗначениеПоиска, "-")-1);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.Ссылка КАК Товар
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|ГДЕ
	|	Товары.Артикул = &КодТовара
	|	И (НЕ Товары.ПометкаУдаления = ИСТИНА)";
	Запрос.УстановитьПараметр("КодТовара",ЗначениеПоиска);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Товар;
	КонецЕсли;
	
	Возврат Неопределено;	
	
КонецФункции

Функция ПолучитьХарактеристику(Товар, Артикул) 
	
	МассивАртикул = СтрРазделить(Артикул, "-");
	Если МассивАртикул.Количество() > 1 Тогда

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|ГДЕ
		|	НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
		|	И ХарактеристикиНоменклатуры.Владелец = &Владелец
		|	И ХарактеристикиНоменклатуры.Артикул = &Артикул";
		
		Запрос.УстановитьПараметр("Владелец",Товар);
		Запрос.УстановитьПараметр("Артикул",МассивАртикул[1]);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Количество() = 1 И Результат.Следующий() Тогда
			Возврат Результат.Характеристика;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();	
	
КонецФункции

Функция ПолучитьОсновнуюХарактеристику(Товар) 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
	|	И ХарактеристикиНоменклатуры.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец",Товар);
	
