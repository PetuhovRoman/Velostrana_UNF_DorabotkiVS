					НоваяСтрокаТоваров.Номенклатура = Номенклатура;
				КонецЕсли;
			КонецЕсли;
			
			ГУИДХарактеристики = СтрокаТоваровСоответствие["variant_id"];
			Если ПустаяСтрока(ГУИДХарактеристики) Или ГУИДХарактеристики = "00000000-0000-0000-0000-000000000000" Тогда
			Иначе
				НовыйGUID = Новый УникальныйИдентификатор(ГУИДХарактеристики);
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(НовыйGUID); 
				Если ОбщегоНазначения.СсылкаСуществует(Характеристика) Тогда
					НоваяСтрокаТоваров.Характеристика = Характеристика;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрокаТоваров.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(НоваяСтрокаТоваров.Номенклатура.ВидСтавкиНДС);
			НоваяСтрокаТоваров.Количество = СтрокаТоваровСоответствие["count"];
			НоваяСтрокаТоваров.Резерв = НоваяСтрокаТоваров.Количество;
			//НоваяСтрокаТоваров.Сумма = ЭлементДОМ.ПолучитьЭлементыПоИмени("Сумма").Элемент(0).ТекстовоеСодержимое;
			НоваяСтрокаТоваров.Цена = СтрокаТоваровСоответствие["price"];
			//НоваяСтрокаТоваров.СуммаСкидкиОплатыБонусом = ЭлементДОМ.ПолучитьЭлементыПоИмени("СуммаСписанияВелоБонусы").Элемент(0).ТекстовоеСодержимое;
			
			//СтруктураРазмещение = Новый Структура;
			//СтруктураРазмещение.Вставить("ИД", ЭлементДОМ.ПолучитьЭлементыПоИмени("Размещение").Элемент(0).ТекстовоеСодержимое);
			//СтруктураРазмещение.Вставить("Наименование", ЭлементДОМ.ПолучитьЭлементыПоИмени("РазмещениеНаименование").Элемент(0).ТекстовоеСодержимое);
			//НоваяСтрокаТоваров.Размещение = ПолучитьСклад(СтруктураРазмещение);
			
		КонецЦикла;
	КонецЕсли; 
	
	//ТЗПС = Новый ТаблицаЗначений;
