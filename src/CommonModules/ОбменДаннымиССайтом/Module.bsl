					|Рост: " + ЗаказСоответствие["size"] + " 
					|Пол: " + ЗаказСоответствие["sex"] + "
					|Промокод:  " + ПромокодСсайта + ?(ЗначениеЗаполнено(ЗаказСоответствие["promo_code_id"]), " (" + ЗаказСоответствие["promo_code_id"] + ") ", "") + "
					|Магазин: " + Магазин + "
					|Дисконтная карта: " + ЗаказСоответствие["discount_card"];
	
	ТЗТоваров = Новый ТаблицаЗначений;
	ТЗТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
