	Запрос.УстановитьПараметр("РеквизитТип",ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения?ref=bbb0e5186fc36de011f050d3982aaa0f"));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказыПокупателейССайта.НомерЗаказаНаСайте КАК НомерЗаказаНаСайте,
	|	ЗаказыПокупателейССайта.ДатаЗаказаНаСайте КАК ДатаЗаказаНаСайте,
	|	ЗаказПокупателяДополнительныеРеквизиты.Значение КАК ТипЗаказа
	|ИЗ
	|	РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыПокупателейССайта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.ДополнительныеРеквизиты КАК ЗаказПокупателяДополнительныеРеквизиты
	|		ПО ЗаказыПокупателейССайта.ЗаказПокупателя = ЗаказПокупателяДополнительныеРеквизиты.Ссылка
	|			И (ЗаказПокупателяДополнительныеРеквизиты.Свойство = &РеквизитТип)
	|ГДЕ
	|	ЗаказыПокупателейССайта.ЗаказПокупателя = &Заказ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() 
		И Выборка.ТипЗаказа = ДоставкаMegamarket 
		Тогда
		НомерЗаказа = СокрЛП(Выборка.НомерЗаказаНаСайте);
		Конект = Новый HTTPСоединение("panel.velostrana.ru");
		ЗаголовокHTTP = Новый Соответствие();
		ХТТПЗапрос = Новый HTTPЗапрос("/api/velostrana/1c/sbermegamarket/confirm/" + НомерЗаказа + "/?token=" + Токен, ЗаголовокHTTP);
		
		ОтветHTTP = Конект.ВызватьHTTPМетод("GET", ХТТПЗапрос);
		
		Если ОтветHTTP.КодСостояния = 200 Тогда
			Сообщить("Успешно подтвержден заказ " + НомерЗаказа);
		Иначе
			СтрокаОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
			ЗаписьЖурналаРегистрации("ПодтверждениеЗаказа", УровеньЖурналаРегистрации.Ошибка,,,"Ошибка подтверждения заказа " + НомерЗаказа + " " + СтрокаОтвета);
			Возврат "Ошибка подтверждения заказа " + НомерЗаказа;
		КонецЕсли;
	Иначе
		Возврат "Доступно только для заказов с Megamarket";
	КонецЕсли;
	
