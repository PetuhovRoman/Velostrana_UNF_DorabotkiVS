	//ТЗПС.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	//ТЗПС.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	//ТЗПС.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	//ТЗПС.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	
	//Если мДокументДОМ.ПолучитьЭлементыПоИмени("СтрокаСертификатов").Количество() > 0 Тогда
	//	//	ЗаписатьТекстовойУзел(ОбъектXML, "ПодарочныйСертификат", 				XMLСтрока(Выборка.ПодарочныйСертификат), Ложь);
	//	//ЗаписатьТекстовойУзел(ОбъектXML, "НомерСертификата", 					СокрЛП(Выборка.ПодарочныйСертификатНаименование), Ложь);
	//	
	//	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("СтрокаСертификатов") Цикл
	//		НомерСтрокиПП = НомерСтрокиПП + 1;
	//		Номенклатура = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Номенклатура?ref=b37a00155d014f0711e74ac01358921f"); 
	//		
	//		ГУИДСертитфиката = ЭлементДОМ.ПолучитьЭлементыПоИмени("ПодарочныйСертификат").Элемент(0).ТекстовоеСодержимое;
	//		НомерСертификата = ЭлементДОМ.ПолучитьЭлементыПоИмени("НомерСертификата").Элемент(0).ТекстовоеСодержимое;
	//		Сертификат = ПолучитьПодарочныйСертификат(ГУИДСертитфиката, НомерСертификата, Номенклатура);
