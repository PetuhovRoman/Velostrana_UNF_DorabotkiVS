Функция ВыполнитьPOSTЗапрос(ТелоЗапроса, ПараметрыПодключения)
	
	Результат = Новый Соответствие;
	Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Cookie", "token=" + ПараметрыПодключения.Токен);
	
	Соединение 	= Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,,,,,,Новый ЗащищенноеСоединениеOpenSSL);
	ИмяФайлаОтправки = ПреобразоватьДанныеДляОтправки(ЗаписьВФайл(ТелоЗапроса, ПараметрыПодключения.ИмяФайла), ЗаголовокHTTP, ПараметрыПодключения.ИмяФайла);
	
    Запрос 		= Новый HTTPЗапрос(ПараметрыПодключения.СтрокаЗапроса + ПараметрыПодключения.Токен, ЗаголовокHTTP);
    Запрос.УстановитьИмяФайлаТела(ИмяФайлаОтправки);
    ОтветPOST  = Соединение.ОтправитьДляОбработки(Запрос);
	
	СтрокаОтвета = ОтветPOST.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	ИмяСобытия 	= "VelostranaAPI." + ПараметрыПодключения.ИмяФайла + ".Ответ";
	КомментарийЖурнала = "Ошибка: " + СтрокаОтвета;
	
	Если СтрНайти(СтрокаОтвета, "Success") = 0 Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , КомментарийЖурнала);
		Возврат Ложь
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

