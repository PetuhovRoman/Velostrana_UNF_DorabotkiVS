	timestamp = ДобавитьМесяц(ТекущаяДата(),-1)-Дата(1970,1,1);
	
	HTTPЗапрос = Новый HTTPЗапрос("api/velostrana/1c/order/"+Формат(timestamp, "ЧГ=0")+"/?token="+Токен+"&status=0",ЗаголовокHTTP);
	
	ОтветHTTP = HTTPСоединение.ВызватьHTTPМетод("GET", HTTPЗапрос);
	СтрокаОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
	//УчетнаяЗаписьПочты = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоКоду("000000002");
	//УправлениеЭлектроннойПочтой.ОтправитьПростоеПисьмо(УчетнаяЗаписьПочты, "1c@velostrana.ru", "ЗАГРУЗКА ЗАКАЗОВ", СокрЛП(ИмяФайлаJSON) + " " + Формат(timestamp, "ЧГ=0"), , ИмяФайлаJSON);
	
	СписокЗаказов = ПреобразоватьJSONВСоответствие(СтрокаОтвета);
	
	мВалютаРегламентированногоУчета = Константы.ВалютаУчета.Получить();
	
	Если ТипЗнч(СписокЗаказов) = Тип("Соответствие") 
