Процедура СохранитьФайлыМаркировки(ВладелецФайла, Файл, ИмяБезРасширения, РасширениеБезТочки, Описание = "")
	
	ИмяСправочника = "ЗаказПокупателяПрисоединенныеФайлы";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателяПрисоединенныеФайлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЗаказПокупателяПрисоединенныеФайлы КАК ЗаказПокупателяПрисоединенныеФайлы
	|ГДЕ
	|	ЗаказПокупателяПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
	|	И ЗаказПокупателяПрисоединенныеФайлы.Наименование = &ИмяФайла";
	Запрос.УстановитьПараметр("ИмяФайла", ИмяБезРасширения);
	Запрос.УстановитьПараметр("ВладелецФайла", ВладелецФайла);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПрисоединенныйФайл = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		ПрисоединенныйФайл = Справочники.ЗаказПокупателяПрисоединенныеФайлы.СоздатьЭлемент(); // ОпределяемыйТип.ПрисоединенныйФайлОбъект
	КонецЕсли;
	
	ХранитьВерсии = СтрСравнить(ИмяСправочника, Метаданные.Справочники.Файлы.Имя) = 0;

	ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();
	ПрисоединенныйФайл.ВладелецФайла                = ВладелецФайла;
	ПрисоединенныйФайл.ДатаМодификацииУниверсальная = ВремяИзмененияУниверсальное;
	ПрисоединенныйФайл.ДатаСоздания                 = ТекущаяДатаСеанса();
	ПрисоединенныйФайл.Описание                     = Описание;
	ПрисоединенныйФайл.Наименование                 = ИмяБезРасширения;
	ПрисоединенныйФайл.Размер                       = Файл.Размер();
	ПрисоединенныйФайл.Расширение                   = РасширениеБезТочки;
	ПрисоединенныйФайл.ТипХраненияФайла             = РаботаСФайламиСлужебный.ТипХраненияФайла(ПрисоединенныйФайл.Размер,
		ПрисоединенныйФайл.Расширение);
	ПрисоединенныйФайл.Изменил                      = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");
	ПрисоединенныйФайл.ХранитьВерсии                = Ложь;
	
	ПрисоединенныйФайл.Том = Справочники.ТомаХраненияФайлов.ПустаяСсылка();
	ПрисоединенныйФайл.ПутьКФайлу = "";
	//ПрисоединенныйФайл.Заполнить(Неопределено);
	ПрисоединенныйФайл.Записать();
	
	ХранилищеДД = Справочники.ХранилищеДвоичныхДанных.СоздатьЭлемент();
	ХранилищеДД.Размер = ПрисоединенныйФайл.Размер;
	ХранилищеДД.ДвоичныеДанные = Новый ХранилищеЗначения(Файл);
	ХранилищеДД.Записать();
	
	МЗФ = РегистрыСведений.ХранилищеФайлов.СоздатьМенеджерЗаписи();
	МЗФ.Файл = ПрисоединенныйФайл.Ссылка;
	МЗФ.ХранилищеДвоичныхДанных = ХранилищеДД.Ссылка;
	МЗФ.Записать();
	
КонецПроцедуры

