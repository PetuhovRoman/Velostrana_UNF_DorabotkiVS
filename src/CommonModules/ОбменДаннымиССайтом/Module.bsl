	СтруктураПараметровОбработки.Вставить("РеквизитТипЗаказа", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ТипЗаказа_499f11036f214dbfbf0a5cb0cdee99f8"));
	СтруктураПараметровОбработки.Вставить("РеквизитИсполнитель", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "Исполнитель_11b013084e704ae5962740253b5ca52d"));
	
	СтруктураПараметровОбработки.Вставить("ОчередьОзон", Неопределено);
	СтруктураПараметровОбработки.Вставить("ОчередьВБ", Неопределено);
	СтруктураПараметровОбработки.Вставить("ОчередьЯМ", Неопределено);
	СтруктураПараметровОбработки.Вставить("ОчередьЯМГ", Неопределено);
	СтруктураПараметровОбработки.Вставить("ОчередьОсновная", Неопределено);
	
	ИсточникОсновной = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ИсточникиПривлеченияПокупателей?ref=bab2000c29e80aa411f03fd635b66bf1");  //WWW
	
	УправлениеОчередьюЗаказовПокупателей.ЗаменаОтветственных(СтруктураПараметровОбработки.ОчередьОсновная, ИсточникОсновной);
	
	Для Каждого ЗаказСоответствие Из СписокЗаказов Цикл
		Если ЗаказСоответствие["type"] = "callback" 
			Или ЗаказСоответствие["type"] = "feedback_request"
			Тогда
		Иначе
			ЗагрузитьЗаказ(ЗаказСоответствие, СтруктураПараметровОбработки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьЗаказ(ЗаказСоответствие, СтруктураПараметров)

	Перем ВариантыОбеспечения;
	
	ОписаниеЗаказа = "" + ЗаказСоответствие["type"] + " ";
	
	Номер = СтрЗаменить(ЗаказСоответствие["order_number"], Символы.НПП, "");
	Если ЗначениеЗаполнено(ЗаказСоответствие["yandex_order_number"]) Тогда
		Номер = СтрЗаменить(ЗаказСоответствие.Получить("yandex_order_number"), Символы.НПП, "");
	КонецЕсли;
	
	ДатаСоздания = ЗаказСоответствие["created_at"]; 
	
	Дата = ТекущаяДатаСеанса();
	ДатаПоставки = Дата + 24*60*60;
	
	Если ЗначениеЗаполнено(ЗаказСоответствие["yandex_shipment_date"]) Тогда
		МассивЧастейДаты = СтрРазделить(ЗаказСоответствие["yandex_shipment_date"], "-", Ложь);
		Если МассивЧастейДаты.Количество() = 3 Тогда 
			ДатаПоставки = Дата(МассивЧастейДаты[0],МассивЧастейДаты[1],МассивЧастейДаты[2]);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ЗаказСоответствие["ozon_shipment_date"]) Тогда
		СтрокаРазделители = ЗаказСоответствие["ozon_shipment_date"];
		// Удаляем дефисы, двоеточия и пробелы
		ЧистаяСтрока = СтрЗаменить(СтрокаРазделители, "-", "");
		ЧистаяСтрока = СтрЗаменить(ЧистаяСтрока, ":", "");
		ЧистаяСтрока = СтрЗаменить(ЧистаяСтрока, " ", "");
		
		ДатаПоставки = Дата(ЧистаяСтрока); // Получим 25.08.2026 20:59:00
	КонецЕсли;
	
	//ДатаПоставкиТекст = Дата + 24*60*60;
	
	//ДатаПоставки = ПреобразоватьДату(ДатаПоставкиТекст);
	
	ДатаСнятияРезерва = Дата(1,1,1);
	
	СтруктураКарта = Новый Структура;
	СтруктураКарта.Вставить("Наименование", ЗаказСоответствие["discount_card"]);
	СтруктураКарта.Вставить("Код", ЗаказСоответствие["discount_card"]);
	
	Если ЗначениеЗаполнено(ЗаказСоответствие["promo_code_id"]) Тогда 
		ПромокодСсайта = СокрЛП(ЗаказСоответствие["promo"]["promo"]);
	Иначе
		ПромокодСсайта = "";
	КонецЕсли;

	СтруктураПромокод = Новый Структура;
	СтруктураПромокод.Вставить("Наименование", ПромокодСсайта);
	
	Исполнитель = "";
	
	ТипЗаказа = СокрЛП(ЗаказСоответствие["type"]);
	//СтатусЗаказа = СокрЛП(мДокументДОМ.ПолучитьЭлементыПоИмени("Статус").Элемент(0).ТекстовоеСодержимое);
	Источник = СокрЛП(ЗаказСоответствие["type"]);
	АдресДоставки = СокрЛП(ЗаказСоответствие["address"]);
	
	СпособОплаты = ВернутьСпособОплаты(Строка(?(ЗаказСоответствие["payment"] = Неопределено, "", ЗаказСоответствие["payment"]["guid"])));
	СпособДоставки = ?(ЗаказСоответствие["delivery"] = Неопределено,"",	ЗаказСоответствие["delivery"]["name"]);
	ВидДоставки = ?(ЗаказСоответствие["delivery"] = Неопределено,"", 	Формат(ЗаказСоответствие["delivery"]["id"], "ЧГ=0"));
	СуммаДоставки = ?(ЗаказСоответствие["delivery"] = Неопределено,"",	ЗаказСоответствие["delivery"]["price"]);
	
	Если ВидДоставки = "3" Тогда //самовывоз 94-delivery 96-tk 
		ВидДоставки = "";
	КонецЕсли;
	
	Город          = ?(ЗаказСоответствие["city"] = Неопределено, "", ЗаказСоответствие["city"]["name"]);
	
