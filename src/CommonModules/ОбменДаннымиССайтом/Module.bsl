				//		Реализация = Накладная;
				//		Прервать;
				//	КонецЕсли;
				//КонецЦикла;
				
				Если ЕстьДокОплатыПоСсылкеНаОплату(СтрокаОплаты.НомерЗаказа, СтрокаОплаты.ДатаОплаты) Тогда
