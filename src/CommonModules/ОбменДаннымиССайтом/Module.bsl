				СтруктураСтроки = Новый Структура;
				
				СтруктураСтроки.Вставить("guid",			СокрЛП(ВыборкаСтрок.Номенклатура.УникальныйИдентификатор()));
				СтруктураСтроки.Вставить("name", 			СокрЛП(ВыборкаСтрок.НоменклатураНаименование));
				Если ЗначениеЗаполнено(ВыборкаСтрок.Характеристика) Тогда
					СтруктураСтроки.Вставить("variant", СокрЛП(ВыборкаСтрок.Характеристика.УникальныйИдентификатор()));
					СтруктураСтроки.Вставить("variant_name", 	СокрЛП(ВыборкаСтрок.Характеристика));
				КонецЕсли;
				
				СтруктураСтроки.Вставить("price", 			ВыборкаСтрок.Цена);
				//++ Куприненко ВВ 140925
				СтруктураСтроки.Вставить("first_price", 	ВыборкаСтрок.first_price);
				//==
				
				МассивСтрок.Добавить(СтруктураСтроки);
				
			КонецЦикла;
			
		КонецЦикла;
		
		СтруктураЗаказа.Вставить("items", МассивСтрок);
		МассивЗаказов.Добавить(СтруктураЗаказа);
		
	КонецЦикла;
	
	Возврат МассивЗаказов;
	
КонецФункции

Функция ВыгрузитьЗаказыПоУзлу(УзелОбмена, ОтправлятьРезультат = Ложь) Экспорт 
	
	
	//Сообщить("Всего заказов к выгрузке: " + СписокЗаказов.Количество());
	//УзелОбмена = ПланыОбмена.ВыгрузкаЗаказовЛичныйКабинет.НайтиПоКоду();
	Результат = Новый Массив;
	//ТекстЗапроса = "/v3/posting/fbs/list";
	ПакетЗаказов = 1000;
	
	МассивЗаказов = Новый Массив;
	МассивУдаленных = Новый Массив;
	
	НомерСообщения = 1;
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(УзелОбмена, НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
		
		Объект = ВыборкаИзменений.Получить();
		флУдаление = ?(ТипЗнч(Объект) = Тип("УдалениеОбъекта"), Истина, Ложь);
		
		Если Не флУдаление Тогда
			
			МассивЗаказов.Добавить(Объект.Ссылка);
			
			Если МассивЗаказов.Количество() >= ПакетЗаказов Тогда
				ОтправитьМассив(УзелОбмена, МассивЗаказов, Результат, ОтправлятьРезультат);
			КонецЕсли;
		Иначе
			МассивУдаленных.Добавить(Объект);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивЗаказов.Количество() > 0 Тогда
		ОтправитьМассив(УзелОбмена, МассивЗаказов, Результат, ОтправлятьРезультат);
	КонецЕсли;
	
	Если МассивУдаленных.Количество() > 0 Тогда
		ОтправитьМассивУдаленных(УзелОбмена, МассивУдаленных, Результат, ОтправлятьРезультат)
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОтправитьМассив(Узел, МассивЗаказов, Результат, ОтправлятьРезультат)
	
	ПараметрыПодключения = НастройкиПодключения(ОтправлятьРезультат, "/api/velostrana/1c/lk/?token=", "lk");

	orders = СформироватьЗаказы(МассивЗаказов);	
	ТелоЗапроса = ПреобразоватьДанныеВJSON(orders);
	
	РезультатЗапроса = ВыполнитьPOSTЗапрос(ТелоЗапроса, ПараметрыПодключения);
	
	УдалитьРегистрацию(Узел, МассивЗаказов, РезультатЗапроса);
	
	МассивЗаказов.Очистить();
	
	Результат.Добавить(РезультатЗапроса);
	
	
КонецПроцедуры

Процедура ОтправитьМассивУдаленных(Узел, МассивЗаказов, Результат, ОтправлятьРезультат)
	
	ПараметрыПодключения = НастройкиПодключения(ОтправлятьРезультат, "/api/velostrana/1c/lk/?token=", "lk");
	
	orders = СформироватьУдаленныеЗаказы(МассивЗаказов);
	
	ТелоЗапроса = ПреобразоватьДанныеВJSON(orders);
	РезультатЗапроса = ВыполнитьPOSTЗапрос(ТелоЗапроса, ПараметрыПодключения);
	
	УдалитьРегистрацию(Узел, МассивЗаказов, РезультатЗапроса);
	
	МассивЗаказов.Очистить();
	Результат.Добавить(РезультатЗапроса);
	
КонецПроцедуры

Функция СформироватьУдаленныеЗаказы(ИсходныйМассивЗаказов)
	
	МассивЗаказов = Новый Массив;
	Для Каждого Объект Из ИсходныйМассивЗаказов Цикл
		СтруктураЗаказа = Новый Структура;
		СтруктураЗаказа.Вставить("guid", 		СокрЛП(Объект.Ссылка.УникальныйИдентификатор()));
		МассивЗаказов.Добавить(СтруктураЗаказа);
	КонецЦикла;
	
	Возврат МассивЗаказов;
	
КонецФункции

Процедура УдалитьРегистрацию(Узел, МассивОбъектов, РезультатЗапроса)
	
	Если РезультатЗапроса Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, МассивОбъектов);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

//ВЫГРУЗКА БОНУСОВ В ЛК
#Область ВыгрузкаБонусовВЛичныйКабинет

Процедура ВыгрузитьБонусы() Экспорт
	
	ВыборкаУзлов = ПланыОбмена.ИнтеграцияСИнтернетМагазиномБонусы.Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		Если ВыборкаУзлов.Ссылка <> ПланыОбмена.ИнтеграцияСИнтернетМагазиномБонусы.ЭтотУзел() Тогда
			//ВыгрузкаЗаказовВЛичныйКабинет.ВыгрузитьЗаказы(ВыборкаУзлов.Ссылка);
			ВыгрузитьБонусыПоУзлу(ВыборкаУзлов.Ссылка, Ложь); //ОтправлятРезультат на почту
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
	
Функция ВыгрузитьБонусыПоУзлу(УзелОбмена, ОтправлятьРезультат = Ложь) Экспорт 
	
	ВидКИ_Телефон = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
	//Сообщить("Всего заказов к выгрузке: " + СписокЗаказов.Количество());
	//УзелОбмена = ПланыОбмена.ВыгрузкаЗаказовЛичныйКабинет.НайтиПоКоду();
	Результат = Новый Массив;
	//ТекстЗапроса = "/v3/posting/fbs/list";
	ПакетДанных = 2000;
	
	МассивВыгруженных = Новый Массив;
	МассивДК = Новый Массив;
	
	НомерСообщения = 1;
	
	//"guid": "f26fce77-5d20-11ee-bbfa-ba0970cf9908",
	//"phone": "79032247550",
	//"bonus": "6789",
	//"balance": "231",
	//"created_at": "2025-06-05T16:27:57Z"
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(УзелОбмена, НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
		
		Объект = ВыборкаИзменений.Получить();
		МассивВыгруженных.Добавить(Объект);
		
		флУдаление = ?(ТипЗнч(Объект) = Тип("УдалениеОбъекта"), Истина, Ложь);
		
		Если Не флУдаление Тогда
			
			
			Если ТипЗнч(Объект) = Тип("СправочникОбъект.ДисконтныеКарты") Тогда	
				
				Если Не ЗначениеЗаполнено(Объект.ВладелецКарты) Тогда
					Продолжить;
				КонецЕсли;
				
				Телефон = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(Объект.ВладелецКарты, ВидКИ_Телефон, , ТекущаяДатаСеанса());	
				
				Если ЗначениеЗаполнено(Телефон) Тогда
					СтруктураДК = Новый Структура;
					СтруктураДК.Вставить("guid", XMLСтрока(Объект.Ссылка));
					СтруктураДК.Вставить("items", Новый Массив);
					СтруктураЗаписи = Новый Структура;
					СтруктураЗаписи.Вставить("phone", Телефон);
					СтруктураЗаписи.Вставить("bonus", 0);
					СтруктураЗаписи.Вставить("balance", ПолучитьБалансБонусов(Объект.Ссылка));
					СтруктураЗаписи.Вставить("created_at", ТекущаяДатаСеанса());
					СтруктураДК.items.Добавить(СтруктураЗаписи);
					МассивДК.Добавить(СтруктураДК);
				Иначе
					ИмяСобытия 	= "VelostranaAPI.ВыгрузкаБонусов";
					Комментарий = "Не указан телефон у контрагента: " + СокрЛП(Объект.ВладелецКарты);
					
					ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка, Комментарий);
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Объект) = Тип("РегистрНакопленияНаборЗаписей.БонусныеБаллы") Тогда
				
				КоличествоЗаписей = Объект.Количество() - 1;
				Если КоличествоЗаписей < 0 Тогда
					Регистратор = Объект.Отбор.Регистратор.Значение;
					Если ЗначениеЗаполнено(Регистратор) Тогда
						СтруктураДК = Новый Структура;
						СтруктураДК.Вставить("guid", XMLСтрока(Регистратор));
						МассивДК.Добавить(СтруктураДК);
					КонецЕсли;	
				Иначе
					СтруктураДК = Новый Структура;
					СтруктураДК.Вставить("guid", XMLСтрока(Объект.Отбор.Регистратор.Значение));
					СтруктураДК.Вставить("items", Новый Массив);
					Для Индекс = 0 по КоличествоЗаписей Цикл 
						Запись = Объект[КоличествоЗаписей - Индекс]; 
						Если Запись.Начислено = 0 Тогда Продолжить КонецЕсли;
						
						//Если ТипЗнч(Запись.Регистратор) = Тип("ДокументСсылка.ЧекККМ")
						//	Или ТипЗнч(Запись.Регистратор) = Тип("ДокументСсылка.ЧекККМВозврат")
						//	Тогда
						//	Продолжить; //ПО ЧЕКАМ ДАННЫЕ ИЗ ОРП
						//КонецЕсли;
						Если Не ЗначениеЗаполнено(Запись.БонуснаяКарта.ВладелецКарты) Тогда
							Продолжить;
						КонецЕсли;
						
						Телефон = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(Запись.БонуснаяКарта.ВладелецКарты, ВидКИ_Телефон, , ТекущаяДатаСеанса());	
						Если ЗначениеЗаполнено(Телефон) Тогда
							СтруктураЗаписи = Новый Структура;
							СтруктураЗаписи.Вставить("phone", Телефон);
							Если Запись.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
								СтруктураЗаписи.Вставить("bonus", Запись.Начислено);
							Иначе 
								СтруктураЗаписи.Вставить("bonus", -Запись.Начислено);
							КонецЕсли;
							СтруктураЗаписи.Вставить("balance", ПолучитьБалансБонусов(Запись.БонуснаяКарта));
							СтруктураЗаписи.Вставить("created_at", Запись.Период);
							
							СтруктураДК.items.Добавить(СтруктураЗаписи);
							
						Иначе
							ИмяСобытия 	= "VelostranaAPI.ВыгрузкаБонусов";
							Комментарий = "Не указан телефон у контрагента: " + СокрЛП(Запись.БонуснаяКарта.ВладелецКарты);
							
							ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Запись.БонуснаяКарта, Комментарий);
						КонецЕсли;
					КонецЦикла;
					МассивДК.Добавить(СтруктураДК);
				КонецЕсли;
			КонецЕсли;
		Иначе
			СтруктураЭлементов = Новый Структура;
			СтруктураЭлементов.Вставить("guid", 		XMLСтрока(Объект.Ссылка));
			МассивДК.Добавить(СтруктураЭлементов);
		КонецЕсли;
		
		Если МассивВыгруженных.Количество() >= ПакетДанных Тогда
			РезультатЗапроса = ОтправитьМассивДК(УзелОбмена, МассивДК, Результат, ОтправлятьРезультат);
			УдалитьРегистрацию(УзелОбмена, МассивВыгруженных, РезультатЗапроса);
			МассивВыгруженных = Новый Массив;
			МассивДК = Новый Массив;
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивДК.Количество() > 0 Тогда
		РезультатЗапроса = ОтправитьМассивДК(УзелОбмена, МассивДК, Результат, ОтправлятьРезультат);
		
		УдалитьРегистрацию(УзелОбмена, МассивВыгруженных, РезультатЗапроса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОтправитьМассивДК(Узел, МассивДанных, Результат, ОтправлятьРезультат)
	
	ПараметрыПодключения = НастройкиПодключения(ОтправлятьРезультат, "/api/velostrana/1c/lk/bonus/?token=", "bonus");

	//МассивДК = СформироватьДК(МассивДанных);	
	ТелоЗапроса = ПреобразоватьДанныеВJSON(МассивДанных);
	
	Если ОтправлятьРезультат Тогда
		ТемаПисьма = "Выгрузка бонусов";
		ТелоПисьма = ТелоЗапроса;
		АдресаПолучателей = "1c@velostrana.ru";
		РезультатОтправки = Ложь;
		ОбщегоНазначенияРМКУНФ.ОтправитьEmail(РезультатОтправки, ТемаПисьма, ТелоПисьма, АдресаПолучателей, ";");
	КонецЕсли;
		
	РезультатЗапроса = ВыполнитьPOSTЗапрос(ТелоЗапроса, ПараметрыПодключения);
	
	Возврат РезультатЗапроса
	
КонецФункции

Функция ПолучитьБалансБонусов(ДК)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(БонусныеБаллыОстатки.НачисленоОстаток) КАК НачисленоОстаток
	|ИЗ
	|	РегистрНакопления.БонусныеБаллы.Остатки(, БонуснаяКарта = &БонуснаяКарта) КАК БонусныеБаллыОстатки
	|
	|ИМЕЮЩИЕ
	|	СУММА(БонусныеБаллыОстатки.НачисленоОстаток) > 0";
	Запрос.УстановитьПараметр("БонуснаяКарта", ДК);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НачисленоОстаток;
	КонецЕсли;
	
	Возврат 0;

КонецФункции

#КонецОбласти

//ВЫГРУЗКА СТАТУСОВ ЗАКАЗОВ
#Область ВыгрузкаСтатусовЗаказов

Процедура ВыгрузитьСтатусыЗаказов() Экспорт
	
	Узел = ПланыОбмена.ИнтеграцияСИнтернетМагазиномЗаказы.НайтиПоНаименованию("ВыгрузкаСтатусовВелострана",Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", Узел);

	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	ЗаказПокупателяИзменения.Ссылка КАК Ссылка,
	|	ЗаказПокупателяИзменения.Ссылка.Номер КАК Номер,
	|	ЗаказПокупателяИзменения.Ссылка.НомерНаСайте КАК НомерНаСайте,
	|	ВЫБОР
	|		КОГДА НЕ ЗакрытиеЗаказовПокупателейЗаказы.Ссылка ЕСТЬ NULL
	|				ИЛИ ЗаказПокупателяИзменения.Ссылка.СтатусЗаказа = ЗНАЧЕНИЕ(Перечисление.СтатусЗаказа.Отменен)
	|			ТОГДА 8
	|		КОГДА ПродажиОбороты.КоличествоОборот > 0 И НЕ ЗаказПокупателяИзменения.Ссылка.ТипЗаказа = ЗНАЧЕНИЕ(Перечисление.ТипЗаказа.ДоставкаРегион)
	|			ТОГДА 6
	|		КОГДА ЗаказПокупателяИзменения.Ссылка.СтатусЗаказа = ЗНАЧЕНИЕ(Перечисление.СтатусЗаказа.Доставлен)
	|			ТОГДА 6
	|		КОГДА ЕСТЬNULL(РасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток, 0) = 0
	|				ИЛИ ЗаказПокупателяИзменения.Ссылка.СтатусЗаказа = ЗНАЧЕНИЕ(Перечисление.СтатусЗаказа.Оплачен)
	|			ТОГДА 5
	|		КОГДА ЗаказПокупателяИзменения.Ссылка.СтатусЗаказа В (ЗНАЧЕНИЕ(Перечисление.СтатусЗаказа.Недозвон), ЗНАЧЕНИЕ(Перечисление.СтатусЗаказа.ОформлениеЗаказа), ЗНАЧЕНИЕ(Перечисление.СтатусЗаказа.ОжиданиеОтправки), ЗНАЧЕНИЕ(Перечисление.СтатусЗаказа.ОформлениеЗаказа), ЗНАЧЕНИЕ(Перечисление.СтатусЗаказа.ПолученССайта))
	|			ТОГДА 3
	|		КОГДА ЗаказПокупателяИзменения.Ссылка.СтатусЗаказа = ЗНАЧЕНИЕ(Перечисление.СтатусЗаказа.ОжиданиеОплаты)
	|			ТОГДА 4
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК СтатусДляСайта
	|ИЗ
	|	Документ.ЗаказПокупателя.Изменения КАК ЗаказПокупателяИзменения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗакрытиеЗаказовПокупателей.Заказы КАК ЗакрытиеЗаказовПокупателейЗаказы
	|		ПО ЗаказПокупателяИзменения.Ссылка = ЗакрытиеЗаказовПокупателейЗаказы.Ссылка
	|			И (ЗакрытиеЗаказовПокупателейЗаказы.Ссылка.Проведен)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты КАК ПродажиОбороты
	|		ПО ЗаказПокупателяИзменения.Ссылка = ПродажиОбороты.ЗаказПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКонтрагентами.Остатки КАК РасчетыСКонтрагентамиОстатки
	|		ПО ЗаказПокупателяИзменения.Ссылка = РасчетыСКонтрагентамиОстатки.Сделка
	|ГДЕ
	|	ЗаказПокупателяИзменения.Узел = &Узел";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИмяСайта = "panel.velostrana.ru";
	Токен = "M7QyNbpVsb7tYd7lMvdJvC0nCzf4Qyvfy3W8e2AgWp9Ul6Mq5AnDKkYg8bS6ZM7r";
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Cookie", "token=" + Токен);
	ЗаголовокHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded;");  
	HTTPСоединение = Новый HTTPСоединение(ИмяСайта,,,,,, Новый ЗащищенноеСоединениеOpenSSL());
	HTTPЗапросPOST = Новый HTTPЗапрос("api/velostrana/1c/order/?token="+Токен, ЗаголовокHTTP);
	
	Пока Выборка.Следующий() Цикл		
		
		HTTPЗапросPOST = Новый HTTPЗапрос("api/velostrana/1c/order/?token="+Токен,ЗаголовокHTTP);
		HTTPЗапросPOST.УстановитьТелоИзСтроки("order_number=" + СокрЛП(Выборка.Номер)+"&status=" + СокрЛП(Выборка.СтатусДляСайта));
		ОтветPOST = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапросPOST);
		
		Если ОтветPOST.КодСостояния = 200 Тогда	
			ЗаписьЖурналаРегистрации("Изменение статуса на сайте", УровеньЖурналаРегистрации.Информация,,,"order_number=" + СокрЛП(Выборка.Номер) + " &status=" + СокрЛП(Выборка.СтатусДляСайта));
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел,Выборка.Ссылка);
		КонецЕсли;	
		
	КонецЦикла;   

КонецПроцедуры

