#Область ЗагрузкаОплат

Функция ЗаказОплаченНаСайтеAPI(СтруктураПараметров, Обновить = Ложь) Экспорт
	
	СсылкаНаЗаказ = СтруктураПараметров.ЗаказПокупателя;
	НомерЗаказа = СтруктураПараметров.НомерЗаказа;
	
	ТаблицаЗаказов = ТаблицаЗаказыОплаты();
	
	Конект = Новый HTTPСоединение("www.velostrana.ru",,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	//Токен = ПолучитьТокен();
	ЗаголовокHTTP = Новый Соответствие();
	
	ХТТПЗапрос = Новый HTTPЗапрос("/payment/alfabank/1c/?order_number=" + НомерЗаказа + ?(Обновить, "&update=1", ""), ЗаголовокHTTP);
	ОтветHTTP = Конект.Получить(ХТТПЗапрос);
	
	ИмяСобытия 	= "VelostranaAPI_СтатусОплаты.Ответ";
	СтрокаОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
	
	Если СтрНайти(СтрокаОтвета, "Success") = 0 Тогда
		//ЗаписьЖурналаРегистрации("VelostranaAPI.СтатусОплаты", УровеньЖурналаРегистрации.Ошибка,, СсылкаНаЗаказ, "Не удалось получить оплаты по заказу " + НомерЗаказа + Символы.ПС + СтрокаОтвета);
		Возврат ТаблицаЗаказов;
	КонецЕсли;	
		
	Результат = ПреобразоватьJSONВСоответствие(СтрокаОтвета);
		
	Если Результат["total"] = 0 Тогда
		Возврат ТаблицаЗаказов;
	КонецЕсли;
	
	ТаблицаЗаказов.Очистить();
	Для Каждого ДанныеПоЗаказу Из Результат["orders"] Цикл
		РеквизитыЗаказа = ДанныеПоЗаказу.Значение;
		
		СтатусОплаты = РеквизитыЗаказа.Получить("status");
		Если ВРег(СтатусОплаты) = "PAID" Тогда
			НоваяСтрока = ТаблицаЗаказов.Добавить();
			НоваяСтрока.ЗаказПокупателя	= СсылкаНаЗаказ;
			НоваяСтрока.Организация		= Справочники.Организации.ОсновнаяОрганизация;
			НоваяСтрока.ДатаОплаты		= РеквизитыЗаказа.Получить("created_at");
			НоваяСтрока.НомерЗаказа		= РеквизитыЗаказа.Получить("order_number");
			НоваяСтрока.ИдЗаказа		= РеквизитыЗаказа.Получить("guid");
			НоваяСтрока.СтатусОплаты	= СтатусОплаты;
			НоваяСтрока.СуммаОплаты		= РеквизитыЗаказа.Получить("amount");
		КонецЕсли;
	КонецЦикла;
	ТаблицаЗаказов.Сортировать("ДатаОплаты");

	Возврат ТаблицаЗаказов;
	
КонецФункции
	
Функция ТаблицаЗаказыОплаты()
	
	ТЗ = Новый ТаблицаЗначений;
	
	ОписаниеТиповСтрока			= Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0, 	ДопустимаяДлина.Переменная)); 
	ОписаниеТиповСтрока20 		= Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(20, 	ДопустимаяДлина.Переменная));
	ОписаниеТиповСтрока30 		= Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(30, 	ДопустимаяДлина.Переменная));
	ОписаниеТиповСтрока200 		= Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная));
	ОписаниеТиповЧисло20_0 		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 0, ДопустимыйЗнак.Неотрицательный));
	ОписаниеТиповЧисло15_2 		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный));
	ОписаниеТиповДата 			= Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	ОписаниеТиповБулево 		= Новый ОписаниеТипов("Булево");
	//ОписаниеТиповСклад 			= Новый ОписаниеТипов("СправочникСсылка.Склады");
	//ОписаниеТиповЗаказКлиента 	= Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя");
	ТЗ.Колонки.Добавить("ЗаказПокупателя");
	ТЗ.Колонки.Добавить("Организация");
	ТЗ.Колонки.Добавить("ДатаОплаты", 		ОписаниеТиповДата);
	ТЗ.Колонки.Добавить("НомерЗаказа", 		ОписаниеТиповСтрока20);
	ТЗ.Колонки.Добавить("ИдЗаказа", 		ОписаниеТиповСтрока200);
	ТЗ.Колонки.Добавить("СтатусОплаты", 	ОписаниеТиповСтрока30);  //status
	ТЗ.Колонки.Добавить("СуммаОплаты", 		ОписаниеТиповЧисло15_2);
	
	Возврат ТЗ;
	
КонецФункции

Процедура ЗагрузкаОплатыЗаказов() Экспорт
	МассивРеализацийКПроведению = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ФактОплатыЗаказов.СчетНаОплату КАК ЗаказПокупателя,
	|	ЕСТЬNULL(ЗаказыПокупателейССайта.НомерЗаказаНаСайте, ФактОплатыЗаказов.СчетНаОплату.Номер) КАК НомерЗаказа,
	|	ДоговорыКонтрагентов.Организация КАК Организация,
	|	ФактОплатыЗаказов.Сумма - ФактОплатыЗаказов.СуммаОплаты - ФактОплатыЗаказов.СуммаАванса КАК СуммаОстаток
	|ИЗ
	|	РегистрСведений.ФактОплатыЗаказов КАК ФактОплатыЗаказов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ФактОплатыЗаказов.СчетНаОплату.Организация = ДоговорыКонтрагентов.Организация
	|			И (ДоговорыКонтрагентов.ЭтоДоговорЭквайринга)
	|			И (НЕ ДоговорыКонтрагентов.ПометкаУдаления)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	|		ПО ФактОплатыЗаказов.СчетНаОплату.Организация = ПодключаемоеОборудование.Организация
	|			И (ПодключаемоеОборудование.ТипПодключения = ЗНАЧЕНИЕ(Перечисление.ТипыПодключенияОборудования.ОбщийДоступ))
	|			И (ПодключаемоеОборудование.ТипОборудования = ЗНАЧЕНИЕ(Перечисление.ТипыПодключаемогоОборудования.ОблачнаяККТ))
	|			И (НЕ ПодключаемоеОборудование.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыПокупателейССайта
	|		ПО ФактОплатыЗаказов.СчетНаОплату = ЗаказыПокупателейССайта.ЗаказПокупателя
	|ГДЕ
	|	ФактОплатыЗаказов.СчетНаОплату ССЫЛКА Документ.ЗаказПокупателя
	|	И НЕ ФактОплатыЗаказов.СчетНаОплату.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	|	И ФактОплатыЗаказов.СуммаОплаты + ФактОплатыЗаказов.СуммаАванса < ФактОплатыЗаказов.Сумма
	|	И ВЫБОР
	|			КОГДА ФактОплатыЗаказов.СчетНаОплату.ВидЗаказа = &СезонноеХранение
	|				ТОГДА ФактОплатыЗаказов.СчетНаОплату.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&НачалоПериода, МЕСЯЦ, -5) И &КонецПериода
	|			ИНАЧЕ ФактОплатыЗаказов.СчетНаОплату.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ТекущаяДатаСеанса() - 20 * 24*60*60));
	Запрос.УстановитьПараметр("КонецПериода", ТекущаяДатаСеанса() - 1*60*60);
	Запрос.УстановитьПараметр("СезонноеХранение", ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ВидыЗаказовПокупателей?ref=bbb385d39ee01ba511f099293b41e9a2"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЗаказПокупателя", Выборка.ЗаказПокупателя);
		СтруктураПараметров.Вставить("НомерЗаказа", ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ПрефиксацияОбъектовКлиентСервер.УдалитьПрефиксыИзНомераОбъекта(Выборка.НомерЗаказа, Истина, Истина)));
		
		ТаблицаОплат = ЗаказОплаченНаСайтеAPI(СтруктураПараметров);
		СуммаОстаток = Выборка.СуммаОстаток;
		Если ТаблицаОплат.Количество() > 0 Тогда
