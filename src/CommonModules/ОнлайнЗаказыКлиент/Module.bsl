
&Вместо("Подключаемый_ОткрытьФормуURLЗаказа")
Процедура ВС_Подключаемый_ОткрытьФормуURLЗаказа(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыСообщения = КонструкторПараметровОтправкиБезШаблона(ПараметрКоманды);
	
	Если Не ПараметрыСообщения = Неопределено Тогда 
		РаботаСПочтовымиСообщениямиКлиент.СоздатьНовоеПисьмо(ПараметрыСообщения);
	КонецЕсли;
	
КонецПроцедуры

Функция КонструкторПараметровОтправкиБезШаблона(ПараметрКоманды)

	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить("Получатель", ОнлайнЗаказыВызовСервера.СписокПолучателей(ПараметрКоманды));
	ПараметрыСообщения.Вставить("Предмет", ПараметрКоманды);
	ПараметрыСообщения.Вставить("Тема", НСтр("ru = 'Ссылка на оплату заказа.'"));
	ПараметрыСообщения.Вставить("Ответственный", УправлениеНебольшойФирмойВызовСервера.ЗначениеРеквизитаОбъекта(ПараметрКоманды, "Ответственный"));
	ПараметрыЗаказа = Новый Структура;
	ПараметрыЗаказа.Вставить("ПредставлениеСсылки", ПараметрКоманды);
	ПараметрыЗаказа.Вставить("Сумма", ОнлайнЗаказыВызовСервера.СуммаОплаты(ПараметрКоманды));
	
	ПараметрыСообщения.Вставить(
		"Текст",
		Новый Структура(
			"ТекстHTML, СтруктураВложений",
			"",
			Новый Структура()));

	ИнтеграцияПодсистемБИПКлиент.ЗаполнитьПараметрыСообщенияБезШаблонаОнлайнЗаказы(
		ПараметрыСообщения,
		ПараметрыЗаказа);
	ОнлайнЗаказыКлиентПереопределяемый.ЗаполнитьПараметрыСообщенияБезШаблонаОнлайнЗаказы(
		ПараметрыСообщения,
		ПараметрыЗаказа);
		
	ПараметрыСообщения.Вставить("Текст", ОнлайнЗаказыВызовСервера.ТекстПисьмаБезШаблонаHTML(ПараметрКоманды));
	
	Если ПустаяСтрока(ПараметрыСообщения.Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПараметрыСообщения;
	
КонецФункции
