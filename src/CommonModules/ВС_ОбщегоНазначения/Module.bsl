Функция ПолучитьСсылкуИзНавигационной(НавигационнаяСсылкаСтрокой) Экспорт
    
    ПерваяТочка = Найти(НавигационнаяСсылкаСтрокой, "e1cib/data/");
    ВтораяТочка = Найти(НавигационнаяСсылкаСтрокой, "?ref=");
    
    ПредставлениеТипа   = Сред(НавигационнаяСсылкаСтрокой, ПерваяТочка + 11, ВтораяТочка - ПерваяТочка - 11);
    ШаблонЗначения = ЗначениеВСтрокуВнутр(ПредопределенноеЗначение(ПредставлениеТипа + ".ПустаяСсылка"));
    ЗначениеСсылки = СтрЗаменить(ШаблонЗначения, "00000000000000000000000000000000", Сред(НавигационнаяСсылкаСтрокой, ВтораяТочка + 5));
	
	Возврат ЗначениеИзСтрокиВнутр(ЗначениеСсылки);
   	 
КонецФункции  

Функция ЕстьПодчиненныеДокументы(СсылкаНаДокумент, ТолькоПроведенные = Ложь, ТипДокумента = "") Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СвязанныеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Документ) КАК СвязанныеДокументы
	|ГДЕ
	|	ИСТИНА";
	
	Если ТолькоПроведенные Тогда
		ТекстЗапроса = ТекстЗапроса + 
		"
		|   И СвязанныеДокументы.Ссылка.Проведен";
	КонецЕсли;
	Если ЗначениеЗаполнено(ТипДокумента) Тогда
		ТекстЗапроса = ТекстЗапроса + 
		"
		|	И СвязанныеДокументы.Ссылка ССЫЛКА Документ." + ТипДокумента;
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Документ", СсылкаНаДокумент);    
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьПодчиненныеДокументы(СсылкаНаДокумент, ТолькоПроведенные = Ложь, ТипДокумента = "") Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СвязанныеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Документ) КАК СвязанныеДокументы
	|ГДЕ
	|	НЕ СвязанныеДокументы.Ссылка.ПометкаУдаления";
	
	Если ТолькоПроведенные Тогда
		ТекстЗапроса = ТекстЗапроса + 
		"
		|   И СвязанныеДокументы.Ссылка.Проведен";
	КонецЕсли;
	Если ЗначениеЗаполнено(ТипДокумента) Тогда
		ТекстЗапроса = ТекстЗапроса + 
		"
		|	И СвязанныеДокументы.Ссылка ССЫЛКА Документ." + ТипДокумента;
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + 
	"
	|УПОРЯДОЧИТЬ ПО
	|	СвязанныеДокументы.Ссылка.Дата,
	|	СвязанныеДокументы.Ссылка";

	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Документ", СсылкаНаДокумент);    
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

Функция СформироватьПечатнуюФормуМаркировки(МассивНоменклатуры) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = Справочники.Номенклатура.ПолучитьМакет("ДанныеМаркировки");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Номенклатура.Артикул КАК Артикул,
	|	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика КАК Характеристика,
	|	ПулКодовМаркировкиСУЗ.ПолныйКодМаркировки КАК ПолныйКодМаркировки,
	|	ШтрихкодыУпаковокТоваров.Ссылка КАК ШтрихкодУпаковки,
	|	ПулКодовМаркировкиСУЗ.GTIN КАК GTIN
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
	|		ПО (ПулКодовМаркировкиСУЗ.ШтрихкодУпаковки = ШтрихкодыУпаковокТоваров.Ссылка)
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.Номенклатура В(&Массив)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	Характеристика
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Массив",МассивНоменклатуры);
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ТабДокумент.Вывести(Шапка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		ОбластьСтрокаТаблицы = Макет.ПолучитьОбласть("Строка");
		ОбластьСтрокаТаблицы.Параметры.Заполнить(Выборка);
		ТабДокумент.Вывести(ОбластьСтрокаТаблицы); 
		
	КонецЦикла;
	
	ЕстьПечать = ТабДокумент.Области.Количество() > 0;	
	Возврат ?(ЕстьПечать, ТабДокумент, Неопределено);

КонецФункции

Процедура ОтправитьSMS(НомераПолучателей, ДанныеЗаполнения, Результат) Экспорт
	
	Если НомераПолучателей.Количество() > 0 Тогда
		
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ТипСобытия",
		ПредопределенноеЗначение("Перечисление.ТипыСобытий.СообщениеSMS"));
		
		НовоеСобытие = Документы.Событие.СоздатьДокумент();
		НовоеСобытие.Заполнить(ЗначенияЗаполнения);
		НовоеСобытие.Дата = ТекущаяДатаСеанса();
		НовоеСобытие.ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.СообщениеSMS");
		НовоеСобытие.Тема = ДанныеЗаполнения.ТемаСообщения;
		НовоеСобытие.СодержаниеHTML = ДанныеЗаполнения.ТекстСообщения;
		НовоеСобытие.Содержание = ДанныеЗаполнения.ТекстСообщения;
		Если ДанныеЗаполнения.Свойство("Ответственный") И ЗначениеЗаполнено(ДанныеЗаполнения.Ответственный) Тогда
			НовоеСобытие.Ответственный = ДанныеЗаполнения.Ответственный;
		КонецЕсли;
		Если ДанныеЗаполнения.Свойство("Основание") И ЗначениеЗаполнено(ДанныеЗаполнения.Основание) Тогда
			НовоеСобытие.ДокументОснование = ДанныеЗаполнения.Основание;
		КонецЕсли;
		
		НовоеСобытие.Участники.Очистить();
				
		Для Каждого Номер Из НомераПолучателей Цикл
			
			Если НЕ ЗначениеЗаполнено(Номер) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = НовоеСобытие.Участники.Добавить();
			НоваяСтрока.Контакт = Номер;
			НоваяСтрока.КакСвязаться = Номер;
			НоваяСтрока.НомерДляОтправки = Номер;
			
		КонецЦикла;
		
		Результат = НовоеСобытие.Участники.Количество() > 0;
		Если НЕ Результат Тогда
			Возврат;
		КонецЕсли;
		
		Попытка

			НовоеСобытие.Записать();
			НовоеСобытие.ОтправитьSMS();
			Результат = Истина;
			
		Исключение
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Отправка смс'",
					КодОсновногоЯзыка),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

// Отправляет email.
//
// Параметры:
//  Результат - Булево - признак выполнения операции отправки email.
//  ТемаПисьма - Строка - тема отправляемого email.
//  ТелоПисьма - Строка - тело текста отправляемого email .
//  АдресаПолучателей - Строка - адреса получателей через разделитель.
//  РазделительАдресовПолучателей - Строка - разделитель для адресов получателей.
//
Процедура ОтправитьEmail(Результат, ТемаПисьма, ТелоПисьма, АдресаПолучателей, РазделительАдресовПолучателей, Вложения = Неопределено) Экспорт
	
	Если НЕ ПустаяСтрока(АдресаПолучателей) Тогда
		
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ТипСобытия",
		ПредопределенноеЗначение("Перечисление.ТипыСобытий.ЭлектронноеПисьмо"));
		ИмяЭлементаПредопределеннойУчетнойЗаписи =
		"Справочник.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты";
		УчетнаяЗаписьДляОтправкиEmail =
			ОбщегоНазначения.ПредопределенныйЭлемент(ИмяЭлементаПредопределеннойУчетнойЗаписи);
		
		НовоеСобытие = Документы.Событие.СоздатьДокумент();
		НовоеСобытие.Заполнить(ЗначенияЗаполнения);
		НовоеСобытие.Дата = ТекущаяДатаСеанса();
		НовоеСобытие.УчетнаяЗапись = УчетнаяЗаписьДляОтправкиEmail;
		НовоеСобытие.ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.ЭлектронноеПисьмо");
		НовоеСобытие.Тема = ТемаПисьма;
		НовоеСобытие.СодержаниеHTML = ТелоПисьма;
		НовоеСобытие.Содержание = ТелоПисьма;
		
		НовоеСобытие.Участники.Очистить();
		
		Адреса =
			СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(АдресаПолучателей, РазделительАдресовПолучателей);
			
		НазначениеАдресата = ПредопределенноеЗначение("Перечисление.ТипыПолучателейЭлектронногоПисьма.Кому");
		
		Для Каждого Адрес Из Адреса Цикл
			
			Если НЕ ЗначениеЗаполнено(Адрес) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = НовоеСобытие.Участники.Добавить();
			НоваяСтрока.Контакт = Адрес;
			НоваяСтрока.КакСвязаться = Адрес;
			НоваяСтрока.ТипПолучателяЭлектронногоПисьма = НазначениеАдресата;
			
		КонецЦикла;
		
		Результат = НовоеСобытие.Участники.Количество() > 0;
		Если НЕ Результат Тогда
			Возврат;
		КонецЕсли;
		
		Попытка
			
			НовоеСобытие.Записать();
			
			Если Не Вложения = Неопределено И Вложения.Количество() > 0 Тогда
				НовоеСобытие.СохранитьВложения(СформироватьТаблицуВложений(Вложения, НовоеСобытие.Ссылка));
			КонецЕсли;
			
			НовоеСобытие.ОтправитьЭлектронноеПисьмо();
			Результат = Истина;
			
		Исключение
			
			ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Отправка email с новым кодом доступа в интерфейс нового рабочего места кассира'",
			КодОсновногоЯзыка),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьТаблицуВложений(Вложения, СсылкаНаСобытие)
	
	ВложенияТЗ = Новый ТаблицаЗначений;
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ВложенияТЗ.Колонки.Добавить("ЭтоВложениеЭлектронногоПисьма", Новый ОписаниеТипов("Булево"));
	ВложенияТЗ.Колонки.Добавить("Идентификатор", ТипСтрока);
	ВложенияТЗ.Колонки.Добавить("Представление", ТипСтрока);
	ВложенияТЗ.Колонки.Добавить("АдресВоВременномХранилище", ТипСтрока);
	ВложенияТЗ.Колонки.Добавить("ИндексКартинки", Новый ОписаниеТипов("Число"));
	ВложенияТЗ.Колонки.Добавить("Письмо", Новый ОписаниеТипов("ДокументСсылка.Событие"));
	ВложенияТЗ.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.СобытиеПрисоединенныеФайлы"));
	
	Для Каждого ОписаниеВложения Из Вложения Цикл
		СтрокаВложений = ВложенияТЗ.Добавить();
		СтрокаВложений.ЭтоВложениеЭлектронногоПисьма = Истина;
		СтрокаВложений.Представление = ОписаниеВложения.Представление;
		СтрокаВложений.АдресВоВременномХранилище = ОписаниеВложения.АдресВоВременномХранилище;
		
		ЧастиИмениФайла = СтрРазделить(ОписаниеВложения.Представление, ".");
		Если ЗначениеЗаполнено(ЧастиИмениФайла) Тогда
			РасширениеБезТочки = ЧастиИмениФайла[ЧастиИмениФайла.ВГраница()];
			СтрокаВложений.ИндексКартинки = РаботаСФайламиСлужебныйКлиентСервер.ИндексПиктограммыФайла(РасширениеБезТочки);
		КонецЕсли;
		СтрокаВложений.Письмо = СсылкаНаСобытие; 
	КонецЦикла;
	
	Возврат ВложенияТЗ;
	
КонецФункции

Процедура АвтоматическоеЗакрытиеСмен() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КассыККМ.Ссылка КАК КассаККМ
	|ИЗ
	|	Справочник.КассыККМ КАК КассыККМ
	|ГДЕ
	|	КассыККМ.ИспользоватьБезПодключенияОборудования
	|	И НЕ КассыККМ.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			
			Результат = Документы.ОтчетОРозничныхПродажах.СформироватьОтчетОРозничныхПродажахИВыполнитьАрхивацию(Выборка.КассаККМ);
			РозничныеПродажиСервер.ЗакрытьКассовуюСмену(Выборка.КассаККМ);
			
		Исключение
			ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Автоматическое закрытие смен'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПерезаписьУстановкиЦен() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УстановкаЦенНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|ГДЕ
	|	УстановкаЦенНоменклатуры.Проведен
	|	И УстановкаЦенНоменклатуры.Дата МЕЖДУ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекДата, ДЕНЬ, -5), ДЕНЬ) И НАЧАЛОПЕРИОДА(&ТекДата, ДЕНЬ)";
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДатаСеанса());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;

КонецПроцедуры

Процедура ОтправитьСообщениеОбОшибкеВСистемуВзаимодействия(ТекстОшибки, ДанныеСсылка = Неопределено) Экспорт
	
	ИдентификаторОбсуждения = СистемаВзаимодействия.ПолучитьОбсуждение("ЖурналОшибок");
	
	Если ИдентификаторОбсуждения = Неопределено Тогда
		
		ОбсуждениеОшибки = СистемаВзаимодействия.СоздатьОбсуждение();
		ОбсуждениеОшибки.Групповое = Истина;
		//Саппорт.Идентификатор = Новый ИдентификаторОбсужденияСистемыВзаимодействия("Support1C");
		ОбсуждениеОшибки.Ключ = "ЖурналОшибок";
		ОбсуждениеОшибки.Заголовок = "Журнал ошибок 1С"; 
		
		ОбсуждениеОшибки.Участники.Добавить(ПолучитьИдПользователяСВ("Поддержка"));
		ОбсуждениеОшибки.Участники.Добавить(ПолучитьИдПользователяСВ("НачальникИТ"));
		ОбсуждениеОшибки.Участники.Добавить(ПолучитьИдПользователяСВ("Программист1С"));
		ОбсуждениеОшибки.Участники.Добавить(ПолучитьИдПользователяСВ("Сервис"));
		ОбсуждениеОшибки.Записать();
		
		ИдентификаторОбсуждения = ОбсуждениеОшибки;
		
	КонецЕсли;
	
	ТекстСообщения = ТекстОшибки;
	
	НовоеСообщение = СистемаВзаимодействия.СоздатьСообщение(ИдентификаторОбсуждения.Идентификатор);
	НовоеСообщение.Дата = ТекущаяДатаСеанса();
	НовоеСообщение.Текст = Новый ФорматированнаяСтрока(ТекстСообщения);
	НовоеСообщение.Автор = ПолучитьИдПользователяСВ("Сервис"); 
	
	НовоеСообщение.Получатели.Добавить(ПолучитьИдПользователяСВ("Поддержка"));
	
	Если ЗначениеЗаполнено(ДанныеСсылка) Тогда
		НовоеСообщение.Данные = ДанныеСсылка;
	КонецЕсли;
	
	НовоеСообщение.Записать(); 
	
КонецПроцедуры

