	Если Роль = "Поддержка" Тогда
		ПолучательПользователь = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bab1000c29e80aa411f03ba2b9ce4e9d");   //Семушкин Илья Юрьевич
		IDПользователяСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПолучательПользователь.ИдентификаторПользователяИБ);
		
	ИначеЕсли Роль = "НачальникИТ" Тогда
		ПолучательПользователь = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bab1000c29e80aa411f03b051a8db700");   //Стрельников Юрий Юрьевич
		IDПользователяСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПолучательПользователь.ИдентификаторПользователяИБ);
		
	ИначеЕсли Роль = "Программист1С" Тогда
		ПолучательПользователь = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bab1000c29e80aa411f03ba2f4fb2b0b");  //Гезенцвей Сергей Владимирович
		IDПользователяСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПолучательПользователь.ИдентификаторПользователяИБ);
		
	ИначеЕсли Роль = "Сервис" Тогда
		ПолучательПользователь = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.Пользователи?ref=bbb385d39ee01ba511f07f51ea48fbed");  //сервис   
		IDПользователяСВ = СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПолучательПользователь.ИдентификаторПользователяИБ);
		
	КонецЕсли;
	
	Возврат IDПользователяСВ; 

