Процедура РассылкаСМСОборотыИнформация() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ВложенныйЗапрос.Подразделение.Код, ""999999"") КАК Порядок,
	|	ВложенныйЗапрос.Подразделение КАК Подразделение,
	|	ВложенныйЗапрос.Подр КАК Подр,
	|	ВложенныйЗапрос.Стоимость КАК Стоимость
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА ПродажиОбороты.Подразделение.Родитель = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|				ТОГДА ПродажиОбороты.Подразделение
	|			ИНАЧЕ ПродажиОбороты.Подразделение.Родитель
	|		КОНЕЦ КАК Подразделение,
	|		ПродажиОбороты.Подразделение КАК Подр,
	|		ПродажиОбороты.СуммаОборот - ПродажиОбороты.СуммаИнтОборот КАК Стоимость
	|	ИЗ
	|		РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, , ) КАК ПродажиОбороты
	|	ГДЕ
	|		ПродажиОбороты.СуммаОборот - ПродажиОбороты.СуммаИнтОборот > 0) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Подр
	|ИТОГИ
	|	СУММА(Стоимость)
	|ПО
	|	Подразделение,
	|	Подр";
		
	Если ТекущаяДата() > НачалоДня(ТекущаяДатаСеанса()) + (21 * 60 * 60) Тогда
		ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	Иначе
		ДатаОкончания = НачалоДня(ТекущаяДатаСеанса()) - 1;
	КонецЕсли;	
	Запрос.УстановитьПараметр("ДатаНачала",	НачалоДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	//Запрос.УстановитьПараметр("Контрагент",	Справочники.Контрагенты.НеВлезать); //папка Не влезать/Грузоотправитель
	
	РезЗапроса =  Запрос.Выполнить();
	Выборка = РезЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТЕКСТ_СООБЩЕНИЯ = "";
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Подразделение) Тогда Продолжить; КонецЕсли;
		
		Подразделение = "";
		Подр = "";
		
		Подразделение = СтрЗаменить(СокрЛП(Выборка.Подразделение),".","");
		Подразделение = СтрЗаменить(Подразделение,"-","");
		Подразделение = СтрЗаменить(Подразделение," ","");
		
		Если Не ПустаяСтрока(ТЕКСТ_СООБЩЕНИЯ) Тогда
			ТЕКСТ_СООБЩЕНИЯ = ТЕКСТ_СООБЩЕНИЯ + " ";
		КонецЕсли;
		
		ТЕКСТ_СООБЩЕНИЯ = ТЕКСТ_СООБЩЕНИЯ +
		Подразделение+": " + Формат(Выборка.Стоимость, "ЧЦ=15; ЧДЦ=; ЧРГ=.; ЧН=0") + Символ(8381);
		
		ВыборкаПодр =  Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПодр.Следующий() Цикл
			Подразделение = СтрЗаменить(СокрЛП(Выборка.Подразделение),".","");
			Подразделение = СтрЗаменить(Подразделение,"-","");
			Подразделение = СтрЗаменить(Подразделение," ","");
			Подр = СокрЛП(ВыборкаПодр.Подр);
			Подр = СтрЗаменить(Подр,".","");
			Подр = СтрЗаменить(Подр,"-","");
			Подр = СтрЗаменить(Подр," ","");
			Если Подр = Подразделение Тогда
				Продолжить;
			КонецЕсли;

			ТЕКСТ_СООБЩЕНИЯ = ТЕКСТ_СООБЩЕНИЯ+
			" "+Подр+": " + Формат(ВыборкаПодр.Стоимость, "ЧЦ=15; ЧДЦ=; ЧРГ=.; ЧН=0") + Символ(8381);
			КолВо = 0;
			
		КонецЦикла;
	КонецЦикла;
	
	КоличествоПосещений = ОбменДаннымиССайтом.ПолучитьМетрику(ДатаОкончания);
	Если КоличествоПосещений = 0 Тогда
		ТекстПосещаемостьWEBОсновная = "Посетителей web: Не удалось получить статистику.";
	Иначе 
		ТекстПосещаемостьWEBОсновная = "Посетители web:" + Формат(КоличествоПосещений, "ЧГ=0");
	КонецЕсли;	
	
	ТекстИнфинитиМ = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Статистика.ДатаВремяЗвонка) КАК Звонков,
	|	СРЕДНЕЕ(ЕСТЬNULL(Статистика.ДлительностьОжидания, 0)) КАК Ожидание,
	|	СРЕДНЕЕ(ЕСТЬNULL(Статистика.ДлительностьРазговора, 0)) КАК Время,
	|	СУММА(ЕСТЬNULL(Статистика.Пропущенных, 0)) КАК Пропущенных
	|ИЗ
	|	(ВЫБРАТЬ
	|		ИнфинитиСтатистикаЗвонков.ДатаВремяЗвонка КАК ДатаВремяЗвонка,
	|		ВЫБОР
	|			КОГДА ИнфинитиСтатистикаЗвонков.ДлительностьРазговора = 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК Пропущенных,
	|		ИнфинитиСтатистикаЗвонков.ДлительностьОжидания КАК ДлительностьОжидания,
	|		ИнфинитиСтатистикаЗвонков.ДлительностьРазговора КАК ДлительностьРазговора
	|	ИЗ
	|		РегистрСведений.ИнфинитиСтатистикаЗвонков КАК ИнфинитиСтатистикаЗвонков
	|	ГДЕ
	|		ИнфинитиСтатистикаЗвонков.ДатаЗвонка = &ДатаОкончания) КАК Статистика
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиРаботы КАК График
	|		ПО (НАЧАЛОПЕРИОДА(Статистика.ДатаВремяЗвонка, ДЕНЬ) = НАЧАЛОПЕРИОДА(График.ВремяНачала, ДЕНЬ))
	|			И (График.ГрафикРаботы = &ГрафикРаботыКЦ)
	|ГДЕ
	|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(Статистика.ДатаВремяЗвонка, ДЕНЬ), Статистика.ДатаВремяЗвонка, СЕКУНДА) МЕЖДУ РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(График.ВремяНачала, ДЕНЬ), График.ВремяНачала, СЕКУНДА) И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(График.ВремяОкончания, ДЕНЬ), График.ВремяОкончания, СЕКУНДА)";
	
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ГрафикРаботыКЦ", ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ГрафикиРаботы?ref=bbbe970f694b62b611f19b3def189473"));
	
	мм = 0;
	сс = 0;
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Звонков = 0 Тогда
			Процент = "";
		Иначе
			Процент = " (" + Окр(Выборка.Пропущенных / Выборка.Звонков * 100) + ")";
		КонецЕсли;
		Время(0, мм, сс, Выборка.Время);
		ТекстИнфинитиМ = "Звонков: " +"
		|"+"Всего: "+ Выборка.Звонков + ", проп. " + Выборка.Пропущенных + Процент + Символы.ПС +" Ср. время " + мм + ?(сс < 10, ":0", ":") + сс;
		Время(0, мм, сс, Выборка.Ожидание);
		ТекстИнфинитиМ = ТекстИнфинитиМ +" , ожид. " + мм + ?(сс < 10, ":0", ":") + сс;
	КонецЦикла;
	
	ТЕКСТ_СООБЩЕНИЯОсновная = Формат(ДатаОкончания, "ДФ='д ММММ гггг (дддд)'");
	ТЕКСТ_СООБЩЕНИЯОсновная = ТЕКСТ_СООБЩЕНИЯОсновная+"
	|"+ТЕКСТ_СООБЩЕНИЯ+"
	|"+ТекстПосещаемостьWEBОсновная+"
	|"+ТекстИнфинитиМ;
	
	//Степанов Сергей 
	//ОтправкаSMS.ОтправитьЧерезSMSTrafficGate("79037554884", ТЕКСТ_СООБЩЕНИЯОсновная, 0);
	//УправлениеЭлектроннойПочтой.ОтправитьПростоеПисьмо(УчетнаяЗаписьПочты, "sergey@velostrana.ru", "Сводный отчет",ТЕКСТ_СООБЩЕНИЯОсновная);
	////Жежеря Антон 	
	//ОтправкаSMS.ОтправитьЧерезSMSTrafficGate("79037217437", ТЕКСТ_СООБЩЕНИЯОсновная, 0);
	//УправлениеЭлектроннойПочтой.ОтправитьПростоеПисьмо(УчетнаяЗаписьПочты, "anton@velostrana.ru", "Сводный отчет",ТЕКСТ_СООБЩЕНИЯОсновная); 
	//// Мягкий Дмитрий 
	//ОтправкаSMS.ОтправитьЧерезSMSTrafficGate("79204652388", ТЕКСТ_СООБЩЕНИЯ_Воронеж, 0);
	//// Васильев Артем 
	//ОтправкаSMS.ОтправитьЧерезSMSTrafficGate("79037935262", ТЕКСТ_СООБЩЕНИЯОсновная, 0);
	ОтправитьСообщения(ТЕКСТ_СООБЩЕНИЯОсновная);
		
КонецПроцедуры

Функция Время(чч, мм, сс, Время = 0) Экспорт
	
	Если Время = NULL Тогда 
		Возврат Время;
	Иначе
		Если Время = 0 Тогда
			Возврат сс + мм * 60 + чч * 3600;
		КонецЕсли;
		чч = Цел(Время / 3600);
		мм = Цел((Время % 3600) / 60);
		сс = Окр((Время % 3600) % 60);
		Возврат Время;
	КонецЕсли;
	
КонецФункции

