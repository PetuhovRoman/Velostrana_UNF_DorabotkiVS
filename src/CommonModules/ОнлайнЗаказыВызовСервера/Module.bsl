Процедура ОтредактироватьТелоПисьма(Тело,ОбъектПечати,ДопПоля)

	Начало = Найти(Тело, "%ВЫПОЛНИТЬ(");
	
	Пока Начало > 0 Цикл 
		Окончание = Найти(Тело,")%");
		ПеремСтрокаЗамены = "";
		Попытка
			Выполнить("ПеремСтрокаЗамены = "+Сред(Тело,Начало+11,Окончание-Начало-11));
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		Тело = СтрЗаменить(Тело,Сред(Тело,Начало,Окончание-Начало+2),ПеремСтрокаЗамены);
		
		Начало = Найти(Тело, "%ВЫПОЛНИТЬ(");		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьБуквенныйПостфикс(Знач Значение)
	
	Стр = "abcdefghijklmnopqrstuvwxyz";
	Результат="";
	Пока Значение > 0 Цикл
		Если Значение % 26 = 0 Тогда
			Результат = Сред(Стр, 26, 1) + Результат;
			Значение = Цел(Значение / 26) - 1 ;
		Иначе	
			Результат = Сред(Стр, Значение % 26, 1) + Результат;
			Значение = Цел(Значение / 26) ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции 

