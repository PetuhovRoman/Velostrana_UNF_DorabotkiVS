
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Оповещение = новый ОписаниеОповещения("ОбработкаКомандыЗавершение", ЭтотОбъект, ПараметрКоманды);
	ПоказатьВопрос(Оповещение, "Закрыть смену по выделенным документам?", РежимДиалогаВопрос.ДаНет);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаКомандыЗавершение(Результат, ПараметрКоманды) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗакрытиеСменыНаСервере(ПараметрКоманды);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗакрытиеСменыНаСервере(СписокДокументов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтчетОРозничныхПродажах.Ссылка КАК ОтчетОРозничныхПродажах,
	|	ОтчетОРозничныхПродажах.КассоваяСмена КАК КассоваяСмена
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	|ГДЕ
	|	ОтчетОРозничныхПродажах.СтатусКассовойСмены = ЗНАЧЕНИЕ(Перечисление.СтатусыОтчетаОРозничныхПродажах.Открыта)
	|	И НЕ ОтчетОРозничныхПродажах.ПометкаУдаления
	|	И ОтчетОРозничныхПродажах.Ссылка В (&Ссылки)";
	
	Запрос.УстановитьПараметр("Ссылки", СписокДокументов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		
		Если ЗначениеЗаполнено(Выборка.КассоваяСмена) Тогда
			КассоваяСменаОбъект = Выборка.КассоваяСмена.ПолучитьОбъект();
			КассоваяСменаОбъект.Статус    = Перечисления.СтатусыКассовойСмены.Закрыта;
			КассоваяСменаОбъект.ОкончаниеКассовойСмены = КонецДня(КассоваяСменаОбъект.Дата);
			КассоваяСменаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
		ОтчетОРозничныхПродажахОбъект = Выборка.ОтчетОРозничныхПродажах.ПолучитьОбъект();	
		
		Документы.ОтчетОРозничныхПродажах.ЗаполнитьОтчетОРозничныхПродажахПоДаннымВЧеках(ОтчетОРозничныхПродажахОбъект);
		
		ОтчетОРозничныхПродажахОбъект.СтатусКассовойСмены    = Перечисления.СтатусыОтчетаОРозничныхПродажах.Закрыта;
		
		ДатаЗакрытияКассовойСмены = КонецДня(ОтчетОРозничныхПродажахОбъект.Дата);
		ОтчетОРозничныхПродажахОбъект.Дата                   = ДатаЗакрытияКассовойСмены;
		ОтчетОРозничныхПродажахОбъект.ОкончаниеКассовойСмены = ДатаЗакрытияКассовойСмены;
		
		Попытка
			ОтчетОРозничныхПродажахОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОтчетОРозничныхПродажахОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
		ЗафиксироватьТранзакцию();
		
		ОтчетОРозничныхПродажахОбъект = Выборка.ОтчетОРозничныхПродажах.ПолучитьОбъект();	
		Если ОтчетОРозничныхПродажахОбъект.Проведен 
			И ОтчетОРозничныхПродажахОбъект.СтатусКассовойСмены = Перечисления.СтатусыОтчетаОРозничныхПродажах.Закрыта Тогда

			ОписаниеОшибки = "";
			Документы.ОтчетОРозничныхПродажах.ВыполнитьАрхивациюЧековККМ(ОтчетОРозничныхПродажахОбъект, ОписаниеОшибки);
			
			Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ОписаниеОшибки;
				Сообщение.Сообщить();
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры
		
