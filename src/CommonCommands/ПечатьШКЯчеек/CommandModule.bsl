&НаСервере
Функция ВывестиТабличныйДокумент(ПараметрКоманды)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ПараметрКоманды);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладскиеЯчейки.Ссылка КАК Ссылка,
	|	СкладскиеЯчейки.Наименование КАК Наименование,
	|	СкладскиеЯчейки.Код КАК Код,
	|	СкладскиеЯчейки.Родитель.Код КАК Секция
	|ИЗ
	|	Справочник.Ячейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Ссылка В ИЕРАРХИИ(&Ссылка)
	|	И НЕ СкладскиеЯчейки.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Макет = Справочники.Ячейки.ПолучитьМакет("ВС_Макет");
	
	ОбластьШК = Макет.ПолучитьОбласть("Строка|Столбец");
	ОбластьШКАкс = Макет.ПолучитьОбласть("СтрокаАкс|Столбец");
	ОбластьСтрелкаВправо = Макет.ПолучитьОбласть("СтрелкаВправо|Столбец");
	ОбластьСтрелкаВлево = Макет.ПолучитьОбласть("СтрелкаВлево|Столбец");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ШК_Ячейки";
	//ШК = Новый COMОбъект("BARCODE.BarcodeCtrl.1");
	//ШК.Borderheight = 0;
	//ШК.ShowText = False;
	//ШК.TypeName = "Code128";
	//ШК.NotchHeightInPercent = 100;
	//ИмяФайла = ПолучитьИмяВременногоФайла("png");
	
	//РодительАксов = Справочники.СкладскиеЯчейки.НайтиПоНаименованию("Зона хранения аксессуаров",Истина);
	//РодительВелосипедов = Справочники.СкладскиеЯчейки.НайтиПоНаименованию("Зона хранения велосипедов",Истина);
		
	Пока Выборка.Следующий() Цикл
		Эталон = Обработки.ПечатьЭтикетокИЦенников.ПолучитьМакет("Эталон");
		КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
		
		ПараметрыШтрихкода = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
		
		Если СтрНайти(Выборка.Наименование,"А-") > 0 Тогда 
			КартинкаШтрихкода = ОбластьШКАкс.Рисунки.ШтрихКодАкс;
			ОбластьШКВывод = ОбластьШКАкс;
		Иначе
			КартинкаШтрихкода = ОбластьШК.Рисунки.ШтрихКод;
			ОбластьШКВывод = ОбластьШК;
		КонецЕсли;
		ПараметрыШтрихкода.Ширина = Окр(КартинкаШтрихкода.Ширина / КоличествоМиллиметровВПикселе);
		ПараметрыШтрихкода.Высота = Окр(КартинкаШтрихкода.Высота / КоличествоМиллиметровВПикселе);
		ПараметрыШтрихкода.Штрихкод = СокрЛП(Выборка.Код);
		ПараметрыШтрихкода.ТипКода = 4; // Code128
		ПараметрыШтрихкода.ОтображатьТекст = Истина;
		ПараметрыШтрихкода.РазмерШрифта = 8;   
		ПараметрыШтрихкода.Масштабировать = Истина;
		
		ИзображениеШтрихкода = ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
		КартинкаШтрихкода.Картинка = ИзображениеШтрихкода.Картинка;
		
		ОбластьШКВывод.Параметры.Ячейка = СтрЗаменить(Выборка.Наименование,"А-","");
		
		ТабличныйДокумент.Вывести(ОбластьШКВывод);
		
		Если СтрНайти(Выборка.Наименование,"А-") = 0 И ЗначениеЗаполнено(Выборка.Секция) Тогда 
			Попытка
				Если УправлениеКонтактнойИнформациейКлиентСервер.ОставитьТолькоЦифрыВСтроке(Выборка.Секция) % 2 = 0 Тогда 
					ТабличныйДокумент.Вывести(ОбластьСтрелкаВправо);
				Иначе
					ТабличныйДокумент.Вывести(ОбластьСтрелкаВлево);
				КонецЕсли;			
			Исключение
				ТабличныйДокумент.Вывести(ОбластьСтрелкаВправо);
			КонецПопытки;
		КонецЕсли;
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();		
	КонецЦикла;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ПолеСверху = 0;
	ТабличныйДокумент.ПолеСнизу = 0;
	ТабличныйДокумент.ПолеСлева = 0;
	ТабличныйДокумент.ПолеСправа = 0;
	ТабличныйДокумент.РазмерКолонтитулаСверху = 0;
	ТабличныйДокумент.РазмерКолонтитулаСнизу = 0;

	Возврат ТабличныйДокумент;
	
КонецФункции

