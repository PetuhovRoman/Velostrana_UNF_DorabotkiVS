
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрыВыполненияКоманды.Источник.Модифицированность Или Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		КнопкиДиалога = Новый СписокЗначений;
		КнопкиДиалога.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Записать'"));
		КнопкиДиалога.Добавить(КодВозвратаДиалога.Отмена);
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("ПараметрКоманды", ПараметрКоманды);
		ПараметрыОповещения.Вставить("ПараметрыВыполненияКоманды", ПараметрыВыполненияКоманды);
		ПоказатьВопрос(
		Новый ОписаниеОповещения("ОбработатьОтветПередПечатьюШК", ЭтотОбъект, ПараметрыОповещения),
		НСтр("ru = 'Перед печатью ШК следует записать документ.'"),
		КнопкиДиалога);
	Иначе
		НапечататьШК(ПараметрКоманды, ПараметрыВыполненияКоманды);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветПередПечатьюШК(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		Параметры.ПараметрыВыполненияКоманды.Источник.Записать();
		НапечататьШК(Параметры.ПараметрКоманды, Параметры.ПараметрыВыполненияКоманды);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьШК(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	СтрокаСообщения = "";
	
	ТабДок = ВывестиТабличныйДокумент(ПараметрКоманды);

	ИмяПринтера = НайтиПринтерPosiflex();
	Если ИмяПринтера = Неопределено Тогда 
		СтрокаСообщения = "Не найден принтер POSIFLEX.";
		ТабДок.Показать();
	Иначе
		ТабДок.ИмяПринтера = ИмяПринтера;
		ТабДок.ПолеСверху = 0;
		ТабДок.ПолеСлева = 0;
		ТабДок.ПолеСнизу = 0;
		ТабДок.ПолеСправа = 0;
		ТабДок.РазмерКолонтитулаСверху = 0;
		ТабДок.РазмерКолонтитулаСнизу = 0;
		ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		ТабДок.АвтоМасштаб = Истина;
		ТабДок.Напечатать();
	КонецЕсли;	
	
	Если Не ПустаяСтрока(СтрокаСообщения) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПредупрежедениеЗавершение", ЭтотОбъект);
		ПоказатьПредупреждение(ОписаниеОповещения, СтрокаСообщения,, "Напечатать ШК");
	КонецЕсли;
	
КонецПроцедуры

