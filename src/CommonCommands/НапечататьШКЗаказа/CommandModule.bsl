&НаСервере
Функция ВывестиТабличныйДокумент(ПараметрКоманды)
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = Документы.ЗаказПокупателя.ПолучитьМакет("ШтрихКодЗаказа");
	Макет.Параметры.НомерЗаказа = ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ПрефиксацияОбъектовКлиентСервер.УдалитьПрефиксыИзНомераОбъекта(ПараметрКоманды.Номер, Истина, Истина));
	Макет.Параметры.Дата = Формат(ПараметрКоманды.Дата, "ДФ=dd.MM.yyyy");
	Макет.Параметры.Сумма = Формат(ПараметрКоманды.СуммаДокумента, "ЧДЦ=2");
	//Макет.Рисунки.ШтрихКод.Объект.Text = СокрЛП(ПараметрКоманды.Номер);
	
	Эталон = Обработки.ПечатьЭтикетокИЦенников.ПолучитьМакет("Эталон");
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
	
	ПараметрыШтрихкода = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	ПараметрыШтрихкода.Ширина = Окр(Макет.Рисунки.КартинкаШтрихкода.Ширина / КоличествоМиллиметровВПикселе);
	ПараметрыШтрихкода.Высота = Окр(Макет.Рисунки.КартинкаШтрихкода.Высота / КоличествоМиллиметровВПикселе);
	ПараметрыШтрихкода.Штрихкод = СокрЛП(ШтрихкодированиеПечатныхФорм.ЧисловойКодПоСсылке(ПараметрКоманды.Ссылка));
	ПараметрыШтрихкода.ТипКода = 4; // Code128
	ПараметрыШтрихкода.ОтображатьТекст = Ложь;
	ПараметрыШтрихкода.РазмерШрифта = 6;   
	ПараметрыШтрихкода.Масштабировать = Истина;
	
	ИзображениеШтрихкода = ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
	
	Макет.Рисунки.КартинкаШтрихкода.Картинка = ИзображениеШтрихкода.Картинка;
	ТабДок.Вывести(Макет);
	
    Возврат ТабДок;
	
КонецФункции

&НаКлиенте
Функция НайтиПринтерPosiflex() Экспорт
	
	Сервис = GetCOMObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2");
    Попытка
        Принтеры = Сервис.ExecQuery("Select * from Win32_Printer");
    Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
    КонецПопытки;    
   	Для каждого Принтер Из Принтеры Цикл
		Если Найти(ВРег(Принтер.Name), "POSIFLEX") > 0 Тогда
			Возврат Принтер.Name;
        КонецЕсли;    
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

