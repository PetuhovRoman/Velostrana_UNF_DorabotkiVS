
&НаКлиенте
процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ПараметрКоманды", ПараметрКоманды);
	ПараметрыОповещения.Вставить("ПараметрыВыполненияКоманды", ПараметрыВыполненияКоманды);
	
	оповещение = новый ОписаниеОповещения("ОбработкаКомандыЗавершение", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(оповещение, "Перезаполнить КМ из заказа?", РежимДиалогаВопрос.ДаНет);
	
конецПроцедуры // ОбработкаКоманды

&НаКлиенте
процедура ОбработкаКомандыЗавершение(результат, ПараметрыОповещения) экспорт
	Перем неОбработано;

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ПерезаполнитьИзЗаказа(ПараметрыОповещения.ПараметрКоманды);
	
	ПараметрыОповещения.ПараметрыВыполненияКоманды.Источник.Прочитать();
	
конецПроцедуры // ОбработкаКоманды

&НаСервере
Процедура ПерезаполнитьИзЗаказа(Накладная)
	
	ДанныеЗаполнения = Накладная.Заказ;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") 
		И ДанныеЗаполнения.ШтрихкодыУпаковок.Количество() > 0
		И ДанныеЗаполнения.Запасы.Итог("Количество") = Накладная.Запасы.Итог("Количество") Тогда
		//Если ТипЗнч(
		Док = Накладная.ПолучитьОбъект();
		Док.ШтрихкодыУпаковок.Загрузить(ДанныеЗаполнения.ШтрихкодыУпаковок.Выгрузить());
		Док.Записать();
	КонецЕсли;
	
	
КонецПроцедуры
