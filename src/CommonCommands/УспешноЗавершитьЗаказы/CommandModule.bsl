///==============================================================================
&НаКлиенте
процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	оповещение = новый ОписаниеОповещения("ОбработкаКомандыЗавершение", ЭтотОбъект, ПараметрКоманды);
	ПоказатьВопрос(оповещение, "Выделенные заказы действительно успешно завершены?", РежимДиалогаВопрос.ДаНет);
конецПроцедуры // ОбработкаКоманды

///==============================================================================
&НаКлиенте
процедура ОбработкаКомандыЗавершение(результат, ПараметрКоманды) экспорт
перем неОбработано;

	если результат <> КодВозвратаДиалога.Да тогда
		возврат;
	конецЕсли;

	обработано = УспешноЗакрытьЗаказы(ПараметрКоманды, неОбработано);
	если неОбработано > 0 тогда
		Сообщить("Закрыто " + обработано + " док., не обработано " + неОбработано + " док.", СтатусСообщения.Важное);
	конецЕсли;
	если обработано > 0 тогда
		Оповестить("Запись_АктВыполненныхРабот");
		Оповестить("ОповещениеОбОплатеЗаказа");
	конецЕсли;
конецПроцедуры // ОбработкаКоманды

///==============================================================================
&НаСервере
функция УспешноЗакрытьЗаказы(заказы, неОбработано)

#Region Запрос
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	ЗаказПокупателя.Ссылка КАК Ссылка,
		|	ЗНАЧЕНИЕ(Справочник.СостоянияЗаказНарядов.Завершен) КАК новоеСостояниеЗаказа
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаряд)
		|	И ЗаказПокупателя.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказНарядов.Завершен)
		|	И ЗаказПокупателя.Ссылка В(&Ссылки)
		|	И ЗаказПокупателя.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказПокупателя.Ссылка,
		|	ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу)
		|	И ЗаказПокупателя.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|	И ЗаказПокупателя.Ссылка В(&Ссылки)
		|	И ЗаказПокупателя.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказПоставщику.Ссылка,
		|	ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПоставщикам.Завершен)
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщику.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПоставщикам.Завершен)
		|	И ЗаказПоставщику.Ссылка В(&Ссылки)
		|	И ЗаказПоставщику.Проведен
		|");
#EndRegion
	Запрос.УстановитьПараметр("Ссылки", заказы);
	Результат    = Запрос.Выполнить();
	выборка      = Результат.Выбрать();
	обработано   = 0;
	неОбработано = 0;
	Пока выборка.Следующий() Цикл
		об = выборка.Ссылка.ПолучитьОбъект();
		об.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
		об.СостояниеЗаказа   = выборка.новоеСостояниеЗаказа;
		попытка
			об.Записать(РежимЗаписиДокумента.Проведение);
		исключение
			Сообщить(ОписаниеОшибки());
			неОбработано = неОбработано + 1;
			продолжить;
		конецПопытки;

		обработано = обработано + 1;
	КонецЦикла;
	возврат обработано;
конецФункции // УспешноЗакрытьЗаказы
