
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрыВыполненияКоманды.Источник.Модифицированность Или Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		КнопкиДиалога = Новый СписокЗначений;
		КнопкиДиалога.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Записать'"));
		КнопкиДиалога.Добавить(КодВозвратаДиалога.Отмена);
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("ПараметрКоманды", ПараметрКоманды);
		ПараметрыОповещения.Вставить("ПараметрыВыполненияКоманды", ПараметрыВыполненияКоманды);
		ПоказатьВопрос(
		Новый ОписаниеОповещения("ОбработатьОтветПередЗагрузкойСтикеров", ЭтотОбъект, ПараметрыОповещения),
		НСтр("ru = 'Перед загрузкой стикеров следует записать документ.'"),
		КнопкиДиалога);
	Иначе
		ЗагрузитьСтикеры(ПараметрКоманды, ПараметрыВыполненияКоманды);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветПередЗагрузкойСтикеров(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		Параметры.ПараметрыВыполненияКоманды.Источник.Записать();
		ЗагрузитьСтикеры(Параметры.ПараметрКоманды, Параметры.ПараметрыВыполненияКоманды);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСтикеры(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ЕстьОшибки = Ложь;
	Для Каждого ЗаказСсылка Из ПараметрКоманды Цикл
		Результат = ЗагрузитьСтикерыНаСервере(ЗаказСсылка);
		
		Если Не ПустаяСтрока(Результат) Тогда
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = Результат;
			СообщениеПользователю.УстановитьДанные(ЗаказСсылка);
			СообщениеПользователю.Сообщить();
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ПараметрКоманды.Количество() = 1 И Не ЕстьОшибки Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВладелецФайла",  ПараметрКоманды[0]);
		ПараметрыФормы.Вставить("ТолькоПросмотр", ПараметрыВыполненияКоманды.Источник.ТолькоПросмотр);
		
		ОткрытьФорму("Обработка.РаботаСФайлами.Форма.ПрисоединенныеФайлы",
			ПараметрыФормы,
			ПараметрыВыполненияКоманды.Источник,
			ПараметрыВыполненияКоманды.Уникальность,
			ПараметрыВыполненияКоманды.Окно);
			
	КонецЕсли;
КонецПроцедуры

