
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	СформироватьЗаданияНаРаботыВел(ПараметрКоманды);
КонецПроцедуры

&НаСервере
Функция СформироватьЗаданияНаРаботыВел(МассивЗаказов)
	
	Для Каждого ЗаказСсылка Из МассивЗаказов Цикл
		СофрмироватьЗаданиеПоЗаказу(ЗаказСсылка);
	КонецЦикла;

КонецФункции

&НаСервере
Процедура СофрмироватьЗаданиеПоЗаказу(ЗаказПокупателя)
	
	ВидРабот = Документы.ЗаданиеНаРаботу.ПолучитьВидРабот("Сборка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателяЗапасы.Номенклатура КАК Номенклатура,
	|	ЗаказПокупателяЗапасы.Характеристика КАК Характеристика,
	|	ЗаказПокупателяЗапасы.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			,
	|			ЗаказПокупателя = &Заказ
	|				И Номенклатура.ВидПродукцииИС = ЗНАЧЕНИЕ(Перечисление.ВидыПродукцииИС.Велосипеды)) КАК ЗаказПокупателяЗапасы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаданияНаРаботу.Обороты(
	|				,
	|				,
	|				,
	|				ЗаказПокупателя = &Заказ
	|					И ВидРабот = &ВидРабот) КАК ЗаданияНаРаботуОбороты
	|		ПО ЗаказПокупателяЗапасы.ЗаказПокупателя = ЗаданияНаРаботуОбороты.ЗаказПокупателя
	|			И ЗаказПокупателяЗапасы.Номенклатура = ЗаданияНаРаботуОбороты.Номенклатура
	|			И ЗаказПокупателяЗапасы.Характеристика = ЗаданияНаРаботуОбороты.Характеристика
	|ГДЕ
	|	ЗаказПокупателяЗапасы.КоличествоОстаток - ЕСТЬNULL(ЗаданияНаРаботуОбороты.ЗагрузкаПланОборот, 0) > 0";
	
	Запрос.УстановитьПараметр("Заказ", ЗаказПокупателя);
	Запрос.УстановитьПараметр("ВидРабот", ВидРабот);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	//ДанныеЗаполнения.ВидРабот = ВидРабот;
	МассивДокументовКПроведению = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Док = Документы.ЗаданиеНаРаботу.СоздатьДокумент();
		Док.Заполнить(Неопределено);
		
		Док.ЗаказПокупателя = ЗаказПокупателя;
		Док.ВидОперации = Перечисления.ВидыОперацийЗаданиеНаРаботу.Внутреннее;
		//Если Не ТипЗнч(ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		//	Возврат;
		//КонецЕсли;
		
		Док.ВидРабот = ВидРабот;
		
		СтрокаТЧ = Док.Работы.Добавить();
		СтрокаТЧ.ВидРабот = Док.ВидРабот;
		СтрокаТЧ.Заказчик = Док.ЗаказПокупателя;
		СтрокаТЧ.Номенклатура = Выборка.Номенклатура;
		СтрокаТЧ.Характеристика = Выборка.Характеристика;
		СтрокаТЧ.Трудоемкость = 1;
		СтрокаТЧ.ДатаНачала = ТекущаяДатаСеанса();
		СтрокаТЧ.ДатаОкончания = ТекущаяДатаСеанса() + 60*60;
		
		Док.Сотрудник = Документы.ЗаданиеНаРаботу.ПолучитьСлужебногоИсполнителя();
		Док.Записать();

		МассивДокументовКПроведению.Добавить(Док);
		
	КонецЕсли;
	
	Если МассивДокументовКПроведению.Количество() > 0 Тогда
		Для Каждого ДокументКПроведению Из МассивДокументовКПроведению Цикл
			//ДокОбъект = ДокументКПроведению.ПолучитьОбъект();
			Попытка
				ДокументКПроведению.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаписьЖурналаРегистрации("Формирование заданий на работу", УровеньЖурналаРегистрации.Ошибка, , ДокументКПроведению.Ссылка,  СокрЛП(ДокументКПроведению) + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;		
	
КонецПроцедуры

