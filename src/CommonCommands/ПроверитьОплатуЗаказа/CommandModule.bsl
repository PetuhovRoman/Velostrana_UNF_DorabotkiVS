КонецПроцедуры

&НаСервере
Функция ПроверитьОплатуНаСервере(ЗаказСсылка)
	
	//ЗаказСсылка = МассивЗаказов;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФактОплатыЗаказов.СчетНаОплату КАК ЗаказПокупателя,
	|	ФактОплатыЗаказов.СуммаОплаты + ФактОплатыЗаказов.СуммаАванса КАК СуммаОплаты,
	|	ФактОплатыЗаказов.Сумма КАК СуммаДокумента,
	|	ЕСТЬNULL(ЗаказыПокупателейССайта.НомерЗаказаНаСайте, ФактОплатыЗаказов.СчетНаОплату.Номер) КАК НомерЗаказа
	|ИЗ
	|	РегистрСведений.ФактОплатыЗаказов КАК ФактОплатыЗаказов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыПокупателейССайта
	|		ПО ФактОплатыЗаказов.СчетНаОплату = ЗаказыПокупателейССайта.ЗаказПокупателя
	|ГДЕ
	|	ФактОплатыЗаказов.СчетНаОплату = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЗаказПокупателя", Выборка.ЗаказПокупателя);
		СтруктураПараметров.Вставить("НомерЗаказа", ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ПрефиксацияОбъектовКлиентСервер.УдалитьПрефиксыИзНомераОбъекта(Выборка.НомерЗаказа, Истина, Истина)));
		
		ТаблицаОплат = ОбменДаннымиССайтом.ЗаказОплаченНаСайтеAPI(СтруктураПараметров, Истина);
		
		Если ТаблицаОплат.Количество() > 0 Тогда
			
			ОплатаПоБанку = 0;
			СуммаПоДокументу = 0;
			ОплатаПоБанку = ТаблицаОплат.Итог("СуммаОплаты");// + ТаблицаОплат.Итог["СуммаБонус"];
			
			ОрганизациияОплаты = ТаблицаОплат[0].Организация;
			ДатаОплатыБанк = ТаблицаОплат[0].ДатаОплаты;		
			
			Инфо = Новый Массив;
			Инфо.Добавить(Новый ФорматированнаяСтрока("ВНИМАНИЕ!" + Символы.ПС, Новый Шрифт(,,Истина), WebЦвета.Кирпичный));
			Инфо.Добавить("По данным банка статус оплаты заказа ");
			Если Выборка.СуммаДокумента <= ОплатаПоБанку Тогда 
				Инфо.Добавить(Новый ФорматированнаяСтрока("ОПЛАЧЕН" + Символы.ПС, Новый Шрифт(,,Истина), WebЦвета.Белоснежный, WebЦвета.Зеленый));
			Иначе
				Инфо.Добавить(Новый ФорматированнаяСтрока("НЕ ОПЛАЧЕН" + Символы.ПС, Новый Шрифт(,,Истина), WebЦвета.Белоснежный, WebЦвета.Лосось));
			КонецЕсли;
			//==
			Инфо.Добавить("Организация: " );
			Инфо.Добавить(Новый ФорматированнаяСтрока("" + ОрганизациияОплаты + Символы.ПС, Новый Шрифт(,,Истина))); 
			Инфо.Добавить("Дата оплаты: " );
			Инфо.Добавить(Новый ФорматированнаяСтрока("" + Формат(ДатаОплатыБанк,"ДФ=dd.MM.yy") + Символы.ПС, Новый Шрифт(,,Истина)));
			Инфо.Добавить("Сумма оплаты: " );
			Инфо.Добавить(Новый ФорматированнаяСтрока("" + ОплатаПоБанку + Символы.ПС, Новый Шрифт(,,Истина)));
			//Инфо.Добавить("Сумма бонусов: " );
			//Инфо.Добавить(Новый ФорматированнаяСтрока("" + Рез.СуммаБонус, Новый Шрифт(,,Истина)));
			Инфо.Добавить(" Всего: " );
			Инфо.Добавить(Новый ФорматированнаяСтрока("" + ОплатаПоБанку, Новый Шрифт(,,Истина)));
			
			Возврат Новый ФорматированнаяСтрока(Инфо);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый ФорматированнаяСтрока("ЗАКАЗ НЕ ОПЛАЧЕН", Новый Шрифт(,,Истина), WebЦвета.Белоснежный, WebЦвета.Лосось);
	
КонецФункции
