
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ПараметрыВыполненияКоманды.Источник.Модифицированность Или Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		КнопкиДиалога = Новый СписокЗначений;
		КнопкиДиалога.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Записать'"));
		КнопкиДиалога.Добавить(КодВозвратаДиалога.Отмена);
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("ПараметрКоманды", ПараметрКоманды);
		ПараметрыОповещения.Вставить("ПараметрыВыполненияКоманды", ПараметрыВыполненияКоманды);
		ПоказатьВопрос(
		Новый ОписаниеОповещения("ОбработатьОтветПередПроверкойОплаты", ЭтотОбъект, ПараметрыОповещения),
		НСтр("ru = 'Перед проверкой оплаты следует записать документ.'"),
		КнопкиДиалога);
	Иначе
		ПроверитьОплату(ПараметрКоманды, ПараметрыВыполненияКоманды);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветПередПроверкойОплаты(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		Параметры.ПараметрыВыполненияКоманды.Источник.Записать();
		ПроверитьОплату(Параметры.ПараметрКоманды, Параметры.ПараметрыВыполненияКоманды);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОплату(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	СтрокаСообщения = ПроверитьОплатуНаСервере(ПараметрКоманды);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПредупрежедениеЗавершение", ЭтотОбъект);
	ПоказатьПредупреждение(ОписаниеОповещения, СтрокаСообщения,, "Проверка оплаты");
	
КонецПроцедуры

