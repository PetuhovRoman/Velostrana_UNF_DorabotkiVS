Функция ПолучитьДанныеПоДокументу(СсылкаНаДокумент) Экспорт
	
	СтруктураВозврата = Новый Структура("Исполнитель, Завершен", Справочники.Сотрудники.ПустаяСсылка(), Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыВРаботеТСД.Исполнитель КАК Исполнитель,
	|	ДокументыВРаботеТСД.Завершен КАК Завершен
	|ИЗ
	|	РегистрСведений.ДокументыВРаботеТСД КАК ДокументыВРаботеТСД
	|ГДЕ
	|	ДокументыВРаботеТСД.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", СсылкаНаДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции
