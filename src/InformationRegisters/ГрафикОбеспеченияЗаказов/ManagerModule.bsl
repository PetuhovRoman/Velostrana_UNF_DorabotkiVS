///==============================================================================
Процедура ОбновитьПроцентОбеспеченияЗаказов(знач Заказы) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказыПокупателейОстатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОстатки.Характеристика КАК Характеристика,
	|	ЗаказыПокупателейОстатки.Склад КАК Склад,
	|	ЗаказыПокупателейОстатки.КоличествоОстаток КАК КоличествоЗаказано
	|ПОМЕСТИТЬ втЗаказано
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(, ЗаказПокупателя В (&заказы)) КАК ЗаказыПокупателейОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвободныеОстатки.СтруктурнаяЕдиница КАК Склад,
	|	СвободныеОстатки.Номенклатура КАК Номенклатура,
	|	СвободныеОстатки.Характеристика КАК Характеристика,
	|	СвободныеОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ втСвободно
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(, ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК СвободныеОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвободныеОстатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|	СвободныеОстатки.СтруктурнаяЕдиница КАК Склад,
	|	СвободныеОстатки.Номенклатура КАК Номенклатура,
	|	СвободныеОстатки.Характеристика КАК Характеристика,
	|	СвободныеОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ПОМЕСТИТЬ втВРезервеПоЗаказу
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(, ЗаказПокупателя В (&заказы)) КАК СвободныеОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втЗаказано.ЗаказПокупателя КАК Заказ,
	|	ВЫБОР
	|		КОГДА СУММА(втЗаказано.КоличествоЗаказано) = 0
	|			ТОГДА 100
	|		ИНАЧЕ СУММА(ВЫБОР
	|					КОГДА втЗаказано.КоличествоЗаказано > ЕСТЬNULL(втСвободно.КоличествоОстаток, 0) + ЕСТЬNULL(втВРезерве.КоличествоОстаток, 0)
	|						ТОГДА ЕСТЬNULL(втСвободно.КоличествоОстаток, 0) + ЕСТЬNULL(втВРезерве.КоличествоОстаток, 0)
	|					ИНАЧЕ втЗаказано.КоличествоЗаказано
	|				КОНЕЦ) / СУММА(втЗаказано.КоличествоЗаказано) * 100
	|	КОНЕЦ КАК Процент
	|ИЗ
	|	втЗаказано КАК втЗаказано
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСвободно КАК втСвободно
	|		ПО втЗаказано.Номенклатура = втСвободно.Номенклатура
	|			И втЗаказано.Характеристика = втСвободно.Характеристика
	|			И втЗаказано.Склад = втСвободно.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВРезервеПоЗаказу КАК втВРезерве
	|		ПО втЗаказано.Номенклатура = втВРезерве.Номенклатура
	|			И втЗаказано.Характеристика = втВРезерве.Характеристика
	|			И втЗаказано.Склад = втВРезерве.Склад
	|			И втЗаказано.ЗаказПокупателя = втВРезерве.ЗаказПокупателя
	|
	|СГРУППИРОВАТЬ ПО
	|	втЗаказано.ЗаказПокупателя";
	Запрос.УстановитьПараметр("заказы", Заказы);
	
	Результат    = Запрос.Выполнить();
	Выборка      = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НаборЗаписей   = РегистрыСведений.ГрафикОбеспеченияЗаказов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.заказ.Установить(Выборка.заказ);
		Запись         = НаборЗаписей.Добавить();
		Запись.Заказ   = Выборка.Заказ;
		Запись.Процент = Выборка.Процент;
		НаборЗаписей.Записать(Истина);

		позиция        = заказы.Найти(Выборка.заказ);
		если позиция <> неопределено тогда
			заказы.Удалить(позиция);
		конецЕсли;
	КонецЦикла;
	
	если заказы.Количество() > 0 Тогда
		Для Каждого заказ Из заказы Цикл
			НаборЗаписей = РегистрыСведений.ГрафикОбеспеченияЗаказов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Заказ.Установить(заказ);
			НаборЗаписей.Записать(Истина);
		КонецЦикла;
	конецЕсли;
	
конецПроцедуры // ОбновитьПроцентОбеспеченияЗаказов

///==============================================================================
Процедура ОбновитьПроцентОбеспеченияВсехЗаказов() экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказыПокупателейОстатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОстатки.Характеристика КАК Характеристика,
	|	ЗаказыПокупателейОстатки.Склад КАК Склад,
	|	ЗаказыПокупателейОстатки.КоличествоОстаток КАК КоличествоЗаказано
	|ПОМЕСТИТЬ втЗаказано
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(, ) КАК ЗаказыПокупателейОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втЗаказано.ЗаказПокупателя КАК заказ,
	|	ВЫБОР
	|		КОГДА СУММА(втЗаказано.КоличествоЗаказано) = 0
	|			ТОГДА 100
	|		ИНАЧЕ СУММА(ВЫБОР
	|					КОГДА втЗаказано.КоличествоЗаказано > ЕСТЬNULL(СвободныеОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(РезервыОстатки.КоличествоОстаток, 0)
	|						ТОГДА ЕСТЬNULL(СвободныеОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(РезервыОстатки.КоличествоОстаток, 0)
	|					ИНАЧЕ втЗаказано.КоличествоЗаказано
	|				КОНЕЦ) / СУММА(втЗаказано.КоличествоЗаказано) * 100
	|	КОНЕЦ КАК процент
	|ПОМЕСТИТЬ втПроценты
	|ИЗ
	|	втЗаказано КАК втЗаказано
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Запасы.Остатки(, ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК СвободныеОстатки
	|		ПО втЗаказано.Номенклатура = СвободныеОстатки.Номенклатура
	|			И втЗаказано.Характеристика = СвободныеОстатки.Характеристика
	|			И втЗаказано.Склад = СвободныеОстатки.СтруктурнаяЕдиница
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Запасы.Остатки(, ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК РезервыОстатки
	|		ПО втЗаказано.Номенклатура = РезервыОстатки.Номенклатура
	|			И втЗаказано.Характеристика = РезервыОстатки.Характеристика
	|			И втЗаказано.Склад = РезервыОстатки.СтруктурнаяЕдиница
	|			И втЗаказано.ЗаказПокупателя = РезервыОстатки.ЗаказПокупателя
	|
	|СГРУППИРОВАТЬ ПО
	|	втЗаказано.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ГрафикОбеспеченияЗаказов.Заказ, втПроценты.заказ) КАК заказ,
	|	втПроценты.процент КАК процент,
	|	ГрафикОбеспеченияЗаказов.Процент КАК текПроцент
	|ИЗ
	|	РегистрСведений.ГрафикОбеспеченияЗаказов КАК ГрафикОбеспеченияЗаказов
	|		ПОЛНОЕ СОЕДИНЕНИЕ втПроценты КАК втПроценты
	|		ПО (втПроценты.заказ = ГрафикОбеспеченияЗаказов.Заказ)
	|ГДЕ
	|	(ГрафикОбеспеченияЗаказов.Процент ЕСТЬ NULL
	|			ИЛИ втПроценты.процент ЕСТЬ NULL
	|			ИЛИ втПроценты.процент <> ГрафикОбеспеченияЗаказов.Процент)";

	Результат = Запрос.Выполнить();
	Выборка   = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ГрафикОбеспеченияЗаказов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.заказ.Установить(Выборка.заказ);
		если Выборка.процент <> null тогда
			Запись         = НаборЗаписей.Добавить();
			Запись.Заказ   = Выборка.заказ;
			Запись.Процент = Выборка.процент;
		конецЕсли;

		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
КонецПроцедуры // ОбновитьПроцентОбеспеченияВсехЗаказов
