Функция ПолучитьСтатусНаличияКодаМаркировки(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ТекДокументЗапасы.Количество) КАК Количество,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТекДокументШтрихкодыУпаковок.ШтрихкодУпаковки) КАК КоличествоШтрихкодовУпаковки
	|ИЗ
	|	Документ.ЗаказПокупателя.Запасы КАК ТекДокументЗапасы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО ТекДокументЗапасы.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.ШтрихкодыУпаковок КАК ТекДокументШтрихкодыУпаковок
	|		ПО ТекДокументЗапасы.Ссылка = ТекДокументШтрихкодыУпаковок.Ссылка
	|ГДЕ
	|	ТекДокументЗапасы.Ссылка = &СсылкаНаДокумент
	|
	|ИМЕЮЩИЕ
	|	СУММА(ЕСТЬNULL(ТекДокументЗапасы.Количество, 0)) > 0";
	Запрос.УстановитьПараметр("СсылкаНаДокумент", ДокументСсылка);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗаказПокупателя", ДокументСсылка.Метаданные().Имя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Количество = Выборка.КоличествоШтрихкодовУпаковки Тогда
			Возврат 1;
		Иначе
			Возврат 2;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Процедура УстановитьСтатусНаличияКодовМаркировки(Знач СсылкаНаДокумент) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = СсылкаНаДокумент;
	МенеджерЗаписи.Прочитать();
	
	МенеджерЗаписи.Документ = СсылкаНаДокумент;
	МенеджерЗаписи.СтатусНаличияКМ = ПолучитьСтатусНаличияКодаМаркировки(СсылкаНаДокумент);
	МенеджерЗаписи.Записать();
	
КонецПроцедуры
