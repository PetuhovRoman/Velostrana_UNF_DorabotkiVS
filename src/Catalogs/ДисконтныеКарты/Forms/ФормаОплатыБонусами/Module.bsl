
&НаКлиенте
Процедура ВС_ОтправитьСМСВместо(Команда)
	РезультатОтправкиSMS = СформироватьСообщениеИОтправитьSMSСервер();
КонецПроцедуры

&НаСервере
Функция СформироватьСообщениеИОтправитьSMSСервер()
	
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БонуснаяКарта, "ВладелецКарты");

	НомерТелефона = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента, , ТекущаяДатаСеанса());
	
	Документ = Неопределено;
	Параметры.Свойство("Документ", Документ);
	Если Не Документ = Неопределено Тогда
		Если ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") 
			И ЗначениеЗаполнено(Документ.КонтактныйТелефон) Тогда
			НомерТелефона = Документ.КонтактныйТелефон;
		КонецЕсли;
	КонецЕсли;
	
	НомерТелефонаПодтвержден = Ложь;
	
	КодПодтверждения = СлучайноеЧетырехзначноеЧисло();
		
	ОтправленныйПинКод = КодПодтверждения;
	//ПараметрыВводаКодаSMS.ПопытокВвода = 0;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("КодПодтверждения", КодПодтверждения);
	
		
		ШаблонСообщения = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.ШаблоныСообщений?ref=bbb385d39ee01ba511f0997c4dd1a466");
		НомерТелефонаПолучателя = НомерТелефона;
		
	//ИначеЕсли ПараметрыВводаКодаSMS.ВариантПроверки = "ПриВыборе" Тогда
	//	
	//	ШаблонСообщения = ШаблонSMSПриПродаже;
	//	НомерТелефонаПолучателя = НайденнаяКартаТелефон;
		
	//КонецЕсли;
	
	ТекстСообщения = "";
	ОбщегоНазначенияРМКПереопределяемый.СформироватьТекстСообщения(ШаблонСообщения,
		ДополнительныеПараметры,
		ТекстСообщения);
	
	РезультатОтправки = ОтправитьSMS(ТекстСообщения, НомерТелефонаПолучателя);
	//Если РезультатОтправки.Результат Тогда
	//	Элементы.КодПроверкиИзSMSНайденнойКарты.КартинкаКнопкиВыбора = БиблиотекаКартинок.Обновить;
	//КонецЕсли;	
	Возврат РезультатОтправки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОтправитьSMS(ТекстСообщения, НомерТелефона)
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатОтправки = Новый Структура;
	РезультатОтправки.Вставить("Результат", Ложь);
	РезультатОтправки.Вставить("ОписаниеОшибки", "");
	РезультатОтправки.Вставить("НомерТелефона", НомерТелефона);
	
	Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
		РезультатОтправки.ОписаниеОшибки =
			НСтр("ru = 'Не сформирован текст сообщения для отправки.'");
		Возврат РезультатОтправки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерТелефона) Тогда
		
		МассивНомеров = Новый Массив;
		МассивНомеров.Добавить(НомерТелефона);
		ОбщегоНазначенияРМКПереопределяемый.ОтправитьSMS(МассивНомеров, ТекстСообщения, РезультатОтправки);
		
	Иначе
		РезультатОтправки.ОписаниеОшибки =
			НСтр("ru = 'Для владельца карты не задан номер телефона. Выслать код подтверждения не удалось'");
	КонецЕсли;
	
	Возврат РезультатОтправки;
	
КонецФункции

&НаСервереБезКонтекста
Функция СлучайноеЧетырехзначноеЧисло()
	
	Генератор = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	СлучайноеЧисло = Генератор.СлучайноеЧисло(0, 9999);
	
	Если СлучайноеЧисло < 1000 Тогда
		СлучайноеЧислоСтрокой = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Строка(СлучайноеЧисло), 4, "0");
	Иначе
		СлучайноеЧислоСтрокой = Формат(СлучайноеЧисло, "ЧГ=0");
	КонецЕсли;
	
	Возврат СлучайноеЧислоСтрокой;
	
КонецФункции

&НаКлиенте
&ИзменениеИКонтроль("ОК")
Процедура ВС_ОК(Команда)

	Если СуммаБонусов > Остаток Тогда
		ТекстСообщения = НСтр("ru = 'Превышен остаток баллов по карте.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "СуммаОплаты", "СуммаОплаты");
		Возврат;
	КонецЕсли;

	Если СуммаБонусов > КОплате / КурсБонусов Тогда
		ТекстСообщения = НСтр("ru = 'Сумма оплаты не может превышать сумму документа.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "СуммаОплаты", "СуммаОплаты");
		Возврат;
	КонецЕсли;

	Если СуммаБонусов > ОграничениеОплатыБаллами Тогда
		ТекстСообщения = НСтр("ru = 'Сумма оплаты не может превышать ограничение, установленное для бонусной программы.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "СуммаОплаты", "СуммаОплаты");
		Возврат;
	КонецЕсли;
	#Вставка
	Если Не ПользователиКлиент.ЭтоПолноправныйПользователь() И ПустаяСтрока(ПинКод) Или ПинКод <> ОтправленныйПинКод Тогда
		ТекстСообщения = НСтр("ru = 'Неверный пин-код!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ПинКод", "ПинКод");
		Возврат;
	КонецЕсли;
	#КонецВставки
	Если СуммаБонусов = 0 Тогда
		ПараметрыЗакрытия = Неопределено;
	ИначеЕсли ЭтоЧекККМ Тогда
		ПараметрыЗакрытия = Новый Структура("МассивВыбранныхКарт, ЕстьОплатаБонусами");
		МассивВыбранныхКарт = Новый Массив;
		Для Каждого СтрокаТаблицы Из ТаблицаВыбранныхДисконтныхКарт Цикл
			СтруктураСтроки = Новый Структура("БонуснаяКарта, СуммаБонусов, СуммаОплаты, ВидОплаты, Курс, Кратность");
			СтруктураСтроки.БонуснаяКарта = СтрокаТаблицы.ДисконтнаяКарта;
			СтруктураСтроки.СуммаБонусов = СтрокаТаблицы.СуммаСписания;
			СтруктураСтроки.ВидОплаты = ПредопределенноеЗначение("Перечисление.ВидыБезналичныхОплат.Бонусы");
			СтруктураСтроки.Курс = СтрокаТаблицы.КурсБонусов;
			СтруктураСтроки.Кратность = 1;
			СтруктураСтроки.СуммаОплаты = Окр(СтрокаТаблицы.СуммаСписания * СтрокаТаблицы.КурсБонусов, 2);
			МассивВыбранныхКарт.Добавить(СтруктураСтроки);
		КонецЦикла;
		ПараметрыЗакрытия.МассивВыбранныхКарт = МассивВыбранныхКарт;
		ПараметрыЗакрытия.ЕстьОплатаБонусами = Истина;
	Иначе

		ПараметрыЗакрытия = Новый Структура;
		ПараметрыЗакрытия.Вставить("БонуснаяКарта", БонуснаяКарта);
		ПараметрыЗакрытия.Вставить("СуммаБонусов", СуммаБонусов);
		ПараметрыЗакрытия.Вставить("Курс", КурсБонусов);
		ПараметрыЗакрытия.Вставить("Кратность", 1);
		ПараметрыЗакрытия.Вставить("СуммаОплаты", СуммаБонусовВВалюте);
		ПараметрыЗакрытия.Вставить("ВидОплаты", ПредопределенноеЗначение("Перечисление.ВидыБезналичныхОплат.Бонусы"));
		ПараметрыЗакрытия.Вставить("ЕстьОплатаБонусами", Истина);

	КонецЕсли;

	Закрыть(ПараметрыЗакрытия);

КонецПроцедуры
