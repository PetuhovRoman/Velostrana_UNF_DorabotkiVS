    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникНоменклатураПоставщиков.Ссылка КАК Ссылка,
	СправочникНоменклатураПоставщиков.Владелец КАК Поставщик,
	СправочникНоменклатураПоставщиков.ПометкаУдаления КАК ПометкаУдаления,
	СправочникНоменклатураПоставщиков.Код КАК Код,
	СправочникНоменклатураПоставщиков.Наименование КАК Наименование,
	СправочникНоменклатураПоставщиков.Артикул КАК Артикул,
	0 КАК КоличествоОстаток,
	СправочникНоменклатураПоставщиков.СрокПополнения КАК СрокПополнения,
	ВнутренняяНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	0 КАК Цена,
	СправочникНоменклатураПоставщиков.Номенклатура КАК Номенклатура,
	СправочникНоменклатураПоставщиков.Характеристика КАК Характеристика,
	0 КАК КартинкаКорзина,
	НЕОПРЕДЕЛЕНО КАК ВалютаЦены,
	НЕОПРЕДЕЛЕНО КАК ПредставлениеВалютаЦены,
	ВЫБОР
		КОГДА ВнутренняяНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
			ТОГДА 0
		КОГДА ВнутренняяНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПодарочныйСертификат)
			ТОГДА 4
		ИНАЧЕ 2
	КОНЕЦ + ВЫБОР
		КОГДА ВнутренняяНоменклатура.ИспользоватьХарактеристики
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ + ВЫБОР
		КОГДА СправочникНоменклатураПоставщиков.ПометкаУдаления
			ТОГДА 6
		ИНАЧЕ 0
	КОНЕЦ + ВЫБОР
		КОГДА ВнутренняяНоменклатура.ЭтоНабор
			ТОГДА 12
		ИНАЧЕ 0
	КОНЕЦ КАК ВариантКартинки,
	ВнутренняяНоменклатура.КатегорияНоменклатуры КАК КатегорияНоменклатуры,
	ВнутренняяНоменклатура.Родитель КАК Родитель,
	СправочникНоменклатураПоставщиков.Родитель КАК НоменклатураПоставщикаРодитель,
	ВнутренняяНоменклатура.Склад КАК Склад,
	ВнутренняяНоменклатура.Ячейка КАК Ячейка,
	ВнутренняяНоменклатура.ЭтоНабор КАК ЭтоНабор,
	ВнутренняяНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	ВнутренняяНоменклатура.ЗапретитьВводДробногоКоличества КАК ЗапретитьВводДробногоКоличества,
	ВнутренняяНоменклатура.Весовой КАК Весовой,
	ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДСНоменклатуры,
	СправочникНоменклатураПоставщиков.Идентификатор КАК Идентификатор
ИЗ
	Справочник.НоменклатураПоставщиков КАК СправочникНоменклатураПоставщиков
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ВнутренняяНоменклатура
		ПО СправочникНоменклатураПоставщиков.Номенклатура = ВнутренняяНоменклатура.Ссылка
ГДЕ
	НЕ СправочникНоменклатураПоставщиков.ЭтоГруппа
	И СправочникНоменклатураПоставщиков.Владелец = &amp;Поставщик</queryText>
      <mainTable>Catalog.НоменклатураПоставщиков</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
