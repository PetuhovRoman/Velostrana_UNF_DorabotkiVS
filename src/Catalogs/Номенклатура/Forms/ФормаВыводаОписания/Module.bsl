
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("Номенклатура",             Номенклатура);
	
	Если ЗначениеЗаполнено(Номенклатура) И Не Номенклатура.ЭтоГруппа Тогда
		Заголовок = СокрЛП(Номенклатура) + " Артикул " + СокрЛП(Номенклатура.Артикул);
		
		ТекстОписания = "https://www.velostrana.ru/api/1cwidget/"+ XMLСтрока(Номенклатура);
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры
