  // Консоль AL 22.10.2026 — модуль менеджера справочника «Ячейки» в расширении «ДоработкиВС».
// Печать QR-кодов зон и ячеек склада.
//
// Что кодируется в QR: код элемента справочника «Ячейки» (поле «Код»). Именно по коду
// мобильное рабочее место кладовщика находит ячейку при сканировании
// (Обработка.МобильноеРабочееМестоКладовщика, функция НайтиЯчейкуПоКоду), поэтому
// напечатанные этикетки сразу пригодны для сканирования в мобильном приложении.
//
// Зона = элемент справочника, у которого есть подчиненные элементы (иерархия элементов).
// Ячейка = элемент без подчиненных.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ИнтерфейсПечати

// Консоль AL 22.10.2026 — добавление команд печати QR-кодов в подменю «Печать» форм списка и элемента.
&После("ДобавитьКомандыПечати")
Процедура ВС_ДобавитьКомандыПечати(КомандыПечати) 
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ВС_QRКодЗонИЯчеек";
	КомандаПечати.Представление = НСтр("ru = 'QR-коды зон и ячеек'");
	КомандаПечати.ФункциональныеОпции = "УчетПоЯчейкам";
	КомандаПечати.СписокФорм ="ФормаЭлемента,ФормаСписка";
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.Порядок = 10;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ВС_QRКодЯчеекЗоны";
	КомандаПечати.Представление = НСтр("ru = 'QR-коды ячеек выбранных зон'");
	КомандаПечати.ФункциональныеОпции = "УчетПоЯчейкам";
	КомандаПечати.СписокФорм = "ФормаСписка,ФормаЭлемента";
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.Порядок = 20;
	
КонецПроцедуры
// Конец Консоль AL

// Консоль AL 22.10.2026 — формирование печатных форм с QR-кодами.
// Процедура вызывается подсистемой печати для объектов, указанных в команде.
//
// Параметры:
//   МассивОбъектов - Массив из СправочникСсылка.Ячейки - выбранные зоны и ячейки.
//   ПараметрыПечати - Структура - дополнительные параметры печати (не используются).
//   КоллекцияПечатныхФорм - ТаблицаЗначений - см. УправлениеПечатью.СоздатьКоллекциюПечатныхФорм.
//   ОбъектыПечати - СписокЗначений - соответствие объектов именам областей табличного документа.
//   ПараметрыВывода - Структура - параметры вывода печатных форм (не используются).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "ВС_QRКодЗонИЯчеек");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = Новый ТабличныйДокумент;
		ПечатнаяФорма.ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Ячейки_ВС_QRКодЗонИЯчеек";
		ПечатнаяФорма.СинонимМакета = НСтр("ru = 'QR-коды зон и ячеек'");
		ВС_СформироватьQRКоды(ПечатнаяФорма.ТабличныйДокумент, МассивОбъектов, ОбъектыПечати, Ложь);
	КонецЕсли;
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "ВС_QRКодЯчеекЗоны");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = Новый ТабличныйДокумент;
		ПечатнаяФорма.ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Ячейки_ВС_QRКодЯчеекЗоны";
		ПечатнаяФорма.СинонимМакета = НСтр("ru = 'QR-коды ячеек выбранных зон'");
		ВС_СформироватьQRКоды(ПечатнаяФорма.ТабличныйДокумент, МассивОбъектов, ОбъектыПечати, Истина);
	КонецЕсли;
	
КонецПроцедуры
// Конец Консоль AL

#КонецОбласти

#Область ВС_СлужебныеПроцедурыИФункции

// Консоль AL 22.10.2026 — служебные процедуры формирования этикеток с QR-кодами.

// Формирует табличный документ: одна этикетка на странице.
//
// Параметры:
//   ТабличныйДокумент - ТабличныйДокумент - заполняемая печатная форма.
//   МассивОбъектов - Массив из СправочникСсылка.Ячейки - выбранные зоны и ячейки.
//   ОбъектыПечати - СписокЗначений - соответствие объектов именам областей табличного документа.
//   РазворачиватьЗоны - Булево - Истина: для выбранной зоны печатаются этикетки всех входящих в нее ячеек
//       (выбранная ячейка без подчиненных печатается сама); Ложь: печатаются только выбранные объекты.
//
Процедура ВС_СформироватьQRКоды(ТабличныйДокумент, МассивОбъектов, ОбъектыПечати, РазворачиватьЗоны)
	
	Перем ПервыйДокумент, НомерСтрокиНачало;
	
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	ДанныеОбъектов = ВС_ДанныеМеток(МассивОбъектов);
	
	Для Каждого Ссылка Из МассивОбъектов Цикл
		
		СтрокиОбъекта = ДанныеОбъектов.НайтиСтроки(Новый Структура("Ссылка", Ссылка));
		Если СтрокиОбъекта.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МассивМеток = СтрокиОбъекта;
		Если РазворачиватьЗоны И СтрокиОбъекта[0].ЭтоЗона Тогда
			// @skip-check query-in-loop - число выбранных зон невелико
			ДанныеПодчиненных = ВС_ДанныеМеток(ВС_ПодчиненныеЭлементы(Ссылка));
			ДанныеПодчиненных.Сортировать("Код");
			МассивМеток = ДанныеПодчиненных.НайтиСтроки(Новый Структура("ЭтоЗона", Ложь));
		КонецЕсли;
		
		НомерСтрокиОбъекта = 0;
		Для Каждого Метка Из МассивМеток Цикл
			
			Если ПустаяСтрока(Метка.Код) Тогда
				ОбщегоНазначения.СообщитьПользователю(
					СтрШаблон(НСтр("ru = 'У элемента ""%1"" не заполнен код, QR-код не сформирован.'"), Метка.Наименование),
					Метка.Ссылка);
				Продолжить;
			КонецЕсли;
			
			ПечатьДокументовУНФ.ПередНачаломФормированияДокумента(ТабличныйДокумент, ПервыйДокумент, НомерСтрокиНачало);
			Если НомерСтрокиОбъекта = 0 Тогда
				НомерСтрокиОбъекта = НомерСтрокиНачало;
			КонецЕсли;
			
			ВС_ВывестиМетку(ТабличныйДокумент, Метка);
			
		КонецЦикла;
		
		Если НомерСтрокиОбъекта > 0 Тогда
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиОбъекта, ОбъектыПечати, Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
		ТабличныйДокумент.Область(, 1, , 1).ШиринаКолонки = 55;
	КонецЕсли;
	
КонецПроцедуры

// Выводит в табличный документ одну этикетку: тип объекта, склад, QR-код, наименование, код.
//
// Параметры:
//   ТабличныйДокумент - ТабличныйДокумент - заполняемая печатная форма.
//   Метка - СтрокаТаблицыЗначений - см. ВС_ДанныеМеток.
//
Процедура ВС_ВывестиМетку(ТабличныйДокумент, Метка)
	
	ПараметрыШтрихкода = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	ПараметрыШтрихкода.Ширина = 300;
	ПараметрыШтрихкода.Высота = 300;
	ПараметрыШтрихкода.ТипКода = 16; // QR
	ПараметрыШтрихкода.Штрихкод = Метка.Код;
	ПараметрыШтрихкода.ОтображатьТекст = Ложь;
	ПараметрыШтрихкода.ПрозрачныйФон = Ложь;
	ПараметрыШтрихкода.Масштабировать = Истина;
	ПараметрыШтрихкода.СохранятьПропорции = Истина;
	
	ИзображениеШтрихкода = ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
	Если ИзображениеШтрихкода.Картинка = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Не удалось сформировать QR-код для элемента ""%1"".'"), Метка.Наименование),
			Метка.Ссылка);
		Возврат;
	КонецЕсли;
	
	НомерСтроки = ТабличныйДокумент.ВысотаТаблицы + 1;
	
	ТипОбъекта = ?(Метка.ЭтоЗона, НСтр("ru = 'ЗОНА СКЛАДА'"), НСтр("ru = 'ЯЧЕЙКА СКЛАДА'"));
	ВС_ЗаполнитьСтрокуМетки(ТабличныйДокумент, НомерСтроки, ТипОбъекта, 16, Истина, 30);
	
	ТекстСклада = СтрШаблон(НСтр("ru = 'Склад: %1'"), Метка.Склад);
	ВС_ЗаполнитьСтрокуМетки(ТабличныйДокумент, НомерСтроки + 1, ТекстСклада, 12, Ложь, 24);
	
	// Строка с QR-кодом.
	ОбластьQR = ТабличныйДокумент.Область(НомерСтроки + 2, 1, НомерСтроки + 2, 1);
	ОбластьQR.Текст = " ";
	ОбластьQR.ВысотаСтроки = 230;
	Рисунок = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
	Рисунок.Картинка = ИзображениеШтрихкода.Картинка;
	Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
	Рисунок.ГраницаСверху = Ложь;
	Рисунок.ГраницаСнизу = Ложь;
	Рисунок.ГраницаСправа = Ложь;
	Рисунок.ГраницаСлева = Ложь;
	Рисунок.Расположить(ОбластьQR);
	
	ВС_ЗаполнитьСтрокуМетки(ТабличныйДокумент, НомерСтроки + 3, Метка.Наименование, 20, Истина, 40);
	ВС_ЗаполнитьСтрокуМетки(ТабличныйДокумент, НомерСтроки + 4, СтрШаблон(НСтр("ru = 'Код: %1'"), Метка.Код), 14, Ложь, 26);
	
	Если Не ПустаяСтрока(Метка.Родитель) Тогда
		ТекстРодителя = СтрШаблон(НСтр("ru = 'Входит в: %1'"), Метка.Родитель);
		ВС_ЗаполнитьСтрокуМетки(ТабличныйДокумент, НомерСтроки + 5, ТекстРодителя, 12, Ложь, 22);
	КонецЕсли;
	
КонецПроцедуры

// Заполняет текстовую строку этикетки: текст по центру с переносом по словам.
//
// Параметры:
//   ТабличныйДокумент - ТабличныйДокумент - заполняемая печатная форма.
//   НомерСтроки - Число - номер заполняемой строки.
//   Текст - Строка - выводимый текст.
//   РазмерШрифта - Число - размер шрифта.
//   Полужирный - Булево - признак полужирного шрифта.
//   ВысотаСтроки - Число - высота строки в пунктах.
//
Процедура ВС_ЗаполнитьСтрокуМетки(ТабличныйДокумент, НомерСтроки, Текст, РазмерШрифта, Полужирный, ВысотаСтроки)
	
	Область = ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
	Область.Текст = Текст;
	Область.Шрифт = Новый Шрифт(, РазмерШрифта, Полужирный);
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Область.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.ВысотаСтроки = ВысотаСтроки;
	
КонецПроцедуры

// Возвращает данные для печати этикеток.
//
// Параметры:
//   Ссылки - Массив из СправочникСсылка.Ячейки - зоны и ячейки.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ссылка - СправочникСсылка.Ячейки
//     * Код - Строка - значение, кодируемое в QR-коде
//     * Наименование - Строка
//     * Склад - Строка - наименование структурной единицы (владельца)
//     * Родитель - Строка - наименование родителя (зоны, в которую входит элемент)
//     * ЭтоЗона - Булево - Истина, если у элемента есть подчиненные элементы
//
Функция ВС_ДанныеМеток(Ссылки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ячейки.Родитель КАК Ссылка
		|ПОМЕСТИТЬ ВТЗоны
		|ИЗ
		|	Справочник.Ячейки КАК Ячейки
		|ГДЕ
		|	Ячейки.Родитель В(&Ссылки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Ячейки.Ссылка КАК Ссылка,
		|	Ячейки.Код КАК Код,
		|	Ячейки.Наименование КАК Наименование,
		|	Ячейки.Владелец.Наименование КАК Склад,
		|	Ячейки.Родитель.Наименование КАК Родитель,
		|	ВЫБОР
		|		КОГДА ВТЗоны.Ссылка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЭтоЗона
		|ИЗ
		|	Справочник.Ячейки КАК Ячейки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗоны КАК ВТЗоны
		|		ПО Ячейки.Ссылка = ВТЗоны.Ссылка
		|ГДЕ
		|	Ячейки.Ссылка В(&Ссылки)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает все подчиненные элементы зоны на всех уровнях иерархии.
//
// Параметры:
//   Зона - СправочникСсылка.Ячейки - зона.
//
// Возвращаемое значение:
//   Массив из СправочникСсылка.Ячейки
//
Функция ВС_ПодчиненныеЭлементы(Зона)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Зона", Зона);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ячейки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Ячейки КАК Ячейки
		|ГДЕ
		|	Ячейки.Ссылка В ИЕРАРХИИ(&Зона)
		|	И Ячейки.Ссылка <> &Зона";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Конец Консоль AL

#КонецОбласти

#КонецЕсли
