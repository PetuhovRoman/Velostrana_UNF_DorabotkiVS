Функция ПолучитьСтруктуруРеквизитовУпаковки(ЭлементДОМ)
	
	Если ЭлементДОМ.ПолучитьЭлементыПоИмени("ШтрихкодУпаковки").Количество() = 0 Тогда //нет номенклатуры в строке
		Возврат Новый Структура;
	КонецЕсли;

	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ГУИД", 					 			ЭлементДОМ.ПолучитьЭлементыПоИмени("ШтрихкодУпаковки").Элемент(0).ТекстовоеСодержимое);
	СтруктураРеквизитов.Вставить("Наименование", 				 		ЭлементДОМ.ПолучитьЭлементыПоИмени("Наименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураРеквизитов.Вставить("ТипУпаковки", 						ЭлементДОМ.ПолучитьЭлементыПоИмени("ТипУпаковки").Элемент(0).ТекстовоеСодержимое);		
	СтруктураРеквизитов.Вставить("ТипШтрихкода", 		 				ЭлементДОМ.ПолучитьЭлементыПоИмени("ТипШтрихкода").Элемент(0).ТекстовоеСодержимое);
	СтруктураРеквизитов.Вставить("ЗначениеШтрихкода", 					ЭлементДОМ.ПолучитьЭлементыПоИмени("ЗначениеШтрихкода").Элемент(0).ТекстовоеСодержимое);
	СтруктураРеквизитов.Вставить("Количество", 				 			ЭлементДОМ.ПолучитьЭлементыПоИмени("Количество").Элемент(0).ТекстовоеСодержимое);
	СтруктураРеквизитов.Вставить("ДатаУпаковки", 			 			ЭлементДОМ.ПолучитьЭлементыПоИмени("ДатаУпаковки").Элемент(0).ТекстовоеСодержимое);
	СтруктураРеквизитов.Вставить("КоличествоПотребительскихУпаковок", 	ЭлементДОМ.ПолучитьЭлементыПоИмени("КоличествоПотребительскихУпаковок").Элемент(0).ТекстовоеСодержимое);
	
	СтруктураРеквизитов.Вставить("ХешСумма", 				 			ЭлементДОМ.ПолучитьЭлементыПоИмени("ХешСумма").Элемент(0).ТекстовоеСодержимое);
	СтруктураРеквизитов.Вставить("ХешСуммаЗначенияШтрихкода", 			ЭлементДОМ.ПолучитьЭлементыПоИмени("ХешСуммаЗначенияШтрихкода").Элемент(0).ТекстовоеСодержимое);
	СтруктураРеквизитов.Вставить("ХешСуммаНормализации", 				ЭлементДОМ.ПолучитьЭлементыПоИмени("ХешСуммаНормализации").Элемент(0).ТекстовоеСодержимое);
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

Функция ПолучитьТаблицуТоваров(ТЗТоваров)

	ТЗНоменклатуры = ТЗТоваров.Скопировать();
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗНоменклатуры.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗНоменклатуры.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	
	Для Каждого СтрокаТЗ Из ТЗНоменклатуры Цикл
		НовыйGUID = Новый УникальныйИдентификатор(СтрокаТЗ.НоменклатураИД);
		Товар = Справочники.Номенклатура.ПолучитьСсылку(НовыйGUID);
		
		Если ОбщегоНазначения.СсылкаСуществует(Товар) Тогда
			СтрокаТЗ.Номенклатура = Товар;
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(СтрокаТЗ.ХарактеристикаИД) И НЕ СтрокаТЗ.ХарактеристикаИД = "00000000-0000-0000-0000-000000000000" Тогда
			НовыйGUID = Новый УникальныйИдентификатор(СтрокаТЗ.ХарактеристикаИД);
			Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(НовыйGUID);
			Если ОбщегоНазначения.СсылкаСуществует(Характеристика) Тогда
				СтрокаТЗ.Характеристика = Характеристика;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТЗ.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию(СтрокаТЗ.СтавкаНДССтр, Истина);
	КонецЦикла;
	
	ТаблицаТоваров = ОтобратьСтрокиПоКритериям(ТЗНоменклатуры,
	                   Новый Структура("Номенклатура", Справочники.Номенклатура.ПустаяСсылка()), Новый Структура("Номенклатура", ВидСравнения.НеРавно)).Выгрузить();
					   
	Возврат ТаблицаТоваров;
	
КонецФункции

Функция ОтобратьСтрокиПоКритериям(Источник, СтруктураКритериев, СтруктураСложныхКритериев = Неопределено)

	Перем ВидСравненияСложный;

	Если СтруктураСложныхКритериев = Неопределено Тогда
		СтруктураСложныхКритериев = Новый Структура;
	КонецЕсли;

	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Источник);

	Для Каждого Критерий Из СтруктураКритериев Цикл
		НовыйОтбор = ПостроительЗапроса.Отбор.Добавить(Критерий.Ключ);

		СтруктураСложныхКритериев.Свойство(Критерий.Ключ, ВидСравненияСложный);

		Если ВидСравненияСложный = Неопределено Тогда
			НовыйОтбор.Установить(Критерий.Значение);
		Иначе
			НовыйОтбор.Использование = Истина;
			НовыйОтбор.ВидСравнения = ВидСравненияСложный;
			НовыйОтбор.Значение = Критерий.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат ПостроительЗапроса.Результат;

КонецФункции // ОтобратьСтрокиПоКритериям()

Функция ПолучитьОрганизацию(СтруктураРеквизитов)
	
	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) Тогда
		НовыйGUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.ИД);
		Организация = Справочники.Организации.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Организация) Тогда
		Возврат Организация;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Приоритет,
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Наименование = &Наименование
	|	И Организации.ИНН = &ИНН
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	2,
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Наименование = &Наименование
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	3,
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("Наименование", СтруктураРеквизитов.Наименование);
	Запрос.УстановитьПараметр("ИНН", СтруктураРеквизитов.ИНН);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Организации.ПустаяСсылка();
	
КонецФункции

Функция ПолучитьПодразделение(СтруктураРеквизитов)
	
	Если СтруктураРеквизитов.ИД = "00000000-0000-0000-0000-000000000000" И ПустаяСтрока(СтруктураРеквизитов.Наименование) Тогда
		Возврат Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
	КонецЕсли;

	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) И НЕ СтруктураРеквизитов.ИД = "00000000-0000-0000-0000-000000000000" Тогда
		НовыйGUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.ИД);
		Подразделение = Справочники.СтруктурныеЕдиницы.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Подразделение) Тогда
		Возврат Подразделение;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК Склады
	|ГДЕ
	|	Склады.Наименование = &Наименование
	|	И Склады.ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.Подразделение)";   
	Запрос.УстановитьПараметр("Наименование", СтруктураРеквизитов.Наименование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	СпрН = Справочники.СтруктурныеЕдиницы.СоздатьЭлемент();
	СпрН.Заполнить(Неопределено);
	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) Тогда
		СпрН.УстановитьСсылкуНового(Подразделение);
	КонецЕсли;
	СпрН.ТипСтруктурнойЕдиницы = Перечисления.ТипыСтруктурныхЕдиниц.Подразделение;
	СпрН.Наименование = СтруктураРеквизитов.Наименование;
	СпрН.Записать();
	
	Возврат СпрН.Ссылка;
	
КонецФункции

