Функция ПолучитьВидНоменклатуры(Знач СтрокаТЧ)
	
	ТекстНаименования = СокрЛП(СтрокаТЧ.ВидНоменклатуры);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КатегорииНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	ВидыНоменклатуры.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", ТекстНаименования);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	
	ВНОбъект = Справочники.КатегорииНоменклатуры.СоздатьЭлемент();
	ВНОбъект.Наименование = ТекстНаименования;
	Если СтрокаТЧ.ТипНоменклатуры = "Услуга" Тогда
		ВНОбъект.ТипНоменклатурыПоУмолчанию = Перечисления.ТипыНоменклатуры.Услуга;
		ВНОбъект.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Услуга;
	Иначе
		ВНОбъект.ТипНоменклатурыПоУмолчанию = Перечисления.ТипыНоменклатуры.Запас;
		ВНОбъект.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
		ВНОбъект.МетодОценки = Перечисления.МетодОценкиЗапасов.FIFO;
		ВНОбъект.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
	КонецЕсли;
	
	ВНОбъект.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
	ВНОбъект.Записать();
	
	Возврат ВНОбъект.Ссылка;
	
КонецФункции

Функция ПолучитьЗначениеРеквизита(Свойство, СтрокаЗначения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	НЕ ЗначенияСвойствОбъектов.ПометкаУдаления
	|	И ЗначенияСвойствОбъектов.Владелец = &Владелец
	|	И ЗначенияСвойствОбъектов.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Владелец", Свойство);
	Запрос.УстановитьПараметр("Наименование", СтрокаЗначения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НовоеЗначение = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
	НовоеЗначение.Владелец = Свойство;
	НовоеЗначение.Наименование = СтрокаЗначения;
	НовоеЗначение.Записать();
	
	Возврат НовоеЗначение.Ссылка;
	
КонецФункции

Функция ПолучитьРодителя(Знач СтрокаТЧ)
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ГУИДГруппы) Тогда
		НовыйGUIDГр = Новый УникальныйИдентификатор(СтрокаТЧ.ГУИДГруппы);
		Родитель = Справочники.Номенклатура.ПолучитьСсылку(НовыйGUIDГр);
		Если ОбщегоНазначения.СсылкаСуществует(Родитель) Тогда
			Возврат Родитель;
		КонецЕсли;
		СпрНГр = Справочники.Номенклатура.СоздатьГруппу();
		СпрНГр.УстановитьСсылкуНового(Родитель);
		СпрНГр.Наименование = СокрЛП(СтрокаТЧ.Группа);
		СпрНГр.Родитель = ПолучитьРодителяГруппы(СтрокаТЧ);
		СпрНГр.Записать();
		Возврат СпрНГр.Ссылка;
	Иначе	
		Возврат Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.Группа);
	КонецЕсли;
КонецФункции

Функция ПолучитьРодителяГруппы(Знач СтрокаТЧ)

	Если Не ЗначениеЗаполнено(СтрокаТЧ.РодительГруппы) Или СтрокаТЧ.РодительГруппы = "Лето" Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	ТекРГ = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.РодительГруппы, Истина);
	Если ЗначениеЗаполнено(ТекРГ) Тогда
		Возврат ТекРГ;
	КонецЕсли;
	
	СпрНГр = Справочники.Номенклатура.СоздатьГруппу();
	СпрНГр.Наименование = СокрЛП(СтрокаТЧ.РодительГруппы);
	СпрНГр.Родитель = ПолучитьРодителяГруппы2(СтрокаТЧ);
	СпрНГр.Записать();
	Возврат СпрНГр.Ссылка;
	
КонецФункции

Функция ПолучитьРодителяГруппы2(Знач СтрокаТЧ)

	Если Не ЗначениеЗаполнено(СтрокаТЧ.РодительГруппы2) Или СтрокаТЧ.РодительГруппы2 = "Лето" Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	ТекРГ = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.РодительГруппы2, Истина);
	Если ЗначениеЗаполнено(ТекРГ) Тогда
		Возврат ТекРГ;
	КонецЕсли;
	
	СпрНГр = Справочники.Номенклатура.СоздатьГруппу();
	СпрНГр.Наименование = СокрЛП(СтрокаТЧ.РодительГруппы2);
	СпрНГр.Записать();
	Возврат СпрНГр.Ссылка;
	
КонецФункции

Функция ПолучитьУпаковку(Знач СтрокаТЧ, Товар, Характеристика)
	//СтрокаТЧ = ДанныеЗагрузки[0];
	
	Если ПустаяСтрока(СтрокаТЧ.ГУИД) Или СтрокаТЧ.ГУИД = "00000000-0000-0000-0000-000000000000" Тогда
		Упаковка = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоНаименованию(СтрокаТЧ.Наименование, Истина, , Товар);
	Иначе
		НовыйGUID = Новый УникальныйИдентификатор(СтрокаТЧ.ГУИД);
		Упаковка = Справочники.ШтрихкодыУпаковокТоваров.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Упаковка) Тогда
		Возврат Упаковка;
	КонецЕсли;
	
		СпрХ = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
		СпрХ.УстановитьСсылкуНового(Упаковка);
		СпрХ.Номенклатура = Товар;
		СпрХ.Характеристика = Характеристика;
		//СпрХ.Наименование = СтрокаТЧ.Наименование;
		СпрХ.ДатаУпаковки = СтрокаТЧ.ДатаУпаковки;
		СпрХ.ТипУпаковки = ЗначениеПеречисления("ТипыУпаковок", СтрокаТЧ.ТипУпаковки);
		СпрХ.ТипШтрихкода = ЗначениеПеречисления("ТипыШтрихкодов", СтрокаТЧ.ТипШтрихкода);
		
		СпрХ.ЗначениеШтрихкода = СтрокаТЧ.ЗначениеШтрихкода;
		СпрХ.Количество = СтрокаТЧ.Количество;
		СпрХ.КоличествоПотребительскихУпаковок = СтрокаТЧ.КоличествоПотребительскихУпаковок;
		
		СпрХ.ХешСумма = СтрокаТЧ.ХешСумма;
		СпрХ.ХешСуммаЗначенияШтрихкода = СтрокаТЧ.ХешСуммаЗначенияШтрихкода;
		СпрХ.ХешСуммаНормализации = СтрокаТЧ.ХешСуммаНормализации;
		
		СпрХ.Записать();
		
		Упаковка = СпрХ.Ссылка;
		
	
	Возврат Упаковка;
	
КонецФункции

Функция ПолучитьНоменклатуруПоставщика(Номенклатура, Характеристика, СтруктураКонтрагент)
	
	Владелец = ПолучитьКонтрагента(СтруктураКонтрагент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НоменклатураПоставщиков.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НоменклатураПоставщиков КАК НоменклатураПоставщиков
	|ГДЕ
	|	НоменклатураПоставщиков.Номенклатура = &Номенклатура
	|	И НоменклатураПоставщиков.Владелец = &Владелец
	|	И НоменклатураПоставщиков.Характеристика = &Характеристика";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	СпрНП = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
	СпрНП.Владелец = ПолучитьКонтрагента(СтруктураКонтрагент); 
	СпрНП.Номенклатура = Номенклатура;
	СпрНП.Характеристика = Характеристика;
	СпрНП.Записать();
	
	Возврат СпрНП.Ссылка;

КонецФункции


Функция ЗначениеПеречисления(ИмяПеречисления, СтрЗначения)
    
    Для Каждого эл из  Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
        Если СтрЗначения = эл.Синоним Тогда 
			Сообщить(эл.Имя);
			Возврат Перечисления[ИмяПеречисления][эл.Имя];
        КонецЕсли;
    КонецЦикла;

КонецФункции // ЗначениеПеречисления()
 
Функция ПреобразоватьДату(ДатаСтрокой)
	
	Если ПустаяСтрока(ДатаСтрокой) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Возврат Дата(ДатаСтрокой);	
	
КонецФункции

// Процедура проводит проверку значнеие и пишет текстовой узел в файл XML
//
// Параметры:
//  ОбъектXML - объект ЗаписьXML
//  Имя       - наименования узла
//  Значение  - текстовое значение для записи в файл
//
Процедура ЗаписатьТекстовойУзел(ОбъектXML, Имя, Значение, ОбязательнаяПроверкаНаПустуюСтроку = Истина)

	СтрокаЗаписи = Строка(Значение);
	Если ОбязательнаяПроверкаНаПустуюСтроку
		И НЕ ЗначениеЗаполнено(СтрокаЗаписи) Тогда
		
		Возврат;		
		
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		
		СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, Символы.НПП, "");
		СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, ",", ".");
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		
		Если Значение Тогда
			СтрокаЗаписи = "true";
		Иначе
			СтрокаЗаписи = "false";
		КонецЕсли;
		
	КонецЕсли;
	
	ОбъектXML.ЗаписатьНачалоЭлемента(Имя);
	ОбъектXML.ЗаписатьТекст(СтрокаЗаписи);
	ОбъектXML.ЗаписатьКонецЭлемента();

КонецПроцедуры
