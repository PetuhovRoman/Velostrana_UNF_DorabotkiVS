		мДокументДОМ = ПостроительДом.Прочитать(ЧтениеXML);
	Исключение
		ЗаписьЖурналаРегистрации("ЗагрузкаДанныхУТ10.Заказы", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		Сообщить(ОписаниеОшибки()); 
		Возврат;
	КонецПопытки;
	
	НомерПринятогоСообщения = 0;
	Если мДокументДОМ.ПолучитьЭлементыПоИмени("MessageNo").Количество() > 0 Тогда
		НомерПринятогоСообщения = Число(мДокументДОМ.ПолучитьЭлементыПоИмени("MessageNo").Элемент(0).ТекстовоеСодержимое);
	КонецЕсли;
	
