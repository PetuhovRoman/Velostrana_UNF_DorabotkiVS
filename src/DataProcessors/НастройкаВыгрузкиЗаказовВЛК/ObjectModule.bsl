
Процедура СохранитьНастройкиСКД() Экспорт
	
	//ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючОбъектаСтрокой(), КлючНастроекСтрокой(), НастройкаКомпоновки);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(КлючОбъектаСтрокой(), НастройкаКомпоновки.ПолучитьНастройки(), КлючНастроекСтрокой());
КонецПроцедуры

Процедура ВосстановитьНастройкиСКД() Экспорт
	
	КомпоновщикНастроекНастройки = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(КлючОбъектаСтрокой(), КлючНастроекСтрокой());
	НастройкаКомпоновки.ЗагрузитьНастройки(КомпоновщикНастроекНастройки);
	
КонецПроцедуры

Функция КлючОбъектаСтрокой()
	Возврат "РегламентноеЗадание.СайтВыгрузкаЗаказов";
КонецФункции

Функция КлючНастроекСтрокой()
	Возврат "НастройкаВыгрузкиЗаказовВЛК";
КонецФункции

Функция СформироватьТЗ() Экспорт
	
	СхемаКомпоновки = ПолучитьОбщийМакет("МакетВыгрузкиЗаказовЛК");
	
	//ИсточникДоступныхНастроек = 
	//Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных);
	//
	//
	//ОбщегоНазначенияРМККлиентСервер.СкопироватьНастройкиКомпоновкиДанных(, Объект.НастройкаКомпоновки.ПолучитьНастройки());
	НастройкиКомпоновки = НастройкаКомпоновки.ПолучитьНастройки();

	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "ЗаказыМассив", ВыгрузитьЗаказы());
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(НастройкиКомпоновки, "СвойствоЗаказаТип", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ТипЗаказа_499f11036f214dbfbf0a5cb0cdee99f8"));

	//Группировки
	ГруппировкаСсылки = НастройкиКомпоновки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Для каждого стрТЗПолей из НастройкиКомпоновки.ДоступныеПоляГруппировок.Элементы цикл
	    ПолеГруппировки1 = ГруппировкаСсылки.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	    ПолеГруппировки1.Использование = Истина;
	    ПолеГруппировки1.Поле = стрТЗПолей.Поле;
	КонецЦикла;
	
	АвтоПоле = ГруппировкаСсылки.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	АвтоПоле.Использование = Истина;
	
	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки1 	= КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиКомпоновки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки1,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТабЗнач = Новый ТаблицаЗначений;
	
	ПроцессорВывода.УстановитьОбъект(ТабЗнач);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	
	orders = СформироватьДанные(ТабЗнач);	
	Возврат ОбменДаннымиССайтом.ПреобразоватьДанныеВJSON(orders);

	
КонецФункции

Функция СформироватьДанные(ТаблицаДанных)
	
	//СоответствиеСтатусов = Новый Соответствие;
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.ПолученССайта, 1);
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.Недозвон, 2);
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.ОформлениеЗаказа, 3);
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.ОжиданиеОплаты, 4);
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.Оплачен, 5);
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.Доставлен, 6);
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.ОжиданиеОтправки, 7);
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.Отменен, 8);
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.ПринятВОбработке, 1);
	//СоответствиеСтатусов.Вставить(Перечисления.СтатусЗаказа.Завершен, 6);
	
	МассивЗаказов = Новый Массив;
	
	Для Каждого Заказ Из ТаблицаДанных Цикл
  
 	 Если Не ЗначениеЗаполнено(Заказ.ВидОплатыКод) Тогда
			Сообщить("По заказу " + Заказ.Номер + " не указан вид оплаты");
			Продолжить;
		КонецЕсли;
		
		//Выгружено = Выгружено + 1;
		
		СтруктураЗаказа = Новый Структура;
		СтруктураЗаказа.Вставить("order_number",СтрЗаменить(СокрЛП(Заказ.Номер), "VS", ""));
		СтруктураЗаказа.Вставить("guid", 		СокрЛП(Заказ.ЗаказГУИД));
		СтруктураЗаказа.Вставить("status", 		СокрЛП(Заказ.СтатусЗаказа));
		СтруктураЗаказа.Вставить("name", 		СокрЛП(Заказ.Контрагент));
		СтруктураЗаказа.Вставить("email", 		СокрЛП(Заказ.Почта));
		СтруктураЗаказа.Вставить("phone", 		СокрЛП(Заказ.Телефон));		
		СтруктураЗаказа.Вставить("message", 	"");
		СтруктураЗаказа.Вставить("created_at", 	Заказ.Дата);
				
		СтруктураОплаты = Новый Структура;
		СтруктураОплаты.Вставить("guid", СокрЛП(Заказ.ВидОплатыКод));
		СтруктураОплаты.Вставить("name", Заказ.ВидОплатыНаименование);
		СтруктураОплаты.Вставить("is_pay", Заказ.Оплачен);
		СтруктураЗаказа.Вставить("payment", СтруктураОплаты);
		
		СтруктураДат = Новый Структура;
		СтруктураДат.Вставить("date", Формат(Заказ.ДатаОтгрузки, "ДФ=yyyy-MM-dd"));
		СтруктураДат.Вставить("range", Формат(Заказ.ВремяНачало, "ДФ=ЧЧ:мм") + ", " + Формат(Заказ.ВремяКонец, "ДФ=ЧЧ:мм"));
		СтруктураДат.Вставить("address", 	СокрЛП(Заказ.Адрес));
		Если ЗначениеЗаполнено(Заказ.Магазин) Тогда
			СтруктураДат.Вставить("shop", 		СокрЛП(Заказ.МагазинКодДляСайта));
			СтруктураДат.Вставить("shop_name", 	СокрЛП(Заказ.Магазин));
		Иначе
			СтруктураДат.Вставить("shop", 		"");
			СтруктураДат.Вставить("shop_name", 	"");
		КонецЕсли;
		МассивДат = Новый Массив;
		МассивДат.Добавить(СтруктураДат);
		
		СтруктураЗаказа.Вставить("delivery", МассивДат);
		//==
		МассивСтрок = Новый Массив;
		
		Товары = Заказ.Ссылка.Запасы.Выгрузить();
		Для Каждого СтрокаТЧ Из Товары Цикл
			// тут в переменной УзелОтправителя будет узел верхнего уровня, а в переменной УзелПолучателя - один из его получателей (вложенного уровня)
			Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда Продолжить КонецЕсли;
			
			Для к = 1 По СтрокаТЧ.Количество Цикл 
				
				СтруктураСтроки = Новый Структура;
				
				СтруктураСтроки.Вставить("guid",			СокрЛП(СтрокаТЧ.Номенклатура.УникальныйИдентификатор()));
				СтруктураСтроки.Вставить("name", 			СокрЛП(СтрокаТЧ.Номенклатура));
				Если ЗначениеЗаполнено(СтрокаТЧ.Характеристика) Тогда
					СтруктураСтроки.Вставить("variant", СокрЛП(СтрокаТЧ.Характеристика.УникальныйИдентификатор()));
					СтруктураСтроки.Вставить("variant_name", 	СокрЛП(СтрокаТЧ.Характеристика));
				КонецЕсли;
				
				СтруктураСтроки.Вставить("price", 			СтрокаТЧ.Всего / СтрокаТЧ.Количество);
				//++ Куприненко ВВ 140925
				СтруктураСтроки.Вставить("first_price", 	СтрокаТЧ.Цена);
				//==
				
				МассивСтрок.Добавить(СтруктураСтроки);
				
			КонецЦикла;
			
		КонецЦикла;
		СтруктураЗаказа.Вставить("items", МассивСтрок);
		
		МассивСтрокПромокоды = Новый Массив;
		Промокоды = Заказ.Ссылка.ПримененныеПромокоды.Выгрузить();
		Для Каждого СтрокаТЧ Из Промокоды Цикл
			// тут в переменной УзелОтправителя будет узел верхнего уровня, а в переменной УзелПолучателя - один из его получателей (вложенного уровня)
			Если Не ЗначениеЗаполнено(СтрокаТЧ.Промокод) Тогда Продолжить КонецЕсли;
			
			СтруктураСтроки = Новый Структура;
			
			СтруктураСтроки.Вставить("id",			СокрЛП(СтрокаТЧ.Промокод));
			СтруктураСтроки.Вставить("name", 		СокрЛП(СтрокаТЧ.УсловиеПредоставленияСкидки));
			
			МассивСтрокПромокоды.Добавить(СтруктураСтроки);
			
		КонецЦикла;
		Если Промокоды.Количество() > 0 Тогда
			СтруктураЗаказа.Вставить("promo", МассивСтрокПромокоды);
		КонецЕсли;
		
		МассивЗаказов.Добавить(СтруктураЗаказа);
		
	КонецЦикла;
	
	Возврат МассивЗаказов;
	
КонецФункции

Функция ВыгрузитьЗаказы() Экспорт
	
	ВыборкаУзлов = ПланыОбмена.ИнтеграцияСИнтернетМагазиномЗаказы.Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		Если ВыборкаУзлов.Ссылка <> ПланыОбмена.ИнтеграцияСИнтернетМагазиномЗаказы.ЭтотУзел() Тогда
			//ВыгрузкаЗаказовВЛичныйКабинет.ВыгрузитьЗаказы(ВыборкаУзлов.Ссылка);
			Возврат ВыгрузитьЗаказыПоУзлу(ВыборкаУзлов.Ссылка); //ОтправлятРезультат на почту
		КонецЕсли;
	КонецЦикла;

КонецФункции
	
Функция ВыгрузитьЗаказыПоУзлу(УзелОбмена) Экспорт 
	
	
	//Сообщить("Всего заказов к выгрузке: " + СписокЗаказов.Количество());
	//УзелОбмена = ПланыОбмена.ВыгрузкаЗаказовЛичныйКабинет.НайтиПоКоду();
	Результат = Новый Массив;
	//ТекстЗапроса = "/v3/posting/fbs/list";
	ПакетЗаказов = 200;
	
	МассивЗаказов = Новый Массив;
	МассивУдаленных = Новый Массив;
	
	НомерСообщения = 1;
	
	ПодобраноЗаказов = 0;
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(УзелОбмена, НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
		
		Если ПодобраноЗаказов > ПакетЗаказов Тогда
			Прервать;
		КонецЕсли;
		
		Объект = ВыборкаИзменений.Получить();
		флУдаление = ?(ТипЗнч(Объект) = Тип("УдалениеОбъекта"), Истина, Ложь);
		
		Если Не флУдаление Тогда
			Если ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
				МассивЗаказов.Добавить(Объект.Ссылка);
			КонецЕсли;
			ПодобраноЗаказов = ПодобраноЗаказов + 1;
		Иначе
			МассивУдаленных.Добавить(Объект);
		КонецЕсли;
	КонецЦикла;
		
	Возврат МассивЗаказов;
	
КонецФункции
