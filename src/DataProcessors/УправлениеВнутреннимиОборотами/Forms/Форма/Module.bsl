		ТекДанные = Элементы.СписокЗаказов.ТекущиеДанные;
	ИначеЕсли Объект.ВидОбработки = "Отгрузка" Тогда
		ТекДанные = Элементы.СписокДокументовОтгрузка.ТекущиеДанные;
	Иначе
		ТекДанные = Элементы.СписокДокументовПриемка.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	ПараметрКоманды = ТекДанные.Ссылка;
	
	// УНФ
	//ОткрытьФорму("ОбщаяФорма.СвязанныеДокументы",
	//	Новый Структура("ОбъектОтбора", ПараметрКоманды),
	//		ПараметрыВыполненияКоманды.Источник,
	//		ПараметрыВыполненияКоманды.Источник.КлючУникальности,
	//		ПараметрыВыполненияКоманды.Окно);
	//
	ОткрытьФорму("ОбщаяФорма.ФормаСтруктурыПодчиненности", Новый Структура("ДокументСсылка", ПараметрКоманды),, Истина, );
	
	СтатистикаИспользованияФормКлиент.ПроверитьЗаписатьСтатистикуКоманды("СтруктураПодчиненности", ЭтаФорма);
	// Конец УНФ
КонецПроцедуры

