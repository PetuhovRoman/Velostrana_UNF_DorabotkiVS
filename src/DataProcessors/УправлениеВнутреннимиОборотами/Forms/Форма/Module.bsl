&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.СкладРЦ = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.СтруктурныеЕдиницы?ref=bc1f00155d014f0711e89b02cb647de3");
	Объект.ПодразделениеРЦ = ВС_ОбщегоНазначения.ПолучитьСсылкуИзНавигационной("e1cib/data/Справочник.СтруктурныеЕдиницы?ref=938e00155d014f0711e91e26440d64df");
	
	Объект.ДатаЗаказа = ТекущаяДатаСеанса();
	
	//ОбновитьПараметрыСписка();
	ДобавитьКолонкуНаличияКодовМаркировки("ДокументЗаказПокупателя");
	
	ctrl = ДобавитьЭлементУправленияФормы(
	"СписокНомерКартинкиОбеспечения",
	Тип("ПолеФормы"),
	Элементы.ГруппаДопСтатусов,
	"СписокЗаказов.НомерКартинкиОбеспечения",
	ВидПоляФормы.ПолеКартинки);
	ctrl.КартинкаЗначений         = БиблиотекаКартинок.СостояниеЗаказа;
	ctrl.КартинкаШапки            = БиблиотекаКартинок.РазделЗакупки;
	ctrl.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ctrl.РастягиватьПоВертикали   = ложь;
	ctrl.РастягиватьПоГоризонтали = ложь;
	ctrl.Заголовок                = "Номер картинки обеспечения";
	ctrl.Подсказка                = "Состояние обеспечения";
	ctrl.Ширина                   = 2;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеВидимостью();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаказовПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.СписокЗаказов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или Не ТекущиеДанные.Свойство("Ссылка") Тогда
		Объект.НоменклатураЗаказа.Очистить();
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбновитьДанныеПоНоменклатуреКлиент", 0.5, Истина);
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовОтгрузкаПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.СписокДокументовОтгрузка.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Или Не ТекущиеДанные.Свойство("Ссылка") Тогда
		Объект.НоменклатураЗаказа.Очистить();
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбновитьДанныеПоНоменклатуреКлиент", 0.5, Истина);
КонецПроцедуры


&НаСервере
Процедура ОбновитьПанельТоваров(СсылкаНаДокументСписка)
	
	Объект.НоменклатураЗаказа.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаНаДокументСписка", СсылкаНаДокументСписка);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	Запрос.УстановитьПараметр("ВидОбработки", Объект.ВидОбработки);
	Если Объект.ВидОбработки = "Подготовка" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателяЗапасы.Номенклатура КАК Номенклатура,
		|	ЗаказПокупателяЗапасы.Характеристика КАК Характеристика,
		|	ЗаказПокупателяЗапасы.Всего КАК Всего,
		|	ЗаказПокупателяЗапасы.Количество КАК Количество,
		|	ВЫБОР
		|		КОГДА ЗаказПокупателяЗапасы.СтруктурнаяЕдиницаРезерв В ИЕРАРХИИ (&Подразделение)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ДляИнформации,
		|	ВЫБОР
		|		КОГДА РазмещениеЗаказовОбороты.ЗаказПокупателя ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Размещено,
		|	ЗаказПокупателяЗапасы.СтруктурнаяЕдиницаРезерв КАК СтруктурнаяЕдиницаРезерв
		|ИЗ
		|	Документ.ЗаказПокупателя.Запасы КАК ЗаказПокупателяЗапасы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РазмещениеЗаказов.Обороты(, , , ЗаказПокупателя = &СсылкаНаДокументСписка) КАК РазмещениеЗаказовОбороты
		|		ПО ЗаказПокупателяЗапасы.Ссылка = РазмещениеЗаказовОбороты.ЗаказПокупателя
		|			И ЗаказПокупателяЗапасы.Номенклатура = РазмещениеЗаказовОбороты.Номенклатура
		|			И ЗаказПокупателяЗапасы.Характеристика = РазмещениеЗаказовОбороты.Характеристика
		|			И РазмещениеЗаказовОбороты.КоличествоПриход > 0
		|ГДЕ
		|	ЗаказПокупателяЗапасы.Ссылка = &СсылкаНаДокументСписка
		|	И НЕ ЗаказПокупателяЗапасы.СтруктурнаяЕдиницаРезерв = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДляИнформации";
		
	ИначеЕсли Объект.ВидОбработки = "Отгрузка" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНаПеремещениеЗапасы.Номенклатура КАК Номенклатура,
		|	ЗаказНаПеремещениеЗапасы.Характеристика КАК Характеристика,
		|	ЗаказНаПеремещениеЗапасы.Количество КАК Количество,
		|	ВЫБОР
		|		КОГДА ЗаказНаПеремещениеЗапасы.Ссылка.СтруктурнаяЕдиницаРезерв В ИЕРАРХИИ (&Подразделение)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ДляИнформации,
		|	ВЫБОР
		|		КОГДА ЗаказыНаПеремещениеОстатки.ЗаказНаПеремещение ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Размещено,
		|	ЗаказНаПеремещениеЗапасы.Ссылка.СтруктурнаяЕдиницаПолучатель КАК СтруктурнаяЕдиницаРезерв
		|ИЗ
		|	Документ.ЗаказНаПеремещение.Запасы КАК ЗаказНаПеремещениеЗапасы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыНаПеремещение.Остатки(
		|				,
		|				ТипДвижения = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженийЗапасов.Отгрузка)
		|					И ЗаказНаПеремещение = &СсылкаНаДокументСписка) КАК ЗаказыНаПеремещениеОстатки
		|		ПО ЗаказНаПеремещениеЗапасы.Ссылка = ЗаказыНаПеремещениеОстатки.ЗаказНаПеремещение
		|			И ЗаказНаПеремещениеЗапасы.Номенклатура = ЗаказыНаПеремещениеОстатки.Номенклатура
		|			И ЗаказНаПеремещениеЗапасы.Характеристика = ЗаказыНаПеремещениеОстатки.Характеристика
		|ГДЕ
		|	ЗаказНаПеремещениеЗапасы.Ссылка = &СсылкаНаДокументСписка
		|	И НЕ ЗаказНаПеремещениеЗапасы.Ссылка.СтруктурнаяЕдиницаРезерв = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДляИнформации";
		
	Иначе
		
	КонецЕсли;
	
	Объект.НоменклатураЗаказа.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеПоНоменклатуреКлиент()
	
	Если Объект.ВидОбработки = "Подготовка" Тогда
		ТекущиеДанные = Элементы.СписокЗаказов.ТекущиеДанные;
	ИначеЕсли Объект.ВидОбработки = "Отгрузка" Тогда
		ТекущиеДанные = Элементы.СписокДокументовОтгрузка.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.СписокДокументовПриемка.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Или Не ТекущиеДанные.Свойство("Ссылка") Тогда
		Возврат 
	КонецЕсли;
	
	СсылкаНаДокумент = ТекущиеДанные.Ссылка;
	
	Если Не ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат 
	КонецЕсли;
	
	ОбновитьПанельТоваров(СсылкаНаДокумент);
	
КонецПроцедуры

&НаСервере
процедура ИзменитьТекстЗапросаСКонтролем(текстЗапроса, строкаПоиска, строкаЗамены) Экспорт

	поз = СтрНайти(текстЗапроса, строкаПоиска);
	если поз <= 0 тогда
		ВызватьИсключение "Не найден искомый текст в запросе.";
	конецЕсли;

	текстЗапроса = СтрЗаменить(текстЗапроса, строкаПоиска, строкаЗамены);
конецПроцедуры // ИзменитьТекстЗапросаСКонтролем

&НаСервере
Функция ДобавитьЭлементУправленияФормы(имя, типЭлемента, родитель, ПутьКДаннымИмяКоманды, вид) Экспорт

	result     = Элементы.Add(имя, типЭлемента, родитель);
	result.Вид = вид;
	if типЭлемента = Тип("КнопкаФормы") then
		result.ИмяКоманды  = ПутьКДаннымИмяКоманды;
	else
		result.ПутьКДанным = ПутьКДаннымИмяКоманды;
	endIf;
	return result;
	
КонецФункции // ДобавитьЭлементУправленияФормы

&НаСервере
Процедура ДобавитьКолонкуНаличияКодовМаркировки(СтрокаОбъекта)
	
	ctrl = ДобавитьЭлементУправленияФормы(
	"СписокНомерКартинкиНаличиеКМ",
	Тип("ПолеФормы"),
	Элементы.ГруппаДопСтатусов,
	"СписокЗаказов.НомерКартинкиНаличиеКМ",
	ВидПоляФормы.ПолеКартинки);
	ctrl.КартинкаЗначений         = БиблиотекаКартинок.МаркируемаяПродукцияТЧ;
	ctrl.КартинкаШапки            = БиблиотекаКартинок.МаркируемаяПродукцияШапка;
	ctrl.ПоложениеЗаголовка       = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ctrl.РастягиватьПоВертикали   = ложь;
	ctrl.РастягиватьПоГоризонтали = ложь;
	ctrl.Заголовок                = "Номер картинки наличия КМ";
	ctrl.Подсказка                = "Наличие кодов маркировки";
	ctrl.Ширина                   = 2;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыСписка()
	
	Если Объект.ВидОбработки = "Подготовка" Тогда
		ТекущийСписокДокументов = СписокЗаказов;
	ИначеЕсли Объект.ВидОбработки = "Отгрузка" Тогда
		ТекущийСписокДокументов = СписокДокументовОтгрузка;
	Иначе
		ТекущийСписокДокументов = СписокДокументовПриемка;
	КонецЕсли;
	
	УстановитьПараметрСписка(ТекущийСписокДокументов, "ДатаОтгрузки", Объект.ДатаЗаказа);
	УстановитьПараметрСписка(ТекущийСписокДокументов, "Подразделение", Объект.Подразделение);
	УстановитьПараметрСписка(ТекущийСписокДокументов, "ПодразделениеИсточник", Объект.ПодразделениеИсточник);
	УстановитьПараметрСписка(ТекущийСписокДокументов, "ВыбранныеСсылки", СписокПомеченныхДокументов);
	УстановитьПараметрСписка(ТекущийСписокДокументов, "ВидОбработки", Объект.ВидОбработки);
	УстановитьПараметрСписка(ТекущийСписокДокументов, "ПодразделениеРЦ", Объект.ПодразделениеРЦ);
	УстановитьПараметрСписка(ТекущийСписокДокументов, "СкладРЦ", Объект.СкладРЦ);
	
	УсловноеОформление.Элементы.Очистить();
	ЭлементОформленияЗеленый = УсловноеОформление.Элементы.Добавить();
    ЭлементОформленияЗеленый.Использование = Истина;
    ЭлементОформленияЗеленый.Оформление.УстановитьЗначениеПараметра("ЦветФона",  WebЦвета.СветлоЗеленый);
    
    ЭлементУсловияЗеленый                = ЭлементОформленияЗеленый.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловияЗеленый.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект.НоменклатураЗаказа.ДляИнформации");
	ЭлементУсловияЗеленый.ПравоеЗначение = Истина; 
	ЭлементУсловияЗеленый.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
    ЭлементУсловияЗеленый.Использование  = Истина;
    
    ОформляемоеПоле      = ЭлементОформленияЗеленый.Поля.Элементы.Добавить();
    ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("НоменклатураЗаказа"); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрСписка(Список, ИмяПараметра, ЗначениеПараметра)
	
	Если Список.Параметры.Элементы.Найти(ИмяПараметра)<>Неопределено Тогда
		Список.Параметры.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДатаЗаказаПриИзмененииНаСервере()
	ОбновитьПараметрыСписка();
КонецПроцедуры

&НаКлиенте
Процедура ДатаЗаказаПриИзменении(Элемент)
	
	СписокПомеченныхДокументов.Очистить();
	ДатаЗаказаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПодразделениеПриИзмененииНаСервере()
	ОбновитьПараметрыСписка();
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	СписокПомеченныхДокументов.Очистить();
	ПодразделениеПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	ОбновитьПараметрыСписка();
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СписокЗаказовПометка" Тогда
        СтандартнаяОбработка = Ложь;
		
		ТекДанные = Элемент.ТекущиеДанные;
		Если ТекДанные.Пометка = 0 Тогда
			Если СписокПомеченныхДокументов.НайтиПоЗначению(ТекДанные.Ссылка) = Неопределено Тогда 
				СписокПомеченныхДокументов.Добавить(ТекДанные.Ссылка) 
			КонецЕсли;
        Иначе
            СписокПомеченныхДокументов.Удалить(СписокПомеченныхДокументов.НайтиПоЗначению(ТекДанные.Ссылка));
		КонецЕсли;
		
		СписокЗаказов.Параметры.УстановитьЗначениеПараметра("ВыбранныеСсылки", СписокПомеченныхДокументов); 
        Элементы.СписокЗаказов.Обновить();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовОтгрузкаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СписокДокументовОтгрузкаПометка" Тогда
        СтандартнаяОбработка = Ложь;
		
		ТекДанные = Элемент.ТекущиеДанные;
		Если ТекДанные.Пометка = 0 Тогда
			Если СписокПомеченныхДокументов.НайтиПоЗначению(ТекДанные.Ссылка) = Неопределено Тогда 
				СписокПомеченныхДокументов.Добавить(ТекДанные.Ссылка) 
			КонецЕсли;
        Иначе
            СписокПомеченныхДокументов.Удалить(СписокПомеченныхДокументов.НайтиПоЗначению(ТекДанные.Ссылка));
		КонецЕсли;
		
		СписокДокументовОтгрузка.Параметры.УстановитьЗначениеПараметра("ВыбранныеСсылки", СписокПомеченныхДокументов); 
        Элементы.СписокДокументовОтгрузка.Обновить();
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура УправлениеВидимостью()
	
	Элементы.ГруппаПодготовка.Видимость = Ложь;
	Элементы.ГруппаПриемка.Видимость = Ложь;
	Элементы.ГруппаОтгрузка.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ВидОбработки) Тогда
		Элементы["Группа" + Объект.ВидОбработки].Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбработкиПриИзменении(Элемент)
	
	СписокПомеченныхДокументов.Очистить();
	
	УправлениеВидимостью();
	
	ОбновитьПараметрыСписка();
	
КонецПроцедуры 

&НаСервере
Процедура СоздатьЗаказыНаПеремещениеНаСервере()
	
	Если Объект.ВидОбработки <> "Подготовка" Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателяЗапасы.Ссылка КАК ЗаказПокупателя,
	|	ЗаказПокупателяЗапасы.ТипНоменклатурыЗапас КАК ТипНоменклатурыЗапас,
	|	ЗаказПокупателяЗапасы.Номенклатура КАК Номенклатура,
	|	ЗаказПокупателяЗапасы.Характеристика КАК Характеристика,
	|	ЗаказПокупателяЗапасы.СерииНоменклатуры КАК СерииНоменклатуры,
	|	ЗаказПокупателяЗапасы.Резерв КАК Резерв,
	|	ЗаказПокупателяЗапасы.РезервОтгрузка КАК РезервОтгрузка,
	|	ЗаказПокупателяЗапасы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЗаказПокупателяЗапасы.Цена КАК Цена,
	|	ЗаказПокупателяЗапасы.Сумма КАК Сумма,
	|	ЗаказПокупателяЗапасы.СтавкаНДС КАК СтавкаНДС,
	|	ЗаказПокупателяЗапасы.СуммаНДС КАК СуммаНДС,
	|	ЗаказПокупателяЗапасы.Всего КАК Всего,
	|	ЗаказПокупателяЗапасы.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ЗаказПокупателяЗапасы.Спецификация КАК Спецификация,
	|	ЗаказПокупателяЗапасы.Содержание КАК Содержание,
	|	ЗаказПокупателяЗапасы.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя.Запасы КАК ЗаказПокупателяЗапасы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РазмещениеЗаказов.Обороты(, , , ЗаказПокупателя = &ЗаказПокупателя) КАК РазмещениеЗаказовОбороты
	|		ПО ЗаказПокупателяЗапасы.Ссылка = РазмещениеЗаказовОбороты.ЗаказПокупателя
	|			И ЗаказПокупателяЗапасы.Номенклатура = РазмещениеЗаказовОбороты.Номенклатура
	|			И ЗаказПокупателяЗапасы.Характеристика = РазмещениеЗаказовОбороты.Характеристика
	|			И РазмещениеЗаказовОбороты.КоличествоПриход > 0
	|ГДЕ
	|	ЗаказПокупателяЗапасы.Ссылка В(&СписокЗаказов) 	
	|	И РазмещениеЗаказовОбороты.ЗаказПокупателя ЕСТЬ NULL
	|	И НЕ ЗаказПокупателяЗапасы.СтруктурнаяЕдиницаРезерв = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|	И НЕ ЗаказПокупателяЗапасы.СтруктурнаяЕдиницаРезерв В ИЕРАРХИИ (&Подразделение)";
	
	Запрос.УстановитьПараметр("СписокЗаказов", СписокПомеченныхДокументов);
	Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() Тогда
		
		ДокЗаказ = Документы.ЗаказНаПеремещение.СоздатьДокумент();
		//Если Док.Проведен Тогда
		//	Возврат;
		//КонецЕсли;
		//ДокЗаказ.Запасы.Очистить();
		//ДокЗаказ.СерииНоменклатуры.Очистить();
		//ДокЗаказ.ДополнительныеРеквизиты.Очистить();
		
		ДокЗаказ.Дата = ТекущаяДатаСеанса();
		ДокЗаказ.Заполнить(Неопределено);
		ДокЗаказ.ДатаПеремещения = ДокЗаказ.Дата + 24*60*60;
		ДокЗаказ.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
		ДокЗаказ.ПоложениеЗаказаПокупателя = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
		ДокЗаказ.Организация = Объект.ПодразделениеИсточник.Организация;
		
		ДокЗаказ.СтруктурнаяЕдиницаРезерв = Объект.ПодразделениеИсточник.ИсточникСписанияНаРасходы;
		ДокЗаказ.СтруктурнаяЕдиницаПолучатель = Объект.Подразделение.ИсточникСписанияНаРасходы;
		
		ДокЗаказ.Автор = Пользователи.ТекущийПользователь();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаТЧ = ДокЗаказ.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
			
		КонецЦикла;
		ДокЗаказ.Комментарий = "#УВО " + ТекущаяДатаСеанса();
		
		ДокЗаказ.Записать();
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ДокЗаказ.Ссылка, ДокЗаказ.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

