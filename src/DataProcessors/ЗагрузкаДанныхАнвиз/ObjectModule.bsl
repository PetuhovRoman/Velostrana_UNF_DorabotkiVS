Процедура ЗагрузитьФайлАнвиз(АдресФайла) Экспорт
	
	
	//ИмяФайла = ПереданныйФайл.Имя;
	// Получение данных из временного хранилища
	Данные = ПолучитьИзВременногоХранилища(АдресФайла);
	// Получение имени временного файла
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");
	// Сохранение данных во временный файл
	Данные.Записать(ИмяВременногоФайла);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПользователиUIDs_ANVIZ.Ссылка КАК Ссылка,
	|	ПользователиUIDs_ANVIZ.МагнитныйКод КАК ИдентификаторANVIZ
	|ИЗ
	|	Справочник.Сотрудники КАК ПользователиUIDs_ANVIZ
	|ГДЕ
	|	ПользователиUIDs_ANVIZ.МагнитныйКод = &ИдентификаторANVIZ";
	
	
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.Прочитать(ИмяВременногоФайла);
	//1 ид машины
	//2-6 строка ид юзера
	//7-10 время
	МассивНеНайденных = Новый Массив;
	
	СписокДат = Новый СписокЗначений;
	СписокДат.ТипЗначения = Новый ОписаниеТипов("Дата");
	
	Для НомСТр=1 По ТекстовыйФайл.КоличествоСтрок() Цикл
		ПараметрыВСтроке = СтрРазделить(ТекстовыйФайл.ПолучитьСтроку(НомСТр),"	");
		ид = ПараметрыВСтроке.Получить(0);
		Сотрудник = ПараметрыВСтроке.Получить(2);
		Подразделение = ПараметрыВСтроке.Получить(8); 
		
		СотрудникСсылка = Справочники.Сотрудники.НайтиПоНаименованию(Сотрудник, Истина);
		
		ДатаВремя = ПараметрыВСтроке.Получить(3);
		ДатаВМассив = СтрРазделить(ДатаВремя," ");
		ДатаВремя = ПрочитатьДатуJSON(ДатаВМассив.Получить(0)+"T"+ДатаВМассив.Получить(1)+".000Z", ФорматДатыJSON.ISO);
		
		Если ЗначениеЗаполнено(ид) Тогда 
			Запрос.УстановитьПараметр("ИдентификаторANVIZ",Формат(ид, "ЧГ=0"));
			ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
			
			Если ВыборкаЗапроса.Следующий() Тогда 
				Менеджер = РегистрыСведений.ДанныеАнвиз.СоздатьМенеджерЗаписи();
				Менеджер.Сотрудник = ВыборкаЗапроса.Ссылка;
				Менеджер.День = ДатаВремя-10800;//'20000102' + ;
				Менеджер.ИДСотрудника = 0+ид;
				Менеджер.ПредставлениеСотрудника = Сотрудник;
				Менеджер.ПредставлениеПодразделения = Подразделение; 
				Менеджер.Записать();
				
				СписокДат.Добавить(ДатаВремя-10800);
			ИначеЕсли ЗначениеЗаполнено(СотрудникСсылка) Тогда
				СотрудникОбъект = СотрудникСсылка.ПолучитьОбъект();
				СотрудникОбъект.МагнитныйКод = Формат(ид, "ЧГ=0");
				СотрудникОбъект.Записать();
				
				Менеджер = РегистрыСведений.ДанныеАнвиз.СоздатьМенеджерЗаписи();
				Менеджер.Сотрудник = СотрудникСсылка;
				Менеджер.День = ДатаВремя-10800;//'20000102' + ;
				Менеджер.ИДСотрудника = 0+ид;
				Менеджер.ПредставлениеСотрудника = Сотрудник; 
				Менеджер.ПредставлениеПодразделения = Подразделение; 
				Менеджер.Записать(); 
				
				СписокДат.Добавить(ДатаВремя-10800);
			Иначе
				СтрокаСообщения = "Не найден сотрудник " + Сотрудник + " с ИД " + ид;
				
				Если МассивНеНайденных.Найти(СтрокаСообщения) = Неопределено Тогда
					ЗаписьЖурналаРегистрации("ЗагрузитьФайлАнвиз", УровеньЖурналаРегистрации.Ошибка,,,СтрокаСообщения);
					МассивНеНайденных.Добавить(СтрокаСообщения);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		
		УдалитьФайлы(ИмяВременногоФайла);
		
	Исключение
	КонецПопытки;
	СписокДат.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	
	ОбменДаннымиАнвиз.СформироватьДокументыУчета(НачалоДня(СписокДат.Получить(0).Значение), КонецДня(СписокДат.Получить(СписокДат.Количество()-1).Значение));
	
КонецПроцедуры

Функция ПолучитьДокументУчета(День)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕжедневныйОтчет.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЕжедневныйОтчет КАК ЕжедневныйОтчет
	|ГДЕ
	|	ЕжедневныйОтчет.ДатаОтчета = &ДатаОтчета
	|	И Не ЕжедневныйОтчет.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДатаОтчета", День);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Возврат Документы.ЕжедневныйОтчет.СоздатьДокумент();

КонецФункции

Процедура РассчитатьПродолжительностьДня(ТекСтрока)
	
	Разность = 0.00;
	
	Если ЗначениеЗаполнено(ТекСтрока.ОкончаниеРаботы)
		И ЗначениеЗаполнено(ТекСтрока.НачалоРаботы) Тогда
		
		Разность = Разность + (ТекСтрока.ОкончаниеРаботы - ТекСтрока.НачалоРаботы);
		
		Если Разность > 0.00 Тогда
			
			Продолжительность = ЗарплатаИПерсоналКлиентСервер.ПреобразоватьСекундыВДату(Разность);
			
		ИначеЕсли Разность < 0.00 Тогда
			
			Продолжительность = Дата(1, 1, 1);
			
		Иначе
			
			ТекСтрока.ПродолжительностьДня = Дата("00010101");
			
		КонецЕсли;
		
		Если Продолжительность <> Неопределено Тогда
			
			ТекСтрока.ПродолжительностьДня = Продолжительность;
			
		Иначе
			
			ТекСтрока.ПродолжительностьДня = Дата("00010101");
			
		КонецЕсли;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекСтрока.ОкончаниеРаботы)
		И ЗначениеЗаполнено(ТекСтрока.НачалоРаботы) Тогда
		
		ОтметкаНачалаРаботы = ТекСтрока.НачалоРаботы - Дата(1, 1, 1);
		ОтметкаКонцаСуток = 86400;
		
		Разность = ОтметкаКонцаСуток - ОтметкаНачалаРаботы;
		Продолжительность = ЗарплатаИПерсоналКлиентСервер.ПреобразоватьСекундыВДату(Разность);
		ТекСтрока.ПродолжительностьДня = Продолжительность;
		
	КонецЕсли;
	
	
КонецПроцедуры
