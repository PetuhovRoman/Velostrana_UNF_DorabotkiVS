&НаКлиенте
Процедура ПоискФайловПоFTP(Команда) Экспорт
	
	// Функция подключения определена выше.
	
	ПомещаемыеФайлы = Новый Массив;
	ПомещаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(Объект.ИмяФайла));
	
	Если ПомещаемыеФайлы.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьФайлыЗавершение", ЭтотОбъект);
		// Начало помещение файла из файловой системы во временное хранилище
		НачатьПомещениеФайлов(ОписаниеОповещения, ПомещаемыеФайлы, , Ложь, УникальныйИдентификатор);;
	КонецЕсли;
	
КонецПроцедуры



&НаКлиенте
Процедура ЗагрузитьФайлыЗавершение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныеФайлы <> Неопределено И ПомещенныеФайлы.Количество() > 0 Тогда
		Для каждого ПереданныйФайл Из ПомещенныеФайлы Цикл
			АдресФайла    = ПереданныйФайл.Хранение;
			
			Если АдресФайла = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ВыполнитьЗагрузкуНаСервере(АдресФайла);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры



&НаСервере
Процедура ВыполнитьЗагрузкуНаСервере(АдресФайла)

		//ИмяФайла = ПереданныйФайл.Имя;
		// Получение данных из временного хранилища
		Данные = ПолучитьИзВременногоХранилища(АдресФайла);
		// Получение имени временного файла
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
		// Сохранение данных во временный файл
		Данные.Записать(ИмяВременногоФайла);
		
		ЧтениеXML = Новый ЧтениеXML;
		Попытка
			ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
		Исключение
			ЧтениеXML.Закрыть();
			Сообщить("Документ XML поврежден");
		КонецПопытки;
		
		ПостроительДом = Новый ПостроительDOM();
		Попытка
			мДокументДОМ = ПостроительДом.Прочитать(ЧтениеXML);
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
		НачатьТранзакцию();
		СтруткураДопТаблиц = ПолучитьДопТаблицы();
		Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("Накладная") Цикл
			ЗагрузитьНакладную(ЭлементДОМ, СтруткураДопТаблиц);
		КонецЦикла;
	
		ЗаписатьТаблицуЦен(СтруткураДопТаблиц.ТаблицаЦен);
		
		ЗафиксироватьТранзакцию();
		Попытка
			
			УдалитьФайлы(ИмяВременногоФайла);
			
		Исключение
		КонецПопытки;
		
	// Обработка файла…
	
	// Хорошим тоном будет удалить временный файл
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДопТаблицы()
	
	СтруктураДопТаблиц = Новый Структура("ТаблицаЦен, ТаблицаОстатков");
	
	ТаблицаЦен = Новый ТаблицаЗначений;
	ТаблицаЦен.Колонки.Добавить("Период", 				Новый ОписаниеТипов("Дата"));
	ТаблицаЦен.Колонки.Добавить("Номенклатура", 		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЦен.Колонки.Добавить("ЕдиницаИзмерения", 	Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаЦен.Колонки.Добавить("ВидЦены",             	Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	ТаблицаЦен.Колонки.Добавить("Цена",                	Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТаблицаЦен.Колонки.Добавить("Валюта",              	Новый ОписаниеТипов("СправочникСсылка.Валюты")); 
	ТаблицаЦен.Колонки.Добавить("ВалютаСтарая",         Новый ОписаниеТипов("СправочникСсылка.Валюты")); 

	ТаблицаОстатков = Новый ТаблицаЗначений;
	ТаблицаОстатков.Колонки.Добавить("Период", 				Новый ОписаниеТипов("Дата"));
	ТаблицаОстатков.Колонки.Добавить("Склад", 				Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	ТаблицаОстатков.Колонки.Добавить("Номенклатура", 		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОстатков.Колонки.Добавить("Характеристика",      Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаОстатков.Колонки.Добавить("Остаток",             Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	
	СтруктураДопТаблиц.Вставить("ТаблицаЦен", ТаблицаЦен);
	СтруктураДопТаблиц.Вставить("ТаблицаОстатков", ТаблицаОстатков);
	
	Возврат СтруктураДопТаблиц;
	
КонецФункции

