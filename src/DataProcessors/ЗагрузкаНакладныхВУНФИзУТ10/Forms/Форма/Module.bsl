	ТекРГ = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.РодительГруппы2, Истина);
	Если ЗначениеЗаполнено(ТекРГ) Тогда
		Возврат ТекРГ;
	КонецЕсли;
	
	СпрНГр = Справочники.Номенклатура.СоздатьГруппу();
	СпрНГр.Наименование = СокрЛП(СтрокаТЧ.РодительГруппы2);
