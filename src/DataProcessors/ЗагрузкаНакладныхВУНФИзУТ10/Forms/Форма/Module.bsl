&НаСервере
Функция ПолучитьКонтрагента(СтруктураРеквизитов, Док)
	//Если Не ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровИКонтрагентов") Тогда
	//	Возврат Справочники.Контрагенты.ПустаяСсылка();
	//КонецЕсли;
	
	Если Булево(СтруктураРеквизитов.ТиповойПокупатель) Тогда
		Возврат Справочники.Контрагенты.НайтиПоНаименованию("Покупатель (ВелоСтрана.ру)", Истина);
	КонецЕсли;
	
	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) Тогда
		НовыйGUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.ИД);
		Контрагент = Справочники.Контрагенты.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Контрагент) Тогда
		Возврат Контрагент;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	0 КАК Приоритет,
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	1,
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И Контрагенты.ИНН = &ИНН
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	2,
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	3,
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("Наименование", СтруктураРеквизитов.Наименование);
	Запрос.УстановитьПараметр("ИНН", ?(ПустаяСтрока(СтруктураРеквизитов.ИНН), "?------?", СтруктураРеквизитов.ИНН));
	Запрос.УстановитьПараметр("КПП", СтруктураРеквизитов.КПП);
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	
	СпрН = Справочники.Контрагенты.СоздатьЭлемент();
	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) Тогда
		СпрН.УстановитьСсылкуНового(Контрагент);
	КонецЕсли;
	СпрН.Покупатель = Истина;
	Если СтруктураРеквизитов.Тип = "Физ. лицо" Тогда
		СпрН.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
		Если ЗначениеЗаполнено(СтруктураРеквизитов.ИНН) Тогда
			СпрН.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель;
			СпрН.ВестиРасчетыПоДоговорам = Истина;
			СпрН.ВестиРасчетыПоДокументам = Истина;
			СпрН.ВестиРасчетыПоЗаказам = Истина;
		Иначе
			СпрН.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо;
			СпрН.ВестиРасчетыПоДоговорам = Ложь;
			СпрН.ВестиРасчетыПоДокументам = Истина;
			СпрН.ВестиРасчетыПоЗаказам = Истина;
		КонецЕсли;
	Иначе
		СпрН.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
		СпрН.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо;
		СпрН.ВестиРасчетыПоДоговорам = Истина;
		СпрН.ВестиРасчетыПоДокументам = Истина;
		СпрН.ВестиРасчетыПоЗаказам = Истина;
	КонецЕсли;
	СпрН.Наименование = СтруктураРеквизитов.Наименование;
	СпрН.НаименованиеПолное = СтруктураРеквизитов.Наименование;
	СпрН.ИНН = СтруктураРеквизитов.ИНН;
	СпрН.КПП = СтруктураРеквизитов.КПП;
	
	СпрН.СчетУчетаАвансовПокупателя = ПланыСчетов.Управленческий.РасчетыПоАвансамПолученным;
	СпрН.СчетУчетаРасчетовСПокупателем = ПланыСчетов.Управленческий.РасчетыСПокупателями;
	СпрН.СчетУчетаАвансовПоставщику = ПланыСчетов.Управленческий.РасчетыПоАвансамВыданным;
	СпрН.СчетУчетаРасчетовСПоставщиком = ПланыСчетов.Управленческий.РасчетыСПоставщиками;
	
	СпрН.СпособЗачетаПредоплатыПоУмолчанию = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто;
	СпрН.СпособРазнесенияОплатыПоУмолчанию = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто;

	Если ЗначениеЗаполнено(СтруктураРеквизитов.Телефон) Тогда
		КИ = СпрН.КонтактнаяИнформация.Добавить();
		КИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		КИ.Представление = СтруктураРеквизитов.Телефон;
		КИ.НомерТелефона = СтруктураРеквизитов.Телефон;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРеквизитов.Почта) Тогда
		КИ = СпрН.КонтактнаяИнформация.Добавить();
		КИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
		//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
		КИ.Представление = СтруктураРеквизитов.Почта;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРеквизитов.ЮрАдрес) Тогда
		КИ = СпрН.КонтактнаяИнформация.Добавить();
		КИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		КИ.Представление = СтруктураРеквизитов.ЮрАдрес;
		КИ.Страна = "Россия";
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураРеквизитов.Адрес) Тогда
		КИ = СпрН.КонтактнаяИнформация.Добавить();
		КИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		КИ.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
		//КИ.ВидДляСписка = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
		КИ.Представление = СтруктураРеквизитов.Адрес;
		КИ.Страна = "Россия";
	КонецЕсли;
	
	СпрН.Записать();
	
	Возврат СпрН.Ссылка;
	
	
