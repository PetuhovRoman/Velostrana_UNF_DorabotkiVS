&НаСервере
Функция ПолучитьСтруктуруРеквизитовНоменклатуры(ЭлементДОМ)
	
	Если ЭлементДОМ.ПолучитьЭлементыПоИмени("ГУИД").Количество() = 0 Тогда //нет номенклатуры в строке
		Возврат Новый Структура;
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить("Тип", 				 ЭлементДОМ.ПолучитьЭлементыПоИмени("Тип").Элемент(0).ТекстовоеСодержимое); //ЭлементДОМ.РодительскийУзел.ПолучитьЭлементыПоИмени("Номер").Элемент(0).ТекстовоеСодержимое
		СтруктураРеквизитов.Вставить("НоменклатурнаяГруппа", ЭлементДОМ.ПолучитьЭлементыПоИмени("НоменклатурнаяГруппа").Элемент(0).ТекстовоеСодержимое);
		
		//UIDТовар = ТИС.XMLСтрока(Выборка.Номенклатура);//СтрокаУТ.ТоварУТ.УникальныйИдентификатор();
		СтруктураРеквизитов.Вставить("ГУИД", 					 ЭлементДОМ.ПолучитьЭлементыПоИмени("ГУИД").Элемент(0).ТекстовоеСодержимое);
		СтруктураРеквизитов.Вставить("Артикул", 				 ЭлементДОМ.ПолучитьЭлементыПоИмени("Артикул").Элемент(0).ТекстовоеСодержимое);
		СтруктураРеквизитов.Вставить("НаименованиеНоменклатуры", ЭлементДОМ.ПолучитьЭлементыПоИмени("НаименованиеНоменклатуры").Элемент(0).ТекстовоеСодержимое);		
		СтруктураРеквизитов.Вставить("НаименованиеПолное", 		 ЭлементДОМ.ПолучитьЭлементыПоИмени("НаименованиеПолное").Элемент(0).ТекстовоеСодержимое);
		СтруктураРеквизитов.Вставить("Группа", 					 ЭлементДОМ.ПолучитьЭлементыПоИмени("Группа").Элемент(0).ТекстовоеСодержимое);
		СтруктураРеквизитов.Вставить("ГУИДГруппы", 				 ЭлементДОМ.ПолучитьЭлементыПоИмени("ГУИДГруппы").Элемент(0).ТекстовоеСодержимое);
		СтруктураРеквизитов.Вставить("РодительГруппы", 			 ЭлементДОМ.ПолучитьЭлементыПоИмени("РодительГруппы").Элемент(0).ТекстовоеСодержимое);
