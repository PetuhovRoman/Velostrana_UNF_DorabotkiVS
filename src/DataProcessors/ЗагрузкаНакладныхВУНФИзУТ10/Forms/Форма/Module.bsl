	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) И НЕ СтруктураРеквизитов.ИД = "00000000-0000-0000-0000-000000000000" Тогда
		НовыйGUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.ИД);
		Карта = Справочники.ДисконтныеКарты.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Карта) Тогда
		Возврат Карта;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КартыЛояльности.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДисконтныеКарты КАК КартыЛояльности
	|ГДЕ
	|	(КартыЛояльности.Наименование = &Наименование
	|			ИЛИ КартыЛояльности.КодКартыШтрихкод = &Код)";
	Запрос.УстановитьПараметр("Наименование", СтруктураРеквизитов.Наименование);
	Запрос.УстановитьПараметр("Код", СтруктураРеквизитов.Код);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	СпрН = Справочники.ДисконтныеКарты.СоздатьЭлемент();
	СпрН.Заполнить(Неопределено);
	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) Тогда
		СпрН.УстановитьСсылкуНового(Карта);
	КонецЕсли;
	СпрН.Наименование = СтруктураРеквизитов.Наименование;
	СпрН.Владелец = Справочники.ВидыДисконтныхКарт.НайтиПоНаименованию("Велострана");
	СпрН.ВладелецКарты = Док.Контрагент;
	//СпрН.Соглашение = Док.Соглашение;
	СпрН.КодКартыШтрихкод = СтруктураРеквизитов.Код; 
	СпрН.Записать();
	
	Возврат СпрН.Ссылка;
	
