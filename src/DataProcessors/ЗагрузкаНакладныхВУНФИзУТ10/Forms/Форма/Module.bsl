Функция ПолучитьОрганизацию(СтруктураРеквизитов)
	
	Если Не ПустаяСтрока(СтруктураРеквизитов.ИД) Тогда
		НовыйGUID = Новый УникальныйИдентификатор(СтруктураРеквизитов.ИД);
		Организация = Справочники.Организации.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Организация) Тогда
		Возврат Организация;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Приоритет,
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Наименование = &Наименование
	|	И Организации.ИНН = &ИНН
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	2,
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Наименование = &Наименование
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	3,
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("Наименование", СтруктураРеквизитов.Наименование);
	Запрос.УстановитьПараметр("ИНН", СтруктураРеквизитов.ИНН);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Организации.ПустаяСсылка();
	
КонецФункции

