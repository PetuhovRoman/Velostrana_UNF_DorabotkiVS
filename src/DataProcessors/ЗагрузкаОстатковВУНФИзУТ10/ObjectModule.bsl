
Функция СведенияОВнешнейОбработке() Экспорт
    
    ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке();
    
    ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
    ПараметрыРегистрации.Версия = "1.0";
    
    НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
    НоваяКоманда.Представление = "Загрузка заказов КФЦ";
    НоваяКоманда.Идентификатор = "ЗагрузкаЗаказовКФЦ";
    НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
    НоваяКоманда.ПоказыватьОповещение = Ложь;
    
    Возврат ПараметрыРегистрации;
    
КонецФункции

&НаСервере
Процедура ВыполнитьЗагрузкуНаСервере(АдресФайла) Экспорт

		//ИмяФайла = ПереданныйФайл.Имя;
		// Получение данных из временного хранилища
		Данные = ПолучитьИзВременногоХранилища(АдресФайла);
		// Получение имени временного файла
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
		// Сохранение данных во временный файл
		Данные.Записать(ИмяВременногоФайла);
		
		ЧтениеXML = Новый ЧтениеXML;
		Попытка
			ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
		Исключение
			ЧтениеXML.Закрыть();
			Сообщить("Документ XML поврежден");
		КонецПопытки;
		
		ПостроительДом = Новый ПостроительDOM();
		Попытка
			мДокументДОМ = ПостроительДом.Прочитать(ЧтениеXML);
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
		//НачатьТранзакцию();
		СтруткураДопТаблиц = ПолучитьДопТаблицы();
		Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("Организация") Цикл
			ЗагрузитьОстаток(ЭлементДОМ, СтруткураДопТаблиц);
		КонецЦикла;
	
		//ЗаписатьТаблицуЦен(СтруткураДопТаблиц.ТаблицаЦен);
		
		//ЗафиксироватьТранзакцию();
		Попытка
			
			УдалитьФайлы(ИмяВременногоФайла);
			
		Исключение
		КонецПопытки;
		
	// Обработка файла…
	
	// Хорошим тоном будет удалить временный файл
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДопТаблицы()
	
	СтруктураДопТаблиц = Новый Структура("ТаблицаЦен");
	
	ТаблицаЦен = Новый ТаблицаЗначений;
	ТаблицаЦен.Колонки.Добавить("Период", 				Новый ОписаниеТипов("Дата"));
	ТаблицаЦен.Колонки.Добавить("Номенклатура", 		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаЦен.Колонки.Добавить("ЕдиницаИзмерения", 	Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаЦен.Колонки.Добавить("ВидЦены",             	Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	ТаблицаЦен.Колонки.Добавить("Цена",                	Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТаблицаЦен.Колонки.Добавить("Валюта",              	Новый ОписаниеТипов("СправочникСсылка.Валюты")); 
	ТаблицаЦен.Колонки.Добавить("ВалютаСтарая",         Новый ОписаниеТипов("СправочникСсылка.Валюты")); 

	//ТаблицаОстатков = Новый ТаблицаЗначений;
	//ТаблицаОстатков.Колонки.Добавить("Период", 				Новый ОписаниеТипов("Дата"));
	//ТаблицаОстатков.Колонки.Добавить("Склад", 				Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	//ТаблицаОстатков.Колонки.Добавить("Номенклатура", 		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	//ТаблицаОстатков.Колонки.Добавить("Характеристика",      Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	//ТаблицаОстатков.Колонки.Добавить("Остаток",             Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	
	СтруктураДопТаблиц.Вставить("ТаблицаЦен", ТаблицаЦен);
	//СтруктураДопТаблиц.Вставить("ТаблицаОстатков", ТаблицаОстатков);
	
	Возврат СтруктураДопТаблиц;
	
КонецФункции


&НаСервере
Процедура ЗаписатьТаблицуЦен(ТаблицаЦен)
	ВидЦены = Справочники.ВидыЦен.Оптовая;
	ТаблицаЦен.ЗаполнитьЗначения(ВидЦены.ВалютаЦены, "Валюта");
	ТаблицаЦен.ЗаполнитьЗначения(ВидЦены.ВалютаЦены, "ВалютаСтарая");
	ТаблицаЦен.ЗаполнитьЗначения(Справочники.КлассификаторЕдиницИзмерения.шт, "ЕдиницаИзмерения");
	//ТаблицаЦен.Сортировать("Период");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЦен.Период КАК Период,
	|	ТаблицаЦен.Номенклатура КАК Номенклатура,
	|	ТаблицаЦен.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаЦен.ВидЦены КАК ВидЦены,
	|	ТаблицаЦен.Цена КАК Цена,
	|	ТаблицаЦен.Валюта КАК Валюта,
	|	ТаблицаЦен.ВалютаСтарая КАК ВалютаСтарая
	|ПОМЕСТИТЬ ТаблицаЦен
	|ИЗ
	|	&ТаблицаЦен КАК ТаблицаЦен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЦен.Период КАК Период,
	|	ТаблицаЦен.Номенклатура КАК Номенклатура,
	|	ТаблицаЦен.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТаблицаЦен.ВидЦены КАК ВидЦены,
	|	ТаблицаЦен.Цена КАК Цена,
	|	ТаблицаЦен.Валюта КАК Валюта,
	|	ТаблицаЦен.ВалютаСтарая КАК ВалютаСтарая
	|ИЗ
	|	ТаблицаЦен КАК ТаблицаЦен
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	|		ПО ТаблицаЦен.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|			И ТаблицаЦен.ВидЦены = ЦеныНоменклатурыСрезПоследних.ВидЦен
	|ГДЕ
	|	НЕ ТаблицаЦен.Цена = ЦеныНоменклатурыСрезПоследних.Цена
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	Запрос.УстановитьПараметр("ТаблицаЦен", ТаблицаЦен);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		//ТаблицаЦен.ЗаполнитьЗначения(ВидЦены, "ВидЦены");
		
		ДатаДок = НачалоДня(ТаблицаЗапроса[0].Период);
		ДокЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
		ДокЦен.Дата = ДатаДок;
		ДокЦен.ПоказыватьДействующуюЦену = Истина;
		ДокЦен.ПоказыватьНовуюЦену = Истина;
		//ДокЦен.УстанавливатьХарактеристикамБезЦен = Истина;
		
		ДокЦен.Запасы.Загрузить(ТаблицаЗапроса);
	    ДокЦен.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	
КонецПроцедуры


