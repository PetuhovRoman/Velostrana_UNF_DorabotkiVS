	Договор = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
	ДокОбъект, ДокОбъект.Контрагент, ДокОбъект.Организация, ДокОбъект.ВидОперации);
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовыйДоговор.Заполнить(Неопределено);
