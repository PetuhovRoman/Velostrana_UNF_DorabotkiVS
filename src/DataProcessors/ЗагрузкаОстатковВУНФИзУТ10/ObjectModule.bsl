Функция ПолучитьНоменклатуру(Знач СтрокаТЧ)
	//СтрокаТЧ = ДанныеЗагрузки[0];
	
	Если ПустаяСтрока(СтрокаТЧ.ГУИД) И СтрокаТЧ.Свойство("НаименованиеНоменклатуры") Тогда
		Товар = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.НаименованиеНоменклатуры, Истина);
	ИначеЕсли Не ПустаяСтрока(СтрокаТЧ.ГУИД) Тогда 
		НовыйGUID = Новый УникальныйИдентификатор(СтрокаТЧ.ГУИД);
		Товар = Справочники.Номенклатура.ПолучитьСсылку(НовыйGUID);
	Иначе
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Товар) Тогда
		Возврат Товар;
	КонецЕсли;
	
	Если Не СтрокаТЧ.Свойство("НаименованиеНоменклатуры") Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
		СпрН = Справочники.Номенклатура.СоздатьЭлемент();
		СпрН.УстановитьСсылкуНового(Товар);
		СпрН.Артикул = СтрокаТЧ.Артикул;
		СпрН.Наименование = СтрокаТЧ.НаименованиеНоменклатуры;
		СпрН.НаименованиеПолное = СтрокаТЧ.НаименованиеПолное;
		Если СтрокаТЧ.ТипНоменклатуры = "Услуга" Тогда
			СпрН.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
			СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Услуга;
		Иначе
			СпрН.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
			
			СпрН.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
			СпрН.МетодОценки = Перечисления.МетодОценкиЗапасов.FIFO;
			СпрН.СчетУчетаЗапасов = ПланыСчетов.Управленческий.ТоварыПродукция;
			
			СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
			
		КонецЕсли;
		СпрН.КатегорияНоменклатуры = ПолучитьВидНоменклатуры(СтрокаТЧ);//Справочники.ВидыНоменклатуры.НайтиПоНаименованию(СтрокаТЧ.ВидНоменклатуры));
		СпрН.Родитель = ПолучитьРодителя(СтрокаТЧ);
		СпрН.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.шт;
		Если ЗначениеЗаполнено(СтрокаТЧ.Страна) Тогда
			СпрН.СтранаПроисхождения = Справочники.СтраныМира.НайтиПоНаименованию(СтрокаТЧ.Страна);
		Иначе
			СпрН.СтранаПроисхождения = "";
		КонецЕсли;
		СпрН.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ВидСтавки(Справочники.СтавкиНДС.НайтиПоНаименованию(СтрокаТЧ.СтавкаНДС));
		СпрН.ИспользоватьХарактеристики = Булево(СтрокаТЧ.УчетПоХарактеристикам);
		СпрН.ВидМаркировки = Перечисления.ВидыМаркировки.НеМаркируется;
		Если ЗначениеЗаполнено(СтрокаТЧ.ВидПродукцииИС) Тогда
			СпрН.ВидПродукцииИС = Перечисления.ВидыПродукцииИС.Велосипеды;
			СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ;
		КонецЕсли;
		
		СпрН.СчетУчетаЗатрат = ПланыСчетов.Управленческий.КоммерческиеРасходы;
		СпрН.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
		
		Если ЗначениеЗаполнено(СтрокаТЧ.РазмерКолес) Тогда
			ДопСвойство = СпрН.ДополнительныеРеквизиты.Добавить();
			ДопСвойство.Свойство = ПолучитьСвойствоНоменклатуры("Колеса", СпрН.КатегорияНоменклатуры);
		    ДопСвойство.Значение = ПолучитьЗначениеРеквизита(ДопСвойство.Свойство, СтрокаТЧ.РазмерКолес);
		КонецЕсли;
		
		СпрН.Записать();
		
		Товар = СпрН.Ссылка;
		
	
	Возврат Товар;
	
КонецФункции

Функция ПолучитьХарактеристику(Знач СтрокаТЧ, Товар)
	//СтрокаТЧ = ДанныеЗагрузки[0];
	Если Не Товар.ИспользоватьХарактеристики Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Если ПустаяСтрока(СтрокаТЧ.ГУИДХарактеристики) Или СтрокаТЧ.ГУИДХарактеристики = "00000000-0000-0000-0000-000000000000" Тогда
		Если СтрокаТЧ.Свойство("ХарактеристикаНаименование") И ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикаНаименование) Тогда
			Характеристика = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(СтрокаТЧ.ХарактеристикаНаименование, Истина, , Товар); 
		Иначе
			Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		КонецЕсли;
	Иначе
		НовыйGUID = Новый УникальныйИдентификатор(СтрокаТЧ.ГУИДХарактеристики);
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Характеристика) Тогда
		Возврат Характеристика;
	КонецЕсли;
	Если Не СтрокаТЧ.Свойство("ХарактеристикаНаименование") Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	СпрХ = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		СпрХ.УстановитьСсылкуНового(Характеристика);
		СпрХ.Владелец = Товар;
		СпрХ.Наименование = СтрокаТЧ.ХарактеристикаНаименование;
		СпрХ.НаименованиеДляПечати = СтрокаТЧ.ХарактеристикаНаименование;
		СпрХ.Артикул = ПолучитьАртикулХарактеристики(Товар, СтрокаТЧ.АртикулХарактеристики);
		
		Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаЦвет)) Тогда
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("Цвет", Товар.КатегорияНоменклатуры);
			СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаЦвет));
		КонецЕсли;
		Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаРостовка)) Тогда
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("Ростовка", Товар.КатегорияНоменклатуры);
			СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаРостовка));
		КонецЕсли;
		//Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаРост)) Тогда
		//	СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
		//	СтрокаДР.Свойство = ПолучитьСвойство("Рост", Товар.КатегорияНоменклатуры);
		//	СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаРост));
		//КонецЕсли;
		Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаРама)) Тогда
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("Рама", Товар.КатегорияНоменклатуры);
			СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаРама));
		КонецЕсли; 
		Если ЗначениеЗаполнено(СокрЛП(СтрокаТЧ.ХарактеристикаРостОт)) Тогда
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("РостОт", Товар.КатегорияНоменклатуры);
			СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаРостОт));
			СтрокаДР = СпрХ.ДополнительныеРеквизиты.Добавить();
			СтрокаДР.Свойство = ПолучитьСвойствоХарактеристики("РостДо", Товар.КатегорияНоменклатуры);
			СтрокаДР.Значение = ПолучитьЗначениеРеквизита(СтрокаДР.Свойство, СокрЛП(СтрокаТЧ.ХарактеристикаРостДо));
		КонецЕсли; 
		СпрХ.Записать();
		
		Характеристика = СпрХ.Ссылка;
		
	
	Возврат Характеристика;
	
КонецФункции

Функция ПолучитьСвойствоХарактеристики(ИмяСвойства, КатегорияНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство КАК Свойство
	|ИЗ
	|	Справочник.КатегорииНоменклатуры КАК КатегорииНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты
	|		ПО КатегорииНоменклатуры.НаборСвойствХарактеристики = НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка
	|ГДЕ
	|	КатегорииНоменклатуры.Ссылка = &КатегорияНоменклатуры
	|	И НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.Наименование = &Свойство";
	Запрос.УстановитьПараметр("Свойство", ИмяСвойства);
	Запрос.УстановитьПараметр("КатегорияНоменклатуры", КатегорияНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Свойство;
	КонецЕсли;
	
	//ТекСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Заголовок", ИмяСвойства);
	
	Если ЗначениеЗаполнено(КатегорияНоменклатуры.НаборСвойствХарактеристики) Тогда
		ТекНабор = КатегорияНоменклатуры.НаборСвойствХарактеристики;
	Иначе
		ТекНабор = Справочники.НаборыДополнительныхРеквизитовИСведений.СоздатьГруппу();
		ТекНабор.Наименование = СокрЛП(КатегорияНоменклатуры);
		ТекНабор.Записать();
		
		ОбъектВН = КатегорияНоменклатуры.ПолучитьОбъект();
		ОбъектВН.ИспользоватьХарактеристики = Истина;
		ОбъектВН.НаборСвойствХарактеристики = ТекНабор.Ссылка;
		ОбъектВН.Записать();
	КонецЕсли;
	
	ТекСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
	ТекСвойство.Виден = Истина; 
	ТекСвойство.Доступен = Истина; 
	ТекСвойство.НаборСвойств = ТекНабор.Ссылка;
	ТекСвойство.Наименование = ИмяСвойства;
	ТекСвойство.Заголовок = ИмяСвойства;
	ТекСвойство.ВидСвойства = Перечисления.ВидыСвойств.ДополнительныеРеквизиты;
	ТекСвойство.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов");
	ТекСвойство.Записать();
	
	НаборОбъект = ТекНабор.Ссылка.ПолучитьОбъект();
	НоваяСтрокаСвойств = НаборОбъект.ДополнительныеРеквизиты.Добавить();
	НоваяСтрокаСвойств.Свойство = ТекСвойство.Ссылка;
	НаборОбъект.Записать();

	Возврат ТекСвойство.Ссылка;
	
КонецФункции

