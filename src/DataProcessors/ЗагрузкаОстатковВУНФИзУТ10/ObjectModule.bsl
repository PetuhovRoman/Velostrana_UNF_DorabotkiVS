&НаСервере
Процедура ЗагрузитьОстаток(мДокументДОМ, СтруктураДопТаблиц)
	
	//НоваяСтрокаДок = СписокДокументовЗаказы.Добавить();
	
	Дата = ПреобразоватьДату(мДокументДОМ.ПолучитьЭлементыПоИмени("Дата").Элемент(0).ТекстовоеСодержимое);
		
	//НоваяСтрокаДок.АдресДоставки = ПолучитьАдресДоставки(мДокументДОМ.ПолучитьЭлементыПоИмени("DELIVERYPLACE").Элемент(0).ТекстовоеСодержимое);
	//ГЛНТочкиДоставки = мДокументДОМ.ПолучитьЭлементыПоИмени("DELIVERYPLACE").Элемент(0).ТекстовоеСодержимое;
	//НоваяСтрокаДок.АдресСтрокой = мДокументДОМ.ПолучитьЭлементыПоИмени("ConsigneeAddr").Элемент(0).ТекстовоеСодержимое;
	//НоваяСтрокаДок.ДокИД = ИмяФайла;//мДокументДОМ.ПолучитьЭлементыПоИмени("DocID").Элемент(0).ТекстовоеСодержимое;
	СтруктураОрганизация = Новый Структура;
	СтруктураОрганизация.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияГУИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Тип", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияТип").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияНаименование").Элемент(0).ТекстовоеСодержимое);
	СтруктураОрганизация.Вставить("ИНН", мДокументДОМ.ПолучитьЭлементыПоИмени("ОрганизацияИНН").Элемент(0).ТекстовоеСодержимое);
	Организация = ПолучитьОрганизацию(СтруктураОрганизация);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураСклад = Новый Структура;
	СтруктураСклад.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладГУИД").Элемент(0).ТекстовоеСодержимое);
	СтруктураСклад.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("СкладНаименование").Элемент(0).ТекстовоеСодержимое);
	Склад = ПолучитьСклад(СтруктураСклад);
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	//СтруктураПодразделение = Новый Структура;
	//СтруктураПодразделение.Вставить("ИД", мДокументДОМ.ПолучитьЭлементыПоИмени("Подразделение").Элемент(0).ТекстовоеСодержимое);
	//СтруктураПодразделение.Вставить("Наименование", мДокументДОМ.ПолучитьЭлементыПоИмени("ПодразделениеНаименование").Элемент(0).ТекстовоеСодержимое);
	
	ТЗТоваров = Новый ТаблицаЗначений;
	ТЗТоваров.Колонки.Добавить("СтруктурнаяЕдиница", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	ТЗТоваров.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗТоваров.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
	ТЗТоваров.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗТоваров.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("СправочникСсылка.СтавкиНДС"));
	ТЗТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 3)));
	//ТЗТоваров.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("ЦенаУчетная", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	ТЗТоваров.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(19, 2)));
	//ТЗТоваров.Колонки.Добавить("ДокИД", ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(100));

	НомерСтрокиПП = 0;
	Для Каждого ЭлементДОМ Из мДокументДОМ.ПолучитьЭлементыПоИмени("Остаток") Цикл
		НомерСтрокиПП = НомерСтрокиПП + 1;
	
		СтруктураРеквизитовНоменклатуры = ПолучитьСтруктуруРеквизитовНоменклатуры(ЭлементДОМ);
		
		Товар = ПолучитьНоменклатуру(СтруктураРеквизитовНоменклатуры);
		
		Если Не ЗначениеЗаполнено(Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаТоваров = ТЗТоваров.Добавить();
		НоваяСтрокаТоваров.СтруктурнаяЕдиница = Склад;

		Если СтруктураРеквизитовНоменклатуры.Количество() <> 0 Тогда
			НоваяСтрокаТоваров.Артикул = СтруктураРеквизитовНоменклатуры.Артикул;
			НоваяСтрокаТоваров.Номенклатура = Товар;
			НоваяСтрокаТоваров.Характеристика = ПолучитьХарактеристику(СтруктураРеквизитовНоменклатуры, НоваяСтрокаТоваров.Номенклатура); 
			
			Если ЭлементДОМ.ПолучитьЭлементыПоИмени("СтавкаНДС").Количество() > 0 Тогда
				НоваяСтрокаТоваров.СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию(СокрЛП(ЭлементДОМ.ПолучитьЭлементыПоИмени("СтавкаНДС").Элемент(0).ТекстовоеСодержимое));
			Иначе
				НоваяСтрокаТоваров.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДСПоПеречислениюСтавкиНДС(НоваяСтрокаТоваров.Номенклатура.ВидСтавкиНДС);
			КонецЕсли;
		КонецЕсли;
		НоваяСтрокаТоваров.Количество = ЭлементДОМ.ПолучитьЭлементыПоИмени("Количество").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.Цена = ЭлементДОМ.ПолучитьЭлементыПоИмени("Цена").Элемент(0).ТекстовоеСодержимое;
		НоваяСтрокаТоваров.ЦенаУчетная = ЭлементДОМ.ПолучитьЭлементыПоИмени("ЦенаУчетная").Элемент(0).ТекстовоеСодержимое;
		//ЭлементЦенаБезНДС = ЭлементДОМ.ПолучитьЭлементыПоИмени("ORDERPRICE");
		//Если ЭлементЦена2.Количество() > 0 Тогда
		//	НоваяСтрокаТоваров.Цена = ЭлементЦенаБезНДС[0].ТекстовоеСодержимое;
		//Иначе
		//	СтавкаНДС = обПолучитьСтавкуНДСТовара(ДанныеСтроки.Товар, ДатаДок);
		//	НоваяСтрокаТоваров.Цена = НоваяСтрокаТоваров.ЦенаБезНДС + НоваяСтрокаТоваров.ЦенаБезНДС * СтавкаНДС / 100;
		//КонецЕсли;
		Если ЗначениеЗаполнено(НоваяСтрокаТоваров.Номенклатура) И СтруктураРеквизитовНоменклатуры.Свойство("Штрихкод") И ЗначениеЗаполнено(СтруктураРеквизитовНоменклатуры.Штрихкод) Тогда
			
			РСШК = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
			РСШК.Номенклатура = НоваяСтрокаТоваров.Номенклатура;
			РСШК.Характеристика = НоваяСтрокаТоваров.Характеристика;
			РСШК.Штрихкод = СтруктураРеквизитовНоменклатуры.Штрихкод;
			//РСШК. = Спрх.Ссылка;
			РСШК.Записать(Истина);
			
		КонецЕсли;
