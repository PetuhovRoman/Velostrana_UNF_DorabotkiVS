#Область ОписаниеПеременных

// Состояние дочерних форм, разрешение закрытия и признак сканирования ячейки.
&НаКлиенте
Перем ОткрытаДочерняяФорма, ЗавершениеРазрешено, ЯчейкаОтсканирована;

#КонецОбласти


#Область ОбработчикиСобытийФормы

// Готовит план приемки по распоряжению или по ранее записанному непроведенному ордеру.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.СтруктураЗаполнения) = Тип("Структура") Тогда
		
		Данные = Параметры.СтруктураЗаполнения;
		РаспоряжениеНаПоступление = Данные.Распоряжение;
		
		ПоказыватьФотоТоваров = Параметры.ПоказыватьФотоТоваров;
		
		Ордер = Документы.ПриходныйОрдер.СоздатьДокумент();
		Ордер.Заполнить(РаспоряжениеНаПоступление);
		
		Если ЗначениеЗаполнено(Данные.Склад) И Не Данные.Склад = Ордер.СтруктурнаяЕдиница Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Склад распоряжения не совпадает с выбранным.'"));
			Возврат;
		КонецЕсли;
		
		ЗонаПриемки = Данные.ЗонаПриемки;
		
	Иначе
		
		Ссылка = Параметры.Ссылка;
		
		Если Не ЗначениеЗаполнено(Ссылка) Или Ссылка.Проведен Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Откройте распоряжение или непроведенный ордер.'"));
			Возврат;
		КонецЕсли;
		
		Ордер = Ссылка.ПолучитьОбъект();
		РаспоряжениеНаПоступление = Ордер.ДокументОснование;
		
	КонецЕсли;
	
	Если Ордер.Запасы.Количество() = 0 Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Нет товаров к приемке.'"));
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРеквизитыШапки(Ордер);
	ЗаполнитьПланПоОрдеру(Ордер);
	
	ИнформацияОДокументе = Строка(РаспоряжениеНаПоступление);
	
	СвойстваСклада = Обработки.МобильноеРабочееМестоКладовщика.СвойстваСклада(Склад);
	ИспользоватьАдресноеХранение = СвойстваСклада.ИспользоватьАдресноеХранение;
	
	Если ЗначениеЗаполнено(ЗонаПриемки) И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗонаПриемки, "Владелец") = Склад Тогда
		ЗонаПриемки = Справочники.Ячейки.ПустаяСсылка();
	КонецЕсли;
	
	НастроитьОформлениеСтрокСИзлишками(); // Консоль AL 19.11.2026 — правило оформляется один раз при создании формы.
	ОбновитьОстаткиИЗаголовки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Не Источник = "ПодключаемоеОборудование" Или ОткрытаДочерняяФорма = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ИмяСобытия = "ScanData"
		Или Не МобильноеРабочееМестоКладовщикаКлиент.ЕстьНеобработанноеСобытие() Тогда
		Возврат;
	КонецЕсли;
	
	Данные = МобильноеРабочееМестоКладовщикаКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
	ОбработатьШтрихкод(Данные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не ЗавершениеРазрешено = Истина И ТоварыПринято.Количество() > 0 Тогда
		
		Отказ = Истина;
		
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = НСтр("ru = 'Приемка не сохранена. Завершите приемку кнопкой Готово.'");
		Иначе
			Оповещение = Новый ОписаниеОповещения("ПослеОтменыНаполнения", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Закрыть без сохранения приемки?'"), РежимДиалогаВопрос.ДаНет, 0);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьКарточкуПриемки(Элемент.ТекущиеДанные, "Приемка");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТоварыПринято

&НаКлиенте
Процедура ТоварыПринятоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИндексСтроки = ТоварыПринято.Индекс(Элемент.ТекущиеДанные);
	ОткрытьКарточкуПриемки(Элемент.ТекущиеДанные, "РедактированиеПриемка", ИндексСтроки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакончитьПриемку(Команда)
	
	Если ТоварыПринято.Количество() = 0 Тогда
		Состояние(НСтр("ru = 'Невозможно закончить приемку, пока не принят ни один товар.'"));
		Возврат;
	КонецЕсли;
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Завершить", НСтр("ru = 'Завершить'"));
	СписокЗначений.Добавить("Продолжить", НСтр("ru = 'Продолжить'"));
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Завершить приемку?'"), СписокЗначений, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура СобратьВсе(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСобратьВсе", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Вкладка Принято будет очищена, продолжить?'"), РежимДиалогаВопрос.ДаНет, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискПоШтрихкоду(Команда)
	
	ТекШтрихкод = "";
	
	ОбработкаЗавершения = Новый ОписаниеОповещения("ПоискПоШтрихкодуЗавершение", ЭтотОбъект,
	Новый Структура("ТекШтрихкод", ТекШтрихкод));
	
	#Если МобильныйКлиент Тогда
		ОткрытьФорму("ОбщаяФорма.ФормаПоискаПоШтрихкоду", , , , , , ОбработкаЗавершения);
	#Иначе
		ПоказатьВводЗначения(ОбработкаЗавершения, ТекШтрихкод, НСтр("ru = 'Введите штрихкод'"));
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура Сканировать(Команда)
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Ячейка", НСтр("ru = 'Ячейку'"));
	СписокЗначений.Добавить("Товар", НСтр("ru = 'Товар'"));
	СписокЗначений.Добавить("Отмена", НСтр("ru = 'Отмена'"));
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаВыбор", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Сканировать'"), СписокЗначений, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПриемку(Команда)
	
	ИндексСтроки = ТоварыПринято.Индекс(Элементы.ТоварыПринято.ТекущиеДанные);
	
	Если ИндексСтроки >= 0 Тогда
		ТоварыПринято.Удалить(ИндексСтроки);
		ОбновитьОстаткиИЗаголовки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПриемкуОрдера(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеОтменыНаполнения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Закрыть без сохранения приемки?'"), РежимДиалогаВопрос.ДаНет, 0);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработкаРезультатов

// Открывает форму сканирования выбранного объекта: ячейки или товара.
//
// Параметры:
//  Результат - Строка - выбранный вариант: "Ячейка", "Товар" или "Отмена";
//  Параметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ПослеЗакрытияВопросаВыбор(Результат, Параметры) Экспорт
	
	Если Результат = "Ячейка" Тогда
		
		Описание = Новый ОписаниеОповещения("УстановитьЯчейку", ЭтотОбъект);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТипПоиска", "ПоискЯчейки");
		ПараметрыФормы.Вставить("Склад", Склад);
		
		ОткрытаДочерняяФорма = Истина;
		
		ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.СканированиеШтрихкода", ПараметрыФормы,
		ЭтотОбъект,,,,
		Описание, РежимОткрытияОкнаФормы.Независимый);
		
	ИначеЕсли Результат = "Товар" Тогда
		
		Описание = Новый ОписаниеОповещения("РезультатСканированияТовара", ЭтотОбъект);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТипПоиска", "ПоискНоменклатуры");
		ПараметрыФормы.Вставить("Склад", Склад);
		ПараметрыФормы.Вставить("ДокументСсылка", Ссылка);
		
		ОткрытаДочерняяФорма = Истина;
		
		ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.СканированиеШтрихкода", ПараметрыФормы,
		ЭтотОбъект,,,,
		Описание, РежимОткрытияОкнаФормы.Независимый);
		
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Открывает карточку найденного товара или предлагает выбрать один из результатов поиска.
//
// Параметры:
//  Результат - Массив из Структура, Неопределено - данные товаров или отмена поиска.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура РезультатСканированияТовара(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОткрытаДочерняяФорма = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Количество() > 1 Тогда
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Товары", Результат);
		ЗначенияЗаполнения.Вставить("Режим", "ВыборНоменклатуры");
		ЗначенияЗаполнения.Вставить("Штрихкод", "");
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РезультатСканирования", ЗначенияЗаполнения);
		
		ОткрытаДочерняяФорма = Истина;
		ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.ФормаВыбораСканирование", ПараметрыФормы,
		ЭтотОбъект,,,,
		Новый ОписаниеОповещения("РезультатСканированияТовара", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	Иначе
		
		ОткрытьКарточкуПриемки(Результат[0], "Приемка");
		
	КонецЕсли;
	
КонецПроцедуры

// Результат сканирования ячейки: открывает приемку в отсканированную ячейку.
//
// Параметры:
//  Результат - Структура, Неопределено - данные найденной ячейки, см. СканированиеШтрихкода:
//   * Ячейка - СправочникСсылка.Ячейки - отсканированная ячейка.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура УстановитьЯчейку(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОткрытаДочерняяФорма = Ложь;
	
	Если Результат = Неопределено Или Не ЗначениеЗаполнено(Результат.Ячейка) Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЯчейкуПриемки(Результат);
	
КонецПроцедуры

// Принимает факт из карточки, затем обрабатывает переход к следующей ячейке или товару.
//
// Параметры:
//  Результат - Структура, Неопределено - данные карточки товара или отмена ввода.
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ОбновитьФорму(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОткрытаДочерняяФорма = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПринятьРезультат(Результат);
	
	Если ЗначениеЗаполнено(Результат.ДанныеСледующейЯчейки) Тогда
		ОткрытьЯчейкуПриемки(Результат.ДанныеСледующейЯчейки);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.ДанныеСледующегоТовара) Тогда
		РезультатСканированияТовара(Результат.ДанныеСледующегоТовара);
	КонецЕсли;
	
КонецПроцедуры

// Принимает все строки из окна наполнения и продолжает приемку в следующей ячейке при ее выборе.
//
// Параметры:
//  Результат - см. ПринятьНаполнениеЯчейки.Результат
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ПослеЯчейкиПриемки(Результат, ДополнительныеПараметры) Экспорт
	
	ОткрытаДочерняяФорма = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПринятьНаполнениеЯчейки(Результат);
	
	// Консоль AL 19.11.2026 — новая ячейка открывается после приема результата наполнения.
	Если ЗначениеЗаполнено(Результат.ДанныеСледующейЯчейки) Тогда
		ОткрытьЯчейкуПриемки(Результат.ДанныеСледующейЯчейки);
	КонецЕсли;
	// Конец Консоль AL
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры = Неопределено) Экспорт
	
	Если Результат = "Завершить" Тогда
		ЗакончитьПриемкуНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаСобратьВсе(Результат, Параметры = Неопределено) Экспорт
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТоварыПринято.Очистить();
	ОбновитьОстаткиИЗаголовки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтменыНаполнения(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Не Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗавершениеРазрешено = Истина;
	Закрыть();
	
КонецПроцедуры

// Обрабатывает введенный штрихкод и передает его на обработку.
//
// Параметры:
//  Результат - Строка, Неопределено - введенный штрихкод;
//  ДополнительныеПараметры - Структура - см. ПоискПоШтрихкоду:
//   * ТекШтрихкод - Строка - штрихкод по умолчанию.
//
&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОценкаПроизводительностиКлиент.ЗамерВремени(СтрШаблон("ПоискПоШтрихкоду%1",
	РаботаСФормойДокументаКлиентСервер.ПолучитьИмяФормыСтрокой(ИмяФормы)));
	
	ТекШтрихкод = ?(Результат = Неопределено, СокрЛП(ДополнительныеПараметры.ТекШтрихкод), СокрЛП(Результат));
	
	Если Не ПустаяСтрока(ТекШтрихкод) Тогда
		Данные = Новый Структура("Штрихкод, Количество", ТекШтрихкод, 1);
		ОбработатьШтрихкод(Данные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПредупрежденияПриемки(ДополнительныеПараметры) Экспорт
	СохранитьПриемкуИЗакрыть();
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеИПриемка

&НаСервере
Процедура ЗаполнитьРеквизитыШапки(Ордер)
	
	Склад = Ордер.СтруктурнаяЕдиница; 
	Отправитель = ?(ЗначениеЗаполнено(Ордер.Контрагент), Ордер.Контрагент,  Параметры.СтруктураЗаполнения.Отправитель) ;
	Комментарий = Ордер.Комментарий;
	Номер = Ордер.Номер;
	Дата = Ордер.Дата;
	
	ДатаВходящегоДокумента = Ордер.ДатаВходящегоДокумента;
	НомерВходящегоДокумента = Ордер.НомерВходящегоДокумента;
	
	Штрихкод = Параметры.Штрихкод;
	ПорядокСканирования = Параметры.ПорядокСканирования;
	
КонецПроцедуры

// Сохраняет исходный план в единицах строк ордера для повторной сверки перед записью.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер - ордер, заполненный по распоряжению.
//
&НаСервере
Процедура ЗаполнитьПланПоОрдеру(Ордер)
	
	ПланОрдера.Очистить();
	
	Для Каждого Запас Из Ордер.Запасы Цикл
		
		Позиция = ПланОрдера.Добавить();
		
		Позиция.Номенклатура = Запас.Номенклатура;
		Позиция.Характеристика = Запас.Характеристика;
		Позиция.Упаковка = Запас.ЕдиницаИзмерения;
		Позиция.Количество = Запас.Количество;
		Позиция.НомерСтрокиОснования = Запас.НомерСтроки;
		Позиция.Артикул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запас.Номенклатура, "Артикул");
		
	КонецЦикла;
	
КонецПроцедуры

// Консоль AL 19.11.2026 — красный текст всей строки принятых товаров с положительным излишком.
&НаСервере
Процедура НастроитьОформлениеСтрокСИзлишками()
	
	Правило = УсловноеОформление.Элементы.Добавить();
	
	ОформляемоеПоле = Правило.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыПринято.Имя);
	
	ОтборИзлишка = Правило.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборИзлишка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТоварыПринято.КоличествоИзлишка");
	ОтборИзлишка.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборИзлишка.ПравоеЗначение = 0;
	
	Правило.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
КонецПроцедуры
// Конец Консоль AL

// Учитывает количество из карточки: при редактировании заменяет факт, иначе накапливает его по ячейкам.
//
// Параметры:
//  Результат - см. ОбновитьФорму.Результат
//  Пересчитать - Булево - обновить остатки и заголовки после приема результата.
//
&НаСервере
Процедура ПринятьРезультат(Результат, Пересчитать = Истина)
	
	Количество = Результат.КоличествоУпаковок;
	
	Если Количество < 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Режим = "РедактированиеПриемка" Тогда
		
		СтрокаФакта = ТоварыПринято[Результат.НомерСтроки];
		
		Если Количество = 0 Тогда
			ТоварыПринято.Удалить(СтрокаФакта);
		Иначе
			СтрокаФакта.Количество = Количество;
			СтрокаФакта.Упаковка = Результат.Упаковка;
			СтрокаФакта.Ячейка = Результат.Ячейка;
		КонецЕсли;
		
	ИначеЕсли Количество > 0 Тогда
		
		Отбор = Новый Структура("Номенклатура, Характеристика, Упаковка, Ячейка",
		Результат.Номенклатура, Результат.Характеристика, Результат.Упаковка, Результат.Ячейка);
		
		Строки = ТоварыПринято.НайтиСтроки(Отбор);
		
		Если Строки.Количество() > 0 Тогда
			Строки[0].Количество = Строки[0].Количество + Количество;
		Иначе
			ДобавитьСтрокуФакта(Результат, Количество);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Пересчитать Тогда
		ОбновитьОстаткиИЗаголовки();
	КонецЕсли;
	
КонецПроцедуры

// Учитывает результат наполнения ячейки и пересчитывает остатки после всего пакета.
//
// Параметры:
//  Результат - Структура - результат формы "РазмещениеВЯчейки", см. ее метод ЗакрытьФорму:
//   * МассивРазмещений - Массив из Структура - принятые позиции.
//   * Ячейка - СправочникСсылка.Ячейки - ячейка назначения.
//
&НаСервере
Процедура ПринятьНаполнениеЯчейки(Результат)
	
	Для Каждого Факт Из Результат.МассивРазмещений Цикл
		
		Факт.Вставить("Режим", "Приемка");
		Факт.Ячейка = Результат.Ячейка;
		
		ПринятьРезультат(Факт, Ложь);
		
	КонецЦикла;
	
	ОбновитьОстаткиИЗаголовки();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуФакта(Результат, Количество)
	
	СтрокаФакта = ТоварыПринято.Добавить();
	
	СтрокаФакта.Номенклатура = Результат.Номенклатура;
	СтрокаФакта.Характеристика = Результат.Характеристика;
	СтрокаФакта.Упаковка = Результат.Упаковка;
	СтрокаФакта.Ячейка = Результат.Ячейка;
	СтрокаФакта.Артикул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.Номенклатура, "Артикул");
	СтрокаФакта.Количество = Количество;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОстаткиИЗаголовки()
	
	ТоварыКПоступлению.Очистить();
	
	ДоступныйПлан = ДоступныйПланПриемки();
	Для Каждого План Из ДоступныйПлан Цикл
		ЗаполнитьЗначенияСвойств(ТоварыКПоступлению.Добавить(), План);
	КонецЦикла;
	
	// Консоль AL 19.11.2026 — «Количество» показывает план строки, излишек выделяется отдельной колонкой.
	Для Каждого Факт Из ТоварыПринято Цикл
		
		КоэффициентФакта = КоэффициентЕдиницыПриемки(Факт.Упаковка);
		ОсталосьРаспределить = Факт.Количество * КоэффициентФакта;
		ПлановоеКоличество = 0;
		
		Для Каждого Остаток Из ТоварыКПоступлению Цикл
			
			Если Не Остаток.Номенклатура = Факт.Номенклатура
				Или Не Остаток.Характеристика = Факт.Характеристика Тогда
				Продолжить;
			КонецЕсли;
			
			Коэффициент = КоэффициентЕдиницыПриемки(Остаток.Упаковка);
			Порция = Мин(Остаток.Количество, Цел(ОсталосьРаспределить / Коэффициент * 1000) / 1000);
			Если Порция <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ПлановоеКоличество = ПлановоеКоличество + Порция;
			Остаток.Количество = Остаток.Количество - Порция;
			ОсталосьРаспределить = Макс(ОсталосьРаспределить - Порция * Коэффициент, 0);
			
			Если ОсталосьРаспределить <= 0 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Факт.КоличествоПлана = ПлановоеКоличество;
		Факт.КоличествоИзлишка = ОсталосьРаспределить / КоэффициентФакта;
		
	КонецЦикла;
	// Конец Консоль AL
	
	Индекс = ТоварыКПоступлению.Количество() - 1;
	
	Пока Индекс >= 0 Цикл
		
		Если ТоварыКПоступлению[Индекс].Количество <= 0 Тогда
			ТоварыКПоступлению.Удалить(Индекс);
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	// Консоль AL 19.11.2026 — подсветка и предупреждение используют итог колонки «Излишек».
	ОсталосьКоличество = 0;
	Для Каждого Остаток Из ТоварыКПоступлению Цикл
		ОсталосьКоличество = ОсталосьКоличество + Остаток.Количество * КоэффициентЕдиницыПриемки(Остаток.Упаковка);
	КонецЦикла;
	ПринятоКоличество = 0;
	ИзлишекКоличество = 0;
	Для Каждого Факт Из ТоварыПринято Цикл
		КоэффициентФакта = КоэффициентЕдиницыПриемки(Факт.Упаковка);
		ПринятоКоличество = ПринятоКоличество + Факт.КоличествоПлана * КоэффициентФакта;
		ИзлишекКоличество = ИзлишекКоличество + Факт.КоличествоИзлишка * КоэффициентФакта;
	КонецЦикла;
	
	Элементы.СтраницаКПоступлению.Заголовок = СтрШаблон("К приемке %1", ОсталосьКоличество);
	
	ЗаголовокПринято = СтрШаблон("Принято %1", ПринятоКоличество);
	
	ЦветЗаголовка = WebЦвета.Черный;
	
	Если ИзлишекКоличество > 0 Тогда
		ЗаголовокПринято = ЗаголовокПринято + СтрШаблон(" (излишек %1)", ИзлишекКоличество);
		ЦветЗаголовка = WebЦвета.Красный;
	ИначеЕсли ОсталосьКоличество = 0 И ПринятоКоличество > 0 Тогда
		ЦветЗаголовка = WebЦвета.Зеленый;
	КонецЕсли;
	
	Элементы.СтраницаПринято.Заголовок = ЗаголовокПринято;
	Элементы.СтраницаПринято.ЦветТекстаЗаголовка = ЦветЗаголовка;
	// Конец Консоль AL
	
КонецПроцедуры

// Консоль AL 19.11.2026 — оформление расчета доступного плана.
// Ограничивает план формы остатком по распоряжению, не вычитая проведенную приемку повторно.
// Исходный ПланОрдера остается неизменным для проверки перед записью.
//
// Возвращаемое значение:
//  ТаблицаЗначений - копия ПланОрдера с доступными количествами в единицах строк.
//
&НаСервере
Функция ДоступныйПланПриемки()
	
	ДоступныйПлан = ПланОрдера.Выгрузить();
	Если Не ЗначениеЗаполнено(РаспоряжениеНаПоступление) Тогда
		Возврат ДоступныйПлан;
	КонецЕсли;
	
	// Собираем план по складу в базовых единицах, отдельно по товару и характеристике.
	Основание = РаспоряжениеНаПоступление.ПолучитьОбъект();
	ПолныйПлан = Новый Массив;
	
	Для Каждого Запас Из Основание.Запасы Цикл
		Если Запас.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(РаспоряжениеНаПоступление) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
			Если Основание.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти Тогда
				Если Не Запас.СтруктурнаяЕдиница = Склад Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли Не Основание.СтруктурнаяЕдиница = Склад Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли Не Основание.СтруктурнаяЕдиницаПолучатель = Склад Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = Неопределено;
		Для Каждого СтрокаПлана Из ПолныйПлан Цикл
			Если СтрокаПлана.Номенклатура = Запас.Номенклатура
				И СтрокаПлана.Характеристика = Запас.Характеристика Тогда
				Ключ = СтрокаПлана;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Ключ = Неопределено Тогда
			Ключ = Новый Структура("Номенклатура, Характеристика, Осталось",
			Запас.Номенклатура, Запас.Характеристика, 0);
			ПолныйПлан.Добавить(Ключ);
		КонецЕсли;
		
		Ключ.Осталось = Ключ.Осталось
		+ Запас.Количество * КоэффициентЕдиницыПриемки(Запас.ЕдиницаИзмерения);
	КонецЦикла;
	
	ПринятоДругими = ПринятоДругимиОрдерами();
	Для Каждого СтрокаПлана Из ПолныйПлан Цикл
		Отбор = Новый Структура("Номенклатура, Характеристика",
		СтрокаПлана.Номенклатура, СтрокаПлана.Характеристика);
		Для Каждого Принято Из ПринятоДругими.НайтиСтроки(Отбор) Цикл
			СтрокаПлана.Осталось = Макс(СтрокаПлана.Осталось - Принято.КоличествоПринято, 0);
		КонецЦикла;
	КонецЦикла;
	
	// Распределяем общий остаток по строкам в их исходном порядке и единицах измерения.
	Для Каждого План Из ДоступныйПлан Цикл
		Если План.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Количество = 0;
		Коэффициент = КоэффициентЕдиницыПриемки(План.Упаковка);
		Для Каждого СтрокаПлана Из ПолныйПлан Цикл
			Если СтрокаПлана.Номенклатура = План.Номенклатура
				И СтрокаПлана.Характеристика = План.Характеристика Тогда
				Количество = Мин(План.Количество, Цел(СтрокаПлана.Осталось / Коэффициент * 1000) / 1000);
				СтрокаПлана.Осталось = Макс(СтрокаПлана.Осталось - Количество * Коэффициент, 0);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		План.Количество = Количество;
	КонецЦикла;
	
	Возврат ДоступныйПлан;
	
КонецФункции
// Конец Консоль AL

&НаСервере
Функция КоэффициентЕдиницыПриемки(Единица)
	
	Если ТипЗнч(Единица) = Тип("СправочникСсылка.ЕдиницыИзмерения") И ЗначениеЗаполнено(Единица) Тогда
		Коэффициент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Единица, "Коэффициент");
		Если Коэффициент <= 0 Тогда
			ВызватьИсключение "У единицы измерения не задан положительный коэффициент.";
		КонецЕсли;
		Возврат Коэффициент;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

// Суммирует приемку по другим проведенным ордерам того же распоряжения и склада.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Номенклатура - СправочникСсылка.Номенклатура
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры
//   * КоличествоПринято - Число - принятое количество в базовых единицах.
//
&НаСервере
Функция ПринятоДругимиОрдерами()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    СтрокиОрдера.Номенклатура КАК Номенклатура,
	|    СтрокиОрдера.Характеристика КАК Характеристика,
	|    СУММА(СтрокиОрдера.Количество *
	|        ВЫБОР
	|            КОГДА СтрокиОрдера.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|                И СтрокиОрдера.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|                ТОГДА ВЫРАЗИТЬ(СтрокиОрдера.ЕдиницаИзмерения КАК Справочник.ЕдиницыИзмерения).Коэффициент
	|            ИНАЧЕ 1
	|        КОНЕЦ) КАК КоличествоПринято
	|ИЗ
	|    Документ.ПриходныйОрдер.Запасы КАК СтрокиОрдера
	|ГДЕ
	|    СтрокиОрдера.Ссылка.ДокументОснование = &Распоряжение
	|    И СтрокиОрдера.Ссылка.СтруктурнаяЕдиница = &Склад
	|    И СтрокиОрдера.Ссылка <> &ИсключаемыйОрдер
	|    И СтрокиОрдера.Ссылка.Проведен
	|    И НЕ СтрокиОрдера.Ссылка.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|    СтрокиОрдера.Номенклатура,
	|    СтрокиОрдера.Характеристика";
	Запрос.УстановитьПараметр("Распоряжение", РаспоряжениеНаПоступление);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	ИсключаемыйОрдер = Документы.ПриходныйОрдер.ПустаяСсылка();
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриходныйОрдер") Тогда
		ИсключаемыйОрдер = Ссылка;
	КонецЕсли;
	Запрос.УстановитьПараметр("ИсключаемыйОрдер", ИсключаемыйОрдер);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область ЗавершениеПриемки

// Показывает расхождения перед сохранением по команде или при повторном сканировании штрихкода ордера.
&НаКлиенте
Процедура ЗакончитьПриемкуНаКлиенте()
	
	Расхождения = РасхожденияПриемки();
	Если Расхождения.Недостача > 0 Или Расхождения.Излишек > 0 Тогда
		Текст = "";
		Если Расхождения.Недостача > 0 Тогда
			Текст = СтрШаблон("Принято меньше, чем требуется. Осталось принять: %1.", Расхождения.Недостача);
		КонецЕсли;
		Если Расхождения.Излишек > 0 Тогда
			Если Не ПустаяСтрока(Текст) Тогда
				Текст = Текст + Символы.ПС;
			КонецЕсли;
			Текст = Текст + СтрШаблон(НСтр("ru = 'Принято с излишком: %1.
			|Излишки будут оформлены отдельным ордером без проведения.'"), Расхождения.Излишек);
			МобильноеРабочееМестоКладовщикаКлиент.ВоспроизвестиЗвукОшибки();
		КонецЕсли;
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ПослеПредупрежденияПриемки", ЭтотОбъект),
		Текст, , "Внимание!");
		Возврат;
	КонецЕсли;
	
	СохранитьПриемкуИЗакрыть();
	
КонецПроцедуры

// Рассчитывает недостачу и излишек без взаимозачета между разными товарами.
//
// Возвращаемое значение:
//  Структура:
//   * Недостача - Число - непринятое количество в базовых единицах.
//   * Излишек - Число - итог колонки «Излишек» принятых строк в базовых единицах.
//
&НаСервере
Функция РасхожденияПриемки()
	
	ОбновитьОстаткиИЗаголовки();
	
	// Консоль AL 19.11.2026 — излишек берется из колонки строки, без пересчета по плану.
	Недостача = 0;
	Для Каждого Остаток Из ТоварыКПоступлению Цикл
		Недостача = Недостача + Остаток.Количество * КоэффициентЕдиницыПриемки(Остаток.Упаковка);
	КонецЦикла;
	
	Излишек = 0;
	Для Каждого Факт Из ТоварыПринято Цикл
		Излишек = Излишек + Факт.КоличествоИзлишка * КоэффициентЕдиницыПриемки(Факт.Упаковка);
	КонецЦикла;
	
	Возврат Новый Структура("Недостача, Излишек", Недостача, Излишек);
	// Конец Консоль AL
	
КонецФункции

// Консоль AL 19.11.2026 — обработка ошибок записи.
// Закрывает форму только после успешной записи всех документов.
&НаКлиенте
Асинх Процедура СохранитьПриемкуИЗакрыть()
	
	Попытка
		ПриемкаСохранена = ЗакончитьПриемкуНаСервере();
	Исключение
		ТекстОшибки = Строка(ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке()));
		ПриемкаСохранена = Ложь;
	КонецПопытки;
	
	Если Не ПриемкаСохранена Тогда
		Ждать МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ЗавершениеРазрешено = Истина;
	Закрыть();
	
КонецПроцедуры
// Конец Консоль AL

// Консоль AL 19.11.2026 — разделение документов приемки.
// Распределяет принятый товар по доступному плану в базовых единицах.
// Сохраняет обе части и их размещения в одной транзакции. Плановую часть проводит.
//
// Возвращаемое значение:
//  Булево - Истина после записи всех документов; Ложь при отказе со значением в ТекстОшибки.
//
&НаСервере
Функция ЗакончитьПриемкуНаСервере()
	
	Если ТоварыПринято.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru = 'Нет принятых товаров.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		Ордер = Ссылка.ПолучитьОбъект();
		
		Если Ордер.Проведен Тогда
			ТекстОшибки = НСтр("ru = 'Ордер уже проведен. Повторная приемка запрещена.'");
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		
		Ордер = Документы.ПриходныйОрдер.СоздатьДокумент();
		Ордер.Заполнить(РаспоряжениеНаПоступление);
		
	КонецЕсли;
	
	Если Не Ордер.СтруктурнаяЕдиница = Склад
		Или Не Ордер.ДокументОснование = РаспоряжениеНаПоступление Тогда
		
		ТекстОшибки = НСтр("ru = 'Склад или основание изменились. Откройте приемку заново.'");
		Возврат Ложь;
		
	КонецЕсли;
	
	// Исходные строки ордера — носители реквизитов и лимит распределения по плану.
	ИсходныеСтроки = Ордер.Запасы.Выгрузить();
	
	Если Не ИсходныеСтроки.Количество() = ПланОрдера.Количество() Тогда
		ТекстОшибки = НСтр("ru = 'Состав плана изменился. Откройте приемку заново.'");
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого План Из ПланОрдера Цикл
		
		Источник = ИсходныеСтроки[План.НомерСтрокиОснования - 1];
		
		Если Не Источник.Номенклатура = План.Номенклатура
			Или Не Источник.Характеристика = План.Характеристика
			Или Не Источник.ЕдиницаИзмерения = План.Упаковка
			Или Не Источник.Количество = План.Количество Тогда
			
			ТекстОшибки = НСтр("ru = 'План изменился. Откройте приемку заново.'");
			Возврат Ложь;
			
		КонецЕсли;
		
		// Документ поступления: сначала из строки, затем из шапки и распоряжения.
		Если Не ЗначениеЗаполнено(Источник.ДокументПоступления)
			И ЗначениеЗаполнено(Ордер.ДокументПоступления) Тогда
			
			Источник.ДокументПоступления = Ордер.ДокументПоступления;
			
		КонецЕсли;
		
		// Заказ и расходный ордер не входят в тип документа поступления УНФ.
		Если Не ЗначениеЗаполнено(Источник.ДокументПоступления) Тогда
			
			Если ТипЗнч(РаспоряжениеНаПоступление) = Тип("ДокументСсылка.ЗаказПоставщику")
				Или ТипЗнч(РаспоряжениеНаПоступление) = Тип("ДокументСсылка.РасходныйОрдер")
				Или Не ЗначениеЗаполнено(РаспоряжениеНаПоступление) Тогда
				
				ТекстОшибки = НСтр("ru = 'Не определен документ поступления.
				|Приемку необходимо открыть по документу поступления, а не по заказу.'");
				Возврат Ложь;
				
			КонецЕсли;
			
			Источник.ДокументПоступления = РаспоряжениеНаПоступление;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДоступныйПлан = ДоступныйПланПриемки();
	Для Каждого План Из ДоступныйПлан Цикл
		ИсходныеСтроки[План.НомерСтрокиОснования - 1].Количество = План.Количество;
	КонецЦикла;
	
	Ордер.Запасы.Очистить();
	ОрдерИзлишков = Неопределено;
	
	// Консоль AL 19.11.2026 — в «Количество» идет плановая часть строки, излишек ордерится по колонке.
	Для Каждого Факт Из ТоварыПринято Цикл
		
		Если Факт.Количество <= 0 Или Не ЗначениеЗаполнено(Факт.Номенклатура) Тогда
			ТекстОшибки = НСтр("ru = 'В принятых строках укажите товар и положительное количество.'");
			Возврат Ложь;
		КонецЕсли;
		
		Если ИспользоватьАдресноеХранение И Не ЗначениеЗаполнено(Факт.Ячейка) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Не указана ячейка для %1'"), Строка(Факт.Номенклатура));
			Возврат Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Факт.Ячейка)
			И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Факт.Ячейка, "Владелец") = Склад Тогда
			
			ТекстОшибки = НСтр("ru = 'Ячейка относится к другому складу.'");
			Возврат Ложь;
			
		КонецЕсли;
		
		КоэффициентФакта = КоэффициентЕдиницыПриемки(Факт.Упаковка);
		Осталось = Факт.КоличествоПлана * КоэффициентФакта;
		
		Для Каждого Источник Из ИсходныеСтроки Цикл
			
			Если Не Источник.Номенклатура = Факт.Номенклатура
				Или Не Источник.Характеристика = Факт.Характеристика Тогда
				Продолжить;
			КонецЕсли;
			
			КоэффициентИсточника = КоэффициентЕдиницыПриемки(Источник.ЕдиницаИзмерения);
			Порция = Мин(Цел(Осталось / КоэффициентИсточника * 1000) / 1000, Источник.Количество);
			
			Если Порция <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаОрдера = Ордер.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОрдера, Источник);
			
			СтрокаОрдера.Количество = Порция;
			СтрокаОрдера.Ячейка = Факт.Ячейка;
			
			Источник.Количество = Источник.Количество - Порция;
			Осталось = Макс(Осталось - Порция * КоэффициентИсточника, 0);
			
			Если Осталось = 0 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Факт.КоличествоИзлишка > 0 Тогда
			Если ОрдерИзлишков = Неопределено Тогда
				ОрдерИзлишков = СоздатьОрдерИзлишков(Ордер);
			КонецЕсли;
			
			СтрокаИзлишков = ОрдерИзлишков.Запасы.Добавить();
			СтрокаИзлишков.Номенклатура = Факт.Номенклатура;
			СтрокаИзлишков.Характеристика = Факт.Характеристика;
			СтрокаИзлишков.ЕдиницаИзмерения = Факт.Упаковка;
			СтрокаИзлишков.Количество = Факт.КоличествоИзлишка;
			СтрокаИзлишков.Ячейка = Факт.Ячейка;
		КонецЕсли;
		
	КонецЦикла;
	// Конец Консоль AL
	
	Ордер.Дата = ТекущаяДатаСеанса();
	Ордер.Комментарий = Комментарий;
	Если Не ОрдерИзлишков = Неопределено Тогда
		ОрдерИзлишков.Дата = Ордер.Дата;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Если Ордер.Запасы.Количество() > 0 Тогда
			ЗаписатьОрдерСРазмещением(Ордер, РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		Если Не ОрдерИзлишков = Неопределено Тогда
			ЗаписатьОрдерСРазмещением(ОрдерИзлишков, РежимЗаписиДокумента.Запись);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Ордер.Запасы.Количество() > 0 Тогда
		Ссылка = Ордер.Ссылка;
	Иначе
		Ссылка = ОрдерИзлишков.Ссылка;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции
// Конец Консоль AL

// Консоль AL 19.11.2026 — формирование ордера излишков.
// Создает ордер для товаров сверх плана.
// Сохраняет распоряжение, но не переносит документ поступления в шапку или строки излишков.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер - ордер плановой приемки.
//
// Возвращаемое значение:
//  ДокументОбъект.ПриходныйОрдер - новый ордер с пустой табличной частью.
//
&НаСервере
Функция СоздатьОрдерИзлишков(Ордер)
	
	ОрдерИзлишков = Документы.ПриходныйОрдер.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ОрдерИзлишков, Ордер,
	"Организация, СтруктурнаяЕдиница, Контрагент, ДокументОснование, ХозяйственнаяОперация, Автор, "
	+ "ДатаВходящегоДокумента, НомерВходящегоДокумента, "
	+ "ПодписьКладовщика, ПодписьРуководителя, ПодписьСдающегоЗапасы, Комиссия");
	ОрдерИзлишков.ДокументПоступления = Неопределено;
	ОрдерИзлишков.Комментарий = НСтр("ru = 'Излишки при приемке'");
	Если Не ПустаяСтрока(Комментарий) Тогда
		ОрдерИзлишков.Комментарий = ОрдерИзлишков.Комментарий + Символы.ПС + Комментарий;
	КонецЕсли;
	
	Возврат ОрдерИзлишков;
	
КонецФункции
// Конец Консоль AL

// Консоль AL 19.11.2026 — запись ордера и размещения.
// Записывает пару документов в транзакции вызывающего метода.
// Переносит адреса из строк в перемещение до очистки ячеек ордера.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер - ордер с заполненными ячейками размещения.
//  РежимЗаписи - РежимЗаписиДокумента - проведение плановой части или запись излишков без проведения.
//
&НаСервере
Процедура ЗаписатьОрдерСРазмещением(Ордер, Знач РежимЗаписи)
	
	ТолькоЗапись = РежимЗаписи = РежимЗаписиДокумента.Запись;
	Перемещение = ПодготовитьПеремещениеПоПриемке(Ордер, ТолькоЗапись);
	
	ПустаяЯчейка = Справочники.Ячейки.ПустаяСсылка();
	Ордер.Ячейка = ПустаяЯчейка;
	Ордер.ПоложениеЯчейки = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
	Ордер.ПоложениеДокументаПоступления = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
	
	Для Каждого СтрокаОрдера Из Ордер.Запасы Цикл
		СтрокаОрдера.Ячейка = ПустаяЯчейка;
		СтрокаОрдера.КлючСвязи = СтрокаОрдера.НомерСтроки;
		СтрокаОрдера.СерииНоменклатуры = "";
	КонецЦикла;
	Ордер.СерииНоменклатуры.Очистить();
	
	Ордер.Записать(РежимЗаписи);
	Если Не Перемещение = Неопределено Тогда
		Перемещение.Дата = Ордер.Дата;
		Перемещение.Комментарий = СтрШаблон(НСтр("ru = 'Размещение по приходному ордеру %1. %2'"),
		Ордер.Ссылка, Ордер.Комментарий);
		Перемещение.Записать(РежимЗаписи);
	КонецЕсли;
	
КонецПроцедуры
// Конец Консоль AL

// Подготавливает размещение из распределенных строк приемки, сохраняя партии и единицы строк ордера.
//
// Параметры:
//  Ордер - ДокументОбъект.ПриходныйОрдер - ордер с еще не очищенными ячейками строк.
//  ТолькоЗапись - Булево - Истина для черновика размещения излишков, в том числе без указанных ячеек.
//
// Возвращаемое значение:
//  - ДокументОбъект.ПеремещениеПоЯчейкам - размещение товаров или черновик по излишкам.
//  - Неопределено - в плановой приемке нет строк с ячейками назначения.
//
&НаСервере
Функция ПодготовитьПеремещениеПоПриемке(Ордер, Знач ТолькоЗапись)
	
	Перемещение = Неопределено;
	Для Каждого СтрокаОрдера Из Ордер.Запасы Цикл
		Если Не ТолькоЗапись И Не ЗначениеЗаполнено(СтрокаОрдера.Ячейка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Перемещение = Неопределено Тогда
			Перемещение = Документы.ПеремещениеПоЯчейкам.СоздатьДокумент();
			Перемещение.Дата = ТекущаяДатаСеанса();
			Перемещение.Организация = Ордер.Организация;
			Перемещение.СтруктурнаяЕдиница = Ордер.СтруктурнаяЕдиница;
			Перемещение.Автор = Ордер.Автор;
			Перемещение.ВидОперации = Перечисления.ВидыОперацийПеремещениеПоЯчейкам.ИзОднойВНесколько;
			Перемещение.Ячейка = Справочники.Ячейки.ПустаяСсылка();
			Если ТолькоЗапись Тогда
				Перемещение.СостояниеЗаказа = ЗаполнениеОбъектовУНФ.ПолучитьСостояниеЗаказаНаПеремещение();
			Иначе
				Перемещение.СостояниеЗаказа = Справочники.СостоянияЗаказовНаПеремещение.Завершен;
			КонецЕсли;
			// Тип основания не включает приходный ордер: сохраняем поддерживаемый документ поступления.
			Если ТипЗнч(РаспоряжениеНаПоступление) = Тип("ДокументСсылка.ПриходнаяНакладная")
				Или ТипЗнч(РаспоряжениеНаПоступление) = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
				Перемещение.ДокументОснование = РаспоряжениеНаПоступление;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаПеремещения = Перемещение.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПеремещения, СтрокаОрдера,
		"Номенклатура, Характеристика, Партия, ЕдиницаИзмерения, Количество, Ячейка");
		СтрокаПеремещения.КлючСвязи = СтрокаПеремещения.НомерСтроки;
	КонецЦикла;
	
	Возврат Перемещение;
	
КонецФункции

#КонецОбласти

#Область СканированиеИОткрытиеФорм

&НаКлиенте
Процедура ОбработатьШтрихкод(ДанныеШтрихкода)
	
	Если Не МобильноеРабочееМестоКладовщикаКлиент.ШтрихкодыВалидны(ДанныеШтрихкода) Тогда
		Возврат;
	КонецЕсли;
	
	// Повторный скан ШК документа завершает приемку.
	Если Штрихкод = ДанныеШтрихкода.Штрихкод Тогда
		ЗакончитьПриемкуНаКлиенте();
		Возврат;
	КонецЕсли;
	
	ДанныеЯчейки = ДанныеЯчейкиПриемки(ДанныеШтрихкода.Штрихкод);
	
	Если ЗначениеЗаполнено(ДанныеЯчейки.Ячейка) Тогда
		ОткрытьЯчейкуПриемки(ДанныеЯчейки);
		Возврат;
	КонецЕсли; 
	
	// Если отсканирован КМ сперва вычленим из него EAN
	ДанныеМаркировки = МенеджерОборудованияМаркировкаКлиент.РазобратьШтриховойКодТовара(ДанныеШтрихкода.Штрихкод);
	Если ЗначениеЗаполнено(ДанныеМаркировки.EAN) Тогда
		Штрихкод = ДанныеМаркировки.EAN;
	КонецЕсли;	
	ДанныеТоваров = ДанныеТоваровПоШК(Штрихкод);
	
	Если ДанныеТоваров.Количество() > 0 Тогда
		РезультатСканированияТовара(ДанныеТоваров);
		Возврат;
	КонецЕсли;
	
	МобильноеРабочееМестоКладовщикаКлиент.ШтрихкодНеРаспознан("Оформление приходного ордера.", Штрихкод);
	//Состояние(НСтр("ru = 'Номенклатура по штрихкоду не найдена'"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеТоваровПоШК(Штрихкод)
	
	Возврат Обработки.МобильноеРабочееМестоКладовщика.ДанныеТоваровПоШК(Штрихкод);
	
КонецФункции

// Ищет ячейку по штрихкоду в пределах склада приемки.
//
// Параметры:
//  Штрихкод - Строка - код ячейки.
//
// Возвращаемое значение:
//  См. Обработки.МобильноеРабочееМестоКладовщика.ДанныеЯчейкиПоШК
//
&НаСервере
Функция ДанныеЯчейкиПриемки(Штрихкод)
	
	Возврат Обработки.МобильноеРабочееМестоКладовщика.ДанныеЯчейкиПоШК(Склад, Штрихкод);
	
КонецФункции

// Открывает наполнение ячейки и передает ее форме обработку сканера.
//
// Параметры:
//  Данные - см. ДанныеЯчейкиПриемки
//
&НаКлиенте
Процедура ОткрытьЯчейкуПриемки(Данные)
	
	ЯчейкаОтсканирована = Истина;
	ЗонаПриемки = Данные.Ячейка;
	
	ПараметрыЯчейки = Новый Структура("Ячейка, Склад, ТипОперации, Режим, ПоказыватьФотоТоваров",
	Данные.Ячейка, Склад, 4, "ПриемкаПриходногоОрдера", ПоказыватьФотоТоваров);
	
	ОткрытаДочерняяФорма = Истина;
	
	ОткрытьФорму(
	"Обработка.МобильноеРабочееМестоКладовщика.Форма.РазмещениеВЯчейки", ПараметрыЯчейки,
	ЭтотОбъект, Истина,,,
	Новый ОписаниеОповещения("ПослеЯчейкиПриемки", ЭтотОбъект),
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Открывает карточку для добавления или редактирования факта приемки.
// При редактировании использует ячейку сохраненной строки, а не текущую зону приемки.
//
// Параметры:
//  Товар - ДанныеФормыЭлементКоллекции, Структура - позиция формы или данные сканирования.
//  Режим - Строка - "Приемка" или "РедактированиеПриемка".
//  ИндексСтроки - Число - индекс принятой строки при редактировании, с нуля.
//
&НаКлиенте
Процедура ОткрытьКарточкуПриемки(Товар, Режим, ИндексСтроки = 0)
	
	Если Режим = "Приемка" И ИспользоватьАдресноеХранение
		И Не ЯчейкаОтсканирована = Истина Тогда
		МобильноеРабочееМестоКладовщикаКлиент.ВоспроизвестиЗвукОшибки();
		ПоказатьПредупреждение(, "Сперва отсканируйте ячейку", , "Ошибка!");
		Возврат;
	КонецЕсли;
	
	ПараметрыКарточки = Новый Структура;
	ПараметрыКарточки.Вставить("Номенклатура", Товар.Номенклатура);
	ПараметрыКарточки.Вставить("Характеристика", Товар.Характеристика);
	ПараметрыКарточки.Вставить("Упаковка", Товар.Упаковка);
	ПараметрыКарточки.Вставить("Количество", Товар.Количество);
	ПараметрыКарточки.Вставить("Режим", Режим);
	ПараметрыКарточки.Вставить("НомерСтроки", ИндексСтроки);
	ПараметрыКарточки.Вставить("Ячейка", ЗонаПриемки);
	ПараметрыКарточки.Вставить("Склад", Склад);
	ПараметрыКарточки.Вставить("ДокументИсточник", Ссылка);
	ПараметрыКарточки.Вставить("РаспоряжениеНаПоступление", РаспоряжениеНаПоступление);
	ПараметрыКарточки.Вставить("ШтрихкодДокумента", Штрихкод);
	ПараметрыКарточки.Вставить("ПорядокСканирования", ПорядокСканирования);
	ПараметрыКарточки.Вставить("ПриемкаБезСерий", Истина);
	ПараметрыКарточки.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);
	
	Если Режим = "РедактированиеПриемка" Тогда
		ПараметрыКарточки.Ячейка = Товар.Ячейка;
	КонецЕсли;
	
	ОткрытаДочерняяФорма = Истина;
	ОткрытьФорму(
	"Обработка.МобильноеРабочееМестоКладовщика.Форма.КарточкаТовара", ПараметрыКарточки,
	ЭтотОбъект,,,,
	Новый ОписаниеОповещения("ОбновитьФорму", ЭтотОбъект),
	РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
