
#Область ОписаниеПеременных

// Признак: из этой формы открыта дочерняя форма или диалог, и сканер обслуживает его.
&НаКлиенте
Перем ОткрытаДочерняяФорма;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Ссылка = Параметры.Ссылка;
	ПоказыватьФотоТоваров = Параметры.ПоказыватьФотоТоваров;
	Штрихкод = Параметры.Штрихкод;

	ЗаполнитьФорму();
	УстановитьУсловноеОформление();


КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["СтраницаИнформация"] Тогда

		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["СтраницаКПоступлению"];

	КонецЕсли;


КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Информация", "ОбработкаОповещения:" + Символы.ПС + ИмяСобытия + Символы.ПС + Источник);

	// ВводДоступен() на ТСД возвращает Ложь при форме на экране, из-за чего событие сканера терялось.
	// Событие обрабатывается, если ввод доступен или из этой формы не открыта дочерняя форма (карточка товара и т.п.).
	// Дублей нет: событие потребляется один раз через ЕстьНеобработанноеСобытие.
	ВводФормыДоступен = ВводДоступен();
	Если Источник = "ПодключаемоеОборудование" Тогда
		МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Информация",
			"Пересчет: ВводДоступен=" + ВводФормыДоступен + ", ОткрытаДочерняяФорма=" + (ОткрытаДочерняяФорма = Истина));
	КонецЕсли;

	// Пока открыта дочерняя форма, сканер обслуживает ее: иначе эта форма первой потребляет событие
	// через ЕстьНеобработанноеСобытие, и обработчик дочерней формы не срабатывает.
	Если Источник = "ПодключаемоеОборудование" И Не ОткрытаДочерняяФорма Тогда

		ЕстьНеобработанноеСобытие = МобильноеРабочееМестоКладовщикаКлиент.ЕстьНеобработанноеСобытие();
		МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Информация",
			"ОбработкаОповещения2:" + Символы.ПС + ИмяСобытия + Символы.ПС + Источник
			+ Символы.ПС + "ЕстьНеобработанноеСобытие:" + ЕстьНеобработанноеСобытие);

		Если ИмяСобытия = "ScanData" И ЕстьНеобработанноеСобытие Тогда

			Данные = МобильноеРабочееМестоКладовщикаКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
			МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Информация",
				"ОбработкаОповещения3:" + Символы.ПС + Данные.Штрихкод);
			ОбработатьШтрихкод(Данные);

		КонецЕсли;

		// Диагностика: событие сканера пришло, но форма его пропустила.
		Если ИмяСобытия = "ScanData" И Не ЕстьНеобработанноеСобытие Тогда
			МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Предупреждение",
				"Пересчет: ScanData пропущено, событие уже обработано другой формой");
		КонецЕсли;

	КонецЕсли;


КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Описание = Новый ОписаниеОповещения("ОбновитьФорму", ЭтотОбъект);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", Элемент.ТекущиеДанные.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика", Элемент.ТекущиеДанные.Характеристика);
	ПараметрыФормы.Вставить("Серия", Элемент.ТекущиеДанные.Серия);
	ПараметрыФормы.Вставить("Упаковка", Элемент.ТекущиеДанные.Упаковка);
	ПараметрыФормы.Вставить("Количество", Элемент.ТекущиеДанные.КоличествоФакт);
	ПараметрыФормы.Вставить("Режим", "РедактированиеПересчет");
	ПараметрыФормы.Вставить("НомерСтроки", Элемент.ТекущаяСтрока);
	ПараметрыФормы.Вставить("Склад", Склад);
	ПараметрыФормы.Вставить("Ячейка", Элемент.ТекущиеДанные.Ячейка);
	ПараметрыФормы.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);
	ПараметрыФормы.Вставить("Артикул", Элемент.ТекущиеДанные.Артикул);
	ПараметрыФормы.Вставить("ДокументИсточник", Ссылка);
	ПараметрыФормы.Вставить("ШтрихкодДокумента", Штрихкод);

	ОткрытаДочерняяФорма = Истина;
	ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.КарточкаТовара", ПараметрыФормы,
		ЭтотОбъект,,,, Описание,
		РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Информация(Команда)
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["СтраницаИнформация"];
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьПересчет(Команда)
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Завершить", НСтр("ru = 'Завершить'"));
	СписокЗначений.Добавить("Продолжить", НСтр("ru = 'Продолжить'"));
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Закончить пересчет?'"), СписокЗначений, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура Сканировать(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Склад", Склад);
	ПараметрыФормы.Вставить("ДокументСсылка", Ссылка);
	ПараметрыФормы.Вставить("Режим", "Пересчет");

	Если ИспользоватьАдресноеХранение Тогда

		ПараметрыФормы.Вставить("ТипПоиска", "ПоискЯчейки");
		Описание = Новый ОписаниеОповещения("РезультатСканированияЯчейки", ЭтотОбъект);

	Иначе

		ПараметрыФормы.Вставить("ТипПоиска", "ПоискНоменклатуры");
		Описание = Новый ОписаниеОповещения("РезультатСканированияТовара", ЭтотОбъект);

	КонецЕсли;

	ОткрытаДочерняяФорма = Истина;
	ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.СканированиеШтрихкода", ПараметрыФормы,
		ЭтотОбъект,,,, Описание,
		РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

&НаКлиенте
Процедура ПоискПоШтрихкоду(Команда)

	ТекШтрихкод = "";

	ОбработкаЗавершения = Новый ОписаниеОповещения(
		"ПоискПоШтрихкодуЗавершение",
		ЭтотОбъект,
		Новый Структура("ТекШтрихкод", ТекШтрихкод));

	ПоказатьВводЗначения(ОбработкаЗавершения, ТекШтрихкод, НСтр("ru = 'Введите штрихкод'"));

КонецПроцедуры

&НаКлиенте
Процедура ПоискЯчейкиПоШтрихкоду(Команда)

	ТекШтрихкод = "";

	ОбработкаЗавершения = Новый ОписаниеОповещения(
		"ПоискЯчейкиПоШтрихкодуЗавершение",
		ЭтотОбъект,
		Новый Структура("ТекШтрихкод", ТекШтрихкод));

	ПоказатьВводЗначения(ОбработкаЗавершения, ТекШтрихкод, НСтр("ru = 'Введите штрихкод'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настраивает условное оформление строк пересчета: расхождение по количеству выделяется цветом.
//
&НаСервере
Процедура УстановитьУсловноеОформление()

	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыКоличествоФакт.Имя);
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.КоличествоРазница");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = 0;
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаОтрицательногоЗначения);

	Элементы.ТоварыЯчейка.Видимость = ИспользоватьАдресноеХранение;


КонецПроцедуры

// Заполняет реквизиты формы и таблицу товаров данными документа пересчета.
//
&НаСервере
Процедура ЗаполнитьФорму()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПересчетТоваров.Номер КАК Номер,
		|	ПересчетТоваров.Дата КАК Дата,
		|	ПересчетТоваров.Автор КАК Исполнитель,
		|	ПересчетТоваров.Комментарий КАК Комментарий,
		|	ПересчетТоваров.СтруктурнаяЕдиница КАК Склад,
		|	ИСТИНА КАК ИспользоватьАдресноеХранение,
		|	ПересчетТоваров.Запасы.(
		|		КоличествоУчет КАК Количество,
		|		Количество КАК КоличествоФакт,
		|		Номенклатура КАК Номенклатура,
		|		Номенклатура.Артикул КАК Артикул,
		|		ЕдиницаИзмерения КАК Упаковка,
		|		Характеристика КАК Характеристика,
		|		Ячейка КАК Ячейка,
		|		Партия КАК Серия,
		|		Количество - КоличествоУчет КАК КоличествоРазница,
		|		Цена КАК Цена
		|	) КАК ТаблицаТовары
		|ИЗ
		|	Документ.ИнвентаризацияЗапасов КАК ПересчетТоваров
		|ГДЕ
		|	ПересчетТоваров.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ВыборкаДетальныеЗаписи);
	
	Товары.Загрузить(ВыборкаДетальныеЗаписи.ТаблицаТовары.Выгрузить());
	
КонецПроцедуры

// Обработчик оповещения карточки товара: обновляет таблицу товаров и переходит к следующему товару.
//
// Параметры:
//   Результат - Структура, Неопределено - данные, возвращенные карточкой товара
//   ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура ОбновитьФорму(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	// Дочерняя форма закрыта.
	ОткрытаДочерняяФорма = Ложь;

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбновитьФормуНаСервере(Результат);

	Если ЗначениеЗаполнено(Результат.ДанныеСледующегоТовара) Тогда
		РезультатСканированияТовара(Результат.ДанныеСледующегоТовара);
	КонецЕсли;

КонецПроцедуры

// Обновляет строку таблицы товаров по результату сканирования или добавляет новую строку.
//
// Параметры:
//   Результат - Структура - данные, возвращенные карточкой товара или ячейки
//
&НаСервере
Процедура ОбновитьФормуНаСервере(Результат)

	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура", Результат.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", Результат.Характеристика);
	// В таблице «Товары» серия - это партия (ПартииНоменклатуры), а форма ячейки и штрихкод возвращают
	// пустую серию другого типа (СерииНоменклатуры). Пустые ссылки разных типов не равны, строка
	// не находилась и добавлялась новая, поэтому незаполненная серия приводится к пустой партии.
	Если ЗначениеЗаполнено(Результат.Серия) Тогда
		СтруктураПоиска.Вставить("Серия", Результат.Серия);
	Иначе
		СтруктураПоиска.Вставить("Серия", Справочники.ПартииНоменклатуры.ПустаяСсылка());
	КонецЕсли;
	СтруктураПоиска.Вставить("Упаковка", Результат.Упаковка);
	СтруктураПоиска.Вставить("Ячейка", Результат.Ячейка);

	РезультатПоиска = Товары.НайтиСтроки(СтруктураПоиска);
	Если РезультатПоиска.Количество() > 0 Тогда

		Если Результат.Режим = "РедактированиеПересчет" Тогда
			РезультатПоиска[0].КоличествоФакт = Результат.КоличествоУпаковок;
		Иначе
			РезультатПоиска[0].КоличествоФакт = РезультатПоиска[0].КоличествоФакт + Результат.КоличествоУпаковок;
		КонецЕсли;

		РезультатПоиска[0].КоличествоРазница = РезультатПоиска[0].КоличествоФакт - РезультатПоиска[0].Количество;

	Иначе

		ЗаписьЖурналаРегистрации("МРМК", УровеньЖурналаРегистрации.Предупреждение, , Результат.Номенклатура,
			"Строка по ШК не найдена в документе инвентаризации, позиция добавляется");

		// Позиции нет в документе: добавляется новая строка с нулевым учетным количеством.
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = Результат.Номенклатура;
		НоваяСтрока.Характеристика = Результат.Характеристика;
		НоваяСтрока.Серия = Результат.Серия;
		НоваяСтрока.Упаковка = Результат.Упаковка;
		НоваяСтрока.Ячейка = Результат.Ячейка;
		НоваяСтрока.Артикул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.Номенклатура, "Артикул");
		НоваяСтрока.Количество = 0;
		НоваяСтрока.КоличествоФакт = Результат.КоличествоУпаковок;
		НоваяСтрока.КоличествоРазница = НоваяСтрока.КоличествоФакт - НоваяСтрока.Количество;

	КонецЕсли;


КонецПроцедуры

// Записывает документ пересчета по данным таблицы товаров.
//
// Возвращаемое значение:
//   Булево - Истина, если документ записан
//
&НаСервере
Функция ЗакончитьПересчетНаСервере()

	Попытка

		ДокументОбъект = Ссылка.ПолучитьОбъект();
		ДокументОбъект.Комментарий = Комментарий;
		ДокументОбъект.Запасы.Очистить();

		Для Каждого Строка Из Товары Цикл

			НоваяСтрока = ДокументОбъект.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, , "Количество");
			НоваяСтрока.Количество = Строка.КоличествоФакт;
			НоваяСтрока.КоличествоУчет = Строка.Количество;
			НоваяСтрока.ЕдиницаИзмерения = Строка.Упаковка;
			НоваяСтрока.Партия = Строка.Серия;

			НоваяСтрока.СуммаУчет = НоваяСтрока.КоличествоУчет * НоваяСтрока.Цена;
			НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;

		КонецЦикла;

		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);

	Исключение

		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось записать %1. %2'"), Ссылка,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;

	КонецПопытки;

	Возврат Истина;


КонецФункции

// Возвращает данные ячейки, найденной по штрихкоду, в разрезе склада формы.
//
// Параметры:
//   Штрихкод - Строка
//
// Возвращаемое значение:
//   Структура - данные найденной ячейки
//
&НаСервере
Функция ДанныеЯчейкиПоШК(Знач Штрихкод)

	Возврат Обработки.МобильноеРабочееМестоКладовщика.ДанныеЯчейкиПоШК(Склад, Штрихкод);

КонецФункции

// Возвращает данные товаров, найденных по штрихкоду.
//
// Параметры:
//   Штрихкод - Строка
//
// Возвращаемое значение:
//   Массив из Структура - данные найденных товаров: Номенклатура, Характеристика, Упаковка, Серия, Количество
//
&НаСервереБезКонтекста
Функция ДанныеТоваровПоШК(Штрихкод)

	Возврат Обработки.МобильноеРабочееМестоКладовщика.ДанныеТоваровПоШК(Штрихкод);

КонецФункции

// Обработчик оповещения вопроса о завершении пересчета: записывает документ и закрывает форму.
//
// Параметры:
//   Результат - Строка - вариант ответа: "Завершить" или "Продолжить"
//   Параметры - Произвольный - не используется
//
&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт

	Если Результат = "Завершить" Тогда

		ПриемкаЗавершена = ЗакончитьПересчетНаСервере();

		Если ПриемкаЗавершена Тогда
			Закрыть();
		Иначе
			Состояние(ТекстОшибки);
		КонецЕсли;

	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Обработчик оповещения ввода штрихкода: обрабатывает введенный штрихкод как отсканированный.
//
// Параметры:
//   Результат - Строка, Неопределено - введенный штрихкод или Неопределено при отмене ввода
//   ДополнительныеПараметры - Структура - содержит ранее введенный штрихкод (ключ ТекШтрихкод)
//
&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ТекШтрихкод = ?(Результат = Неопределено, СокрЛП(ДополнительныеПараметры.ТекШтрихкод), СокрЛП(Результат));

	Если Не ПустаяСтрока(ТекШтрихкод) Тогда

		Параметр = Новый Массив;
		Параметр.Добавить(ТекШтрихкод);
		Параметр.Добавить(Неопределено);
		Данные = МобильноеРабочееМестоКладовщикаКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
		ОбработатьШтрихкод(Данные);

	КонецЕсли;

КонецПроцедуры

// Обработчик оповещения ввода штрихкода ячейки: обрабатывает штрихкод с поиском ячейки в первую очередь.
//
// Параметры:
//   Результат - Строка, Неопределено - введенный штрихкод или Неопределено при отмене ввода
//   ДополнительныеПараметры - Структура - содержит ранее введенный штрихкод (ключ ТекШтрихкод)
//
&НаКлиенте
Процедура ПоискЯчейкиПоШтрихкодуЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ТекШтрихкод = ?(Результат = Неопределено, СокрЛП(ДополнительныеПараметры.ТекШтрихкод), СокрЛП(Результат));

	ПорядокСканирования = "СначалаСканированиеЯчейки";

	Если Не ПустаяСтрока(ТекШтрихкод) Тогда

		Параметр = Новый Массив;
		Параметр.Добавить(ТекШтрихкод);
		Параметр.Добавить(Неопределено);
		Данные = МобильноеРабочееМестоКладовщикаКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
		ОбработатьШтрихкод(Данные);

	КонецЕсли;

	ПорядокСканирования = "";

КонецПроцедуры

// Обрабатывает отсканированный штрихкод: товар, ячейку или штрихкод документа.
//
// Параметры:
//   ДанныеШтрихкода - Структура - данные сканера: Штрихкод, Количество
//
&НаКлиенте
Процедура ОбработатьШтрихкод(ДанныеШтрихкода)

	// Отсканирован код маркировки: типовым разбором получаем штрихкод товара (EAN) и дальше работаем
	// как с обычным штрихкодом. Подмена выполняется до проверки валидности, так как в коде маркировки
	// есть разделители групп (GS).
	Если ПорядокСканирования <> "СначалаСканированиеЯчейки" Тогда
		ДанныеМаркировки = МенеджерОборудованияМаркировкаКлиент.РазобратьШтриховойКодТовара(ДанныеШтрихкода.Штрихкод);
		Если ЗначениеЗаполнено(ДанныеМаркировки.EAN) Тогда
			МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Информация",
				"Пересчет: отсканирован код маркировки, штрихкод товара = " + ДанныеМаркировки.EAN);
			ДанныеШтрихкода = Новый Структура("Штрихкод, Количество", ДанныеМаркировки.EAN, 1);
		КонецЕсли;
	КонецЕсли;

	ШтрихкодыВалидны = МобильноеРабочееМестоКладовщикаКлиент.ШтрихкодыВалидны(ДанныеШтрихкода);

	Если Не ШтрихкодыВалидны Тогда
		Возврат;
	КонецЕсли;

	Если Штрихкод = ДанныеШтрихкода.Штрихкод Тогда

		ПересчетЗавершен = ЗакончитьПересчетНаСервере();

		Если ПересчетЗавершен Тогда
			Закрыть();
		Иначе
			Состояние(ТекстОшибки);
		КонецЕсли;

		Возврат;
	КонецЕсли;

	СначалаПоискЯчейки = (ПорядокСканирования = "СначалаСканированиеЯчейки");

	// Штрихкод очищается от незначащих символов, о ненайденном коде сообщает общий модуль.
	ТекШтрихкод = СокрЛП(ДанныеШтрихкода.Штрихкод);

	Если ИспользоватьАдресноеХранение Тогда

		Если СначалаПоискЯчейки Тогда

			ДанныеЯчейки = ДанныеЯчейкиПоШК(ТекШтрихкод);

			Если ЗначениеЗаполнено(ДанныеЯчейки.Ячейка) Тогда
				РезультатСканированияЯчейки(ДанныеЯчейки);
				Возврат;
			КонецЕсли;

			МобильноеРабочееМестоКладовщикаКлиент.ШтрихкодНеРаспознан(
				НСтр("ru = 'Ячейка по штрихкоду не найдена'"), ТекШтрихкод);

		Иначе

			ДанныеТоваров = ДанныеТоваровПоШК(ТекШтрихкод);

			Если ЗначениеЗаполнено(ДанныеТоваров) Тогда
				РезультатСканированияТовара(ДанныеТоваров);
				Возврат;
			КонецЕсли;

			// Склад с адресным хранением: товар не найден, значит отсканирована ячейка. Она открывается так же,
			// как при поиске ячейки по штрихкоду (порядок сканирования выставляется на время открытия).
			ДанныеЯчейки = ДанныеЯчейкиПоШК(ТекШтрихкод);

			Если ЗначениеЗаполнено(ДанныеЯчейки.Ячейка) Тогда
				ПорядокСканирования = "СначалаСканированиеЯчейки";
				РезультатСканированияЯчейки(ДанныеЯчейки);
				ПорядокСканирования = "";
				Возврат;
			КонецЕсли;

			МобильноеРабочееМестоКладовщикаКлиент.ШтрихкодНеРаспознан(
				НСтр("ru = 'Номенклатура и ячейка по штрихкоду не найдены'"), ТекШтрихкод);

		КонецЕсли;

	Иначе

		ДанныеТоваров = ДанныеТоваровПоШК(ТекШтрихкод);

		Если ЗначениеЗаполнено(ДанныеТоваров) Тогда
			РезультатСканированияТовара(ДанныеТоваров);
			Возврат;
		КонецЕсли;

		МобильноеРабочееМестоКладовщикаКлиент.ШтрихкодНеРаспознан(
			НСтр("ru = 'Номенклатура по штрихкоду не найдена'"), ТекШтрихкод);

	КонецЕсли;


КонецПроцедуры

// Проверяет, есть ли в табличной части документа строка с указанной номенклатурой.
//
// Параметры:
//   Номенклатура - СправочникСсылка.Номенклатура
//
// Возвращаемое значение:
//   Булево - Истина, если строка с номенклатурой есть в документе
//
&НаКлиенте
Функция ТоварЕстьВДокументе(Номенклатура)

	Для Каждого СтрокаТовара Из Товары Цикл
		Если СтрокаТовара.Номенклатура = Номенклатура Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Предупреждает, что товара нет в документе, и после закрытия предупреждения открывает карточку товара.
// Позиция при этом не отбрасывается - она добавится в документ после подтверждения в карточке.
//
// Параметры:
//   ДанныеТовара - Структура - найденный по штрихкоду товар
//
&НаКлиенте
Асинх Процедура ПредупредитьОТовареВнеДокументаИОткрытьКарточку(ДанныеТовара)

	// Пока показано предупреждение, повторные сканы не обрабатываются.
	ОткрытаДочерняяФорма = Истина;

	ТекстПредупреждения = СтрШаблон(
		НСтр("ru = 'Товара ""%1"" нет в документе инвентаризации. Позиция будет добавлена в документ.'"),
		ПредставлениеНоменклатуры(ДанныеТовара.Номенклатура));
	МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Предупреждение", ТекстПредупреждения);

	МобильноеРабочееМестоКладовщикаКлиент.ВоспроизвестиЗвукОшибки();

	Ждать ПредупреждениеАсинх(ТекстПредупреждения, , НСтр("ru = 'Найдена новая позиция'"));

	ОткрытьКарточкуТовараПересчета(ДанныеТовара);

КонецПроцедуры

// Возвращает представление номенклатуры для вывода в сообщениях.
//
// Параметры:
//   Номенклатура - СправочникСсылка.Номенклатура
//
// Возвращаемое значение:
//   Строка - представление номенклатуры
//
&НаСервереБезКонтекста
Функция ПредставлениеНоменклатуры(Номенклатура)

	Возврат Строка(Номенклатура);

КонецФункции

// Обработчик оповещения сканирования товара: открывает карточку товара или форму выбора номенклатуры.
//
// Параметры:
//   Результат - Массив из Структура, Неопределено - найденные по штрихкоду товары
//   ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура РезультатСканированияТовара(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	// Дочерняя форма закрыта.
	ОткрытаДочерняяФорма = Ложь;

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Количество() > 1 Тогда

		Описание = Новый ОписаниеОповещения("РезультатСканированияТовара", ЭтотОбъект);

		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Товары", Результат);
		ЗначенияЗаполнения.Вставить("Режим", "ВыборНоменклатуры");
		ЗначенияЗаполнения.Вставить("Штрихкод", "");

		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РезультатСканирования", ЗначенияЗаполнения);

		ОткрытаДочерняяФорма = Истина;
		ОткрытьФорму(
			"Обработка.МобильноеРабочееМестоКладовщика.Форма.ФормаВыбораСканирование", ПараметрыФормы,
			ЭтотОбъект,,,, Описание, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

	Иначе

		ДанныеТовара = Результат[0];

		// Товара нет в документе: предупреждение со звуком, затем карточка (позиция добавится).
		Если Не ТоварЕстьВДокументе(ДанныеТовара.Номенклатура) Тогда
			ПредупредитьОТовареВнеДокументаИОткрытьКарточку(ДанныеТовара);
			Возврат;
		КонецЕсли;

		ОткрытьКарточкуТовараПересчета(ДанныеТовара);

	КонецЕсли;

КонецПроцедуры

// Открывает карточку товара для заполнения в режиме пересчета.
//
// Параметры:
//   ДанныеТовара - Структура - найденный по штрихкоду товар
//
&НаКлиенте
Процедура ОткрытьКарточкуТовараПересчета(ДанныеТовара)
	
	Если ПорядокСканирования = "СначалаСканированиеЯчейки" Тогда
		Описание = Новый ОписаниеОповещения("ОбновитьФорму", ЭтотОбъект);
	Иначе
		Описание = Новый ОписаниеОповещения("ДобавитьТовар", ЭтотОбъект);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", ДанныеТовара.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика", ДанныеТовара.Характеристика);
	ПараметрыФормы.Вставить("Серия", ДанныеТовара.Серия);
	ПараметрыФормы.Вставить("Упаковка", ДанныеТовара.Упаковка);
	ПараметрыФормы.Вставить("Количество", ДанныеТовара.Количество);
	ПараметрыФормы.Вставить("Режим", "Пересчет");
	ПараметрыФормы.Вставить("НомерСтроки", 0);
	ПараметрыФормы.Вставить("Склад", Склад);
	ПараметрыФормы.Вставить("Источник", Ссылка);
	ПараметрыФормы.Вставить("ШтрихкодУпаковки", ДанныеТовара.ШтрихкодУпаковки);
	ПараметрыФормы.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);
	ПараметрыФормы.Вставить("ШтрихкодДокумента", Штрихкод);
	ПараметрыФормы.Вставить("ПорядокСканирования", ПорядокСканирования);

	ОткрытаДочерняяФорма = Истина;
	ОткрытьФорму(
	"Обработка.МобильноеРабочееМестоКладовщика.Форма.КарточкаТовара",ПараметрыФормы,
	ЭтотОбъект,,,,Описание,
	РежимОткрытияОкнаФормы.Независимый); 
	
КонецПроцедуры

// Обработчик оповещения сканирования ячейки: открывает форму размещения товаров в ячейке.
//
// Параметры:
//   Результат - Структура, Неопределено - данные найденной ячейки
//   ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура РезультатСканированияЯчейки(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	// Дочерняя форма закрыта.
	ОткрытаДочерняяФорма = Ложь;

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Описание = Новый ОписаниеОповещения("ЗавершитьПересчетВЯчейке", ЭтотОбъект);

	ТоварыВЯчейке = Новый Массив;

	Для Каждого Строка Из Товары Цикл

		Если Строка.Ячейка = Результат.Ячейка Тогда

			Структура = СтруктураТоваров();
			ЗаполнитьЗначенияСвойств(Структура, Строка);
			// В таблице «Товары» нет упаковок: факт хранится в КоличествоФакт, учетное количество - в Количество
			// (форма ячейки получает его как КоличествоУпаковок).
			Структура.КоличествоУпаковок = Строка.Количество;
			Структура.КоличествоУпаковокРазмещено = Строка.КоличествоФакт;

			ТоварыВЯчейке.Добавить(Структура);

		КонецЕсли;

	КонецЦикла;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ячейка", Результат.Ячейка);
	ПараметрыФормы.Вставить("Товары", ТоварыВЯчейке);
	ПараметрыФормы.Вставить("Склад", Склад);
	ПараметрыФормы.Вставить("ТипОперации", 4);
	ПараметрыФормы.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);
	ПараметрыФормы.Вставить("Ссылка", Ссылка);
	ПараметрыФормы.Вставить("ШтрихкодДокумента", Штрихкод);
	ПараметрыФормы.Вставить("ШтрихкодЯчейки", Результат.Штрихкод);
	ПараметрыФормы.Вставить("ПорядокСканирования", ПорядокСканирования);
	ПараметрыФормы.Вставить("Режим", "РедактированиеПересчет");
	ПараметрыФормы.Вставить("ПечататьКоличествоПоУчету", ПечататьКоличествоПоУчету);

	ОткрытаДочерняяФорма = Истина;
	ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.РазмещениеВЯчейки", ПараметрыФормы,
		ЭтотОбъект,,,, Описание,
		РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

// Обработчик оповещения карточки товара: добавляет товар в таблицу пересчета.
//
// Параметры:
//   Результат - Структура, Неопределено - данные, возвращенные карточкой товара
//   ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура ДобавитьТовар(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	// Дочерняя форма закрыта.
	ОткрытаДочерняяФорма = Ложь;

	// Карточка закрыта без результата (назад, выход): список товаров не изменяется.
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДобавитьТоварНаСервере(Результат);

	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Состояние(ТекстОшибки);
	КонецЕсли;

	Если ЗначениеЗаполнено(Результат.ДанныеСледующегоТовара) Тогда
		РезультатСканированияТовара(Результат.ДанныеСледующегоТовара);
	КонецЕсли;

КонецПроцедуры

// Добавляет данные товара в таблицу пересчета.
//
// Параметры:
//   Результат - Структура, Неопределено - данные, возвращенные карточкой товара
//
&НаСервере
Процедура ДобавитьТоварНаСервере(Знач Результат)

	СтруктураПоиска = Новый Структура;

	Если Результат = Неопределено Тогда

		СтруктураПоиска.Вставить("Ячейка", Справочники.Ячейки.ПустаяСсылка());
		РезультатПоиска = Товары.НайтиСтроки(СтруктураПоиска);
		Для Каждого Строка Из РезультатПоиска Цикл
			Товары.Удалить(Строка);
		КонецЦикла;

		Возврат;

	КонецЕсли;

	МассивПересчета = Новый Массив;

	Если ЗначениеЗаполнено(Результат.Ячейка) Тогда
		Ячейка = Результат.Ячейка;
	ИначеЕсли ЗначениеЗаполнено(Результат.ДанныеСледующейЯчейки) Тогда
		Ячейка = Результат.ДанныеСледующейЯчейки.Ячейка;
	Иначе
		Ячейка = Справочники.Ячейки.ПустаяСсылка();
	КонецЕсли;

	Структура = СтруктураТоваровПересчета();
	ЗаполнитьЗначенияСвойств(Структура, Результат);
	Структура.Ячейка = Ячейка;
	МассивПересчета.Добавить(Структура);

	Для Каждого СтрокаЯчейки Из МассивПересчета Цикл

		СтрокаЯчейки.Вставить("Режим", Результат.Режим);
		ОбновитьФормуНаСервере(СтрокаЯчейки);

	КонецЦикла;


КонецПроцедуры

// Обработчик оповещения формы ячейки: переносит размещения в таблицу пересчета.
//
// Параметры:
//   Результат - Структура, Неопределено - результат работы формы ячейки
//   ДополнительныеПараметры - Произвольный - не используется
//
&НаКлиенте
Процедура ЗавершитьПересчетВЯчейке(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	// Дочерняя форма закрыта.
	ОткрытаДочерняяФорма = Ложь;

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаЯчейки Из Результат.МассивРазмещений Цикл

		СтрокаЯчейки.Вставить("Режим", Результат.Режим);
		ОбновитьФормуНаСервере(СтрокаЯчейки);

	КонецЦикла;

	Если ЗначениеЗаполнено(Результат.ДанныеСледующейЯчейки) Тогда
		РезультатСканированияЯчейки(Результат.ДанныеСледующейЯчейки);
	КонецЕсли;

КонецПроцедуры

// Возвращает структуру данных товара для формы ячейки.
//
// Возвращаемое значение:
//   Структура:
//     * Номенклатура - Строка
//     * Характеристика - Строка
//     * Серия - Строка
//     * Упаковка - Строка
//     * КоличествоУпаковок - Строка
//     * Назначение - Строка
//     * КоличествоУпаковокРазмещено - Строка
//
&НаКлиенте
Функция СтруктураТоваров()

	Структура = Новый Структура;
	Структура.Вставить("Номенклатура", "");
	Структура.Вставить("Характеристика", "");
	Структура.Вставить("Серия", "");
	Структура.Вставить("Упаковка", "");
	Структура.Вставить("КоличествоУпаковок", "");
	Структура.Вставить("Назначение", "");
	Структура.Вставить("КоличествоУпаковокРазмещено", "");

	Возврат Структура;

КонецФункции

// Возвращает структуру данных товара для добавления в таблицу пересчета.
//
// Возвращаемое значение:
//   Структура:
//     * Номенклатура - Строка
//     * Характеристика - Строка
//     * Серия - Строка
//     * Назначение - Строка
//     * Упаковка - Строка
//     * УпаковкаРазмещено - Строка
//     * КоличествоУпаковок - Число
//     * КоличествоУпаковокРазмещено - Число
//     * Ячейка - Строка
//     * ЯчейкаЗамена - Строка
//     * НомерСтроки - Строка
//
&НаСервере
Функция СтруктураТоваровПересчета()

	Структура = Новый Структура;
	Структура.Вставить("Номенклатура", "");
	Структура.Вставить("Характеристика", "");
	Структура.Вставить("Серия", "");
	Структура.Вставить("Назначение", "");
	Структура.Вставить("Упаковка", "");
	Структура.Вставить("УпаковкаРазмещено", "");
	Структура.Вставить("КоличествоУпаковок", 0);
	Структура.Вставить("КоличествоУпаковокРазмещено", 0);
	Структура.Вставить("Ячейка", "");
	Структура.Вставить("ЯчейкаЗамена", "");
	Структура.Вставить("НомерСтроки", "");

	Возврат Структура;

КонецФункции

#КонецОбласти
