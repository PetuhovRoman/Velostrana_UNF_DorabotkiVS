#Область ОписаниеПеременных

// Консоль AL 22.10.2026 — признак: из этой формы открыта форма сканирования штрихкода, и сканер обслуживает её
&НаКлиенте
Перем ОткрытаФормаСканирования, ОткрытаДочерняяФорма;
// Конец Консоль AL

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Ячейка = Параметры.Ячейка;
	Склад = Параметры.Склад;
	ТипОперации = Параметры.ТипОперации;
	ПоказыватьФотоТоваров = Параметры.ПоказыватьФотоТоваров;
	
	Если Параметры.Свойство("Режим") Тогда
		Режим = Параметры.Режим;
	КонецЕсли;
	
	Если Параметры.Свойство("Ссылка") Тогда
		Ссылка = Параметры.Ссылка;
	КонецЕсли;
	
	Если Параметры.Свойство("РаспоряжениеНаОтбор") Тогда
		РаспоряжениеНаОтбор = Параметры.РаспоряжениеНаОтбор;
	КонецЕсли;
	
	Если Параметры.Свойство("Товары") Тогда
		
		ТоварыВЯчейке = Параметры.Товары;
		
		Для Каждого Строка Из ТоварыВЯчейке Цикл
			
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			Если ТипОперации = 1 Тогда
				НоваяСтрока.ЗаголовокФакт = НСтр("ru = 'Размещено'");
			ИначеЕсли ТипОперации = 2 Тогда
				НоваяСтрока.ЗаголовокФакт = НСтр("ru = 'Отобрано'");
			КонецЕсли;
			НоваяСтрока.Ячейка = Ячейка;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипОперации = 3 Тогда
		
		Если Режим = "ПересчетРедактирование" Тогда
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры);
		КонецЕсли;
		
		Если Параметры.Свойство("ЯчейкаЗамена") Тогда
			ЯчейкаЗамена = Параметры.ЯчейкаЗамена;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	// Консоль AL 22.10.2026 — пока открыта форма сканирования, сканер обслуживает её (иначе событие обработается дважды)
	// ВводДоступен() на ТСД возвращает Ложь при форме на экране: событие сканера терялось.
	// Вместо него используется признак открытой дочерней формы (карточка товара обслуживает сканер сама), дублей нет: событие потребляется один раз через ЕстьНеобработанноеСобытие().
	Если Источник = "ПодключаемоеОборудование" И Не ОткрытаФормаСканирования = Истина И Не ОткрытаДочерняяФорма = Истина Тогда
		// Конец Консоль AL
		
		Если ИмяСобытия = "ScanData" И МенеджерОборудованияУНФКлиент.ЕстьНеобработанноеСобытие() Тогда
			
			// Преобразуем предварительно к ожидаемому формату
			Если Параметр[1] = Неопределено Тогда
				Штрихкод = Параметр[0];
			Иначе
				Штрихкод = Параметр[1][1];
			КонецЕсли;
			
			ОбработатьШтрихкод(Штрихкод);
			
		КонецЕсли;
		
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры

// Консоль AL 26.10.2026 — открытие карточки товара по данным отсканированного товара (вынесено из ОбработкаОповещения без изменения логики)
&НаКлиенте
Процедура ОткрытьКарточкуОтсканированногоТовара(ПараметрыКарточкаТовара)
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура",   ПараметрыКарточкаТовара.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", ПараметрыКарточкаТовара.Характеристика);
	СтруктураПоиска.Вставить("Серия",          ПараметрыКарточкаТовара.Серия);
	СтруктураПоиска.Вставить("Упаковка",       ПараметрыКарточкаТовара.Упаковка);
	
	РезультатПоиска = Товары.НайтиСтроки(СтруктураПоиска);
	// Консоль AL 26.10.2026 — при пересчете в ячейке (ТипОперации = 4) товара может не быть в списке ячейки:
	// карточка открывается и для такого товара, строка добавится после подтверждения.
	// Консоль AL 11.11.2026 — приемка перемещения: список сеанса содержит только часть товаров задания,
	// поэтому карточка открывается для любого товара перемещения, а не только найденного в списке.
	Если РезультатПоиска.Количество() > 0 Или ТипОперации = 4
		Или (ТипОперации = 1 И Режим = "РазмещениеВЯчейку"
		И ЗначениеЗаполнено(Ссылка)
		И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПеремещениеПоЯчейкам")) Тогда
		// Конец Консоль AL
		
		// Консоль AL 26.10.2026 — результат карточки принимает клиентская обёртка: она снимает признак открытой карточки
		Описание = Новый ОписаниеОповещения("РезультатКарточкиТовара", ЭтотОбъект);
		// Конец Консоль AL
		
		ПараметрыФормы = Новый Структура;
		// Консоль AL 26.10.2026 — товар берется из строки списка, а если ее нет — из найденного по штрихкоду
		ДанныеТовара = ?(РезультатПоиска.Количество() > 0, РезультатПоиска[0], ПараметрыКарточкаТовара);
		ПараметрыФормы.Вставить("Номенклатура",   ДанныеТовара.Номенклатура);
		ПараметрыФормы.Вставить("Характеристика", ДанныеТовара.Характеристика);
		ПараметрыФормы.Вставить("Серия",          ДанныеТовара.Серия);
		ПараметрыФормы.Вставить("Упаковка",       ДанныеТовара.Упаковка);
		// Конец Консоль AL
		ПараметрыФормы.Вставить("Количество",     ПараметрыКарточкаТовара.Количество);
		// Консоль AL 26.10.2026 — в пустом списке текущей строки нет: Товары.Индекс(Неопределено) вызвал бы ошибку
		ПараметрыФормы.Вставить("НомерСтроки",    ?(Элементы.Товары.ТекущиеДанные = Неопределено,
		0, Товары.Индекс(Элементы.Товары.ТекущиеДанные)));
		// Конец Консоль AL
		ПараметрыФормы.Вставить("Склад",          Склад);
		
		Если ТипОперации = 1 Тогда
			ПараметрыФормы.Вставить("Режим", "РазмещениеВЯчейку");
		ИначеЕсли ТипОперации = 2 Тогда
			ПараметрыФормы.Вставить("Режим", "ОтборИзЯчейкиОтгрузка");
			ПараметрыФормы.Вставить("РаспоряжениеНаОтбор", РаспоряжениеНаОтбор);
			// Консоль AL 26.10.2026 — пересчет в ячейке: режим карточки "Пересчет" (как в ветке сканирования через кнопку)
		ИначеЕсли ТипОперации = 4 Тогда
			ПараметрыФормы.Вставить("Режим", ?(Режим = "ПриемкаПриходногоОрдера", "Приемка", "Пересчет")); // Роман.П 06.11.2026 — режим приемки
			// Конец Консоль AL
		Иначе
			ПараметрыФормы.Вставить("Режим", "ОтборИзЯчейки");
			ПараметрыФормы.Вставить("РаспоряжениеНаОтбор", РаспоряжениеНаОтбор);
		КонецЕсли;
		
		// Консоль AL 26.10.2026 — для пересчета ячейка карточки — ячейка текущей формы
		Если РезультатПоиска.Количество() = 0 Тогда
			ПараметрыФормы.Вставить("Ячейка", Ячейка);
		ИначеЕсли РезультатПоиска[0].ЯчейкаЗамена.Пустая() Тогда
			// Конец Консоль AL
			ПараметрыФормы.Вставить("Ячейка", РезультатПоиска[0].Ячейка);
		Иначе
			ПараметрыФормы.Вставить("Ячейка", РезультатПоиска[0].ЯчейкаЗамена);
		КонецЕсли;
		ПараметрыФормы.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);
		ПараметрыФормы.Вставить("ДокументИсточник", Ссылка);
		
		ОткрытаДочерняяФорма = Истина; // Консоль AL 26.10.2026 — пока открыта карточка, сканер обслуживает ее
		ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.КарточкаТовара",ПараметрыФормы,
		ЭтотОбъект,,,,Описание,
		РежимОткрытияОкнаФормы.Независимый);
		
	Иначе
		СообщениеПользователю = Новый СообщениеПользователю;
		ТекстСообщения = НСтр("ru='Не требуется %1 номенклатуры %2 в упаковке %3'");
		Если ТипОперации = 1 Тогда
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", НСтр("ru='размещение'"));
		Иначе
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", НСтр("ru='отбор'"));
		КонецЕсли;
		
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%2", ПараметрыКарточкаТовара.Номенклатура);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%3", ПараметрыКарточкаТовара.Упаковка);
		
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Сообщить();
	КонецЕсли;
	
	
КонецПроцедуры
// Конец Консоль AL

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Описание = Новый ОписаниеОповещения("РезультатКарточкиТовара", ЭтотОбъект); // Консоль AL 26.10.2026 — было: ПодтвердитьКоличество
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура"			, Элемент.ТекущиеДанные.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика"		, Элемент.ТекущиеДанные.Характеристика);
	ПараметрыФормы.Вставить("Серия"					, Элемент.ТекущиеДанные.Серия);
	ПараметрыФормы.Вставить("Упаковка"				, Элемент.ТекущиеДанные.Упаковка);
	ПараметрыФормы.Вставить("Количество"			, Элемент.ТекущиеДанные.КоличествоУпаковок);
	ПараметрыФормы.Вставить("НомерСтроки"			, Товары.Индекс(Элементы.Товары.ТекущиеДанные));
	ПараметрыФормы.Вставить("Склад"					, Склад);
	ПараметрыФормы.Вставить("ПоказыватьФотоТоваров"	, ПоказыватьФотоТоваров);
	ПараметрыФормы.Вставить("Артикул"				, Элемент.ТекущиеДанные.Артикул);
	ПараметрыФормы.Вставить("ДокументИсточник"		, Ссылка);
	
	Если ТипОперации = 1 Тогда
		ПараметрыФормы.Вставить("Режим", "РедактированиеРазмещениеПоЯчейкам");
	ИначеЕсли ТипОперации = 2 Тогда
		ПараметрыФормы.Вставить("Режим", "РедактированиеОтборИзЯчейкиОтгрузка");
		ПараметрыФормы.Вставить("РаспоряжениеНаОтбор", РаспоряжениеНаОтбор);
	ИначеЕсли ТипОперации = 4 Тогда
		ПараметрыФормы.Вставить("Режим", ?(Режим = "ПриемкаПриходногоОрдера", "РедактированиеПриемка", "РедактированиеПересчет")); // Роман.П 06.11.2026 — редактирование приемки
		ПараметрыФормы.Вставить("Количество", Элемент.ТекущиеДанные.КоличествоУпаковокРазмещено); // Консоль AL 26.10.2026 — как в УТ11: при пересчете редактируется факт
	Иначе
		ПараметрыФормы.Вставить("Режим", "Просмотр");
	КонецЕсли;
	
	
	Если Элемент.ТекущиеДанные.ЯчейкаЗамена.Пустая() Тогда
		ПараметрыФормы.Вставить("Ячейка", Элемент.ТекущиеДанные.Ячейка);
	Иначе
		ПараметрыФормы.Вставить("Ячейка", Элемент.ТекущиеДанные.ЯчейкаЗамена);
	КонецЕсли;	
	
	ОткрытаДочерняяФорма = Истина; // Консоль AL 26.10.2026 — пока открыта карточка, сканер обслуживает ее
	ОткрытьФорму(
	"Обработка.МобильноеРабочееМестоКладовщика.Форма.КарточкаТовара",ПараметрыФормы,
	ЭтотОбъект,,,,Описание,
	РежимОткрытияОкнаФормы.Независимый);
	
	
КонецПроцедуры

&НаКлиенте
Процедура Подтвердить(Команда)
	
	Если ТипОперации = 3 И НЕ ЗначениеЗаполнено(ЯчейкаЗамена) Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = НСтр("ru='Укажите ячейку для размещения'");
		СообщениеПользователю.Сообщить();
		Возврат;
	КонецЕсли;
	
	ЗакрытьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(ДанныеСледующейЯчейки = Неопределено)
	
	МассивРазмещений = Новый Массив;
	
	Для Каждого Строка Из Товары Цикл
		Структура = СтруктураТоваров();
		ЗаполнитьЗначенияСвойств(Структура, Строка);
		Структура.Вставить("КоличествоУпаковок", Строка.КоличествоУпаковокРазмещено);
		МассивРазмещений.Добавить(Структура);
	КонецЦикла;
	
	РезультатСборки = Новый Структура;
	РезультатСборки.Вставить("Ячейка"				, Ячейка);
	РезультатСборки.Вставить("МассивРазмещений"		, МассивРазмещений);
	РезультатСборки.Вставить("Режим"				, Режим);
	РезультатСборки.Вставить("ШтрихкодыУпаковок"	, ШтрихкодыУпаковок);
	РезультатСборки.Вставить("ДанныеСледующейЯчейки", ДанныеСледующейЯчейки);
	
	Закрыть(РезультатСборки);
	
	
КонецПроцедуры

&НаКлиенте
Процедура Блокировать(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ячейка", Ячейка);
	
	ОткрытьФорму(
	"Обработка.МобильноеРабочееМестоКладовщика.Форма.БлокировкаЯчейки",ПараметрыФормы,
	ЭтаФорма,,,,,
	РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

&НаКлиенте
Процедура Сканировать(Команда)
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Ячейка", НСтр("ru = 'Ячейку'"));
	СписокЗначений.Добавить("Товар", НСтр("ru = 'Товар'"));
	СписокЗначений.Добавить("Отмена", НСтр("ru = 'Отмена'"));
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаВыбор", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Сканировать'"), СписокЗначений, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискПоШтрихкоду(Команда)
	
	ТекШтрихкод = "";
	
	ОбработкаЗавершения = Новый ОписаниеОповещения("ПоискПоШтрихкодуЗавершение", ЭтотОбъект,
	Новый Структура("ТекШтрихкод", ТекШтрихкод));
	
	#Если МобильныйКлиент Тогда
		ОткрытьФорму("ОбщаяФорма.ФормаПоискаПоШтрихкоду", , , , , , ОбработкаЗавершения);
	#Иначе
		ПоказатьВводЗначения(ОбработкаЗавершения, ТекШтрихкод, НСтр("ru = 'Введите штрихкод'"));
	#КонецЕсли
	
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Если ТипОперации = 1 Тогда
		ОбновитьПодсказку();
		Элементы.Подтвердить.Заголовок = НСтр("ru = 'Закончить размещение'");
		ЭтаФорма.Заголовок = НСтр("ru = 'Размещение в ячейку'");
	ИначеЕсли ТипОперации = 2 Тогда
		ОбновитьПодсказку();
		Элементы.Подтвердить.Заголовок = НСтр("ru = 'Закончить отбор'");
		ЭтаФорма.Заголовок             = НСтр("ru = 'Отбор из ячейки'");
	ИначеЕсли ТипОперации = 3 Тогда
		ОбновитьПодсказку();
		Элементы.Подтвердить.Заголовок             = НСтр("ru = 'Переместить'");
		ЭтаФорма.Заголовок                         = НСтр("ru = 'Перемещение'");
		Элементы.ЯчейкаЗамена.Видимость            = Истина;
		Элементы.ГруппаПодсказка.Видимость         = Ложь;
		Элементы.ТоварыЗаголовокФакт.Видимость     = Ложь;
		Элементы.ТоварыУпаковкаРазмещено.Видимость = Истина;
		Элементы.Ячейка.Заголовок                  = НСтр("ru = 'Ячейка отбор'");
		Элементы.ЯчейкаЗамена.Заголовок            = НСтр("ru = 'Ячейка размещение'");
	ИначеЕсли ТипОперации = 4 Тогда
		ОбновитьПодсказку();
		Элементы.Подтвердить.Заголовок = НСтр("ru = 'Закончить пересчет'");
		ЭтаФорма.Заголовок             = НСтр("ru = 'Пересчет в ячейке'");
	КонецЕсли;
	
	// Роман.П 06.11.2026 — существующая форма адаптируется только для приемки ордера
	Если ТипОперации = 4 И Режим = "ПриемкаПриходногоОрдера" Тогда
		Заголовок = "Приемка в ячейку";
		Элементы.Подтвердить.Заголовок = "Закончить приемку в ячейку";
		Элементы.Блокировать.Видимость = Ложь;
		Элементы.ГруппаПодсказка.Видимость = Ложь;
		// В этой форме собирается факт, а не пересчитывается план: сравнение с нулем не требуется.
		Элементы.ТоварыКоличествоУпаковок.Видимость = Ложь;
		Для Каждого СтрокаТовара Из Товары Цикл
			СтрокаТовара.ЗаголовокФакт = "Принято";
		КонецЦикла;
		Возврат;
	КонецЕсли;
	// Конец Роман.П
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыКоличествоУпаковокРазмещено");
	
	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Товары.КоличествоУпаковок");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ЭлементОтбора.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Товары.КоличествоУпаковокРазмещено");
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаПроблема);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкод(Штрихкод)
	
	// Консоль AL 22.10.2026 — отсканирован код маркировки: типовым разбором получаем штрихкод товара (EAN)
	// и дальше ищем товар как по обычному штрихкоду (ячейку код маркировки обозначать не может, подмена безвредна)
	ДанныеМаркировки = МенеджерОборудованияМаркировкаКлиент.РазобратьШтриховойКодТовара(Штрихкод);
	Если ЗначениеЗаполнено(ДанныеМаркировки.EAN) Тогда
		Штрихкод = ДанныеМаркировки.EAN;
	КонецЕсли;
	// Конец Консоль AL
	
	ЭтоЯчейка = Ложь;
	ЭтоТовар = Ложь;
	
	РезультатПоискаЯчейки = НайтиЯчейкуСервер(Склад, Штрихкод);
	ШтрихкодЯчейки = ЗначениеЗаполнено(РезультатПоискаЯчейки.Ячейка);
	
	Если ШтрихкодЯчейки Тогда
		Если РезультатПоискаЯчейки.Ячейка = Ячейка Тогда
			ЗакрытьФорму();
			Возврат;
		Иначе
			// Консоль AL 19.11.2026 — в приемке ордера скан другой ячейки всегда закрывает форму:
			// пустое наполнение переходит к новой ячейке, заполненное сначала принимает результат у владельца. 
			// Роман.П 19.11.2026 - по хорешму надо для всего так делать. Но пока отложим, надо основное закончить, а котда доберёмся до другого документа будем исправять (скорее всего как доберусь до инвентаризации)
			Если Режим = "ПриемкаПриходногоОрдера" Тогда
				ЗакрытьФорму(РезультатПоискаЯчейки);
				Возврат;
			КонецЕсли;
			// Конец Консоль AL
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = НСтр("ru='Для перехода к следующей ячейке закончите работу с текущей'");
			СообщениеПользователю.Сообщить();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыКарточкаТовара = НайтиТоварСервер(Штрихкод);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыКарточкаТовара.Номенклатура) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='Не найдена номенклатура со штрихкодом: %1'"), Штрихкод);
		//ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		МобильноеРабочееМестоКладовщикаКлиент.ШтрихкодНеРаспознан(ТекстОшибки, Штрихкод);
		Возврат;
	КонецЕсли;
	
	// Консоль AL 26.10.2026 — открытие карточки товара вынесено в отдельную процедуру (используется и для следующего товара из карточки)
	ОткрытьКарточкуОтсканированногоТовара(ПараметрыКарточкаТовара);	
	
	
КонецПроцедуры

// Обрабатывает введенный штрихкод и передает его на обработку.
//
// Параметры:
//  Результат - Строка, Неопределено - введенный штрихкод;
//  ДополнительныеПараметры - Структура - см. ПоискПоШтрихкоду:
//   * ТекШтрихкод - Строка - штрихкод по умолчанию.
//
&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОценкаПроизводительностиКлиент.ЗамерВремени(СтрШаблон("ПоискПоШтрихкоду%1",
	РаботаСФормойДокументаКлиентСервер.ПолучитьИмяФормыСтрокой(ИмяФормы)));
	
	ТекШтрихкод = ?(Результат = Неопределено, СокрЛП(ДополнительныеПараметры.ТекШтрихкод), СокрЛП(Результат));
	
	Если Не ПустаяСтрока(ТекШтрихкод) Тогда
		ОбработатьШтрихкод(ТекШтрихкод);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураТоваров()
	
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура","");
	Структура.Вставить("Характеристика","");
	Структура.Вставить("Серия","");
	Структура.Вставить("Назначение","");
	Структура.Вставить("Упаковка","");
	Структура.Вставить("УпаковкаРазмещено","");
	Структура.Вставить("КоличествоУпаковок","");
	Структура.Вставить("КоличествоУпаковокРазмещено","");
	Структура.Вставить("Ячейка","");
	Структура.Вставить("ЯчейкаЗамена","");
	Структура.Вставить("НомерСтроки","");
	
	Возврат Структура;
	
КонецФункции

&НаКлиенте
Процедура РезультатЗаменыЯчейки(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЯчейкаЗамена = Результат;
	Элементы.Ячейка.Видимость = Ложь;
	Элементы.ЯчейкаЗамена.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПодсказку()
	
	Если ТипОперации = 1 Тогда
		Элементы.ЗаголовокПодсказка1.Заголовок = НСтр("ru = 'Размещено строк'");
	ИначеЕсли ТипОперации = 4 Тогда
		Элементы.ЗаголовокПодсказка1.Заголовок = ?(Режим = "ПриемкаПриходногоОрдера", "Принято", "Пересчитано"); // Роман.П 06.11.2026 — текст приемки
	Иначе
		Элементы.ЗаголовокПодсказка1.Заголовок = НСтр("ru = 'Отобрано строк'");
	КонецЕсли;
	
	План = Товары.Количество();
	ОтработаноСтрокБезОшибок = 0;
	Для Каждого Строка Из Товары Цикл
		Если Строка.КоличествоУпаковок = Строка.КоличествоУпаковокРазмещено Тогда
			ОтработаноСтрокБезОшибок = ОтработаноСтрокБезОшибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ЗаголовокПодсказкаФакт.Заголовок = ОтработаноСтрокБезОшибок;
	Элементы.ЗаголовокПодсказкаПлан.Заголовок = План;
	Элементы.ЗаголовокПодсказкаРазница.Заголовок = План - ОтработаноСтрокБезОшибок;
	
	
КонецПроцедуры

// Консоль AL 26.10.2026 — результат карточки товара, открытой по сканированию штрихкода товара:
// снимает признак открытой карточки (сканер снова обслуживает эту форму) и передает результат дальше.
&НаКлиенте
Процедура РезультатКарточкиТовара(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОткрытаДочерняяФорма = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Консоль AL 11.11.2026 — проверка до изменения факта и перехода к следующему товару.
	ТекстОтказа = ПроверитьКоличествоРазмещения(Результат);
	Если ЗначениеЗаполнено(ТекстОтказа) Тогда
		МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(ТекстОтказа);
		Возврат;
	КонецЕсли;
	// Конец Консоль AL
	
	ПодтвердитьКоличество(Результат, ДополнительныеПараметры);
	
	// Консоль AL 12.11.2026 - следующую ячейку передаем через владельца после приема карточки.
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПеремещениеПоЯчейкам")
		И Результат.Свойство("ДанныеСледующейЯчейки")
		И ЗначениеЗаполнено(Результат.ДанныеСледующейЯчейки) Тогда
		ЗакрытьФорму(Результат.ДанныеСледующейЯчейки);
		Возврат;
	КонецЕсли;
	// Конец Консоль AL
	
	// Консоль AL 26.10.2026 — в карточке отсканирован другой товар: карточка закрылась с его данными (как в УТ11, ОбновитьФорму):
	// после учета текущей позиции открываем карточку отсканированного товара
	Если Результат.Свойство("ДанныеСледующегоТовара") И ЗначениеЗаполнено(Результат.ДанныеСледующегоТовара) Тогда
		РезультатСканированияТовара(Результат.ДанныеСледующегоТовара);
	КонецЕсли;
	// Конец Консоль AL
	
КонецПроцедуры

// Консоль AL 26.10.2026 — открытие карточки товара, отсканированного в карточке предыдущего товара
// (или выбранного из нескольких найденных по штрихкоду). Аналог РезультатСканированияТовара формы в УТ11.
//
// Параметры:
//  Результат - Массив - структуры с данными товаров (Номенклатура, Характеристика, Серия, Упаковка, Количество).
&НаКлиенте
Процедура РезультатСканированияТовара(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОткрытаДочерняяФорма = Ложь;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Количество() > 1 Тогда
		
		Описание = Новый ОписаниеОповещения("РезультатСканированияТовара", ЭтотОбъект);
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Товары", Результат);
		ЗначенияЗаполнения.Вставить("Режим", "ВыборНоменклатуры");
		ЗначенияЗаполнения.Вставить("Штрихкод", "");
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РезультатСканирования", ЗначенияЗаполнения);
		
		ОткрытаДочерняяФорма = Истина;
		ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.ФормаВыбораСканирование", ПараметрыФормы,
		ЭтотОбъект,,,,Описание, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	Иначе
		ОткрытьКарточкуОтсканированногоТовара(Результат[0]);
	КонецЕсли;
	
КонецПроцедуры
// Конец Консоль AL

&НаСервере
Процедура ПодтвердитьКоличество(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Номенклатура", Результат.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", Результат.Характеристика);
	СтруктураПоиска.Вставить("Упаковка", Результат.Упаковка);
	// Консоль AL 26.10.2026 — карточка товара возвращает серию типа «Партии номенклатуры», а колонка «Серия» этой формы
	// имеет тип «Серии номенклатуры»: пустые ссылки разных типов не равны, поиск существующей строки не срабатывал
	// и добавлялась новая строка. Незаполненную серию приводим к пустой ссылке типа колонки.
	Если ЗначениеЗаполнено(Результат.Серия) Тогда
		СтруктураПоиска.Вставить("Серия", Результат.Серия);
	Иначе
		СтруктураПоиска.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());
	КонецЕсли;
	// Конец Консоль AL
	
	Если Результат.Режим = "РедактированиеРазмещениеПоЯчейкам"
		ИЛИ Результат.Режим = "РедактированиеОтборИзЯчейкиОтгрузка" Тогда
		
		Литерал = "НомерСтроки";
		НомерСтроки = Результат[Литерал];
		
		СерииПриОтгрузке = СерииНоменклатурыПриОтгрузке(Результат.Номенклатура);
		
		Если Результат.Режим = "РедактированиеОтборИзЯчейкиОтгрузка"
			И Не ЗначениеЗаполнено(Товары[НомерСтроки].Серия) 
			И СерииПриОтгрузке.УказыватьПоФактуОтбора 
			И СерииПриОтгрузке.УчитыватьОстаткиСерий Тогда 
			
			СтруктураПоиска.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());
			РезультатПоиска = Товары.НайтиСтроки(СтруктураПоиска);
			
			Если РезультатПоиска.Количество() > 0 Тогда  
				ВычитаемоеЗначение = Мин(РезультатПоиска[0].КоличествоУпаковок, Результат.КоличествоУпаковок);
				РезультатПоиска[0].КоличествоУпаковок = РезультатПоиска[0].КоличествоУпаковок - ВычитаемоеЗначение; 
				НоваяСтрока = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Результат,,"КоличествоУпаковок");
				НоваяСтрока.КоличествоУпаковок = ВычитаемоеЗначение;
				НоваяСтрока.КоличествоУпаковокРазмещено = Результат.КоличествоУпаковок;
				
				Если РезультатПоиска[0].КоличествоУпаковок <= 0 Тогда
					Товары.Удалить(РезультатПоиска[0])
				КонецЕсли;
				
				ОбновитьПодсказку();
				
				Возврат;
				
			КонецЕсли; 
			
		КонецЕсли;
		
		Товары[НомерСтроки].КоличествоУпаковокРазмещено = Результат.КоличествоУпаковок;
		Если Товары[НомерСтроки].Ячейка <> Результат.Ячейка Тогда
			Товары[НомерСтроки].ЯчейкаЗамена = Результат.Ячейка;
		КонецЕсли;  		
		Товары[НомерСтроки].Серия = Результат.Серия;
		
	Иначе
		
		РезультатПоиска = Товары.НайтиСтроки(СтруктураПоиска);
		Если РезультатПоиска.Количество() > 0 Тогда
			// Консоль AL 26.10.2026 — как в УТ11: при редактировании пересчета из списка количество заменяется, а не суммируется
			Если Результат.Режим = "РедактированиеПересчет" Или Результат.Режим = "РедактированиеПриемка" Тогда // Роман.П 06.11.2026 — факт заменяется
				РезультатПоиска[0].КоличествоУпаковокРазмещено = Результат.КоличествоУпаковок;
			Иначе
				РезультатПоиска[0].КоличествоУпаковокРазмещено = РезультатПоиска[0].КоличествоУпаковокРазмещено + Результат.КоличествоУпаковок;
			КонецЕсли;
			// Конец Консоль AL
			РезультатПоиска[0].Серия = Результат.Серия; 
		ИначеЕсли Результат.КоличествоУпаковок > 0 Тогда 
			
			Если Результат.Режим = "ОтборИзЯчейкиОтгрузка" Тогда
				СтруктураПоиска.Вставить("Серия", Справочники.СерииНоменклатуры.ПустаяСсылка());
				РезультатПоиска = Товары.НайтиСтроки(СтруктураПоиска);
				Если РезультатПоиска.Количество() > 0 Тогда  
					ВычитаемоеЗначение = Мин(РезультатПоиска[0].КоличествоУпаковок, Результат.КоличествоУпаковок);
					РезультатПоиска[0].КоличествоУпаковок = РезультатПоиска[0].КоличествоУпаковок - ВычитаемоеЗначение; 
					НоваяСтрока = Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Результат,,"КоличествоУпаковок");
					НоваяСтрока.КоличествоУпаковок = ВычитаемоеЗначение;
					НоваяСтрока.КоличествоУпаковокРазмещено = Результат.КоличествоУпаковок;
					
					Если РезультатПоиска[0].КоличествоУпаковок <= 0 Тогда
						Товары.Удалить(РезультатПоиска[0])
					КонецЕсли; 
					ОбновитьПодсказку();
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Результат,,"КоличествоУпаковок");
			НоваяСтрока.КоличествоУпаковокРазмещено = Результат.КоличествоУпаковок;
			НоваяСтрока.Ячейка = Ячейка;
			
			Если Результат.Режим = "Перемещение" Тогда
				НоваяСтрока.ЯчейкаЗамена       = ЯчейкаЗамена;
				НоваяСтрока.КоличествоУпаковок = НоваяСтрока.КоличествоУпаковокРазмещено;
				НоваяСтрока.УпаковкаРазмещено  = НоваяСтрока.Упаковка;
			ИначеЕсли Результат.Режим = "РазмещениеВЯчейку" Тогда
				НоваяСтрока.ЗаголовокФакт = НСтр("ru = 'Размещено'");
			ИначеЕсли Результат.Режим = "ОтборИзЯчейкиОтгрузка" Тогда
				НоваяСтрока.ЗаголовокФакт = НСтр("ru = 'Отобрано'");
			ИначеЕсли Результат.Режим = "Приемка" Тогда
				НоваяСтрока.ЗаголовокФакт = "Принято"; // Роман.П 06.11.2026 — подпись принятого количества
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого СтрокаКодМаркировки Из Результат.ШтрихкодыУпаковок Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКодМаркировки);
	КонецЦикла;
	
	ОбновитьПодсказку();
	
КонецПроцедуры

