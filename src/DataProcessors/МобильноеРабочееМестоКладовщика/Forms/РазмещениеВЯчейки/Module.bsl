&НаКлиенте
Процедура ПослеЗакрытияВопросаВыбор(Результат, Параметры) Экспорт
	
	Если Результат = "Ячейка" Тогда
		
		Описание = Новый ОписаниеОповещения("УстановитьЯчейку", ЭтотОбъект);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТипПоиска", "ПоискЯчейки");
		ПараметрыФормы.Вставить("Склад", Склад);
		// Консоль AL 22.10.2026 — сканер обслуживает форму сканирования, даже если ВводДоступен() вернёт Ложь
		ПараметрыФормы.Вставить("ОбрабатыватьСканерБезПроверкиВвода", Истина);
		ОткрытаФормаСканирования = Истина;
		// Конец Консоль AL
		
		ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.СканированиеШтрихкода",ПараметрыФормы,
		ЭтотОбъект,,,,Описание,
		РежимОткрытияОкнаФормы.Независимый);
		
	ИначеЕсли Результат = "Товар" Тогда
		
		Описание = Новый ОписаниеОповещения("РезультатСканирования", ЭтотОбъект);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТипПоиска", "ПоискНоменклатуры");
		ПараметрыФормы.Вставить("Склад", Склад);
		ПараметрыФормы.Вставить("ДокументСсылка", Ссылка);
		// Консоль AL 22.10.2026 — сканер обслуживает форму сканирования, даже если ВводДоступен() вернёт Ложь
		ПараметрыФормы.Вставить("ОбрабатыватьСканерБезПроверкиВвода", Истина);
		ОткрытаФормаСканирования = Истина;
		// Конец Консоль AL
		
		ОткрытьФорму(
		"Обработка.МобильноеРабочееМестоКладовщика.Форма.СканированиеШтрихкода",ПараметрыФормы,
		ЭтотОбъект,,,,Описание,
		РежимОткрытияОкнаФормы.Независимый);
		
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатСканирования(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОткрытаФормаСканирования = Ложь; // Консоль AL 22.10.2026 — форма сканирования закрыта
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Консоль AL 22.10.2026 — форма сканирования номенклатуры возвращает массив найденных по штрихкоду товаров,
	// а дальнейший код ожидает структуру одного товара: при нескольких вариантах предлагаем выбрать, иначе берём единственный
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		
		Если Результат.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Если Результат.Количество() > 1 Тогда
			
			ЗначенияЗаполнения = Новый Структура;
			ЗначенияЗаполнения.Вставить("Товары", Результат);
			ЗначенияЗаполнения.Вставить("Режим", "ВыборНоменклатуры");
			ЗначенияЗаполнения.Вставить("Штрихкод", "");
			
			ПараметрыВыбора = Новый Структура;
			ПараметрыВыбора.Вставить("РезультатСканирования", ЗначенияЗаполнения);
			ПараметрыВыбора.Вставить("Склад", Склад);
			
			ОткрытаФормаСканирования = Истина;
			ОткрытьФорму(
			"Обработка.МобильноеРабочееМестоКладовщика.Форма.ФормаВыбораСканирование", ПараметрыВыбора,
			ЭтотОбъект,,,, Новый ОписаниеОповещения("РезультатСканирования", ЭтотОбъект),
			РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			Возврат;
			
		КонецЕсли;
		
		Результат = Результат[0];
		
	КонецЕсли;
	// Конец Консоль AL
	
	Описание = Новый ОписаниеОповещения("РезультатКарточкиТовара", ЭтаФорма); // Консоль AL 26.10.2026 — было: ПодтвердитьКоличество
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", Результат.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика", Результат.Характеристика);
	Если Результат.Свойство("Серия") Тогда
		ПараметрыФормы.Вставить("Серия", Результат.Серия);
	Иначе
		ПараметрыФормы.Вставить("Серия", ПустаяСерия);
	КонецЕсли;
	ПараметрыФормы.Вставить("Упаковка", Результат.Упаковка);
	ПараметрыФормы.Вставить("Количество", 1);
	Если ТипОперации = 1 Тогда
		ПараметрыФормы.Вставить("Режим", "РазмещениеВЯчейку");
	ИначеЕсли ТипОперации = 2 Тогда
		ПараметрыФормы.Вставить("Режим", "ОтборИзЯчейкиОтгрузка");
		ПараметрыФормы.Вставить("РаспоряжениеНаОтбор", РаспоряжениеНаОтбор);
	ИначеЕсли ТипОперации = 3 Тогда
		ПараметрыФормы.Вставить("Режим", "Перемещение");
	ИначеЕсли ТипОперации = 4 Тогда
		ПараметрыФормы.Вставить("Режим", ?(Режим = "ПриемкаПриходногоОрдера", "Приемка", "Пересчет")); // Роман.П 06.11.2026 — режим приемки
	Иначе
		ПараметрыФормы.Вставить("Режим", "Просмотр");
	КонецЕсли;
	ПараметрыФормы.Вставить("Ячейка", Ячейка);
	ПараметрыФормы.Вставить("НомерСтроки", 0);
	ПараметрыФормы.Вставить("Склад", Склад);
	ПараметрыФормы.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);
	ПараметрыФормы.Вставить("ДокументИсточник", Ссылка);
	Если Результат.Свойство("ШтрихкодУпаковки") Тогда
		ПараметрыФормы.Вставить("ШтрихкодУпаковки", Результат.ШтрихкодУпаковки);
	Иначе
		ПараметрыФормы.Вставить("ШтрихкодУпаковки", Неопределено);
	КонецЕсли;
	
	ОткрытьФорму(
	"Обработка.МобильноеРабочееМестоКладовщика.Форма.КарточкаТовара",ПараметрыФормы,
	ЭтаФорма,,,,Описание,
	РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЯчейку(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОткрытаФормаСканирования = Ложь; 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЯчейкаЗамена = Результат;
	
	Если ТипЗнч(ЯчейкаЗамена) = Тип("Структура") И ЯчейкаЗамена.Свойство("Ячейка") Тогда 
		ЯчейкаЗамена = ЯчейкаЗамена.Ячейка;		
	КонецЕсли;
	
	Для Каждого Строка Из Товары Цикл
		Строка.ЯчейкаЗамена = ЯчейкаЗамена;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СерииНоменклатурыПриОтгрузке(Знач Номенклатура)
	
	ВидНоменклатуры =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидНоменклатуры");
	ПолитикаУчетаСерий = Обработки.МобильноеРабочееМестоКладовщика.ПолитикаУчетаСерий(ВидНоменклатуры, Склад);
	Если ЗначениеЗаполнено(ПолитикаУчетаСерий) Тогда
		СерииПриОтгрузке = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПолитикаУчетаСерий, "УказыватьПоФактуОтбора,
		|	УчитыватьОстаткиСерий");
	Иначе
		СерииПриОтгрузке = Новый Структура("УказыватьПоФактуОтбора,
		|	УчитыватьОстаткиСерий", Ложь, Ложь);
	КонецЕсли;
	
	Возврат СерииПриОтгрузке;
	
КонецФункции 

// Консоль AL 11.11.2026 — факт проверяется до записи в таблицу размещения.
&НаСервере
Функция ПроверитьКоличествоРазмещения(ДанныеКарточки)
	
	// Консоль AL 11.11.2026 — лимит только для приемки перемещения; пересчет и прочие режимы не затронуты.
	Если Режим <> "РазмещениеВЯчейку" И Режим <> "РедактированиеРазмещениеПоЯчейкам" Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		Возврат "";
	КонецЕсли;
	
	Если ДанныеКарточки.КоличествоУпаковок < 0 Тогда
		Возврат "Количество не может быть отрицательным.";
	КонецЕсли;
	
	План = 0;
	Факт = 0;
	Для Каждого Позиция Из Товары Цикл
		Если Позиция.Номенклатура = ДанныеКарточки.Номенклатура
			И Позиция.Характеристика = ДанныеКарточки.Характеристика
			И Позиция.Упаковка = ДанныеКарточки.Упаковка Тогда
			План = План + Позиция.КоличествоУпаковок;
			Факт = Факт + Позиция.КоличествоУпаковокРазмещено;
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеКарточки.Режим = "РедактированиеРазмещениеПоЯчейкам"
		И ДанныеКарточки.НомерСтроки >= 0
		И ДанныеКарточки.НомерСтроки < Товары.Количество() Тогда
		
		Факт = Факт - Товары[ДанныеКарточки.НомерСтроки].КоличествоУпаковокРазмещено;
		
	КонецЕсли;
	
	Если Факт + ДанныеКарточки.КоличествоУпаковок > План Тогда
		Возврат "Количество превышает остаток к размещению. Результат карточки не принят.";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции
// Конец Консоль AL

