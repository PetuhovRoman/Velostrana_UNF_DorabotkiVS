#Область ОписаниеПеременных

&НаКлиенте
Перем ОткрытаДочерняяФормаСканера, ЯчейкаПриемкиТСД;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Ссылка") И ЗначениеЗаполнено(Параметры.Ссылка) Тогда
		Ссылка = Параметры.Ссылка;
	ИначеЕсли Параметры.Свойство("Склад") Тогда
		Склад = Параметры.Склад;
	КонецЕсли;

	Если Параметры.Свойство("Исполнитель") Тогда
		Исполнитель = Параметры.Исполнитель;
	КонецЕсли;

	ПоказыватьФотоТоваров = Параметры.ПоказыватьФотоТоваров;

	#Если МобильныйАвтономныйСервер Тогда
		Элементы.ФормаОтменитьПеремещение.Видимость = Ложь;
	#Иначе
		Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
			Статус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "СостояниеЗаказа");
			СостояниеЗаказаНачальное = ЗаполнениеОбъектовУНФ.ПолучитьСостояниеЗаказаНаПеремещение();
			Если Статус = СостояниеЗаказаНачальное
				И ПравоДоступа("ИнтерактивнаяПометкаУдаления", Метаданные.Документы.ПеремещениеПоЯчейкам) Тогда
				Элементы.ФормаОтменитьПеремещение.Видимость = Истина;
			Иначе
				Элементы.ФормаОтменитьПеремещение.Видимость = Ложь;
			КонецЕсли;
		Иначе
			Элементы.ФормаОтменитьПеремещение.Видимость = Ложь;
		КонецЕсли;
	#КонецЕсли

	ЗаполнитьФорму();

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Заголовок = Строка(Ссылка);
	Иначе
		Заголовок = НСтр("ru = 'Новое перемещение по ячейкам'");
	КонецЕсли;


КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["СтраницаИнформация"] Тогда
		СтандартнаяОбработка = Ложь;
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["СтраницаКПоступлению"];
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если Источник <> "ПодключаемоеОборудование" Или ИмяСобытия <> "ScanData"
		Или ОткрытаДочерняяФормаСканера = Истина Тогда
		Возврат;
	КонецЕсли;

	Если Не МенеджерОборудованияУНФКлиент.ЕстьНеобработанноеСобытие() Тогда
		Возврат;
	КонецЕсли;

	Если Параметр[1] = Неопределено Тогда
		Штрихкод = Параметр[0];
	Иначе
		Штрихкод = Параметр[1][1];
	КонецЕсли;

	ОбработатьШтрихкод(Штрихкод);


КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		Если Не ЗначениеЗаполнено(ЯчейкаПриемкиТСД) Тогда
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД("Сначала отсканируйте ячейку назначения.");
			Возврат;
		КонецЕсли;
		ЗапроситьПриемкуСтрокиТСД(Элемент.ТекущаяСтрока);
		Возврат;
	КонецЕсли;

	Описание = Новый ОписаниеОповещения("ЗавершитьРазмещениеВЯчейку", ЭтотОбъект);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", Элемент.ТекущиеДанные.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика", Элемент.ТекущиеДанные.Характеристика);
	ПараметрыФормы.Вставить("Серия", Элемент.ТекущиеДанные.Серия);
	ПараметрыФормы.Вставить("Упаковка", Элемент.ТекущиеДанные.УпаковкаОтбор);
	ПараметрыФормы.Вставить("УпаковкаРазмещено", Элемент.ТекущиеДанные.УпаковкаРазмещение);
	ПараметрыФормы.Вставить("КоличествоУпаковок", Элемент.ТекущиеДанные.КоличествоУпаковокОтбор);
	ПараметрыФормы.Вставить("КоличествоУпаковокРазмещено", Элемент.ТекущиеДанные.КоличествоУпаковокРазмещение);
	ПараметрыФормы.Вставить("Режим", "ПересчетРедактирование");
	ПараметрыФормы.Вставить("НомерСтроки", Элемент.ТекущаяСтрока);
	ПараметрыФормы.Вставить("Склад", Склад);
	ПараметрыФормы.Вставить("Ячейка", Элемент.ТекущиеДанные.ЯчейкаОтбор);
	ПараметрыФормы.Вставить("ЯчейкаЗамена", Элемент.ТекущиеДанные.ЯчейкаРазмещение);
	ПараметрыФормы.Вставить("ТипОперации", 3);
	ПараметрыФормы.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);
	ПараметрыФормы.Вставить("Артикул", Элемент.ТекущиеДанные.Артикул);
	ПараметрыФормы.Вставить("Ссылка", Ссылка);

	ОткрытаДочерняяФормаСканера = Истина;

	ОткрытьФорму("Обработка.МобильноеРабочееМестоКладовщика.Форма.РазмещениеВЯчейки",
		ПараметрыФормы, ЭтотОбъект, , , , Описание, РежимОткрытияОкнаФормы.Независимый);


КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакончитьКонтроль(Команда)

	ОчиститьСообщения();

	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Завершить", НСтр("ru = 'Завершить'"));
	СписокЗначений.Добавить("Продолжить", НСтр("ru = 'Продолжить'"));

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Завершить перемещение?'"), СписокЗначений, 0);


КонецПроцедуры

&НаКлиенте
Процедура Сканировать(Команда)

	Описание = Новый ОписаниеОповещения("РезультатПоискаЯчейки", ЭтотОбъект);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТипПоиска", "ПоискЯчейки");
	ПараметрыФормы.Вставить("Склад", Склад);

	ОткрытаДочерняяФормаСканера = Истина;

	ОткрытьФорму("Обработка.МобильноеРабочееМестоКладовщика.Форма.СканированиеШтрихкода",
		ПараметрыФормы, ЭтотОбъект, , , , Описание, РежимОткрытияОкнаФормы.Независимый);


КонецПроцедуры

&НаКлиенте
Процедура ПоискПоШтрихкоду(Команда)

	ТекШтрихкод = "";

	ОбработкаЗавершения = Новый ОписаниеОповещения("ПоискПоШтрихкодуЗавершение", ЭтотОбъект,
		Новый Структура("ТекШтрихкод", ТекШтрихкод));

	#Если МобильныйКлиент Тогда
		ОткрытьФорму("ОбщаяФорма.ФормаПоискаПоШтрихкоду", , , , , , ОбработкаЗавершения);
	#Иначе
		ПоказатьВводЗначения(ОбработкаЗавершения, ТекШтрихкод, НСтр("ru = 'Введите штрихкод'"));
	#КонецЕсли


КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПеремещение(Команда)

	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Завершить", НСтр("ru = 'Пометить документ на удаление'"));
	СписокЗначений.Добавить("Продолжить", НСтр("ru = 'Продолжить перемещение'"));

	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОтменитьПеремещение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Для отмены перемещения необходимо пометить на удаление документ перемещения. Вернуться к редактированию будет невозможно. Пометить на удаление?'"),
		СписокЗначений, 0);


КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет таблицу товаров и реквизиты формы по данным документа «Перемещение по ячейкам» или «Заказ на перемещение».
&НаСервере
Процедура ЗаполнитьФорму()

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		ДокументПеремещения = Ссылка.ПолучитьОбъект();
		Склад = ДокументПеремещения.СтруктурнаяЕдиница;
		Комментарий = ДокументПеремещения.Комментарий;

		Товары.Очистить();

		Для Каждого Позиция Из ДокументПеремещения.Запасы Цикл
			НоваяСтрока = Товары.Добавить();

			НоваяСтрока.Номенклатура = Позиция.Номенклатура;
			НоваяСтрока.Характеристика = Позиция.Характеристика;
			НоваяСтрока.Серия = Позиция.Партия;
			НоваяСтрока.Артикул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Позиция.Номенклатура, "Артикул");
			НоваяСтрока.УпаковкаОтбор = Позиция.ЕдиницаИзмерения;
			НоваяСтрока.УпаковкаРазмещение = Позиция.ЕдиницаИзмерения;
			НоваяСтрока.КоличествоОтбор = Позиция.Количество;
			НоваяСтрока.КоличествоУпаковокОтбор = Позиция.Количество;
			НоваяСтрока.ЯчейкаОтбор = ДокументПеремещения.Ячейка;
			НоваяСтрока.ЯчейкаРазмещение = Позиция.Ячейка;

			Если ЗначениеЗаполнено(Позиция.Ячейка) Тогда
				НоваяСтрока.КоличествоРазмещение = Позиция.Количество;
				НоваяСтрока.КоличествоУпаковокРазмещение = Позиция.Количество;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
		ЗаполнитьОстаткиЗаказа();
	КонецЕсли;


КонецПроцедуры

// Обрабатывает отсканированный штрихкод в соответствии с типом задания.
//
// Параметры:
//  Штрихкод - Строка - распознанный штрихкод товара или ячейки.
//
&НаКлиенте
Процедура ОбработатьШтрихкод(Штрихкод)

	ДанныеМаркировки = МенеджерОборудованияМаркировкаКлиент.РазобратьШтриховойКодТовара(Штрихкод);
	Если ЗначениеЗаполнено(ДанныеМаркировки.EAN) Тогда
		Штрихкод = ДанныеМаркировки.EAN;
	КонецЕсли;

	ДанныеСкана = НайтиДанныеСканаЗадания(Штрихкод);

	Если ДанныеСкана = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
		Если ЗначениеЗаполнено(ДанныеСкана.Ячейка) Тогда
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
				"Для сборки заказа сканируйте товар. Ячейки в заказе не используются.");
			Возврат;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ДанныеСкана.Товар.Номенклатура) Тогда
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД("Не найден товар по штрихкоду: " + Штрихкод);
			Возврат;
		КонецЕсли;

		ОсталосьСобрать = ДанныеСкана.Товар.Количество;
		Если ОсталосьСобрать <= 0 Тогда
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
				"Для штрихкода не определено положительное количество.");
			Возврат;
		КонецЕсли;

		ДоступноСобрать = 0;

		Для Каждого СтрокаЗаказаФормы Из Товары Цикл
			Если СовпадаетПозицияСборки(СтрокаЗаказаФормы, ДанныеСкана.Товар, Ложь) Тогда
				ДоступноСобрать = ДоступноСобрать + Макс(0,
					СтрокаЗаказаФормы.КоличествоУпаковокОтбор - СтрокаЗаказаФормы.КоличествоУпаковокРазмещение);
			КонецЕсли;
		КонецЦикла;

		Если ОсталосьСобрать > ДоступноСобрать Тогда
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
				"Товар отсутствует в заказе или количество скана превышает остаток к сборке.");
			Возврат;
		КонецЕсли;

		Для Каждого СтрокаЗаказаФормы Из Товары Цикл
			Если ОсталосьСобрать = 0 Тогда
				Прервать;
			КонецЕсли;
			Если СовпадаетПозицияСборки(СтрокаЗаказаФормы, ДанныеСкана.Товар, Ложь) Тогда
				ДобавитьФакт = Мин(ОсталосьСобрать, Макс(0,
					СтрокаЗаказаФормы.КоличествоУпаковокОтбор - СтрокаЗаказаФормы.КоличествоУпаковокРазмещение));
				СтрокаЗаказаФормы.КоличествоУпаковокРазмещение =
					СтрокаЗаказаФормы.КоличествоУпаковокРазмещение + ДобавитьФакт;
				СтрокаЗаказаФормы.КоличествоРазмещение = СтрокаЗаказаФормы.КоличествоУпаковокРазмещение;
				ОсталосьСобрать = ОсталосьСобрать - ДобавитьФакт;
			КонецЕсли;
		КонецЦикла;

		Возврат;
	КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		Если ЗначениеЗаполнено(ДанныеСкана.Ячейка) Тогда
			РазобратьСканЯчейкиПеремещения(ДанныеСкана.Ячейка, Штрихкод);
		Иначе
			РазобратьСканТовараПеремещения(ДанныеСкана.Товар);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеСкана.Ячейка) Тогда
		РезультатПоискаЯчейки(ДанныеСкана.Ячейка);
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДанныеСкана.Товар.Номенклатура) Тогда
		МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД("Не найден товар или ячейка по штрихкоду: " + Штрихкод);
		Возврат;
	КонецЕсли;

	// Товар открывается в уже используемой форме ввода количества; результат идет по прежней цепочке.
	Для Каждого СтрокаТовара Из Товары Цикл
		Если СовпадаетПозицияСборки(СтрокаТовара, ДанныеСкана.Товар, Ложь)
			И СтрокаТовара.КоличествоУпаковокРазмещение < СтрокаТовара.КоличествоУпаковокОтбор Тогда
			ОткрытьСтрокуПоСкану(СтрокаТовара);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД("Товар отсутствует в задании или план по нему уже собран.");


КонецПроцедуры

// Обрабатывает введенный штрихкод и передает его на обработку.
//
// Параметры:
//  Результат - Строка, Неопределено - введенный штрихкод;
//  ДополнительныеПараметры - Структура - см. ПоискПоШтрихкоду:
//   * ТекШтрихкод - Строка - штрихкод по умолчанию.
//
&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(Результат, ДополнительныеПараметры) Экспорт

	ОценкаПроизводительностиКлиент.ЗамерВремени(СтрШаблон("ПоискПоШтрихкоду%1",
		РаботаСФормойДокументаКлиентСервер.ПолучитьИмяФормыСтрокой(ИмяФормы)));

	ТекШтрихкод = ?(Результат = Неопределено, СокрЛП(ДополнительныеПараметры.ТекШтрихкод), СокрЛП(Результат));

	Если Не ПустаяСтрока(ТекШтрихкод) Тогда
		ОбработатьШтрихкод(ТекШтрихкод);
	КонецЕсли;


КонецПроцедуры

// Обрабатывает результат поиска ячейки и открывает приемку в найденную ячейку.
//
// Параметры:
//  Результат - СправочникСсылка.Ячейки, Неопределено - найденная ячейка;
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура РезультатПоискаЯчейки(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	ОткрытаДочерняяФормаСканера = Ложь;

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		ОткрытьПриемкуВЯчейкуТСД(Результат);
		Возврат;
	КонецЕсли;

	Описание = Новый ОписаниеОповещения("ЗавершитьРазмещениеВЯчейку", ЭтотОбъект);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ячейка", Результат);
	ПараметрыФормы.Вставить("Склад", Склад);
	ПараметрыФормы.Вставить("ТипОперации", 3);
	ПараметрыФормы.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);
	ПараметрыФормы.Вставить("Ссылка", Ссылка);

	ОткрытаДочерняяФормаСканера = Истина;

	ОткрытьФорму("Обработка.МобильноеРабочееМестоКладовщика.Форма.РазмещениеВЯчейки",
		ПараметрыФормы, ЭтотОбъект, , , , Описание, РежимОткрытияОкнаФормы.Независимый);


КонецПроцедуры

// Обрабатывает результат работы формы размещения в ячейки.
//
// Параметры:
//  Результат - Структура, Неопределено - результат размещения, возвращенный формой «РазмещениеВЯчейки»;
//  ДополнительныеПараметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ЗавершитьРазмещениеВЯчейку(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	ОткрытаДочерняяФормаСканера = Ложь;

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
		ПринятьРезультатСборкиЗаказа(Результат);
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		Попытка
			ЗаписатьРазмещенияТСД(Результат);
		Исключение
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(ОписаниеОшибки());
			Возврат;
		КонецПопытки;

		Если Результат.Свойство("ДанныеСледующейЯчейки")
			И ЗначениеЗаполнено(Результат.ДанныеСледующейЯчейки) Тогда
			ОткрытьПриемкуВЯчейкуТСД(Результат.ДанныеСледующейЯчейки.Ячейка);
		КонецЕсли;

		Возврат;
	КонецЕсли;

	Для Каждого Строка Из Результат.МассивРазмещений Цикл
		Если Результат.Режим = "ПересчетРедактирование" Тогда
			НоваяСтрока = Товары[Строка.НомерСтроки];
		Иначе
			НоваяСтрока = Товары.Добавить();
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);

		НоваяСтрока.ЯчейкаОтбор = Строка.Ячейка;
		НоваяСтрока.ЯчейкаРазмещение = Строка.ЯчейкаЗамена;
		НоваяСтрока.УпаковкаОтбор = Строка.Упаковка;
		НоваяСтрока.УпаковкаРазмещение = Строка.УпаковкаРазмещено;
		НоваяСтрока.КоличествоУпаковокОтбор = Строка.КоличествоУпаковок;
		НоваяСтрока.КоличествоУпаковокРазмещение = Строка.КоличествоУпаковокРазмещено;
	КонецЦикла;


КонецПроцедуры

// Обрабатывает ответ на вопрос о завершении перемещения.
//
// Параметры:
//  Результат - Строка - выбранный вариант ответа: "Завершить" или "Продолжить";
//  Параметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт

	Если Результат = "Завершить" Тогда
		Попытка
			ОтборЗавершен = ЗакончитьПеремещениеНаСервере();
		Исключение
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(ОписаниеОшибки());
			Возврат;
		КонецПопытки;

		Если ОтборЗавершен Тогда
			Закрыть();
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;


КонецПроцедуры

// Проводит перемещение по ячейкам по итогам работы с заданием или создает новый документ перемещения.
//
// Возвращаемое значение:
//  Булево - Истина, если перемещение завершено и форму можно закрывать.
//
&НаСервере
Функция ЗакончитьПеремещениеНаСервере()

	Если Товары.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрано ни одного товара для перемещения'");
	КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
		СоздатьОтгрузкуПоЗаказу();
		Возврат Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Ссылка) И ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		ДокументОбъект = Ссылка.ПолучитьОбъект();
		ЕстьНепринятыеСтроки = Ложь;
		Для Каждого Позиция Из ДокументОбъект.Запасы Цикл
			Если Не ЗначениеЗаполнено(Позиция.Ячейка) Тогда
				ЕстьНепринятыеСтроки = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЕстьНепринятыеСтроки Тогда
			СостояниеВРаботе = Справочники.СостоянияЗаказовНаПеремещение.НайтиПоНаименованию("В работе", Истина);

			Если Не ЗначениеЗаполнено(СостояниеВРаботе) Тогда
				ВызватьИсключение "В справочнике состояний заказов на перемещение не найдено состояние «В работе».";
			КонецЕсли;

			ДокументОбъект.СостояниеЗаказа = СостояниеВРаботе;
			Если ДокументОбъект.Проведен Тогда
				// Обработчик объекта требует перепроведения при смене состояния проведенного документа.
				// Незавершенное состояние по правилам расширения не формирует складских движений.
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		Иначе
			ДокументОбъект.СостояниеЗаказа = Справочники.СостоянияЗаказовНаПеремещение.Завершен;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	Иначе
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
			Для Каждого СтрокаЗаказаФормы Из Товары Цикл
				Если СтрокаЗаказаФормы.КоличествоУпаковокРазмещение <= 0 Тогда
					ВызватьИсключение "Подтвердите сборку каждой позиции заказа перед завершением.";
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// Формирование нового документа «Перемещение по ячейкам» (в т.ч. на основании «Заказа на перемещение»)
		ДокументОбъект = Документы.ПеремещениеПоЯчейкам.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПеремещениеПоЯчейкам.ИзОднойВНесколько;
		ДокументОбъект.СтруктурнаяЕдиница = Склад;

		ОрганизацияСклада = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "Организация");

		Если ЗначениеЗаполнено(ОрганизацияСклада) Тогда
			ДокументОбъект.Организация = ОрганизацияСклада;
		ИначеЕсли ЗначениеЗаполнено(Ссылка) Тогда
			ДокументОбъект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Организация");
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
			ДокументОбъект.Организация = Справочники.Организации.ОсновнаяОрганизация();
		КонецЕсли;

		Если ЗначениеЗаполнено(Исполнитель) Тогда
			ДокументОбъект.Автор = Исполнитель;
		Иначе
			ДокументОбъект.Автор = Пользователи.ТекущийПользователь();
		КонецЕсли;

		ДокументОбъект.Комментарий = Комментарий;
		ДокументОбъект.СостояниеЗаказа = Справочники.СостоянияЗаказовНаПеремещение.Завершен;

		Если ЗначениеЗаполнено(Товары[0].ЯчейкаОтбор) Тогда
			ДокументОбъект.Ячейка = Товары[0].ЯчейкаОтбор;
		КонецЕсли;

		ДокументОбъект.Запасы.Очистить();

		Для Каждого Строка Из Товары Цикл
			НоваяСтрока = ДокументОбъект.Запасы.Добавить();

			НоваяСтрока.Номенклатура = Строка.Номенклатура;
			НоваяСтрока.Характеристика = Строка.Характеристика;
			НоваяСтрока.Партия = Строка.Серия;
			НоваяСтрока.Количество = ?(Строка.КоличествоРазмещение > 0,
				Строка.КоличествоРазмещение, Строка.КоличествоОтбор);
			НоваяСтрока.ЕдиницаИзмерения = ?(ЗначениеЗаполнено(Строка.УпаковкаРазмещение),
				Строка.УпаковкаРазмещение, Строка.УпаковкаОтбор);
			НоваяСтрока.Ячейка = ?(ЗначениеЗаполнено(Строка.ЯчейкаРазмещение),
				Строка.ЯчейкаРазмещение, Строка.ЯчейкаОтбор);
		КонецЦикла;

		НачатьТранзакцию();
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;


	Возврат Истина;

КонецФункции

// Обрабатывает ответ на вопрос об отмене перемещения.
//
// Параметры:
//  Результат - Строка - выбранный вариант ответа: "Завершить" или "Продолжить";
//  Параметры - Неопределено - не используется.
//
&НаКлиенте
Процедура ПослеЗакрытияВопросаОтменитьПеремещение(Результат, Параметры) Экспорт

	Если Результат = "Завершить" Тогда
		Попытка
			ПеремещениеОтменено = ОтменитьПеремещениеНаСервере();
		Исключение
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(ОписаниеОшибки());
			Возврат;
		КонецПопытки;

		Если ПеремещениеОтменено Тогда
			Закрыть();
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;


КонецПроцедуры

// Помечает документ перемещения на удаление.
//
// Возвращаемое значение:
//  Булево - Истина, если документ помечен на удаление или отменять нечего.
//
&НаСервере
Функция ОтменитьПеремещениеНаСервере()

	Если Не ЗначениеЗаполнено(Ссылка) Или ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ПеремещениеПоЯчейкам") Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		ДокументОбъект = Ссылка.ПолучитьОбъект();
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось отменить задание на перемещение.'"));

		Возврат Ложь;
	КонецПопытки;


	Возврат Истина;

КонецФункции

// Переносит результат сборки заказа в таблицу товаров формы.
//
// Параметры:
//  РезультатСборки - Структура - результат работы формы «РазмещениеВЯчейки»:
//   * МассивРазмещений - Массив из Структура - размещенные позиции;
//   * Режим - Строка - режим размещения, например "ПересчетРедактирование".
//
&НаКлиенте
Процедура ПринятьРезультатСборкиЗаказа(РезультатСборки)

	Для Каждого СобраннаяСтрока Из РезультатСборки.МассивРазмещений Цикл
		КоличествоФакт = СобраннаяСтрока.КоличествоУпаковокРазмещено;

		Если КоличествоФакт < 0 Тогда
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД("Собранное количество не может быть отрицательным.");
			Продолжить;
		КонецЕсли;

		Если РезультатСборки.Режим = "ПересчетРедактирование" Тогда
			// При ручной корректировке изменяем именно выбранную строку, не первую похожую.
			Если СобраннаяСтрока.НомерСтроки < 0 Или СобраннаяСтрока.НомерСтроки >= Товары.Количество() Тогда
				МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
					"Строка задания не найдена. Откройте задание заново.");
				Продолжить;
			КонецЕсли;

			СтрокаФормы = Товары[СобраннаяСтрока.НомерСтроки];
			Если Не СовпадаетПозицияСборки(СтрокаФормы, СобраннаяСтрока)
				Или КоличествоФакт > СтрокаФормы.КоличествоУпаковокОтбор Тогда
				МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
					"Позиция не совпадает или количество превышает план строки.");
				Продолжить;
			КонецЕсли;

			УстановитьФактСборки(СтрокаФормы, СобраннаяСтрока, КоличествоФакт);
			Продолжить;
		КонецЕсли;

		// До изменения строк проверяем суммарную свободную емкость подходящих позиций.
		Доступно = 0;
		Для Каждого Кандидат Из Товары Цикл
			Если СовпадаетПозицияСборки(Кандидат, СобраннаяСтрока) Тогда
				Доступно = Доступно + Макс(0,
					Кандидат.КоличествоУпаковокОтбор - Кандидат.КоличествоУпаковокРазмещение);
			КонецЕсли;
		КонецЦикла;

		Если КоличествоФакт > Доступно Тогда
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
				"Товар отсутствует в заказе или собранное количество превышает остаток плана. Позиция не принята.");
			Продолжить;
		КонецЕсли;

		Осталось = КоличествоФакт;
		Для Каждого Кандидат Из Товары Цикл
			Если Осталось = 0 Тогда
				Прервать;
			КонецЕсли;

			Если Не СовпадаетПозицияСборки(Кандидат, СобраннаяСтрока) Тогда
				Продолжить;
			КонецЕсли;

			ДобавитьКоличество = Мин(Осталось, Макс(0,
				Кандидат.КоличествоУпаковокОтбор - Кандидат.КоличествоУпаковокРазмещение));
			Если ДобавитьКоличество > 0 Тогда
				УстановитьФактСборки(Кандидат, СобраннаяСтрока,
					Кандидат.КоличествоУпаковокРазмещение + ДобавитьКоличество);
				Осталось = Осталось - ДобавитьКоличество;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;


КонецПроцедуры

// Сравнивает позицию таблицы товаров с собранной позицией заказа.
//
// Параметры:
//  СтрокаФормы - ДанныеФормыЭлементКоллекции - строка таблицы товаров формы;
//  СобраннаяСтрока - Структура - собранная позиция из результата размещения;
//  СравниватьСерию - Булево - Истина, если дополнительно сверять серию.
//
// Возвращаемое значение:
//  Булево - Истина, если номенклатура, характеристика и упаковка совпадают,
//           а при СравниватьСерию = Истина совпадает и серия.
//
&НаКлиенте
Функция СовпадаетПозицияСборки(СтрокаФормы, СобраннаяСтрока, СравниватьСерию = Истина)

	Совпадает = СтрокаФормы.Номенклатура = СобраннаяСтрока.Номенклатура
		И СтрокаФормы.Характеристика = СобраннаяСтрока.Характеристика
		И СтрокаФормы.УпаковкаОтбор = СобраннаяСтрока.Упаковка;

	Если СравниватьСерию Тогда
		Совпадает = Совпадает И СтрокаФормы.Серия = СобраннаяСтрока.Серия;
	КонецЕсли;


	Возврат Совпадает;

КонецФункции

// Записывает фактически собранное количество и ячейку в строку таблицы товаров.
//
// Параметры:
//  СтрокаФормы - ДанныеФормыЭлементКоллекции - строка таблицы товаров формы;
//  СобраннаяСтрока - Структура - собранная позиция из результата размещения;
//  КоличествоФакт - Число - фактически собранное количество упаковок.
//
&НаКлиенте
Процедура УстановитьФактСборки(СтрокаФормы, СобраннаяСтрока, КоличествоФакт)

	СтрокаФормы.КоличествоУпаковокРазмещение = КоличествоФакт;
	СтрокаФормы.КоличествоРазмещение = КоличествоФакт;
	СтрокаФормы.ЯчейкаОтбор = СобраннаяСтрока.Ячейка;
	СтрокаФормы.ЯчейкаРазмещение = СобраннаяСтрока.ЯчейкаЗамена;

КонецПроцедуры

// Определяет по штрихкоду ячейку или товар задания на перемещение.
//
// Параметры:
//  СкладЗадания - СправочникСсылка.СтруктурныеЕдиницы - склад, в ячейках которого ищется штрихкод;
//  Штрихкод - Строка - сканированный штрихкод.
//
// Возвращаемое значение:
//  Структура - найденные данные:
//   * Ячейка - СправочникСсылка.Ячейки, Произвольный - найденная ячейка или пустая ссылка;
//   * Товар - Структура, Неопределено - данные товара, если ячейка не найдена.
//
&НаСервереБезКонтекста
Функция НайтиДанныеСканаЗаданияНаСервере(СкладЗадания, Штрихкод)

	ДанныеЯчейки = Обработки.МобильноеРабочееМестоКладовщика.ДанныеЯчейкиПоШК(СкладЗадания, Штрихкод);
	ДанныеТовара = Неопределено;
	Если Не ЗначениеЗаполнено(ДанныеЯчейки.Ячейка) Тогда
		ДанныеТовара = Обработки.МобильноеРабочееМестоКладовщика.НайтиТоварПоШК(Штрихкод);
	КонецЕсли;


	Возврат Новый Структура("Ячейка,Товар", ДанныеЯчейки.Ячейка, ДанныеТовара);

КонецФункции

// Определяет по штрихкоду ячейку или товар текущего задания.
//
// Параметры:
//  Штрихкод - Строка - сканированный штрихкод.
//
// Возвращаемое значение:
//  Структура - см. НайтиДанныеСканаЗаданияНаСервере;
//  Неопределено - если при поиске произошла ошибка.
//
&НаКлиенте
Функция НайтиДанныеСканаЗадания(Штрихкод)

	Попытка
		Возврат НайтиДанныеСканаЗаданияНаСервере(Склад, Штрихкод);
	Исключение
		МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;


КонецФункции

// Открывает форму размещения в ячейки для отсканированной строки товара.
//
// Параметры:
//  СтрокаТовара - ДанныеФормыЭлементКоллекции - строка таблицы товаров формы.
//
&НаКлиенте
Процедура ОткрытьСтрокуПоСкану(СтрокаТовара)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", СтрокаТовара.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика", СтрокаТовара.Характеристика);
	ПараметрыФормы.Вставить("Серия", СтрокаТовара.Серия);
	ПараметрыФормы.Вставить("Артикул", СтрокаТовара.Артикул);
	ПараметрыФормы.Вставить("Упаковка", СтрокаТовара.УпаковкаОтбор);
	ПараметрыФормы.Вставить("УпаковкаРазмещено", СтрокаТовара.УпаковкаРазмещение);
	ПараметрыФормы.Вставить("КоличествоУпаковок", СтрокаТовара.КоличествоУпаковокОтбор);
	ПараметрыФормы.Вставить("КоличествоУпаковокРазмещено", СтрокаТовара.КоличествоУпаковокРазмещение);
	ПараметрыФормы.Вставить("Режим", "ПересчетРедактирование");

	// Дочерняя форма использует индекс строки так же, как существующий обработчик результата.
	ИндексСтроки = 0;
	Для Каждого Кандидат Из Товары Цикл
		Если Кандидат = СтрокаТовара Тогда
			Прервать;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;

	ПараметрыФормы.Вставить("НомерСтроки", ИндексСтроки);
	ПараметрыФормы.Вставить("Склад", Склад);
	ПараметрыФормы.Вставить("Ячейка", СтрокаТовара.ЯчейкаОтбор);
	ПараметрыФормы.Вставить("ЯчейкаЗамена", СтрокаТовара.ЯчейкаРазмещение);
	ПараметрыФормы.Вставить("ТипОперации", 3);
	ПараметрыФормы.Вставить("Ссылка", Ссылка);
	ПараметрыФормы.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);

	Описание = Новый ОписаниеОповещения("ЗавершитьРазмещениеВЯчейку", ЭтотОбъект);

	ОткрытаДочерняяФормаСканера = Истина;

	ОткрытьФорму("Обработка.МобильноеРабочееМестоКладовщика.Форма.РазмещениеВЯчейки",
		ПараметрыФормы, ЭтотОбъект, , , , Описание, РежимОткрытияОкнаФормы.Независимый);


КонецПроцедуры

// Разбирает скан ячейки: смена сеанса приемки или запуск нового.
//
// Параметры:
//  Ячейка    - СправочникСсылка.Ячейки - отсканированная ячейка;
//  Штрихкод  - Строка - исходный ШК для журнала отказа.
//
&НаКлиенте
Асинх Процедура РазобратьСканЯчейкиПеремещения(Знач Ячейка, Знач Штрихкод)

	// Ячейка-источник не может быть ячейкой назначения.
	Если Товары.Количество() > 0
		И Ячейка = Товары[0].ЯчейкаОтбор Тогда
		МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
			"Нельзя разместить товар в ту же ячейку, из которой перемещаем.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЯчейкаПриемкиТСД) Тогда
		// Новый сеанс: ячейка та же, что и источник, отклоняется выше.
		ЯчейкаПриемкиТСД = Ячейка;
		ОткрытьПриемкуВЯчейкуТСД(Ячейка);
		Возврат;
	КонецЕсли;

	Если Ячейка = ЯчейкаПриемкиТСД Тогда
		// Повторный скан текущей ячейки продолжает сеанс.
		ОткрытьПриемкуВЯчейкуТСД(Ячейка);
		Возврат;
	КонецЕсли;

	// Сканирована другая ячейка — решение принимает пользователь.
	// Возможен откат текущего сеанса без записи в документ.
	Если ЕстьНезаписанныеПозиции() Тогда
		Ответ = Ждать ЗадатьВопросПереводаСеансаТСД();

		Если Ответ = "Остаться" Тогда
			МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
				"Сканирование отменено. Продолжайте наполнение текущей ячейки.");
			Возврат;
		КонецЕсли;

		Если Ответ = "ПерейтиОтменить" Тогда
			ОткатитьСеансПриемкиТСД();
			ЗаполнитьФорму();
		КонецЕсли;
	Иначе
		// Незаписанного нет: смена ячейки без вопросов не требуется,
		// но пользователь должен явно подтвердить перевод сеанса.
		Ответ = Ждать ЗадатьВопросПереводаСеансаТСД();

		Если Ответ = "Остаться" Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЯчейкаПриемкиТСД = Ячейка;

	ОткрытьПриемкуВЯчейкуТСД(Ячейка);


КонецПроцедуры

// Открывает ввод количества для первой непринятой позиции отсканированного товара.
//
// Параметры:
//  ДанныеТовара - Структура - результат поиска товара по ШК.
//
&НаКлиенте
Процедура РазобратьСканТовараПеремещения(Знач ДанныеТовара)

	МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
		"Сначала отсканируйте ячейку назначения и сканируйте товар в форме размещения.");

КонецПроцедуры

// Признак наличия позиций сеанса, которые еще не записаны в документ.
//
&НаКлиенте
Функция ЕстьНезаписанныеПозиции()

	Для Каждого Позиция Из Товары Цикл
		Если Не ЗначениеЗаполнено(Позиция.ЯчейкаРазмещение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;


	Возврат Ложь;

КонецФункции

// Вопрос пользователю: продолжить текущую ячейку или перейти к новой.
// Дублирует поведение типовой формы «РазмещениеВЯчейки»: сканы игнорируются,
// пока пользователь не выберет вариант.
//
&НаКлиенте
Асинх Функция ЗадатьВопросПереводаСеансаТСД()

	ТекстВопроса = "Отсканирована другая ячейка."
		+ Символы.ПС + "Завершить наполнение текущей ячейки и перейти к новой?";

	Варианты = Новый СписокЗначений;
	Варианты.Добавить("Остаться", "Остаться в текущей ячейке");
	Варианты.Добавить("ПерейтиПринять", "Перейти, принять текущее");
	Варианты.Добавить("ПерейтиОтменить", "Перейти, отменить текущее");


	Возврат Ждать ВопросАсинх(ТекстВопроса, Варианты, 0, , НСтр("ru = 'Смена ячейки'"));

КонецФункции

// Сбрасывает незаписанные позиции сеанса приемки.
&НаКлиенте
Процедура ОткатитьСеансПриемкиТСД()

	Попытка
		СброситьСеансПриемкиНаСервере();
	Исключение
		МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(ОписаниеОшибки());
	КонецПопытки;


КонецПроцедуры

// Возвращает строки с незаполненной ячейкой к исходному состоянию документа.
&НаСервере
Процедура СброситьСеансПриемкиНаСервере()

	ДокументПеремещения = Ссылка.ПолучитьОбъект();

	Для Каждого Позиция Из ДокументПеремещения.Запасы Цикл
		Если ЗначениеЗаполнено(Позиция.Ячейка) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаФормы = Товары[ДокументПеремещения.Запасы.Индекс(Позиция)];
		Позиция.Количество = СтрокаФормы.КоличествоОтбор;
	КонецЦикла;

	ДокументПеремещения.Записать(РежимЗаписиДокумента.Запись);


КонецПроцедуры

// Запрашивает количество для позиции и выполняет приемку.
//
// Параметры:
//  ИндексПозиции - Число - индекс строки таблицы Товары.
//
&НаКлиенте
Процедура ЗапроситьПриемкуСтрокиТСД(Знач ИндексПозиции)

	Если ИндексПозиции < 0 Или ИндексПозиции >= Товары.Количество() Тогда
		Возврат;
	КонецЕсли;

	Позиция = Товары[ИндексПозиции];

	Если ЗначениеЗаполнено(Позиция.ЯчейкаРазмещение) Тогда
		МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(
			"Строка уже принята. Для новой приемки выберите остаток без ячейки.");
		Возврат;
	КонецЕсли;

	ДанныеПриемки = Новый Структура("Индекс,Ячейка", ИндексПозиции, ЯчейкаПриемкиТСД);
	Оповещение = Новый ОписаниеОповещения("ПослеВводаПриемкиТСД", ЭтотОбъект, ДанныеПриемки);

	ОткрытаДочерняяФормаСканера = Истина;
	ПоказатьВводЧисла(Оповещение, Позиция.КоличествоОтбор, "Количество в выбранную ячейку", 15, 3);


КонецПроцедуры

// Сохраняет введенное количество в выбранную ячейку.
//
// Параметры:
//  Количество - Число, Неопределено - введенное количество упаковок;
//  ДанныеПриемки - Структура - см. ЗапроситьПриемкуСтрокиТСД:
//   * Индекс - Число - индекс строки таблицы товаров;
//   * Ячейка - СправочникСсылка.Ячейки - ячейка назначения.
//
&НаКлиенте
Процедура ПослеВводаПриемкиТСД(Количество, ДанныеПриемки) Экспорт

	ОткрытаДочерняяФормаСканера = Ложь;

	Если Количество = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СохранитьПриемкуТСД(ДанныеПриемки.Индекс, ДанныеПриемки.Ячейка, Количество);
	Исключение
		МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД(ОписаниеОшибки());
	КонецПопытки;


КонецПроцедуры

// Записывает приемку товара в ячейку в документ перемещения.
//
// Параметры:
//  ИндексПозиции - Число - индекс строки таблицы товаров;
//  ЯчейкаНазначения - СправочникСсылка.Ячейки - ячейка назначения;
//  Количество - Число - принимаемое количество упаковок.
//
&НаСервере
Процедура СохранитьПриемкуТСД(Знач ИндексПозиции, Знач ЯчейкаНазначения, Знач Количество)

	Если Количество <= 0 Или Не ЗначениеЗаполнено(ЯчейкаНазначения) Тогда
		ВызватьИсключение "Укажите ячейку и положительное количество.";
	КонецЕсли;

	Если ЯчейкаНазначения = Товары[0].ЯчейкаОтбор Тогда
		ВызватьИсключение "Ячейка-источник не может быть ячейкой назначения.";
	КонецЕсли;

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЯчейкаНазначения, "Владелец") <> Склад Тогда
		ВызватьИсключение "Ячейка не относится к складу перемещения.";
	КонецЕсли;

	ДокументПеремещения = Ссылка.ПолучитьОбъект();

	Если ДокументПеремещения.ВидОперации <> Перечисления.ВидыОперацийПеремещениеПоЯчейкам.ИзОднойВНесколько Тогда
		ВызватьИсключение "Приемка в разные ячейки поддерживается для операции «Из одной в несколько».";
	КонецЕсли;

	Если ДокументПеремещения.СостояниеЗаказа = Справочники.СостоянияЗаказовНаПеремещение.Завершен Тогда
		ВызватьИсключение "Документ уже завершен. Изменения не записаны.";
	КонецЕсли;

	Если ДокументПеремещения.Запасы.Количество() <> Товары.Количество()
		Или ИндексПозиции < 0
		Или ИндексПозиции >= Товары.Количество() Тогда
		ВызватьИсключение "Документ изменился. Откройте задание заново.";
	КонецЕсли;

	Позиция = ДокументПеремещения.Запасы[ИндексПозиции];
	СтрокаФормы = Товары[ИндексПозиции];

	СтрокаИзменилась = ЗначениеЗаполнено(Позиция.Ячейка)
		Или Позиция.Номенклатура     <> СтрокаФормы.Номенклатура
		Или Позиция.Характеристика   <> СтрокаФормы.Характеристика
		Или Позиция.Партия           <> СтрокаФормы.Серия
		Или Позиция.ЕдиницаИзмерения <> СтрокаФормы.УпаковкаОтбор;

	Если СтрокаИзменилась Тогда
		ВызватьИсключение "Строка изменилась или уже принята. Откройте задание заново.";
	КонецЕсли;

	Если Количество > Позиция.Количество Тогда
		ВызватьИсключение "Количество превышает непринятый остаток строки ("
			+ Позиция.Количество + "). Приемка не выполнена.";
	КонецЕсли;

	Если Количество < Позиция.Количество Тогда
		Остаток = ДокументПеремещения.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(Остаток, Позиция);
		Остаток.Количество = Позиция.Количество - Количество;
		// Ячейка исходной строки пуста, поэтому у остатка она тоже остается пустой.
	КонецЕсли;

	Позиция.Количество = Количество;
	Позиция.Ячейка = ЯчейкаНазначения;

	Попытка
		Если ДокументПеремещения.Проведен Тогда
			ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументПеремещения.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	Исключение
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

	ЗаполнитьФорму();


КонецПроцедуры

// Открывает форму «РазмещениеВЯчейки» с непринятыми позициями сеанса.
//
// Параметры:
//  ЯчейкаНазначения - СправочникСсылка.Ячейки - ячейка текущего сеанса.
//
&НаКлиенте
Процедура ОткрытьПриемкуВЯчейкуТСД(Знач ЯчейкаНазначения)

	ЯчейкаПриемкиТСД = ЯчейкаНазначения;

	ПозицииПриемки = Новый Массив;

	Для Каждого Позиция Из Товары Цикл
		Если ЗначениеЗаполнено(Позиция.ЯчейкаРазмещение) Тогда
			Продолжить;
		КонецЕсли;

		ДанныеПозиции = Новый Структура;
		ДанныеПозиции.Вставить("Номенклатура", Позиция.Номенклатура);
		ДанныеПозиции.Вставить("Характеристика", Позиция.Характеристика);
		ДанныеПозиции.Вставить("Серия", Позиция.Серия);
		ДанныеПозиции.Вставить("Артикул", Позиция.Артикул);
		ДанныеПозиции.Вставить("Упаковка", Позиция.УпаковкаОтбор);
		ДанныеПозиции.Вставить("УпаковкаРазмещено", Позиция.УпаковкаОтбор);
		ДанныеПозиции.Вставить("КоличествоУпаковок", Позиция.КоличествоОтбор);
		ДанныеПозиции.Вставить("КоличествоУпаковокРазмещено", 0);

		ПозицииПриемки.Добавить(ДанныеПозиции);
	КонецЦикла;

	Если ПозицииПриемки.Количество() = 0 Тогда
		МобильноеРабочееМестоКладовщикаКлиент.ОшибкаОперацииТСД("Все строки уже приняты в ячейки.");
		Возврат;
	КонецЕсли;

	ПараметрыПриемки = Новый Структура;
	ПараметрыПриемки.Вставить("Ячейка", ЯчейкаНазначения);
	ПараметрыПриемки.Вставить("Склад", Склад);
	ПараметрыПриемки.Вставить("ТипОперации", 1);
	ПараметрыПриемки.Вставить("Товары", ПозицииПриемки);
	ПараметрыПриемки.Вставить("Ссылка", Ссылка);
	ПараметрыПриемки.Вставить("Режим", "РазмещениеВЯчейку");
	ПараметрыПриемки.Вставить("ПоказыватьФотоТоваров", ПоказыватьФотоТоваров);

	Оповещение = Новый ОписаниеОповещения("ЗавершитьРазмещениеВЯчейку", ЭтотОбъект);

	ОткрытаДочерняяФормаСканера = Истина;
	ОткрытьФорму("Обработка.МобильноеРабочееМестоКладовщика.Форма.РазмещениеВЯчейки",
		ПараметрыПриемки, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.Независимый);


КонецПроцедуры

// Записывает в документ перемещения размещение товаров по ячейкам.
//
// Параметры:
//  РезультатРазмещения - Структура - результат работы формы «РазмещениеВЯчейки»:
//   * Ячейка - СправочникСсылка.Ячейки - ячейка назначения;
//   * МассивРазмещений - Массив из Структура - размещенные позиции.
//
&НаСервере
Процедура ЗаписатьРазмещенияТСД(Знач РезультатРазмещения)

	Если Не ЗначениеЗаполнено(РезультатРазмещения.Ячейка) Тогда
		ВызватьИсключение "Форма размещения не вернула ячейку назначения.";
	КонецЕсли;

	ДокументПеремещения = Ссылка.ПолучитьОбъект();

	Если ДокументПеремещения.ВидОперации <> Перечисления.ВидыОперацийПеремещениеПоЯчейкам.ИзОднойВНесколько
		Или ДокументПеремещения.СостояниеЗаказа = Справочники.СостоянияЗаказовНаПеремещение.Завершен Тогда
		ВызватьИсключение "Документ завершен или вид операции не поддерживает приемку в разные ячейки.";
	КонецЕсли;

	Если РезультатРазмещения.Ячейка = Товары[0].ЯчейкаОтбор Тогда
		ВызватьИсключение "Ячейка-источник не может быть ячейкой назначения.";
	КонецЕсли;

	ВладелецЯчейки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РезультатРазмещения.Ячейка, "Владелец");

	Если ВладелецЯчейки <> ДокументПеремещения.СтруктурнаяЕдиница Тогда
		ВызватьИсключение "Ячейка не относится к складу документа.";
	КонецЕсли;

	Если ДокументПеремещения.Запасы.Количество() <> Товары.Количество() Тогда
		ВызватьИсключение "Документ изменился. Откройте задание заново.";
	КонецЕсли;

	ПроверитьНеизменностьСтрок(ДокументПеремещения);

	Изменено = Ложь;

	Для Каждого ПринятаяПозиция Из РезультатРазмещения.МассивРазмещений Цикл
		ОсталосьПринять = ПринятаяПозиция.КоличествоУпаковокРазмещено;

		Если ОсталосьПринять < 0 Тогда
			ВызватьИсключение "Отрицательное количество недопустимо. Размещение не записано.";
		КонецЕсли;

		// Обрабатываем только исходные строки: добавленные остатки — следующий сеанс.
		Для ИндексСтроки = 0 По Товары.Количество() - 1 Цикл
			Если ОсталосьПринять = 0 Тогда
				Прервать;
			КонецЕсли;

			Позиция = ДокументПеремещения.Запасы[ИндексСтроки];

			ПозицияПодходит = Не ЗначениеЗаполнено(Позиция.Ячейка)
				И Позиция.Номенклатура     = ПринятаяПозиция.Номенклатура
				И Позиция.Характеристика   = ПринятаяПозиция.Характеристика
				И Позиция.ЕдиницаИзмерения = ПринятаяПозиция.Упаковка;

			Если Не ПозицияПодходит Тогда
				Продолжить;
			КонецЕсли;

			КоличествоВЯчейку = Мин(ОсталосьПринять, Позиция.Количество);

			Если КоличествоВЯчейку < Позиция.Количество Тогда
				Остаток = ДокументПеремещения.Запасы.Добавить();
				ЗаполнитьЗначенияСвойств(Остаток, Позиция);
				Остаток.Количество = Позиция.Количество - КоличествоВЯчейку;
			КонецЕсли;

			Позиция.Количество = КоличествоВЯчейку;
			Позиция.Ячейка = РезультатРазмещения.Ячейка;

			ОсталосьПринять = ОсталосьПринять - КоличествоВЯчейку;
			Изменено = Истина;
		КонецЦикла;

		Если ОсталосьПринять > 0 Тогда
			ВызватьИсключение "Количество размещения превышает непринятый остаток. Изменения не записаны.";
		КонецЕсли;
	КонецЦикла;

	Если Не Изменено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если ДокументПеремещения.Проведен Тогда
			ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументПеремещения.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	Исключение
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

	ЗаполнитьФорму();


КонецПроцедуры

// Сверяет строки документа с таблицей формы до записи размещений.
//
// Параметры:
//  ДокументПеремещения - ДокументОбъект.ПеремещениеПоЯчейкам - изменяемый документ перемещения.
//
&НаСервере
Процедура ПроверитьНеизменностьСтрок(ДокументПеремещения)

	ИндексСтроки = 0;

	Для Каждого Позиция Из ДокументПеремещения.Запасы Цикл
		СтрокаФормы = Товары[ИндексСтроки];

		СтрокаИзменилась = Позиция.Номенклатура <> СтрокаФормы.Номенклатура
			Или Позиция.Характеристика   <> СтрокаФормы.Характеристика
			Или Позиция.ЕдиницаИзмерения <> СтрокаФормы.УпаковкаОтбор
			Или Позиция.Количество       <> СтрокаФормы.КоличествоОтбор
			Или Позиция.Ячейка           <> СтрокаФормы.ЯчейкаРазмещение;

		Если СтрокаИзменилась Тогда
			ВызватьИсключение "Строки документа изменились. Результат размещения не записан.";
		КонецЕсли;

		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;


КонецПроцедуры

// Возвращает остатки заказа на перемещение, доступные к отгрузке по складу заказа.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Номенклатура - СправочникСсылка.Номенклатура - товар;
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика товара;
//   * КоличествоОстаток - Число - остаток, доступный к отгрузке.
//
&НаСервере
Функция ОстаткиЗаказаКОтгрузке()

	ЗаказОбъект = Ссылка.ПолучитьОбъект();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ЗаказыНаПеремещение.Остатки(
	|		,
	|		ЗаказНаПеремещение = &Заказ
	|			И Склад = &Склад
	|			И ТипДвижения = &ТипДвижения) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Характеристика
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.КоличествоОстаток) > 0";

	Запрос.УстановитьПараметр("Заказ", Ссылка);
	Запрос.УстановитьПараметр("Склад", ЗаказОбъект.СтруктурнаяЕдиницаРезерв);
	Запрос.УстановитьПараметр("ТипДвижения", Перечисления.ТипыДвиженийЗапасов.Отгрузка);


	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает коэффициент единицы измерения для пересчета количества.
//
// Параметры:
//  Единица - СправочникСсылка.ЕдиницыИзмерения, Неопределено - единица измерения.
//
// Возвращаемое значение:
//  Число - коэффициент единицы измерения, 1 если единица не указана.
//
&НаСервере
Функция КоэффициентЕдиницыОтгрузки(Единица)

	Если ЗначениеЗаполнено(Единица) И ТипЗнч(Единица) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Единица, "Коэффициент");
	КонецЕсли;


	Возврат 1;

КонецФункции

// Рассчитывает план отгрузки по строкам заказа с учетом остатков.
//
// Возвращаемое значение:
//  Массив из Структура - строки плана:
//   * НомерСтроки - Число - номер строки заказа;
//   * Количество - Число - количество к отгрузке в единицах измерения строки.
//
&НаСервере
Функция СтрокиОтгрузкиЗаказа()

	ЗаказОбъект = Ссылка.ПолучитьОбъект();
	Остатки = ОстаткиЗаказаКОтгрузке();
	План = Новый Массив;
	Для Каждого Остаток Из Остатки Цикл
		Всего = 0;
		Для Каждого СтрокаЗаказа Из ЗаказОбъект.Запасы Цикл
			Если СтрокаЗаказа.Номенклатура = Остаток.Номенклатура
				И СтрокаЗаказа.Характеристика = Остаток.Характеристика Тогда
				Всего = Всего + СтрокаЗаказа.Количество
					* КоэффициентЕдиницыОтгрузки(СтрокаЗаказа.ЕдиницаИзмерения);
			КонецЕсли;
		КонецЦикла;

		Пропустить = Макс(0, Всего - Остаток.КоличествоОстаток);
		Доступно = Остаток.КоличествоОстаток;
		Для Каждого СтрокаЗаказа Из ЗаказОбъект.Запасы Цикл
			Если СтрокаЗаказа.Номенклатура <> Остаток.Номенклатура
				Или СтрокаЗаказа.Характеристика <> Остаток.Характеристика Тогда
				Продолжить;
			КонецЕсли;
			Коэффициент = КоэффициентЕдиницыОтгрузки(СтрокаЗаказа.ЕдиницаИзмерения);
			Учтено = Мин(Пропустить, СтрокаЗаказа.Количество * Коэффициент);
			Пропустить = Пропустить - Учтено;
			КоличествоПлана = Мин(Доступно, СтрокаЗаказа.Количество * Коэффициент - Учтено);
			Если КоличествоПлана > 0 Тогда
				План.Добавить(Новый Структура("НомерСтроки,Количество",
					СтрокаЗаказа.НомерСтроки, КоличествоПлана / Коэффициент));
				Доступно = Доступно - КоличествоПлана;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	УпорядоченныйПлан = Новый Массив;
	Для Каждого СтрокаЗаказа Из ЗаказОбъект.Запасы Цикл
		Для Каждого ПозицияПлана Из План Цикл
			Если ПозицияПлана.НомерСтроки = СтрокаЗаказа.НомерСтроки Тогда
				УпорядоченныйПлан.Добавить(ПозицияПлана);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;


	Возврат УпорядоченныйПлан;

КонецФункции

// Заполняет таблицу товаров остатками заказа, доступными к отгрузке.
&НаСервере
Процедура ЗаполнитьОстаткиЗаказа()

	ЗаказОбъект = Ссылка.ПолучитьОбъект();
	Склад = ЗаказОбъект.СтруктурнаяЕдиницаРезерв;
	Комментарий = ЗаказОбъект.Комментарий;
	Товары.Очистить();
	Для Каждого План Из СтрокиОтгрузкиЗаказа() Цикл
		Источник = ЗаказОбъект.Запасы[План.НомерСтроки - 1];

		СтрокаФормы = Товары.Добавить();

		СтрокаФормы.Номенклатура = Источник.Номенклатура;
		СтрокаФормы.Характеристика = Источник.Характеристика;
		СтрокаФормы.Артикул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Номенклатура, "Артикул");
		СтрокаФормы.УпаковкаОтбор = Источник.ЕдиницаИзмерения;
		СтрокаФормы.УпаковкаРазмещение = Источник.ЕдиницаИзмерения;
		СтрокаФормы.КоличествоОтбор = План.Количество;
		СтрокаФормы.КоличествоУпаковокОтбор = План.Количество;
	КонецЦикла;


КонецПроцедуры

// Создает и проводит документ перемещения запасов по собранному заказу.
&НаСервере
Процедура СоздатьОтгрузкуПоЗаказу()

	ЗаказОбъект = Ссылка.ПолучитьОбъект();
	План = СтрокиОтгрузкиЗаказа();
	Если План.Количество() <> Товары.Количество() Тогда
		ВызватьИсключение "Остатки изменились. Откройте задание заново.";
	КонецЕсли;

	ДокументОтгрузки = Документы.ПеремещениеЗапасов.СоздатьДокумент();

	ДокументОтгрузки.Заполнить(Ссылка);

	ДокументОтгрузки.ЗаказНаПеремещение = Ссылка;

	ДокументОтгрузки.Дата = ТекущаяДатаСеанса();

	// Очистка ТЧ, если они заполнились по основанию
	ДокументОтгрузки.Запасы.Очистить();
	ДокументОтгрузки.СерииНоменклатуры.Очистить();

	Для Индекс = 0 По План.Количество() - 1 Цикл
		Источник = ЗаказОбъект.Запасы[План[Индекс].НомерСтроки - 1];

		Факт = Товары[Индекс];

		Если Факт.Номенклатура <> Источник.Номенклатура
			Или Факт.Характеристика <> Источник.Характеристика
			Или Факт.КоличествоОтбор <> План[Индекс].Количество Тогда
			ВызватьИсключение "Остатки изменились. Откройте задание заново.";
		КонецЕсли;

		Количество = Факт.КоличествоУпаковокРазмещение;
		Если Количество < 0 Или Количество > План[Индекс].Количество Тогда
			ВызватьИсключение "Количество превышает остаток заказа.";
		КонецЕсли;

		Если Количество = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Источник.СерииНоменклатуры) Тогда
			ВызватьИсключение "Для серийного товара необходим подбор серий. Перемещение не создано.";
		КонецЕсли;

		СтрокаДокумента = ДокументОтгрузки.Запасы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, Источник);

		СтрокаДокумента.Количество = Количество;
		СтрокаДокумента.Резерв = Мин(Источник.Резерв, Количество);
	КонецЦикла;

	Если ДокументОтгрузки.Запасы.Количество() = 0 Тогда
		ВызватьИсключение "Нет отсканированных товаров. Документ не создан.";
	КонецЕсли;

	ДокументОтгрузки.Записать(РежимЗаписиДокумента.Проведение);


КонецПроцедуры

#КонецОбласти

