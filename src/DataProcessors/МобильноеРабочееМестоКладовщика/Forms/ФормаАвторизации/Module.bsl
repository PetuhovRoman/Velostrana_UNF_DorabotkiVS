#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();
	ПараметрыОткрытияФормы = Неопределено;
	ПользовательПоУмолчанию = Пользователи.ТекущийПользователь();
	//ОбщегоНазначенияРМК.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	//НастроитьФормуПоВходнымПараметрам();
	//Если РежимВхода Или РежимСмены Тогда
	//	НастроитьДоступностьСозданияКодаДоступа();
	//КонецЕсли;
	НастроитьТиповыеГорячиеКлавиши();
	//НастроитьЭлементыФормы();
	АдаптацияФормыМобильныйКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ПараметрыОткрытияФормы = Неопределено Тогда
		Оповещение = Новый ОписаниеОповещения("ЗакрытьПриложениеПриОшибке", ЭтотОбъект);
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ПараметрыОткрытияФормы.ТекстСообщения,
			ПараметрыОткрытияФормы.ТекстЗаголовка);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ИнтерфейсРМКСлужебныйКлиент.ОткрытьФормуСообщенияОбОшибке(ЭтотОбъект, ПараметрыОткрытияОшибки, Оповещение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Информация", "Авторизация - ОбработкаОповещения:" + Символы.ПС + ИмяСобытия + Символы.ПС + Источник);
	// Консоль AL 22.10.2026 — ВводДоступен() на ТСД (мобильный клиент) возвращает Ложь при форме на экране: событие сканера терялось.
	// На мобильном клиенте проверку доступности ввода не применяем (как в форме пересчета товаров).
	ВводФормыДоступен = ВводДоступен();
	Если Источник = "ПодключаемоеОборудование" Тогда
		МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Информация",
			"Авторизация: ВводДоступен=" + ВводФормыДоступен + ", ЭтоМобильныйКлиент=" + ЭтоМобильныйКлиент);
	КонецЕсли;
	Если Источник = "ПодключаемоеОборудование" И (ВводФормыДоступен Или ЭтоМобильныйКлиент) Тогда
	// Конец Консоль AL
		Если ИмяСобытия = "ScanData" Тогда
			
			СохраненныйШтрихкод = ?(Параметр[1] = Неопределено, Параметр[0], Параметр[1][1]);
			ВыполнитьПоискПоШтрихкоду(СохраненныйШтрихкод);
			
		ИначеЕсли ИмяСобытия = "ScanDataBase64" Тогда
			
			СохраненныйШтрихкод = "";
			ШтрихкодBase64 = ?(Параметр[1] = Неопределено, Параметр[0], Параметр[1][1]);
			МенеджерОборудованияРМККлиентСервер.Base64ВШтрихкод(ШтрихкодBase64, СохраненныйШтрихкод);
			ВыполнитьПоискПоШтрихкоду(СохраненныйШтрихкод);
			
		ИначеЕсли ИмяСобытия = "TracksData" Тогда
			
			СохраненныйШтрихкод = Параметр[0];
			ВыполнитьПоискПоШтрихкоду(СохраненныйШтрихкод);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	МобильноеРабочееМестоКладовщикаЛокализация.ЗаписатьСообщениеВЖурнал("Информация", "Авторизация - ВнешнееСобытие:" + Символы.ПС + Событие + Символы.ПС + Источник);
	Если ОбщегоНазначенияРМККлиент.ИспользоватьВнешнееСобытие() И ВводДоступен() Тогда
		
		ОбрабатываемыеСобытия = Новый Массив;
		ОбрабатываемыеСобытия.Добавить("Штрихкод");
		ОбрабатываемыеСобытия.Добавить("ПолученШтрихкод");
		ОбрабатываемыеСобытия.Добавить("ScanData");
		ОбрабатываемыеСобытия.Добавить("TracksData");
		ОбрабатываемыеСобытия.Добавить("ДанныеКарты");
		
		Если Не ОбрабатываемыеСобытия.Найти(Событие) = Неопределено Тогда
			СохраненныйШтрихкод = Данные;
			ВыполнитьПоискПоШтрихкоду(СохраненныйШтрихкод);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

