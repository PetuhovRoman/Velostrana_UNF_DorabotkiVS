// Проверяет необходимость указания серий при планировании отбора.
//
// Параметры:
//  РасходныйОрдер - ДокументСсылка.РасходныйОрдерНаТовары - ссылка на расходный ордер;
//  Склад - СправочникСсылка.СтруктурныеЕдиницы - склад, указанный в расходном ордере.
//
// Возвращаемое значение:
//  Булево - Истина, если требуется указание серий при планировании отбора.
//
Функция ПроверитьСтатусУказанияСерийПриПланированииОтбора(РасходныйОрдер, Склад) Экспорт

	Помещение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РасходныйОрдер, "Помещение");
	СтруктураПараметров = Новый Структура("Склад, Помещение", Склад, Помещение);
	ИспользоватьАдресноеХранение = ПолучитьФункциональнуюОпцию("ИспользоватьАдресноеХранение", СтруктураПараметров);

	Если Не ИспользоватьАдресноеХранение Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ОтгружаемыеТовары КАК РасходныйОрдерНаТоварыОтгружаемыеТовары
	|ГДЕ
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.СтатусУказанияСерий В(&Статусы)
	|	И РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка = &Ссылка";
	
	Статусы = Новый Массив;
	Статусы.Добавить(27);
	Статусы.Добавить(7);
	Статусы.Добавить(5);

	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.УстановитьПараметр("Ссылка", РасходныйОрдер);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();   
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;


КонецФункции

#КонецЕсли

// Возвращает свойства склада.
//
// Параметры:
//  Склад - СправочникСсылка.СтруктурныеЕдиницы - склад.
//
// Возвращаемое значение:
//  Структура, Неопределено - свойства склада; Неопределено, если склад не найден:
//   * ИспользоватьАдресноеХранение - Булево - признак использования адресного хранения;
//   * ИспользоватьОрдернуюСхемуПриПоступлении - Булево - признак ордерной схемы при поступлении;
//   * ИспользоватьСтатусыРасходныхОрдеров - Булево - признак использования статусов расходных ордеров.
//
Функция СвойстваСклада(Склад) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИСТИНА КАК ИспользоватьАдресноеХранение,
	|	Склады.ОрдерныйСклад КАК ИспользоватьОрдернуюСхемуПриПоступлении,
	|	ЛОЖЬ КАК ИспользоватьСтатусыРасходныхОрдеров
	|ИЗ
	|	Справочник.СтруктурныеЕдиницы КАК Склады
	|ГДЕ
	|	Склады.Ссылка = &Склад";
	
	Запрос.УстановитьПараметр("Склад", Склад);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Результат = Новый Структура;

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Результат.Вставить("ИспользоватьАдресноеХранение",
			ВыборкаДетальныеЗаписи.ИспользоватьАдресноеХранение);
		Результат.Вставить("ИспользоватьОрдернуюСхемуПриПоступлении",
			ВыборкаДетальныеЗаписи.ИспользоватьОрдернуюСхемуПриПоступлении);
		Результат.Вставить("ИспользоватьСтатусыРасходныхОрдеров",
			ВыборкаДетальныеЗаписи.ИспользоватьСтатусыРасходныхОрдеров);
	КонецЕсли;

	Возврат Результат;


КонецФункции

// Возвращает сведения о товаре по штрихкоду.
//
// Параметры:
//  Штрихкод - Строка - штрихкод номенклатуры.
//
// Возвращаемое значение:
//  Структура - сведения о товаре:
//   * Номенклатура - СправочникСсылка.Номенклатура - найденный товар;
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика товара;
//   * Серия - СправочникСсылка.СерииНоменклатуры - серия товара, не заполняется;
//   * Упаковка - СправочникСсылка.ЕдиницыИзмерения - единица измерения товара;
//   * Количество - Число - количество товара по штрихкоду.
//
Функция НайтиТоварПоШК(Штрихкод) Экспорт

	ДанныеТовара = Новый Структура;
	ДанныеТовара.Вставить("Номенклатура",   Справочники.Номенклатура.ПустаяСсылка());
	ДанныеТовара.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ДанныеТовара.Вставить("Серия",          Справочники.СерииНоменклатуры.ПустаяСсылка());
	ДанныеТовара.Вставить("Упаковка",       Справочники.ЕдиницыИзмерения.ПустаяСсылка());
	ДанныеТовара.Вставить("Количество",     1);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ШтрихкодыНоменклатуры.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ШтрихкодыНоменклатуры.Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ ШтрихкодыНоменклатуры.ЕдиницаИзмерения
	|	КОНЕЦ КАК Упаковка
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ДанныеТовара;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ДанныеТовара, Выборка);
	КонецЦикла;
	
	Возврат ДанныеТовара;


КонецФункции

