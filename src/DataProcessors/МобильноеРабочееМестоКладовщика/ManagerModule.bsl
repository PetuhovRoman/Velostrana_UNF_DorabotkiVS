#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает структуру параметров заполнения приходного ордера.
//
// Возвращаемое значение:
//  Структура - параметры заполнения приходного ордера:
//   * Распоряжение - Произвольный, Неопределено - распоряжение на приемку;
//   * Отправитель - Произвольный, Неопределено - отправитель товара;
//   * ЗакрыватьГрафикПоступления - Булево, Неопределено - признак закрытия графика поступления;
//   * Склад - Произвольный, Неопределено - склад приемки;
//   * КонтролируемаяПартия - Произвольный, Неопределено - контролируемая партия;
//   * Помещение - Произвольный, Неопределено - помещение приемки;
//   * ЗонаПриемки - Произвольный, Неопределено - зона приемки;
//   * ДатаВходящегоДокумента - Дата, Неопределено - дата входящего документа;
//   * НомерВходящегоДокумента - Строка, Неопределено - номер входящего документа;
//   * ДатаПоступления - Дата, Неопределено - дата поступления;
//   * ХозяйственнаяОперация - Произвольный, Неопределено - хозяйственная операция.
//
Функция СтруктураЗаполненияПриходногоОрдера() Экспорт

	Структура = Новый Структура;

	Структура.Вставить("Распоряжение",               Неопределено);
	Структура.Вставить("Отправитель",                Неопределено);
	Структура.Вставить("ЗакрыватьГрафикПоступления", Неопределено);
	Структура.Вставить("Склад",                      Неопределено);
	Структура.Вставить("КонтролируемаяПартия",       Неопределено);
	Структура.Вставить("Помещение",                  Неопределено);
	Структура.Вставить("ЗонаПриемки",                Неопределено);
	Структура.Вставить("ДатаВходящегоДокумента",     Неопределено);
	Структура.Вставить("НомерВходящегоДокумента",    Неопределено);
	Структура.Вставить("ДатаПоступления",            Неопределено);
	Структура.Вставить("ХозяйственнаяОперация",      Неопределено);

	Возврат Структура;


КонецФункции

// Возвращает структуру параметров заполнения расходного ордера.
//
// Возвращаемое значение:
//  Структура - параметры заполнения расходного ордера:
//   * Склад - Произвольный, Неопределено - склад отгрузки;
//   * Помещение - Произвольный, Неопределено - помещение отгрузки;
//   * Получатель - Произвольный, Неопределено - получатель товара;
//   * ЗонаОтгрузки - Произвольный, Неопределено - зона отгрузки;
//   * ЗаданиеНаПеревозку - Произвольный, Неопределено - задание на перевозку;
//   * РаспоряженияНаОтгрузку - Массив из Произвольный - распоряжения на отгрузку;
//   * ФоновоеЗадание - Булево - признак выполнения в фоновом задании.
//
Функция СтруктураЗаполненияРасходногоОрдера() Экспорт

	СтруктураПараметров = Новый Структура;

	СтруктураПараметров.Вставить("Склад", Неопределено);
	СтруктураПараметров.Вставить("Помещение", Неопределено);
	СтруктураПараметров.Вставить("Получатель", Неопределено);
	СтруктураПараметров.Вставить("ЗонаОтгрузки", Неопределено);
	СтруктураПараметров.Вставить("ЗаданиеНаПеревозку", Неопределено);
	СтруктураПараметров.Вставить("РаспоряженияНаОтгрузку", Новый Массив);
	СтруктураПараметров.Вставить("ФоновоеЗадание", Ложь);

	Возврат СтруктураПараметров;


КонецФункции

#Если НЕ МобильныйАвтономныйСервер Тогда

#Область СчетчикиПриемка

// Возвращает запрос со списком распоряжений на приемку, по которым есть неоформленный остаток.
//
// Приходная накладная ордерного склада списывает товар в регистре «Запасы к поступлению на склады»
// (расход), а проведенный приходный ордер возвращает остаток в ноль (приход), поэтому ожидаемое
// поступление - отрицательный остаток.
//
// Параметры:
//  Склад - СправочникСсылка.СтруктурныеЕдиницы - склад, по которому отбираются распоряжения;
//  ДатаПоступления - Дата, Неопределено - дата поступления, если заполнена - отбор по дню документа;
//  СостояниеПоступленияФильтр - Произвольный - не используется.
//
// Возвращаемое значение:
//  Запрос - запрос списка распоряжений на приемку.
//
Функция РаспоряженияНаПриемку(Склад, ДатаОстатков) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыКПоступлению.ДокументОснование КАК Распоряжение,
	|	ТоварыКПоступлению.ДокументОснование.Номер КАК Номер,
	|	ТоварыКПоступлению.ДокументОснование.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА ТоварыКПоступлению.ДокументОснование ССЫЛКА Документ.ПриходнаяНакладная
	|			ТОГДА ТоварыКПоступлению.ДокументОснование.Контрагент
	|		КОГДА ТоварыКПоступлению.ДокументОснование ССЫЛКА Документ.ПеремещениеЗапасов
	|			ТОГДА ТоварыКПоступлению.ДокументОснование.СтруктурнаяЕдиница
	|	КОНЕЦ КАК Отправитель,
	|	ТоварыКПоступлению.СтруктурнаяЕдиница КАК Склад,
	|	ТоварыКПоступлению.ДокументОснование.ХозяйственнаяОперация КАК ХозяйственнаяОперация
	|ИЗ
	|	РегистрНакопления.ЗапасыКПоступлениюНаСклады.Остатки(&ДатаОстатков, СтруктурнаяЕдиница = &Склад) КАК ТоварыКПоступлению
	|ГДЕ
	|	ТоварыКПоступлению.КоличествоОстаток < 0
	|	И ТоварыКПоступлению.ДокументОснование <> НЕОПРЕДЕЛЕНО";
	//|	И &УсловиеДата";
	
	//Если ЗначениеЗаполнено(ДатаПоступления) Тогда
	//	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДата",
	//		"И НАЧАЛОПЕРИОДА(ТоварыКПоступлениюОстаткиТекущие.ДокументОснование.Дата, ДЕНЬ) = &ДатаПоступления");
	//	Запрос.УстановитьПараметр("ДатаПоступления", НачалоДня(ДатаПоступления));
	//Иначе
	//	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДата", "");
	//КонецЕсли;
	//
	//Запрос.УстановитьПараметр("Склад", Склад);
	//Возврат Запрос;
	
	Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	//Если ДатаПоступления = Неопределено Тогда
	//	Запрос.УстановитьПараметр("УсловиеДата", Истина);
	//Иначе
	//	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДата",
	//	"И НАЧАЛОПЕРИОДА(ТоварыКПоступлениюОстаткиТекущие.ДокументОснование.Дата, ДЕНЬ) = &ДатаПоступления");
	//	Запрос.УстановитьПараметр("ДатаПоступления", НачалоДня(ДатаПоступления));	
	//КонецЕсли;
	
	Возврат Запрос;

		
КонецФункции

#КонецОбласти

#Область СчетчикиОтгрузка

// Возвращает запрос с перемещениями, ожидающими отгрузки по завершенным заказам на перемещение.
//
// Возвращаемое значение:
//  Запрос - запрос, возвращающий количество различных товаров по документам перемещения.
//
Функция СчетчикРаспоряженийОтгрузки() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗапасыКРасходу.ДокументОснование КАК Документ,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗапасыКРасходу.Номенклатура) КАК КоличествоТоваров
	|ИЗ
	|	РегистрНакопления.ЗапасыКРасходуСоСкладов.Остатки(
	|			,
	|			СтруктурнаяЕдиница = &Склад
	|				И ДокументОснование ССЫЛКА Документ.ПеремещениеЗапасов) КАК ЗапасыКРасходу
	|ГДЕ
	|	ЗапасыКРасходу.ДокументОснование.ЗаказНаПеремещение.СостояниеЗаказа = &СостояниеЗавершен
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапасыКРасходу.ДокументОснование";

	Возврат Запрос;


КонецФункции

// Возвращает запрос со списком распоряжений на отгрузку по складу.
//
// Параметры:
//  Склад - СправочникСсылка.СтруктурныеЕдиницы - склад, по которому отбираются распоряжения.
//
// Возвращаемое значение:
//  Запрос - запрос списка распоряжений на отгрузку.
//
Функция СписокРаспоряженийНаОтгрузку(Склад) Экспорт

	Запрос = Новый Запрос;

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказыПокупателя.ЗаказПокупателя КАК Распоряжение,
	|	ЗаказыПокупателя.ЗаказПокупателя.Контрагент КАК Получатель,
	|	ЕСТЬNULL(ЗаказыПокупателя.ЗаказПокупателя.Номер, """") КАК Номер,
	|	ЕСТЬNULL(ЗаказыПокупателя.ЗаказПокупателя.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК Дата,
	|	ТИПЗНАЧЕНИЯ(ЗаказыПокупателя.ЗаказПокупателя) КАК ТипДокумента,
	|	ЗаказыПокупателя.ЗаказПокупателя.СостояниеЗаказа КАК СостояниеЗаказа,
	|	ВЫБОР
	|		КОГДА ЗаказыПокупателя.ЗаказПокупателя.Ответственный = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|			ТОГДА ЗаказыПокупателя.ЗаказПокупателя.Контрагент.Ответственный
	|		ИНАЧЕ ЗаказыПокупателя.ЗаказПокупателя.Ответственный
	|	КОНЕЦ КАК Ответственный,
	|	1 КАК ИндексКартинки,
	|	&ОтветственныйЗаголовок КАК ОтветственныйЗаголовок
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(, ЗаказПокупателя.ДатаОтгрузки = &ДатаОтгрузки) КАК ЗаказыПокупателя
	|ГДЕ
	|	ЗаказыПокупателя.ЗаказПокупателя.СтатусСборки = 0
	|	И ЗаказыПокупателя.ЗаказПокупателя.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовНаПеремещение.Завершен)
	|	И ЗаказыПокупателя.КоличествоОстаток > 0";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтветственныйЗаголовок", НСтр("ru = '""Менеджер""'"));

	Запрос.Текст = ТекстЗапроса;

	Возврат Запрос;


КонецФункции

// Возвращает таблицу товаров распоряжения на отгрузку или приемку.
//
// Параметры:
//  ТипДокумента - Число - если 1, то возвращаются данные о поступлении, иначе - данные об отгрузке;
//  Распоряжение - ОпределяемыйТип.РаспоряжениеНаОтгрузку, ОпределяемыйТип.РаспоряжениеНаПоступление - распоряжение;
//  КонтролируемаяПартия - СправочникСсылка.КонтролируемыеПартии - партия.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с полями:
//   * Номенклатура - СправочникСсылка.Номенклатура - товар;
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика товара;
//   * Назначение - Строка - назначение;
//   * Серия - СправочникСсылка.СерииНоменклатуры - серия товара;
//   * Склад - СправочникСсылка.СтруктурныеЕдиницы - склад;
//   * КоличествоУпаковок - Число - остаток к отгрузке или поступлению;
//   * Артикул - Строка - артикул товара;
//   * Упаковка - СправочникСсылка.ЕдиницыИзмерения - единица измерения товара.
//
Функция СписокТоваровНаОтгрузкуПриемку(ТипДокумента, Распоряжение, КонтролируемаяПартия = Неопределено) Экспорт

	Если ТипДокумента = 1 Тогда

		// Товары распоряжения на приемку: ожидаемое поступление - отрицательный остаток регистра
		// «Запасы к поступлению на склады» по документу-основанию. Серия в таблице формы - справочник
		// «Серии номенклатуры», а в регистре хранится партия, поэтому серия не заполняется.
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТоварыКПоступлениюОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыКПоступлениюОстатки.Номенклатура.Артикул КАК Артикул,
		|	ТоварыКПоступлениюОстатки.Характеристика КАК Характеристика,
		|	"""" КАК Назначение,
		|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
		|	ТоварыКПоступлениюОстатки.СтруктурнаяЕдиница КАК Склад,
		|	-ТоварыКПоступлениюОстатки.КоличествоОстаток КАК КоличествоУпаковок,
		|	ТоварыКПоступлениюОстатки.Номенклатура.ЕдиницаИзмерения КАК Упаковка
		|ИЗ
		|	РегистрНакопления.ЗапасыКПоступлениюНаСклады.Остатки(, ДокументОснование = &ДокументПоступления) КАК ТоварыКПоступлениюОстатки
		|ГДЕ
		|	ТоварыКПоступлениюОстатки.КоличествоОстаток < 0";
			
		Запрос.УстановитьПараметр("ДокументПоступления", Распоряжение);

		Возврат Запрос.Выполнить().Выгрузить();

	Иначе

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТоварыКОтгрузкеОстатки.Склад КАК Склад,
		|	ТоварыКОтгрузкеОстатки.ЗаказПокупателя.Контрагент КАК Получатель,
		|	ТоварыКОтгрузкеОстатки.ЗаказПокупателя КАК ДокументОтгрузки,
		|	ТоварыКОтгрузкеОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыКОтгрузкеОстатки.Номенклатура.Артикул КАК Артикул,
		|	ТоварыКОтгрузкеОстатки.Характеристика КАК Характеристика,
		|	"""" КАК Назначение,
		|	"""" КАК Серия,
		|	ТоварыКОтгрузкеОстатки.КоличествоОстаток КАК КоличествоУпаковок,
		|	ТоварыКОтгрузкеОстатки.Номенклатура.ЕдиницаИзмерения КАК Упаковка
		|ИЗ
		|	РегистрНакопления.ЗаказыПокупателей.Остатки(, ЗаказПокупателя = &ДокументОтгрузки) КАК ТоварыКОтгрузкеОстатки
		|ГДЕ
		|	ТоварыКОтгрузкеОстатки.КоличествоОстаток > 0";
		
		Запрос.УстановитьПараметр("ДокументОтгрузки", Распоряжение);
		
		Возврат Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;


КонецФункции

#КонецОбласти

// Возвращает политику учета серий для вида номенклатуры.
//
// Параметры:
//  ВидНоменклатуры - СправочникСсылка.ВидыНоменклатуры - вид номенклатуры;
//  Склад - СправочникСсылка.СтруктурныеЕдиницы - склад, не используется.
//
// Возвращаемое значение:
//  ПеречислениеСсылка - политика учета серий вида номенклатуры.
//
Функция ПолитикаУчетаСерий(ВидНоменклатуры, Склад) Экспорт

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНоменклатуры, "ПолитикаУчетаСерий");

КонецФункции

#КонецЕсли

#Область СчетчикиПриемка

// Возвращает запрос с непроведенными приходными ордерами склада.
//
// Параметры запроса:
//  Склад - СправочникСсылка.СтруктурныеЕдиницы - склад, по которому отбираются ордера.
//
// Возвращаемое значение:
//  Запрос - запрос списка приходных ордеров в работе.
//
Функция СписокПриходныхОрдеров() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриходныйОрдер.Ссылка КАК Ссылка,
	|	ПриходныйОрдер.Номер КАК Номер,
	|	ПриходныйОрдер.Дата КАК Дата,
	|	ПриходныйОрдер.Комментарий КАК Комментарий,
	|	ПриходныйОрдер.СтруктурнаяЕдиница КАК Склад,
	|	ПриходныйОрдер.Контрагент КАК Отправитель,
	|	ПриходныйОрдер.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ПриходныйОрдер.Ячейка КАК Ячейка,
	|	ВЫБОР
	|		КОГДА ПриходныйОрдер.НомерВходящегоДокумента = """"
	|			ТОГДА ПриходныйОрдер.Номер
	|		ИНАЧЕ ПриходныйОрдер.НомерВходящегоДокумента
	|	КОНЕЦ КАК НомерВходящегоДокумента,
	|	ВЫБОР
	|		КОГДА ПриходныйОрдер.ДатаВходящегоДокумента = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ПриходныйОрдер.Дата
	|		ИНАЧЕ ПриходныйОрдер.ДатаВходящегоДокумента
	|	КОНЕЦ КАК ДатаВходящегоДокумента,
	|	ПриходныйОрдер.Автор КАК Исполнитель,
	|	&ИсполнительЗаголовок КАК ИсполнительЗаголовок,
	|	ПриходныйОрдер.ДокументОснование КАК Распоряжение,
	|	ПриходныйОрдер.ДокументОснование.Номер КАК РаспоряжениеНомер,
	|	ПриходныйОрдер.ДокументОснование.Дата КАК РаспоряжениеДата,
	|	ТИПЗНАЧЕНИЯ(ПриходныйОрдер.ДокументОснование) КАК РаспоряжениеПредставление
	|ИЗ
	|	Документ.ПриходныйОрдер КАК ПриходныйОрдер
	|ГДЕ
	|	ПриходныйОрдер.СтруктурнаяЕдиница = &Склад
	|	И НЕ ПриходныйОрдер.ПометкаУдаления
	|	И НЕ ПриходныйОрдер.Проведен";
	
	Запрос.УстановитьПараметр("ИсполнительЗаголовок", НСтр("ru = 'Исполнитель'"));

	Возврат Запрос;


КонецФункции

#КонецОбласти

#Область СчетчикиОтгрузка

// Возвращает запрос списка документов «Расходный ордер на товары».
//
// Возвращаемое значение:
//  Запрос - запрос списка проведенных расходных ордеров склада.
//
Функция ЗапросСписокРасходныхОрдеров() Экспорт

	Запрос = Новый Запрос;

	#Если Не МобильныйАвтономныйСервер Тогда

	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасходныйОрдерНаТовары.Ссылка КАК Ссылка,
	|	РасходныйОрдерНаТовары.Номер КАК Номер,
	|	РасходныйОрдерНаТовары.Дата КАК Дата,
	|	РасходныйОрдерНаТовары.Комментарий КАК Комментарий,
	|	РасходныйОрдерНаТовары.Статус КАК Статус,
	|	РасходныйОрдерНаТовары.Помещение КАК Помещение,
	|	РасходныйОрдерНаТовары.Получатель КАК Получатель,
	|	РасходныйОрдерНаТовары.Ответственный КАК Ответственный,
	|	РасходныйОрдерНаТовары.Контролер КАК Контролер,
	|	РасходныйОрдерНаТовары.Отгрузил КАК Отгрузил,
	|	&ОтветственныйЗаголовок КАК ОтветственныйЗаголовок
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары КАК РасходныйОрдерНаТовары
	|ГДЕ
	|	РасходныйОрдерНаТовары.Склад = &Склад
	|	И НЕ РасходныйОрдерНаТовары.ПометкаУдаления
	|	И РасходныйОрдерНаТовары.Проведен";
	
	
	#Иначе

	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасходныйОрдерНаТовары.Ссылка КАК Ссылка,
	|	РасходныйОрдерНаТовары.Номер КАК Номер,
	|	РасходныйОрдерНаТовары.Дата КАК Дата,
	|	РасходныйОрдерНаТовары.Комментарий КАК Комментарий,
	|	РасходныйОрдерНаТовары.Статус КАК Статус,
	|	РасходныйОрдерНаТовары.Помещение КАК Помещение,
	|	РасходныйОрдерНаТовары.Ответственный КАК Ответственный,
	|	&ОтветственныйЗаголовок КАК ОтветственныйЗаголовок
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары КАК РасходныйОрдерНаТовары
	|ГДЕ
	|	РасходныйОрдерНаТовары.Склад = &Склад
	|	И НЕ РасходныйОрдерНаТовары.ПометкаУдаления
	|	И РасходныйОрдерНаТовары.Проведен";
	
	#КонецЕсли

	Возврат Запрос;


КонецФункции

#КонецОбласти

#Область СчетчикиПрочиеОперации

// Возвращает запрос списка пересчетов товаров, по которым нет оприходования и списания.
//
// Возвращаемое значение:
//  Запрос - запрос списка пересчетов товаров склада.
//
Функция СписокПересчетов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПересчетТоваров.Ссылка КАК Ссылка,
	|	ПересчетТоваров.Номер КАК Номер,
	|	ПересчетТоваров.Дата КАК Дата,
	|	ПересчетТоваров.ПодписьМОЛ2.ФизическоеЛицо КАК Исполнитель,
	|	ПересчетТоваров.Комментарий КАК Комментарий,
	|	ПересчетТоваров.СтруктурнаяЕдиница КАК Склад,
	|	&ИсполнительЗаголовок КАК ИсполнительЗаголовок
	|ИЗ
	|	Документ.ИнвентаризацияЗапасов КАК ПересчетТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОприходованиеЗапасов КАК ОприходованиеЗапасов
	|		ПО (ОприходованиеЗапасов.ДокументОснование = ПересчетТоваров.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеЗапасов КАК СписаниеЗапасов
	|		ПО (СписаниеЗапасов.ДокументОснование = ПересчетТоваров.Ссылка)
	|ГДЕ
	|	НЕ ПересчетТоваров.ПометкаУдаления
	|	И ОприходованиеЗапасов.Ссылка ЕСТЬ NULL
	|	И СписаниеЗапасов.Ссылка ЕСТЬ NULL
	|	И &УсловиеИсполнитель
	|	И ПересчетТоваров.СтруктурнаяЕдиница = &Склад";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИсполнительЗаголовок", НСтр("ru = '""Исполнитель""'"));

	Возврат Запрос;


КонецФункции

// Возвращает запрос с документами «Перемещение по ячейкам», которые являются распоряжениями на размещение.
//
// Документ с состоянием заказа «Завершен» делает движения, иначе он является распоряжением на размещение в МРМ.
//
// Возвращаемое значение:
//  Запрос - запрос списка распоряжений на перемещение по ячейкам.
//
Функция СписокРаспоряженийНаПеремещениеПоЯчейкам() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПеремещениеПоЯчейкам.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеПоЯчейкам КАК ПеремещениеПоЯчейкам
	|ГДЕ
	|	ПеремещениеПоЯчейкам.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовНаПеремещение.Завершен)
	|	И ПеремещениеПоЯчейкам.Проведен
	|	И ПеремещениеПоЯчейкам.СтруктурнаяЕдиница = &Склад
	|
	|СГРУППИРОВАТЬ ПО
	|	ПеремещениеПоЯчейкам.Ссылка";

	Возврат Запрос;


КонецФункции

// Возвращает запрос списка заданий на перемещение по складу.
//
// Параметры:
//  РаспоряженияНаОтбор - Булево - если Истина, отбираются заказы на перемещение, иначе - перемещения по ячейкам.
//
// Возвращаемое значение:
//  Запрос - запрос списка заданий на перемещение.
//
Функция СписокЗаданийНаПеремещение(РаспоряженияНаОтбор = Ложь) Экспорт

	Запрос = Новый Запрос;

	Если РаспоряженияНаОтбор Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЗаказНаПеремещениеДокументы.Ссылка КАК Ссылка,
		|	МАКСИМУМ(ЗаказНаПеремещениеДокументы.Номер) КАК Номер,
		|	МАКСИМУМ(ЗаказНаПеремещениеДокументы.Дата) КАК Дата,
		|	СУММА(ЗаказыНаПеремещениеОстатки.КоличествоОстаток) КАК КоличествоОстаток,
		|	МАКСИМУМ(ЗаказНаПеремещениеДокументы.Ответственный) КАК Исполнитель
		|ИЗ
		|	РегистрНакопления.ЗаказыНаПеремещение.Остатки(
		|			&ДатаОстатков,
		|			ЗаказНаПеремещение.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовНаПеремещение.Завершен)
		|				И Склад = &Склад) КАК ЗаказыНаПеремещениеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение КАК ЗаказНаПеремещениеДокументы
		|		ПО ЗаказыНаПеремещениеОстатки.ЗаказНаПеремещение = ЗаказНаПеремещениеДокументы.Ссылка
		|ГДЕ
		|	ЗаказыНаПеремещениеОстатки.ЗаказНаПеремещение.Проведен
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаПеремещениеДокументы.Ссылка";
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ПеремещениеПоЯчейкам.Номер КАК Номер,
		|	ПеремещениеПоЯчейкам.Ссылка КАК Ссылка,
		|	ПеремещениеПоЯчейкам.Дата КАК Дата,
		|	ПеремещениеПоЯчейкам.СтруктурнаяЕдиница КАК Склад,
		|	ПеремещениеПоЯчейкам.Комментарий КАК Комментарий,
		|	ПеремещениеПоЯчейкам.СостояниеЗаказа КАК Статус,
		|	ПеремещениеПоЯчейкам.Автор КАК Исполнитель
		|ИЗ
		|	Документ.ПеремещениеПоЯчейкам КАК ПеремещениеПоЯчейкам
		|ГДЕ
		|	ПеремещениеПоЯчейкам.СтруктурнаяЕдиница = &Склад
		|	И ПеремещениеПоЯчейкам.СостояниеЗаказа <> ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовНаПеремещение.Завершен)
		|	И ПеремещениеПоЯчейкам.Проведен";
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;

	Возврат Запрос;


КонецФункции

// Возвращает запрос с активными блокировками складских ячеек склада.
//
// Возвращаемое значение:
//  Запрос - запрос списка блокировок ячеек.
//
Функция СписокБлокировок() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БлокировкиСкладскихЯчеек.Ячейка КАК Ячейка,
	|	БлокировкиСкладскихЯчеек.ТипБлокировки КАК ТипБлокировки,
	|	Ответственный КАК Ответственный
	|ИЗ
	|	РегистрСведений.БлокировкиСкладскихЯчеек КАК БлокировкиСкладскихЯчеек
	|ГДЕ
	|	БлокировкиСкладскихЯчеек.Активность
	|	И БлокировкиСкладскихЯчеек.Ячейка.Владелец = &Склад";

	Возврат Запрос;


КонецФункции

