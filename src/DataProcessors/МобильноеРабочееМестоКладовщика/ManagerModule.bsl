//  Помещение - СправочникСсылка.Помещения - помещение ячейки, не используется;
//  Штрихкод - Строка - штрихкод ячейки.
//
// Возвращаемое значение:
//  Структура - данные ячейки:
//   * Ячейка - СправочникСсылка.Ячейки - найденная ячейка, пустая ссылка если не найдена.
//
Функция НайтиЯчейкуСервер(Склад, Помещение, Штрихкод) Экспорт

	Возврат НайтиЯчейкуПоКоду(Склад, Штрихкод);

КонецФункции

// Возвращает данные ячейки по коду в пределах склада.
//
// Параметры:
//  Склад - СправочникСсылка.СтруктурныеЕдиницы - склад ячейки;
//  Штрихкод - Строка - код ячейки.
//
// Возвращаемое значение:
//  Структура - данные ячейки:
//   * Ячейка - СправочникСсылка.Ячейки - найденная ячейка, пустая ссылка если не найдена.
//
Функция НайтиЯчейкуПоКоду(Склад, Штрихкод)

	СтруктураЯчейки = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СкладскиеЯчейки.Ссылка КАК Ячейка
	|ИЗ
	|	Справочник.Ячейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Код = &Код
	|	И СкладскиеЯчейки.Владелец = &Склад";

	Запрос.УстановитьПараметр("Код", Штрихкод);
	Запрос.УстановитьПараметр("Склад", Склад);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		СтруктураЯчейки.Вставить("Ячейка", Справочники.Ячейки.ПустаяСсылка());
		Возврат СтруктураЯчейки;
	КонецЕсли;

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураЯчейки.Вставить("Ячейка", ВыборкаДетальныеЗаписи.Ячейка);
		Возврат СтруктураЯчейки;
	КонецЦикла;

	Возврат СтруктураЯчейки;


КонецФункции

// Проверяет, отсканированы ли коды маркировки товара.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - товар;
//  КоличествоУпаковок - Число - количество упаковок;
//  Упаковка - СправочникСсылка.ЕдиницыИзмерения - единица измерения;
//  ШтрихкодыУпаковок - Массив из Строка - штрихкоды упаковок.
//
// Возвращаемое значение:
//  Булево - Истина, если коды маркировки отсканированы.
//
Функция МаркиОтсканированы(Номенклатура, КоличествоУпаковок, Упаковка, ШтрихкодыУпаковок) Экспорт

	ПризнакПредметаРасчета = ПолучитьРеквизитСправочника(Номенклатура, "ПризнакПредметаРасчета");
	Если ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ Тогда
		Для Каждого Строка Из ШтрихкодыУпаковок Цикл
			// Обработчик строки
		КонецЦикла;
		Возврат Истина;
	Иначе
		Возврат Истина;
	КонецЕсли;


КонецФункции

// Возвращает массив с данными о найденной номенклатуре по штрихкоду.
//
// Параметры:
//  Штрихкод - Строка - штрихкод отсканированной номенклатуры.
//
// Возвращаемое значение:
//  Массив из Структура - результаты поиска товара:
//   * Номенклатура - СправочникСсылка.Номенклатура - найденный товар;
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика товара;
//   * Серия - СправочникСсылка.СерииНоменклатуры - серия товара;
//   * Количество - Число - количество товара, всегда 1;
//   * ШтрихкодУпаковки - Строка - штрихкод упаковки;
//   * Упаковка - СправочникСсылка.ЕдиницыИзмерения - единица измерения товара.
//
Функция ДанныеТоваровПоШК(Штрихкод) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	|	ШтрихкодыНоменклатуры.Партия	КАК Серия,
	|	1 КАК Количество, 
	|	СТРОКА("""") КАК ШтрихкодУпаковки,
	|	ВЫБОР
	|		КОГДА ШтрихкодыНоменклатуры.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА ШтрихкодыНоменклатуры.Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ ШтрихкодыНоменклатуры.ЕдиницаИзмерения
	|	КОНЕЦ КАК Упаковка
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Если РезультатЗапроса.Количество() Тогда
		#Если Не МобильныйАвтономныйСервер Тогда
			Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатЗапроса);
		#Иначе
			Возврат МобильноеРабочееМестоКладовщика.ТаблицаЗначенийВМассив(РезультатЗапроса);
		#КонецЕсли
	КонецЕсли;

	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатЗапроса);


КонецФункции

// Возвращает данные ячейки, найденной по штрихкоду.
//
// Параметры:
//  Склад - СправочникСсылка.СтруктурныеЕдиницы - склад ячейки;
//  Штрихкод - Строка - штрихкод отсканированной ячейки.
//
// Возвращаемое значение:
//  Структура - данные ячейки:
//   * Штрихкод - Строка - штрихкод отсканированной ячейки;
//   * Ячейка - СправочникСсылка.Ячейки - найденная ячейка, пустая ссылка если не найдена.
//
Функция ДанныеЯчейкиПоШК(Склад, Штрихкод) Экспорт
	
	СтруктураЯчейки = НайтиЯчейкуПоКоду(Склад, Штрихкод);

	Если ЗначениеЗаполнено(СтруктураЯчейки.Ячейка) Тогда
		СтруктураЯчейки.Вставить("Штрихкод", Штрихкод);
		Возврат СтруктураЯчейки;
	КонецЕсли;

	СтруктураЯчейки = МобильноеРабочееМестоКладовщика.НайтиЯчейкуПоШтрихкоду(Склад, Штрихкод, Истина);

	Если СтруктураЯчейки.КодВозврата = 0 Тогда
		СтруктураЯчейки.Вставить("Ячейка", Справочники.Ячейки.ПустаяСсылка());
	Иначе
		#Если Не МобильныйАвтономныйСервер Тогда
			ЯчейкаСкладПомещение = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураЯчейки.Ячейка, "Владелец");
		#Иначе
			ЯчейкаСкладПомещение = МобильноеРабочееМестоКладовщика.ЗначенияРеквизитовОбъекта(СтруктураЯчейки.Ячейка, "Владелец");
		#КонецЕсли
		Если Склад <> ЯчейкаСкладПомещение.Владелец Тогда
			СтруктураЯчейки.Вставить("Ячейка", Справочники.Ячейки.ПустаяСсылка());
		КонецЕсли;
	КонецЕсли;

	СтруктураЯчейки.Вставить("Штрихкод", Штрихкод);

	Возврат СтруктураЯчейки;


КонецФункции

// Возвращает структуру результата поиска документа по штрихкоду.
//
// Возвращаемое значение:
//  Структура - результат поиска документа:
//   * ЭтоРаспоряжение - Булево - признак того, что найденный документ является распоряжением;
//   * Ссылки - Массив из ДокументСсылка - ссылки на найденные документы;
//   * Распоряжение - ДокументСсылка, Неопределено - распоряжение, если найдены ордера;
//   * Направление - Строка - направление найденного документа;
//   * Режим - Строка - режим поиска документа;
//   * Штрихкод - Строка - штрихкод отсканированного документа;
//   * ТекстОшибки - Строка - текст ошибки поиска документа.
//
Функция РезультатПоискаДокументаПоШК() Экспорт

	СтруктураДокумента = Новый Структура;

	СтруктураДокумента.Вставить("ЭтоРаспоряжение", Истина);
	СтруктураДокумента.Вставить("Ссылки", Новый Массив);
	СтруктураДокумента.Вставить("Распоряжение", Неопределено);
	СтруктураДокумента.Вставить("Направление", "");
	СтруктураДокумента.Вставить("Режим", "");
	СтруктураДокумента.Вставить("Штрихкод", "");
	СтруктураДокумента.Вставить("ТекстОшибки", "");

	Возврат СтруктураДокумента;


