	Возврат ХранилищеСистемныхНастроек.ПолучитьСписок("ЗагрузкаНовойНоменклатурыXLS");
	
КонецФункции

// Сохраняет значения параметров.
//
&НаСервере
Процедура СохранитьПараметрыНаСервере(ИмяНастройки)
	
	СохраняемыеПараметры = Новый Структура;
	СохраняемыеПараметры.Вставить("ИмяФайла", Объект.ИмяФайла);
	СохраняемыеПараметры.Вставить("НомерЛиста", Объект.НомерЛиста);

	СохраняемыеПараметры.Вставить("НомерПервойСтроки", Объект.НомерПервойСтроки);
	СохраняемыеПараметры.Вставить("КолонкаАртикул", Объект.КолонкаАртикул);
	СохраняемыеПараметры.Вставить("КолонкаАртикулХарактеристики", Объект.КолонкаАртикулХарактеристики);
	СохраняемыеПараметры.Вставить("КолонкаНаименованиеНоменклатуры", Объект.КолонкаНаименованиеНоменклатуры);
	СохраняемыеПараметры.Вставить("КолонкаШК", Объект.КолонкаШК);
	СохраняемыеПараметры.Вставить("КолонкаХарактеристикаЦвет", Объект.КолонкаХарактеристикаЦвет);
	СохраняемыеПараметры.Вставить("КолонкаХарактеристикаРама", Объект.КолонкаХарактеристикаРама);
	СохраняемыеПараметры.Вставить("КолонкаХарактеристикаРост", Объект.КолонкаХарактеристикаРост);
	СохраняемыеПараметры.Вставить("КолонкаХарактеристикаРостовка", Объект.КолонкаХарактеристикаРостовка);
	СохраняемыеПараметры.Вставить("КолонкаТип", Объект.КолонкаТип);
	СохраняемыеПараметры.Вставить("КолонкаМодель", Объект.КолонкаМодель);
	СохраняемыеПараметры.Вставить("КолонкаРазмерКолес", Объект.КолонкаРазмерКолес);

	СохраняемыеПараметры.Вставить("КолонкаГУИД", Объект.КолонкаГУИД);
	СохраняемыеПараметры.Вставить("КолонкаНаименованиеНоменклатурыПолное", Объект.КолонкаНаименованиеНоменклатурыПолное);
	СохраняемыеПараметры.Вставить("КолонкаГруппа", Объект.КолонкаГруппа);
	СохраняемыеПараметры.Вставить("КолонкаГУИДГруппы", Объект.КолонкаГУИДГруппы);
	СохраняемыеПараметры.Вставить("КолонкаВидНоменклатуры", Объект.КолонкаВидНоменклатуры);
	СохраняемыеПараметры.Вставить("КолонкаСтавкаНДС", Объект.КолонкаСтавкаНДС);
	СохраняемыеПараметры.Вставить("КолонкаБренд", Объект.КолонкаБренд);
	СохраняемыеПараметры.Вставить("КолонкаСтрана", Объект.КолонкаСтрана);
	СохраняемыеПараметры.Вставить("КолонкаОписание", Объект.КолонкаОписание);
	СохраняемыеПараметры.Вставить("КолонкаГод", Объект.КолонкаГод);
	СохраняемыеПараметры.Вставить("КолонкаТипТовара", Объект.КолонкаТипТовара);

	СохраняемыеПараметры.Вставить("КолонкаЦена", Объект.КолонкаЦена);
	СохраняемыеПараметры.Вставить("КолонкаЦена1", Объект.КолонкаЦена1);
	СохраняемыеПараметры.Вставить("КолонкаЦена2", Объект.КолонкаЦена2);
	СохраняемыеПараметры.Вставить("КолонкаЦена3", Объект.КолонкаЦена3);
	СохраняемыеПараметры.Вставить("КолонкаЦена4", Объект.КолонкаЦена4);
	СохраняемыеПараметры.Вставить("КолонкаЦена5", Объект.КолонкаЦена5);
	СохраняемыеПараметры.Вставить("КолонкаЦена6", Объект.КолонкаЦена6);
	СохраняемыеПараметры.Вставить("КолонкаЦена7", Объект.КолонкаЦена7);
	СохраняемыеПараметры.Вставить("КолонкаЦена8", Объект.КолонкаЦена8);
	
	
	ХранилищеСистемныхНастроек.Сохранить("ЗагрузкаНовойНоменклатурыXLS", ИмяНастройки, СохраняемыеПараметры);
	
КонецПроцедуры

// Восстанавливает значения параметров.
//
&НаСервере
Процедура ВосстановитьПараметрыНаСервере(ИмяНастройки)
	
	ВосстановленныеПараметры = ХранилищеСистемныхНастроек.Загрузить("ЗагрузкаНовойНоменклатурыXLS", ИмяНастройки);
	
	Если ТипЗнч(ВосстановленныеПараметры) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ВосстановленныеПараметры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Парам Из ВосстановленныеПараметры Цикл
		
		ИмяПараметра = Парам.Ключ;
		Попытка
			Объект[ИмяПараметра] = Парам.Значение;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузитьИзФайла(Команда)
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.КолонкаГруппа) 
		И Не ЗначениеЗаполнено(Объект.КолонкаГУИДГруппы) 
		И Не ЗначениеЗаполнено(Объект.КолонкаБренд) Тогда
	КонецЕсли;
		
	
	ДвоичныеДанные = Новый ДвоичныеДанные(Объект.ИмяФайла);
    АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
    ЧтениеФайлаНаСервере(АдресХранилища);
	
	Элементы.Группа4.ТекущаяСтраница = Элементы.Группа6;

КонецПроцедуры

&НаСервере
Процедура ЧтениеФайлаНаСервере(АдресХранилища)
    
    Файл = ПолучитьИзВременногоХранилища(АдресХранилища);
    Если Прав(Объект.ИмяФайла, 3) = "xls" Тогда
        РасширениеФайла = "xls";
    Иначе
        РасширениеФайла = "xlsx";
    КонецЕсли;
    
    ИмяФайлаВр = ПолучитьИмяВременногоФайла(РасширениеФайла);
    Файл.Записать(ИмяФайлаВр);
    
    ПолныйТабДок = Новый ТабличныйДокумент;
    Попытка
        ПолныйТабДок.Прочитать(ИмяФайлаВр, СпособЧтенияЗначенийТабличногоДокумента.Текст);
    Исключение
        Сообщить(ОписаниеОшибки(), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	Если Объект.НомерЛиста = 0 Тогда
		ИндексЛиста = 0;
	Иначе
		ИндексЛиста = Объект.НомерЛиста - 1;
	КонецЕсли;
	
	Если ПолныйТабДок.Области.Количество() > 0 Тогда
		ТабДок = ПолныйТабДок.ПолучитьОбласть(ПолныйТабДок.Области[ИндексЛиста].Имя);
	Иначе
		Сообщить("Пустой файл");
		Возврат;
	КонецЕсли;
	
	Объект.ДанныеЗагрузки.Очистить();
	НомерПоследнейСтроки = ?(Объект.ВсяОбластьДанных, ТабДок.ВысотаТаблицы, Объект.НомерПоследнейСтроки);
	
	// Обход строк табличного документа и заполнение таблицы значений
	Для НомерСтроки = Объект.НомерПервойСтроки по НомерПоследнейСтроки Цикл  

		НаименованиеНоменклатуры 	= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаНаименованиеНоменклатуры));
		
		Если ПустаяСтрока(НаименованиеНоменклатуры) Тогда Продолжить КонецЕсли;
		
		НСтрока = Объект.ДанныеЗагрузки.Добавить();
		НСтрока.НаименованиеНоменклатуры 	= НаименованиеНоменклатуры;		
		НСтрока.ВидНоменклатуры 	= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаВидНоменклатуры));
		НСтрока.СтавкаНДС 			= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаСтавкаНДС));
		
		Если СтрНайти(НСтрока.СтавкаНДС, "%") = 0 Тогда
			НСтрока.СтавкаНДС = НСтрока.СтавкаНДС + "%";
		КонецЕсли;
		
		Если Не Объект.КолонкаТип = 0 Тогда
			НСтрока.Тип 				= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаТип));
		КонецЕсли;
		Если Не Объект.КолонкаГУИД = 0 Тогда
			НСтрока.ГУИД 					= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаГУИД));
		КонецЕсли;
		Если Не Объект.КолонкаАртикул = 0 Тогда
			НСтрока.Артикул 				= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаАртикул));
		КонецЕсли;
		Если Не Объект.КолонкаШК = 0 Тогда
			НСтрока.Штрихкод 			= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаШК));
		КонецЕсли;
		Если Не Объект.КолонкаНаименованиеНоменклатурыПолное = 0 Тогда
			НСтрока.НаименованиеПолное 		= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаНаименованиеНоменклатурыПолное));
		КонецЕсли;
		Если Не Объект.КолонкаГруппа = 0 Тогда
			НСтрока.Группа 					= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаГруппа));
		КонецЕсли;
		Если Не Объект.КолонкаГУИДГруппы = 0 Тогда
			НСтрока.ГУИДГруппы 			= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаГУИДГруппы));
		КонецЕсли;
		Если Не Объект.КолонкаБренд = 0 Тогда
			НСтрока.Бренд 				= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаБренд));
		КонецЕсли;
		Если Не Объект.КолонкаСтрана = 0 Тогда
			НСтрока.Страна 				= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаСтрана));
		КонецЕсли;
		Если Не Объект.КолонкаОписание = 0 Тогда
			НСтрока.Описание 			= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаОписание));
		КонецЕсли;
		Если Не Объект.КолонкаРазмерКолес = 0 Тогда
			НСтрока.РазмерКолес 		= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаРазмерКолес));
		КонецЕсли;
		Если Не Объект.КолонкаМодель = 0 Тогда
			НСтрока.Модель 				= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаМодель));
		КонецЕсли;
		Если Не Объект.КолонкаГод = 0 Тогда
			НСтрока.Год 				= СтрЗаменить(СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаГод)), "(", ""), ")", "");
		КонецЕсли;
		Если Не Объект.КолонкаТипТовара = 0 Тогда
			НСтрока.ТипТовара 				= СтрЗаменить(СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаТипТовара)), "(", ""), ")", "");
		КонецЕсли;

		Если Не Объект.КолонкаАртикулХарактеристики = 0 Тогда
			НСтрока.АртикулХарактеристики 	= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки, Объект.КолонкаАртикулХарактеристики));
		КонецЕсли;
		Если Не Объект.КолонкаХарактеристикаЦвет = 0 Тогда
			НСтрока.ХарактеристикаЦвет 	= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаХарактеристикаЦвет));
		КонецЕсли;
		
		Если Не Объект.КолонкаХарактеристикаРостовка = 0 Тогда
			Ростовка = СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаХарактеристикаРостовка)), "-", "");
			НСтрока.ХарактеристикаРостовка 		= ?(ПустаяСтрока(Ростовка), НСтрока.РазмерКолес, Ростовка + """");
		КонецЕсли;
		
		Если Не Объект.КолонкаХарактеристикаРама = 0 Тогда
			НСтрока.ХарактеристикаРама 			= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаХарактеристикаРама));
		КонецЕсли;
		Если Не Объект.КолонкаХарактеристикаРост = 0 Тогда
			НСтрока.ХарактеристикаРост 			= СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаХарактеристикаРост));
		КонецЕсли;
		
		Если Не Объект.КолонкаЦена = 0 Тогда
			НСтрока.Цена 				= СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаЦена)),",",".");
		КонецЕсли;
		Если Не Объект.КолонкаЦена1 = 0 Тогда
			НСтрока.Цена1 				= СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаЦена1)),",",".");
		КонецЕсли;
		Если Не Объект.КолонкаЦена2 = 0 Тогда
			НСтрока.Цена2 				= СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаЦена2)),",",".");
		КонецЕсли;
		Если Не Объект.КолонкаЦена3 = 0 Тогда
			НСтрока.Цена3 				= СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаЦена3)),",",".");
		КонецЕсли;
		Если Не Объект.КолонкаЦена4 = 0 Тогда
			НСтрока.Цена4 				= СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаЦена4)),",",".");
		КонецЕсли;
		Если Не Объект.КолонкаЦена5 = 0 Тогда
			НСтрока.Цена5 				= СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаЦена5)),",",".");
		КонецЕсли;
		Если Не Объект.КолонкаЦена6 = 0 Тогда
			НСтрока.Цена6 				= СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаЦена6)),",",".");
		КонецЕсли;
		Если Не Объект.КолонкаЦена7 = 0 Тогда
			НСтрока.Цена7 				= СтрЗаменить(СокрЛП(ПолучитьСодержаниеЯчейки(ТабДок, НомерСтроки,Объект.КолонкаЦена7)),",",".");
