&НаКлиенте
Процедура СохранитьПараметры(Команда)
	
	СписокНастроек = ПолучитьСписокНастроекНаСервере();
	СписокНастроек.Добавить("НоваяНастройка", "СОЗДАТЬ НОВУЮ");
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтотОбъект, "Сохранение");
	СписокНастроек.ПоказатьВыборЭлемента(Оповещение, "Выберите настройку");
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЭлемента(ВыбранныйЭлемент, СписокПараметров) Экспорт
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = ВыбранныйЭлемент.Значение; 
	Если ВыбранноеЗначение = "НоваяНастройка" Тогда
		Подсказка = "Введите имя настройки";
		Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки", ЭтотОбъект, СписокПараметров);
		ПоказатьВводСтроки(Оповещение, "", Подсказка, 0, Истина);
	Иначе
		Если СписокПараметров = "Сохранение" Тогда
			СохранитьПараметрыНаСервере(ВыбранныйЭлемент.Значение);
		ИначеЕсли  СписокПараметров = "Восстановление" Тогда
			ВосстановитьПараметрыНаСервере(ВыбранныйЭлемент.Значение);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтроки(Строка, Параметры) Экспорт
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СохранитьПараметрыНаСервере(Строка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьПараметры(Команда)
	
	СписокНастроек = ПолучитьСписокНастроекНаСервере();
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтотОбъект, "Восстановление");
	СписокНастроек.ПоказатьВыборЭлемента(Оповещение, "Выберите настройку");
	
КонецПроцедуры

