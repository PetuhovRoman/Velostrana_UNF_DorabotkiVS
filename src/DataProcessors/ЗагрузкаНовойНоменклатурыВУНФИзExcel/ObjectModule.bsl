Функция ПолучитьТоварнуюКатегорию(Знач СтрокаТЧ)
	ВН = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(СтрокаТЧ.ВидНоменклатуры);
	
	ТекСпр = Справочники.ТоварныеКатегории.НайтиПоНаименованию(СтрокаТЧ.Модель,,,ВН); 

	Если ЗначениеЗаполнено(ТекСпр) Тогда
		Возврат ТекСпр;
	КонецЕсли;
	СпрТК = Справочники.ТоварныеКатегории.СоздатьЭлемент();
	СпрТК.Наименование = СокрЛП(СтрокаТЧ.Модель);
	СпрТК.Родитель = Справочники.ТоварныеКатегории.НайтиПоНаименованию(СтрокаТЧ.Бренд,,,ВН);
	СпрТК.Владелец = ВН;
	СпрТК.Записать();
	
	Возврат СпрТК.Ссылка;
		
КонецФункции

Функция ЗначениеПеречисления(ИмяПеречисления, СтрЗначения)
    
    Для Каждого эл из  Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
        Если СтрЗначения = эл.Синоним Тогда 
			Сообщить(эл.Имя);
			Возврат Перечисления[ИмяПеречисления][эл.Имя];
        КонецЕсли;
    КонецЦикла;

КонецФункции // ЗначениеПеречисления()

Функция ПолучитьЮрФизЛицо(СтрокаЮФЛицо, СтрокаИНН)
	
	Если СтрокаЮФЛицо = "Юр. лицо" Тогда
		Возврат Перечисления.ЮрФизЛицо.ЮрЛицо;
	ИначеЕсли ЗначениеЗаполнено(СтрокаИНН) Тогда
		Возврат Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
	Иначе
		Возврат Перечисления.ЮрФизЛицо.ФизЛицо;
	КонецЕсли;
		

КонецФункции

Функция ПолучитьПапку(ТекНаименование)
	
	ГруппаСпр = Справочники.Партнеры.НайтиПоНаименованию(ТекНаименование);
	
	Если ЗначениеЗаполнено(ГруппаСпр) И ГруппаСпр.ЭтоГруппа Тогда
		Возврат ГруппаСпр;
	КонецЕсли;
	
	ГруппаОбъект = Справочники.Партнеры.СоздатьГруппу();
	ГруппаОбъект.Наименование = ТекНаименование;
	ГруппаОбъект.Записать();
	
	Возврат ГруппаОбъект.Ссылка;
	
КонецФункции

// Выводит сообщение пользователю.
//
// Параметры:
//	ТекстСообщенияПользователю - Строка - Текст выводимого сообщения.
//
Процедура СообщитьПользователю(ТекстСообщенияПользователю, СсылкаНаОбъект = Неопределено) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Сообщение.УстановитьДанные(СсылкаНаОбъект);
	КонецЕсли;
	Сообщение.Сообщить();
	
КонецПроцедуры


