Функция ПолучитьАртикулХарактеристики(Товар, СтрокаАртикула)

	Если ЗначениеЗаполнено(СтрокаАртикула) Тогда
		Возврат СтрокаАртикула;
	КонецЕсли;
	
    Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХарактеристикиНоменклатуры.Наименование
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Владелец", Товар);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Формат(Выборка.Количество() + 1, "ЧЦ=2; ЧВН=");
	
КонецФункции

Функция ПолучитьНоменклатуру(Знач СтрокаТЧ)
	
	Если ПустаяСтрока(СтрокаТЧ.ГУИД) Тогда
		Товар = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.НаименованиеНоменклатуры, Истина);
	Иначе
		НовыйGUID = Новый УникальныйИдентификатор(СтрокаТЧ.ГУИД);
		Товар = Справочники.Номенклатура.ПолучитьСсылку(НовыйGUID);
	КонецЕсли;
	
	Если ОбщегоНазначения.СсылкаСуществует(Товар) Тогда
		Если ПерезаполнятьНоменклатуру Тогда
			СпрН = Товар.ПолучитьОбъект();
		Иначе
			Возврат Товар;
		КонецЕсли;
	Иначе
		СпрН = Справочники.Номенклатура.СоздатьЭлемент();
		Если Не ПустаяСтрока(СтрокаТЧ.ГУИД) Тогда
			СпрН.УстановитьСсылкуНового(Товар);
		КонецЕсли;
	КонецЕсли;
	
	СпрН.Артикул = СтрокаТЧ.Артикул;
	СпрН.Наименование = СтрокаТЧ.НаименованиеНоменклатуры;
	СпрН.НаименованиеПолное = ?(ЗначениеЗаполнено(СтрокаТЧ.НаименованиеПолное), СтрокаТЧ.НаименованиеПолное, СтрокаТЧ.НаименованиеНоменклатуры);
	Если СтрокаТЧ.Тип = "Услуга" Тогда
		СпрН.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
		СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Услуга;
	Иначе
		СпрН.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
		
		СпрН.СпособПополнения = Перечисления.СпособыПополненияЗапасов.Закупка;
		СпрН.МетодОценки = Перечисления.МетодОценкиЗапасов.FIFO;
		СпрН.СчетУчетаЗапасов = ПланыСчетов.Управленческий.ТоварыПродукция;
		
		СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
		
	КонецЕсли;
	СпрН.КатегорияНоменклатуры = Справочники.КатегорииНоменклатуры.НайтиПоНаименованию(СтрокаТЧ.ВидНоменклатуры);
	СпрН.Родитель = ПолучитьРодителя(СтрокаТЧ);
	СпрН.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.шт;
	Если ЗначениеЗаполнено(СтрокаТЧ.Страна) Тогда
		СпрН.СтранаПроисхождения = Справочники.СтраныМира.НайтиПоНаименованию(СтрокаТЧ.Страна);
	Иначе
		СпрН.СтранаПроисхождения = "";
	КонецЕсли;
	СпрН.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ВидСтавки(Справочники.СтавкиНДС.НайтиПоНаименованию(СтрокаТЧ.СтавкаНДС));
	СпрН.ИспользоватьХарактеристики = ЗначениеЗаполнено(СтрокаТЧ.ХарактеристикаЦвет);
	СпрН.ВидМаркировки = Перечисления.ВидыМаркировки.НеМаркируется;
	Если ЗначениеЗаполнено(СпрН.КатегорияНоменклатуры.ВидПродукцииИС) Тогда
		СпрН.ВидПродукцииИС = СпрН.КатегорияНоменклатуры.ВидПродукцииИС;
		СпрН.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ;
	КонецЕсли;
	
	СпрН.СчетУчетаЗатрат = ПланыСчетов.Управленческий.КоммерческиеРасходы;
	СпрН.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ОсновноеНаправление;
	
	СпрН.ТорговаяМарка = Справочники.ТорговыеМарки.НайтиПоНаименованию(СтрокаТЧ.Бренд); 
	СпрН.Комментарий = СтрокаТЧ.Описание;
	//СпрН.ВестиУчетПоГТД = УчетПоГТД;
	
	//СпрН.ТоварнаяКатегория = ПолучитьТоварнуюКатегорию(СтрокаТЧ);
	Если ЗначениеЗаполнено(СтрокаТЧ.РазмерКолес) Тогда
		ДопСвойство = СпрН.ДополнительныеРеквизиты.Добавить();
		ДопСвойство.Свойство = ПолучитьСвойствоНоменклатуры("Колеса", СпрН.КатегорияНоменклатуры);
		ДопСвойство.Значение = ПолучитьЗначениеРеквизита(ДопСвойство.Свойство, СтрокаТЧ.РазмерКолес);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ТипТовара) Тогда
		ДопСвойство = СпрН.ДополнительныеРеквизиты.Добавить();
		ДопСвойство.Свойство = ПолучитьСвойствоНоменклатуры("Тип товара", СпрН.КатегорияНоменклатуры);
		ДопСвойство.Значение = ПолучитьЗначениеРеквизита(ДопСвойство.Свойство, СтрокаТЧ.ТипТовара);
	КонецЕсли;
	
	СпрН.Записать();
	
	Товар = СпрН.Ссылка;
	
	ЗаписьЖурналаРегистрации("ЗагрузкаДанныхEXCEL.Номенклатура", УровеньЖурналаРегистрации.Информация, , Товар, "Создана номенклатура " + СтрокаТЧ.НаименованиеНоменклатуры + " (" + СтрокаТЧ.Артикул + ")");
	
	Возврат Товар;

	
КонецФункции

Функция ПолучитьЗначениеРеквизита(Свойство, СтрокаЗначения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	НЕ ЗначенияСвойствОбъектов.ПометкаУдаления
	|	И ЗначенияСвойствОбъектов.Владелец = &Владелец
	|	И ЗначенияСвойствОбъектов.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Владелец", Свойство);
	Запрос.УстановитьПараметр("Наименование", СтрокаЗначения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	НовоеЗначение = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
	НовоеЗначение.Владелец = Свойство;
	НовоеЗначение.Наименование = СтрокаЗначения;
	НовоеЗначение.Записать();
	
	Возврат НовоеЗначение.Ссылка;
	
КонецФункции

Функция ПолучитьРодителя(Знач СтрокаТЧ)
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ГУИДГруппы) Тогда
		НовыйGUIDГр = Новый УникальныйИдентификатор(СтрокаТЧ.ГУИДГруппы);
		Родитель = Справочники.Номенклатура.ПолучитьСсылку(НовыйGUIDГр);
		Если ОбщегоНазначения.СсылкаСуществует(Родитель) Тогда
			Возврат Родитель;
		КонецЕсли;
		СпрНГр = Справочники.Номенклатура.СоздатьГруппу();
		СпрНГр.УстановитьСсылкуНового(Родитель);
		СпрНГр.Наименование = СокрЛП(СтрокаТЧ.Год);
		СпрНГр.Родитель = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.Бренд, Истина);
		СпрНГр.Записать();
		Возврат СпрНГр.Ссылка;
	ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.Группа) Тогда	
		ТекСпр = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.Группа,, Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.Бренд, Истина));
		Если ЗначениеЗаполнено(ТекСпр) Тогда
			Возврат ТекСпр;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.Год) Тогда	
		ТекСпр = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.Год,, Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.Бренд, Истина));
		Если ЗначениеЗаполнено(ТекСпр) Тогда
			Возврат ТекСпр;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.Бренд) Тогда	
		ТекСпр = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.Бренд,,);
		Если ЗначениеЗаполнено(ТекСпр) Тогда
			Возврат ТекСпр;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.Группа)
		Или  ЗначениеЗаполнено(СтрокаТЧ.Год)
		Или  ЗначениеЗаполнено(СтрокаТЧ.Бренд) Тогда
		
		СпрНГр = Справочники.Номенклатура.СоздатьГруппу();
		Если ЗначениеЗаполнено(СтрокаТЧ.Группа) Тогда
			СпрНГр.Наименование = СокрЛП(СтрокаТЧ.Группа);
			СпрНГр.Родитель = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.Бренд, Истина);
		ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.Год) Тогда 
			СпрНГр.Наименование = СокрЛП(СтрокаТЧ.Год);
			СпрНГр.Родитель = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаТЧ.Бренд, Истина);
		Иначе
			СпрНГр.Наименование = СокрЛП(СтрокаТЧ.Бренд);
		КонецЕсли;
		
		СпрНГр.Записать();
		
		Возврат СпрНГр.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

Функция ПолучитьСвойствоХарактеристики(ИмяСвойства, КатегорияНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство КАК Свойство
	|ИЗ
	|	Справочник.КатегорииНоменклатуры КАК КатегорииНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты
	|		ПО КатегорииНоменклатуры.НаборСвойствХарактеристики = НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка
	|ГДЕ
	|	КатегорииНоменклатуры.Ссылка = &КатегорияНоменклатуры
	|	И НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.Наименование = &Свойство";
	Запрос.УстановитьПараметр("Свойство", ИмяСвойства);
	Запрос.УстановитьПараметр("КатегорияНоменклатуры", КатегорияНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Свойство;
	КонецЕсли;
	
	//ТекСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Заголовок", ИмяСвойства);
	
	Если ЗначениеЗаполнено(КатегорияНоменклатуры.НаборСвойствХарактеристики) Тогда
		ТекНабор = КатегорияНоменклатуры.НаборСвойствХарактеристики;
	Иначе
		ТекНабор = Справочники.НаборыДополнительныхРеквизитовИСведений.СоздатьГруппу();
		ТекНабор.Наименование = СокрЛП(КатегорияНоменклатуры);
		ТекНабор.Записать();
		
		ОбъектВН = КатегорияНоменклатуры.ПолучитьОбъект();
		ОбъектВН.ИспользоватьХарактеристики = Истина;
		ОбъектВН.НаборСвойствХарактеристики = ТекНабор.Ссылка;
		ОбъектВН.Записать();
	КонецЕсли;
	
	ТекСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
	ТекСвойство.Виден = Истина; 
	ТекСвойство.Доступен = Истина; 
	ТекСвойство.НаборСвойств = ТекНабор.Ссылка;
	ТекСвойство.Наименование = ИмяСвойства;
	ТекСвойство.Заголовок = ИмяСвойства;
	ТекСвойство.ВидСвойства = Перечисления.ВидыСвойств.ДополнительныеРеквизиты;
	ТекСвойство.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов");
	ТекСвойство.Записать();
	
	НаборОбъект = ТекНабор.Ссылка.ПолучитьОбъект();
	НоваяСтрокаСвойств = НаборОбъект.ДополнительныеРеквизиты.Добавить();
	НоваяСтрокаСвойств.Свойство = ТекСвойство.Ссылка;
	НаборОбъект.Записать();

	Возврат ТекСвойство.Ссылка;
	
КонецФункции

