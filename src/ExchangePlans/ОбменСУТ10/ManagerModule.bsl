Процедура ЗарегистрироватьИзмененияДляОбмена(ОбменДанными, Организация, Подразделение) Экспорт 
	
	ОбменДанными.Получатели.Очистить();
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбменДанными.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.ОбменСУТ10 КАК ОбменДанными
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменСУТ10.Подразделения КАК ОбменСУТ10Подразделения
	|		ПО ОбменДанными.Ссылка = ОбменСУТ10Подразделения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.ОбменСУТ10.Организации КАК ОбменСУТ10Организации
	|		ПО ОбменДанными.Ссылка = ОбменСУТ10Организации.Ссылка
	|ГДЕ
	|	ОбменДанными.Ссылка <> &ЭтотУзел
	|	И ВЫБОР
	|			КОГДА ОбменСУТ10Организации.Организация ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ОбменСУТ10Организации.Организация = &Организация
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ОбменСУТ10Подразделения.Подразделение ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ОбменСУТ10Подразделения.Подразделение = &Подразделение
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.ОбменСУТ10.ЭтотУзел());
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбменДанными.Получатели.Добавить(Выборка.Ссылка);
	КонецЦикла;	
	
КонецПроцедуры
