///==============================================================================
&Перед("ПриЗаписи")
Процедура pdunf_ПриЗаписи(Отказ, Замещение)

	Если ОбменДанными.Загрузка
		ИЛИ НЕ ДополнительныеСвойства.Свойство("ДляПроведения")
		ИЛИ НЕ ДополнительныеСвойства.ДляПроведения.Свойство("СтруктураВременныеТаблицы") Тогда
		Возврат;
	КонецЕсли;

	ТаблицаЗаказов = ДополнительныеСвойства.ТаблицаЗаказов;
	заказы         = ТаблицаЗаказов.ВыгрузитьКолонку("ЗаказПокупателя");
	РегистрыСведений.ГрафикОбеспеченияЗаказов.ОбновитьПроцентОбеспеченияЗаказов(заказы);
КонецПроцедуры // pdunf_ПриЗаписи
