&После("ПриЗаписи")
Процедура pdunf_ПриЗаписи(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат
	КонецЕсли;

	//РегистрыСведений.ГрафикОбеспеченияЗаказов.ОбновитьПроцентОбеспеченияВсехЗаказов(); 
	ОтборФоновыхЗаданий = Новый Структура;
	ОтборФоновыхЗаданий.Вставить("Ключ", 		"ОбновитьПроцентОбеспеченияВсехЗаказов");
	ОтборФоновыхЗаданий.Вставить("Состояние", 	СостояниеФоновогоЗадания.Активно);
	ФоновоеЗадание = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборФоновыхЗаданий);
	Если ФоновоеЗадание.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПроцедуры = "РегистрыСведений.ГрафикОбеспеченияЗаказов.ОбновитьПроцентОбеспеченияВсехЗаказов";
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	ПараметрыВыполнения.КлючФоновогоЗадания = "ОбновитьПроцентОбеспеченияВсехЗаказов";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, ИмяПроцедуры);
	
КонецПроцедуры // pdunf_ПриЗаписи
