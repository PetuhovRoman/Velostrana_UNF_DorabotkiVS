
&После("ОбработкаЗаполнения")
Процедура ВС_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		СостояниеЗаказа = ЗаполнениеОбъектовУНФ.ПолучитьСостояниеЗаказаНаПеремещение();
	КонецЕсли;
	
КонецПроцедуры

&ИзменениеИКонтроль("ОбработкаПроведения")
Процедура ВС_ОбработкаПроведения(Отказ, РежимПроведения)
#Вставка
// Роман.П 02.11.2026 — проведение распоряжения без движений, штатный текст ниже под контролем.
	Если Не ЗначениеЗаполнено(СостояниеЗаказа) Тогда
		ОбщегоНазначения.СообщитьПользователю("Укажите состояние перемещения перед проведением.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если СостояниеЗаказа <> Справочники.СостоянияЗаказовНаПеремещение.Завершен Тогда
		// Для распоряжения не формируем новые складские и серийные движения.
		// Штатная подготовка помечает к записи ранее использованные регистры:
		// пустые наборы заменяют старые записи, а не оставляют их в базе.
		ПроведениеДокументовУНФ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
		ПроведениеДокументовУНФ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
		ПроведениеДокументовУНФ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
		Документы.ПеремещениеПоЯчейкам.ВыполнитьКонтроль(Ссылка, ДополнительныеСвойства, Отказ);
		ПроведениеДокументовУНФ.ЗакрытьМенеджерВременныхТаблиц(ЭтотОбъект);
		Возврат;
	КонецЕсли;
// Конец Роман.П
#КонецВставки
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеДокументовУНФ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Инициализация данных документа
	Документы.ПеремещениеПоЯчейкам.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеДокументовУНФ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Отражение в разделах учета
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ПроведениеДокументовУНФ.ОтразитьДвижения("ЗапасыНаСкладах", ТаблицыДляДвижений, Движения, Отказ);
	
	// СерииНоменклатуры
	ПроведениеДокументовУНФ.ОтразитьДвижения("СерииНоменклатурыГарантии", ТаблицыДляДвижений, Движения, Отказ);
	ПроведениеДокументовУНФ.ОтразитьДвижения("ДвиженияСерииНоменклатуры", ТаблицыДляДвижений, Движения, Отказ);
	ПроведениеДокументовУНФ.ОтразитьДвижения("СерииНоменклатуры", ТаблицыДляДвижений, Движения, Отказ);
	
	// Запись наборов записей
	ПроведениеДокументовУНФ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	// Контроль
	Документы.ПеремещениеПоЯчейкам.ВыполнитьКонтроль(Ссылка, ДополнительныеСвойства, Отказ);
	
	ПроведениеДокументовУНФ.ЗакрытьМенеджерВременныхТаблиц(ЭтотОбъект);
	
КонецПроцедуры

// Роман.П 02.11.2026 — защита обратного перехода, в том числе при обычной записи без перепроведения.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	ПрежниеЗначения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Проведен, СостояниеЗаказа");
	Если ПрежниеЗначения.Проведен
		И СостояниеЗаказа <> ПрежниеЗначения.СостояниеЗаказа Тогда
		Если РежимЗаписи <> РежимЗаписиДокумента.Проведение
			Или ПрежниеЗначения.СостояниеЗаказа = Справочники.СостоянияЗаказовНаПеремещение.Завершен
			Или Не ЗначениеЗаполнено(ПрежниеЗначения.СостояниеЗаказа) Тогда
			ОбщегоНазначения.СообщитьПользователю("Смена состояния требует перепроведения. Для возврата завершенного или старого документа сначала отмените проведение.");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
// Конец Роман.П
