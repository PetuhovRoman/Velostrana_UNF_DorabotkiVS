
&ИзменениеИКонтроль("ПолучитьКодВидаОперации")
Функция ВС_ПолучитьКодВидаОперации(СтруктураПараметров, КодВидаОперацииОснования = Неопределено) Экспорт

	Перем КодВидаОперации;

	Дата                      = СтруктураПараметров.Дата;
	ВидСчетаФактуры           = СтруктураПараметров.ВидОперации;
	Исправление               = СтруктураПараметров.Исправление;
	Контрагент                = СтруктураПараметров.Контрагент;
	ДоговорКонтрагента        = СтруктураПараметров.Договор;
	Если ТипЗнч(СтруктураПараметров) = Тип("ДокументОбъект.СчетФактура") Тогда
		ДокументОснование = СтруктураПараметров.ДокументОснование;
	Иначе
		ДокументОснование = Неопределено;
	КонецЕсли;

	Если ТипЗнч(СтруктураПараметров) = Тип("ДокументОбъект.СчетФактура") Тогда
		Продавец              = Справочники.Контрагенты.ПустаяСсылка();
	Иначе
		Продавец              = СтруктураПараметров.Продавец;
	КонецЕсли;
	ВерсияКодовВидовОпераций  = УчетНДСКлиентСервер.ВерсияКодовВидовОпераций(Дата);

	Если ТипЗнч(СтруктураПараметров) = Тип("ДокументОбъект.СчетФактура") Тогда
		ДокументыОснования = СтруктураПараметров.ДокументыОснования.Выгрузить( , "ДокументОснование");
	ИначеЕсли ТипЗнч(СтруктураПараметров.ДокументыОснования) = Тип("ТаблицаЗначений") Тогда
		ДокументыОснования = СтруктураПараметров.ДокументыОснования;
	Иначе
		ДокументыОснования = СтруктураПараметров.ДокументыОснования;
	КонецЕсли;

	Если Исправление Или ВидСчетаФактуры = Перечисления.ВидыОперацийСчетФактура.Корректировка Тогда
		Если ЗначениеЗаполнено(КодВидаОперацииОснования) Тогда
			Возврат УчетНДС.АктуальныйКодВидаОперации(КодВидаОперацииОснования, ВерсияКодовВидовОпераций);
		КонецЕсли;
	КонецЕсли;

	Если ВидСчетаФактуры = Перечисления.ВидыОперацийСчетФактура.Аванс Тогда
        
        Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда 
            УчетАгентскогоНДСПокупателем = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКонтрагента, "УчетАгентскогоНДСПокупателем");
            Если УчетАгентскогоНДСПокупателем Тогда 
                КодВидаОперации = "33";
                Возврат КодВидаОперации;
            КонецЕсли;
        КонецЕсли;

		КодВидаОперации = "02";

		Если ЗначениеЗаполнено(ДокументОснование) И ТипЗнч(ДокументОснование) = Тип(
			"ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
			КодВидаОперации = "26"; // авансы по подарочным сертификатам
		КонецЕсли;

	ИначеЕсли ВидСчетаФактуры = Перечисления.ВидыОперацийСчетФактура.НаАвансКомитента Тогда

		КодВидаОперации = ?(ВерсияКодовВидовОпераций < 3, "05", "02");

	ИначеЕсли ВидСчетаФактуры = Перечисления.ВидыОперацийСчетФактура.СуммовыеРазницы Тогда

		КодВидаОперации = ?(ВерсияКодовВидовОпераций < 3, "09", "01");

	ИначеЕсли ВидСчетаФактуры = Перечисления.ВидыОперацийСчетФактура.НаАвансКомитента Тогда
        
        Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда 
            УчетАгентскогоНДСПокупателем = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорКонтрагента, "УчетАгентскогоНДСПокупателем");
            Если УчетАгентскогоНДСПокупателем Тогда 
                КодВидаОперации = "34";
                Возврат КодВидаОперации;
            КонецЕсли;
        КонецЕсли;

		МассивДокументовРеализации = Новый Массив;

		Для Каждого СтрокаТабличнойЧасти Из ДокументыОснования Цикл

			КодВидаОперации = "";
			ТипОснования = ТипЗнч(СтрокаТабличнойЧасти.ДокументОснование);

			Если ВерсияКодовВидовОпераций >= 3 Тогда
                // По умолчанию код "01", но необходимо проверить случай "смешанной" реализации (код 15),
                // которая может быть оформлена документом "Реализация товаров услуг".
				КодВидаОперации = "01";
				Если ТипОснования = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
					МассивДокументовРеализации.Добавить(СтрокаТабличнойЧасти);
				Иначе
					МассивДокументовРеализации.Очистить();
					Прервать;
				КонецЕсли;
            // Коды видов операций до 1 июля 2016 года
			ИначеЕсли (ТипОснования = Тип("ДокументСсылка.РасходнаяНакладная")
				И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТабличнойЧасти.ДокументОснование, "ВидОперации")
				= Перечисления.ВидыОперацийРасходнаяНакладная.ВозвратПоставщику) Тогда
				КодВидаОперации = "03";
			ИначеЕсли ТипОснования = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
				КодВидаОперации = "04";
			ИначеЕсли ТипОснования = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
				Если ЗначениеЗаполнено(Продавец) И Продавец <> Контрагент Тогда
					КодВидаОперации = "04";
				КонецЕсли;
			ИначеЕсли ТипОснования = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
				МассивДокументовРеализации.Добавить(СтрокаТабличнойЧасти);
			КонецЕсли;

		КонецЦикла;

		Если МассивДокументовРеализации.Количество() > 0 Тогда
            // Определим какие ценности были реализованы и проверим случай "смешанной" реализации (код 15).

			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ДокументыОснования", МассивДокументовРеализации);
			Запрос.УстановитьПараметр("ИспользуютсяАгентскиеУслуги",
				Константы.ФункциональнаяОпцияИспользоватьАгентскиеУслуги.Получить());
			Запрос.Текст =
			"ВЫБРАТЬ
			|    РасходнаяНакладнаяЗапасы.Ссылка КАК Ссылка,
			|    ВЫБОР
			|        КОГДА РасходнаяНакладнаяЗапасы.Партия.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПартий.ТоварыНаКомиссии)
			|            ТОГДА 1
			|        ИНАЧЕ 0
			|    КОНЕЦ КАК ЕстьКомиссионныеТоварыИУслуги,
			|    ВЫБОР
			|        КОГДА НЕ РасходнаяНакладнаяЗапасы.Партия.Статус = Значение(Перечисление.СтатусыПартий.ТоварыНаКомиссии)
			|            ТОГДА 1
			|        ИНАЧЕ 0
			|    КОНЕЦ КАК ЕстьСобственныеТоварыИУслуги
			|ИЗ
			|    Документ.РасходнаяНакладная.Запасы КАК РасходнаяНакладнаяЗапасы
			|        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПартииНоменклатуры КАК ПартииНоменклатуры
			|        ПО РасходнаяНакладнаяЗапасы.Партия = ПартииНоменклатуры.Ссылка
			|ГДЕ
			|    РасходнаяНакладнаяЗапасы.Ссылка В (&ДокументыОснования)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|    РеализацияТоваровУслугАгентскиеУслуги.Ссылка,
			|    1,
			|    0
			|ИЗ
			|    Документ.РасходнаяНакладная.Запасы КАК РеализацияТоваровУслугАгентскиеУслуги
			|ГДЕ
			|    РеализацияТоваровУслугАгентскиеУслуги.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
			|    И Номенклатура.ЭтоАгентскаяУслуга
			|    И &ИспользуютсяАгентскиеУслуги
			|ИТОГИ
			|    СУММА(ЕстьКомиссионныеТоварыИУслуги),
			|    СУММА(ЕстьСобственныеТоварыИУслуги)
			|ПО
			|    ОБЩИЕ";

			Результат = Запрос.Выполнить();
			Если Не Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Если Выборка.Следующий() Тогда
					Если Выборка.ЕстьСобственныеТоварыИУслуги > 0 И Выборка.ЕстьКомиссионныеТоварыИУслуги > 0 Тогда
						КодВидаОперации = ?(ВерсияКодовВидовОпераций < 3, "01;04", "15");
					ИначеЕсли ВерсияКодовВидовОпераций < 3 И Выборка.ЕстьКомиссионныеТоварыИУслуги > 0 Тогда
						КодВидаОперации = "04";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КодВидаОперации) Тогда
		КодВидаОперации = "01";
		#Вставка
		Если ЗначениеЗаполнено(Контрагент) 
			И Контрагент.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо Тогда
			КодВидаОперации = "26";
		КонецЕсли;
		#КонецВставки
	КонецЕсли;

	Возврат КодВидаОперации;

КонецФункции
