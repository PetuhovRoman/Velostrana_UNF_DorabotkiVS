
&НаСервере
&После("ПриСозданииНаСервере")
Процедура ВС_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НовыйМассив = Новый Массив(Элементы.РаботыСтрокаНоменклатура.ПараметрыВыбора);
	
	МассивПВ = Новый Массив(Элементы.РаботыСтрокаНоменклатура.ПараметрыВыбора[0].Значение);
	МассивПВ.Добавить(Перечисления.ТипыНоменклатуры.Запас);
	
	ПВ = Новый ПараметрВыбора("Отбор.ТипНоменклатуры", Новый ФиксированныйМассив(МассивПВ));
	НовыйМассив.Удалить(0);
	НовыйМассив.Вставить(0, ПВ); 
    Элементы.РаботыСтрокаНоменклатура.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
КонецПроцедуры

&НаКлиенте
&После("УправлениеФормой")
Процедура ВС_УправлениеФормой()
	
	Элементы.Стоимость.Видимость				= Истина;
	Элементы.РаботыНоменклатура.Видимость		= Истина;
	Элементы.РаботыХарактеристика.Видимость		= Истина;
	
	Элементы.РаботыСтрокаНоменклатура.Видимость	= Истина;
	Элементы.РаботыСтрокаХарактеристика.Видимость= Истина;
	
	Элементы.РаботыЦена.Видимость				= Истина;
	Элементы.РаботыСумма.Видимость				= Истина;
	
	Элементы.РаботыИтогСумма.Видимость			= Истина;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаданиеНаРаботу.Внешнее") Тогда
		Элементы.РаботыСтрокаНоменклатура.Заголовок = "Работа, услуга";
	Иначе
		Элементы.РаботыСтрокаНоменклатура.Заголовок = "Номенклатура";
	КонецЕсли;
	
КонецПроцедуры
