
&После("ЗаполнитьПоЗаказуПокупателя")
Процедура ВС_ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаказОснование = ДанныеЗаполнения.Основание;
	Иначе
		ЗаказОснование = ДанныеЗаполнения;
	КонецЕсли;
	Если ТипЗнч(ЗаказОснование) = Тип("ДокументСсылка.ЗаказПокупателя") 
		И ЗаказОснование.ШтрихкодыУпаковок.Количество() > 0
		И ЗаказОснование.Запасы.Итог("Количество") = Запасы.Итог("Количество") Тогда
		АкцизныеМарки.Очистить();
		Для Каждого СтрокаКМ Из ДанныеЗаполнения.ШтрихкодыУпаковок Цикл
			СтрокаАкциз = АкцизныеМарки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаАкциз, СтрокаКМ);
			СтрокаАкциз.АкцизнаяМарка = СтрокаКМ.ШтрихкодУпаковки;
		КонецЦикла;
		//АкцизныеМарки.Загрузить(ДанныеЗаполнения.ШтрихкодыУпаковок.Выгрузить());
	КонецЕсли;
КонецПроцедуры
