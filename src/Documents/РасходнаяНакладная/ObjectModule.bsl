
&После("ЗаполнитьПоЗаказуПокупателя")
Процедура ВС_ЗаполнитьПоЗаказуПокупателя(ДанныеЗаполнения)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПокупателя") 
		И ДанныеЗаполнения.ШтрихкодыУпаковок.Количество() > 0
		И ДанныеЗаполнения.Запасы.Итог("Количество") = Запасы.Итог("Количество") Тогда
		ШтрихкодыУпаковок.Загрузить(ДанныеЗаполнения.ШтрихкодыУпаковок.Выгрузить());
	КонецЕсли;
КонецПроцедуры
