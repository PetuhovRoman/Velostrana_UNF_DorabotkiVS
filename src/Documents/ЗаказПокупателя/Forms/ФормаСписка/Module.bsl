///==============================================================================
&НаКлиенте
Процедура ОтборОбеспеченностьОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = ложь;
	Если не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	конецЕсли;

	Если  ВыбранноеЗначение = "Обеспечено полностью" Тогда
		СтатусОбеспечения = 0;
	иначеЕсли ВыбранноеЗначение = "Обеспечено частично"  тогда
		СтатусОбеспечения = 1;
	иначеЕсли ВыбранноеЗначение = "Не обеспечено"        тогда
		СтатусОбеспечения = 2;
	иначе
		СтатусОбеспечения = ВыбранноеЗначение;
	конецЕсли;

	УстановитьМеткуИОтборСписка("НомерКартинкиОбеспечения", Элемент.Родитель.Имя, СтатусОбеспечения, ВыбранноеЗначение);
	ВыбранноеЗначение = Неопределено;
	
КонецПроцедуры // ОтборОбеспеченностьОбработкаВыбора

