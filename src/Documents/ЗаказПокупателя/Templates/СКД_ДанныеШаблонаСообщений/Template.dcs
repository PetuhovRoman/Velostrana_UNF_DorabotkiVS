			<dataPath>СлужбаДоставки</dataPath>
			<field>СлужбаДоставки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерНаСайте</dataPath>
			<field>НомерНаСайте</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер на сайте</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаНаСайте</dataPath>
			<field>ДатаНаСайте</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата на сайте</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДокументЗаказПокупателя.Номер КАК Номер,
	ДокументЗаказПокупателя.Дата КАК Дата,
	ЕСТЬNULL(ЗаказыПокупателейССайта.НомерЗаказаНаСайте, ДокументЗаказПокупателя.Номер) КАК НомерНаСайте,
	ЕСТЬNULL(ЗаказыПокупателейССайта.ДатаЗаказаНаСайте, ДокументЗаказПокупателя.Дата) КАК ДатаНаСайте,
	ДокументЗаказПокупателя.СостояниеЗаказа КАК СостояниеЗаказа,
	ДокументЗаказПокупателя.ВариантЗавершения КАК ВариантЗавершения,
	ДокументЗаказПокупателя.ПричинаОтмены КАК ПричинаОтмены,
	ВЫБОР
		КОГДА ДокументЗаказПокупателя.Контрагент &lt;&gt; ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				ИЛИ СвязиКонтрагентЛид.Контрагент ЕСТЬ NULL
			ТОГДА ДокументЗаказПокупателя.Контрагент.Наименование
		ИНАЧЕ СвязиКонтрагентЛид.Контрагент.Наименование
	КОНЕЦ КАК Покупатель,
	ДокументЗаказПокупателя.Контрагент.КонтактноеЛицо.Наименование КАК КонтактноеЛицоНаименование,
	ДокументЗаказПокупателя.Лид.Наименование КАК Лид,
	СвязиКонтрагентКонтакт.Должность КАК КонтактноеЛицоДолжность,
	ДокументЗаказПокупателя.Заметки КАК Заметки,
	ВЫБОР
		КОГДА ДокументЗаказПокупателя.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ФизическоеЛицо)
				ИЛИ ДокументЗаказПокупателя.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.ИндивидуальныйПредприниматель)
			ТОГДА ВЫБОР
					КОГДА ДокументЗаказПокупателя.Контрагент.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
						ТОГДА &amp;ОбращениеПолМужской
					КОГДА ДокументЗаказПокупателя.Контрагент.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Женский)
						ТОГДА &amp;ОбращениеПолЖенский
					ИНАЧЕ &amp;Обращение
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ДокументЗаказПокупателя.Контрагент.КонтактноеЛицо.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
					ТОГДА &amp;ОбращениеПолМужской
				КОГДА ДокументЗаказПокупателя.Контрагент.КонтактноеЛицо.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Женский)
					ТОГДА &amp;ОбращениеПолЖенский
				ИНАЧЕ &amp;Обращение
			КОНЕЦ
	КОНЕЦ КАК Обращение,
	ДокументЗаказПокупателя.Ответственный КАК Ответственный,
	ДокументЗаказПокупателя.Проект КАК Проект,
	ДокументЗаказПокупателя.СуммаДокумента КАК СуммаДокумента,
	ДокументЗаказПокупателя.ДатаОтгрузки КАК ДатаОтгрузки,
	ДокументЗаказПокупателя.ВалютаДокумента КАК ВалютаДокумента,
	ДокументЗаказПокупателя.ВидРабот КАК ВидРабот,
	ДокументЗаказПокупателя.Старт КАК Старт,
	ДокументЗаказПокупателя.Финиш КАК Финиш,
	ДокументЗаказПокупателя.СписокНоменклатуры КАК СписокНоменклатуры,
	ДокументЗаказПокупателя.СписокРесурсов КАК СписокРесурсов,
	ВЫБОР
		КОГДА ДокументЗаказПокупателя.СуммаДокумента &lt;= 0
				ИЛИ НЕ ДокументЗаказПокупателя.Контрагент.ВестиРасчетыПоЗаказам
				ИЛИ НЕ ДокументЗаказПокупателя.Проведен
			ТОГДА 0
		ИНАЧЕ ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0)
	КОНЕЦ КАК СуммаОплаты,
	ДокументЗаказПокупателя.УсловияКоммерческогоПредложения КАК УсловияКоммерческогоПредложения,
	ДокументЗаказПокупателя.УсловияСчетаЗаказа КАК УсловияСчетаЗаказа,
	ДокументЗаказПокупателя.Договор.Наименование КАК ДоговорНаименование,
	ДокументЗаказПокупателя.Договор.ДатаДоговора КАК ДоговорДатаДоговора,
	ДокументЗаказПокупателя.Договор.СрокДействия КАК ДоговорСрокДействия,
	"" КАК СписокРесурсовСФотоИУказаниемПериодаРесурса,
	"" КАК СписокРесурсовСУказаниемПериодаРесурса,
	"" КАК СписокРесурсовСФотоИУказаниемДлительностиРесурса,
	"" КАК СписокРесурсовСУказаниемДлительностиРесурса,
	"" КАК СписокРабот,
	"" КАК ВремяДоНачалаЗаписи,
	ДокументЗаказПокупателя.АдресДоставки КАК АдресДоставки,
	ДокументЗаказПокупателя.КонтактноеЛицо КАК КонтактноеЛицоПолучатель,
	ДокументЗаказПокупателя.Курьер КАК Курьер,
	ДокументЗаказПокупателя.ПунктВыдачиЗаказа КАК ПунктВыдачиЗаказа,
	ДокументЗаказПокупателя.СтоимостьДоставки КАК СтоимостьДоставки,
	ДокументЗаказПокупателя.ТрекНомер КАК ТрекНомер,
	ДокументЗаказПокупателя.СпособДоставки КАК СпособДоставки,
	ДокументЗаказПокупателя.ОжидаемаяДатаВручения КАК ОжидаемаяДатаВручения,
	ДокументЗаказПокупателя.ВремяДоставкиС КАК ВремяДоставкиС,
	ДокументЗаказПокупателя.ВремяДоставкиПо КАК ВремяДоставкиПо,
	ДокументЗаказПокупателя.СлужбаДоставки КАК СлужбаДоставки
ИЗ
	Документ.ЗаказПокупателя КАК ДокументЗаказПокупателя
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиКонтрагентКонтакт.СрезПоследних КАК СвязиКонтрагентКонтакт
		ПО (СвязиКонтрагентКонтакт.Контакт = ДокументЗаказПокупателя.Контрагент.КонтактноеЛицо)
			И (СвязиКонтрагентКонтакт.Контрагент = ДокументЗаказПокупателя.Контрагент)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФактОплатыЗаказов КАК ФактОплаты
		ПО ДокументЗаказПокупателя.Ссылка = ФактОплаты.СчетНаОплату
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиКонтрагентЛид КАК СвязиКонтрагентЛид
		ПО ДокументЗаказПокупателя.Лид = СвязиКонтрагентЛид.Лид
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыПокупателейССайта
		ПО ДокументЗаказПокупателя.Ссылка = ЗаказыПокупателейССайта.ЗаказПокупателя
ГДЕ
	ДокументЗаказПокупателя.Ссылка = &amp;ЗаказПокупателя</query>
	</dataSet>
