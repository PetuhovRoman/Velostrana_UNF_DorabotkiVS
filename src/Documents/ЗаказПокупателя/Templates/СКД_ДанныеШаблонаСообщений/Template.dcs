			<dataPath>КонтактноеЛицоПолучатель</dataPath>
			<field>КонтактноеЛицоПолучатель</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Контактное лицо (получатель)</v8:content>
